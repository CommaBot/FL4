@[irreducible] noncomputable def R.faults.trap_extra_mrs_loop.body (sender : obj.Tcb) (buf : Std.U64) (i : Std.Usize) : SProg (ControlFlow Std.Usize Unit) := do
  let s1 ← pure ((Array.to_slice faults.TRAP_EXTRA_MESSAGE))
  let i1 := Slice.len s1
  if i < i1 then do
    let i2 ← SProg.liftR (Array.index_usize faults.TRAP_EXTRA_MESSAGE i)
    let v ← R.obj.Tcb.reg sender i2
    let i3 ← pure ((UScalar.cast .U64 i))
    let i4 ← pure ((core.num.U64.wrapping_add faults.TRAP_EXTRA_FIRST i3))
    let i5 ← pure ((core.num.U64.wrapping_add i4 1#u64))
    let _ ← R.msg.buf_set buf i5 v
    let i6 ← SProg.liftR (i + 1#usize)
    pure (.cont i6)
  else do
    pure (.done ())

