@[irreducible] noncomputable def R.faults.set_fault (t : obj.Tcb) (f : error.Fault) : SProg Unit := do
  let (ty, w0, w1, w2) ← SProg.blk 3 (
      match f with
      | error.Fault.Null => do
          pure ((fl4_abi.consts.fault.NullFault, 0#u64, 0#u64, 0#u64))
      | error.Fault.Cap addr in_recv lf => do
          do
            let (lt, l0, l1) ← SProg.liftR (error.LookupFault.encode lf)
            let _ ← R.obj.Tcb.set_lf_type t lt
            let _ ← R.obj.Tcb.set_lf_w0 t l0
            let _ ← R.obj.Tcb.set_lf_w1 t l1
            let i ← SProg.blk 0 (
                if in_recv then do
                  pure (1#u64)
                else do
                  pure (0#u64))
            pure ((fl4_abi.consts.fault.CapFault, addr, i, 0#u64))
      | error.Fault.UnknownSyscall number => do
          pure ((fl4_abi.consts.fault.UnknownSyscall, number, 0#u64, 0#u64))
      | error.Fault.UserException number code => do
          pure ((fl4_abi.consts.fault.UserException, number, code, 0#u64))
      | error.Fault.Debug reason addr bp => do
          pure ((fl4_abi.consts.fault.DebugException, reason, addr, bp))
      | error.Fault.Timeout badge => do
          pure ((fl4_abi.consts.fault.Timeout, badge, 0#u64, 0#u64))
      | error.Fault.VmFault addr fsr instruction => do
          do
            let i ← SProg.blk 1 (
                if instruction then do
                  pure (1#u64)
                else do
                  pure (0#u64))
            pure ((fl4_abi.consts.fault.VMFault, addr, fsr, i))
      | error.Fault.VcpuFault hsr => do
          pure ((fl4_abi.consts.fault.VCPUFault, hsr, 0#u64, 0#u64))
      | error.Fault.VgicMaintenance idx idx_valid => do
          do
            let i ← SProg.blk 2 (
                if idx_valid then do
                  pure (1#u64)
                else do
                  pure (0#u64))
            pure ((fl4_abi.consts.fault.VGICMaintenance, idx, i, 0#u64))
      | error.Fault.VppiEvent irq => do
          pure ((fl4_abi.consts.fault.VPPIEvent, irq, 0#u64, 0#u64)))
  let _ ← R.obj.Tcb.set_fault_type t ty
  let _ ← R.obj.Tcb.set_fault_w0 t w0
  let _ ← R.obj.Tcb.set_fault_w1 t w1
  R.obj.Tcb.set_fault_w2 t w2

