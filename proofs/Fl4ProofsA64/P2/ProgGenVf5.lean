/-- The measure of `faults.trap_extra_mrs_loop` drops at every `cont` step, on every store. -/
theorem R.faults.trap_extra_mrs_loop.body_dec (sender : obj.Tcb) (buf : Std.U64) (s : S) (i : Std.Usize) {σ0}
    (h : fl4_core_a64.faults.trap_extra_mrs_loop.body mS sender buf s i = ok (.cont σ0)) :
    (fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) ((fun (σ0 : S × Std.Usize) => (σ0.2, σ0.1)) σ0).1 < (fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) i := by
  simp only [fl4_core_a64.faults.trap_extra_mrs_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.faults.trap_extra_mrs_loop (sender : obj.Tcb) (buf : Std.U64) (i : Std.Usize) : SProg Unit :=
  SProg.iter (fun xL => R.faults.trap_extra_mrs_loop.body sender buf xL) ((fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) i + 1) i

