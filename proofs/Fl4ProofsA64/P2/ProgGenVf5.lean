  unfold R.faults.trap_extra_mrs_loop fl4_core_a64.faults.trap_extra_mrs_loop
  exact interp_iterS mS mA (fun (σ0 : S × Std.Usize) => fl4_core_a64.faults.trap_extra_mrs_loop.body mS sender buf σ0.1 σ0.2) (fun xL => R.faults.trap_extra_mrs_loop.body sender buf xL) (fun (xL : Std.Usize) (sL : S) => (sL, xL)) (fun (σ0 : S × Std.Usize) => (σ0.2, σ0.1)) (fun (b : S) => ((), b)) (fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) (fun _ => rfl)
