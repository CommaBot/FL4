@[irreducible] noncomputable def R.smp.send_pending  : SProg Unit := do
  let c ← SProg.curCpu
  let lo ← R.obj.node_get c layout.node.IPI_PENDING
  let hi ← R.obj.node_get c layout.node.IPI_PENDING_HI
  let i ← pure ((lo ||| hi))
  if i != 0#u64 then do
    let _ ← R.obj.node_set c layout.node.IPI_PENDING 0#u64
    let _ ← R.obj.node_set c layout.node.IPI_PENDING_HI 0#u64
    let i1 ← pure ((UScalar.cast .U128 hi))
    let i2 ← SProg.liftR (i1 <<< 64#i32)
    let i3 ← pure ((UScalar.cast .U128 lo))
    let i4 ← pure ((i2 ||| i3))
    let _ ← AR.send_reschedule i4
    pure (())
  else do
    pure (())

