@[irreducible] noncomputable def R.schedcontext.set_consumed (sc : obj.Sc) (t : obj.Tcb) (write_msg : Bool) : SProg Unit := do
  let c ← R.schedcontext.update_consumed sc
  if write_msg then do
    let buf ← R.msg.lookup_ipc_buffer true t
    let _ ← R.obj.Tcb.set_reg t layout.reg.BADGE 0#u64
    let len ← R.msg.set_mr t buf 0#u64 c
    let mi ← SProg.liftR (msginfo.MessageInfo.new 0#u64 0#u64 0#u64 len)
    R.msg.set_msg_info t mi
  else do
    pure (())

