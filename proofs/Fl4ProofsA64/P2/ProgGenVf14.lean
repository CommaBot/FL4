      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.PageTable _ _ _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.PageDirectory _ _ _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.Pdpt _ _ _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.Pml4 _ _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.Vcpu _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.Ept ptr i b asid _ => do
      match i with
      | 0#uscalar => do
          if b then do
            let r ← R.ept.find asid
            match r with
            | core.result.Result.Ok r1 => do
                if r1 = ptr then do
                  let _ ← AR.set_stage2_vspace ptr asid
                  pure (())
                else do
                  let _ ← AR.set_stage2_vspace 0#u64 0#u64
                  pure (())
            | core.result.Result.Err _ => do
                let _ ← AR.set_stage2_vspace 0#u64 0#u64
                pure (())
          else do
            let _ ← AR.set_stage2_vspace 0#u64 0#u64
            pure (())
      | _ => do
          let _ ← AR.set_stage2_vspace 0#u64 0#u64
          pure (())
  | capability.Cap.AsidControl => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.AsidPool _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.IoPortControl => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.IoPort _ _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.TdxControl => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())
  | capability.Cap.HighVSpace _ _ _ => do
      let _ ← AR.set_stage2_vspace 0#u64 0#u64
      pure (())

@[reif_simps] theorem R.vspace.set_stage2_root_eq (t : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.vspace.set_stage2_root t) sS aA =
      (fl4_core_a64.vspace.set_stage2_root mS mA sS aA t >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.vspace.set_stage2_root
  simp only [reif_simps, fl4_core_a64.vspace.set_stage2_root]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.vspace.set_stage2_root_nz (t : obj.Tcb) : NoZero (R.vspace.set_stage2_root t) := by
  unfold R.vspace.set_stage2_root
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.ept.find_nz)
    | (with_reducible apply R.obj.Slot.cap_nz)
    | (with_reducible apply AR.set_stage2_vspace_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

