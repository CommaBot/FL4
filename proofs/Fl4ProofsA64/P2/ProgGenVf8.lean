@[irreducible] noncomputable def R.faults.trap_extra_mrs (sender : obj.Tcb) (buf : Std.U64) (n : Std.U64) : SProg Std.U64 := do
  if buf = 0#u64 then do
    pure (n)
  else do
    if n != faults.TRAP_EXTRA_FIRST then do
      pure (n)
    else do
      let i ← R.obj.Tcb.flags sender
      let i1 ← pure ((i &&& fl4_abi.consts.tcb_flag.TRAP_SYSCALLS))
      if i1 = 0#u64 then do
        pure (n)
      else do
        let _ ← R.obj.Tcb.set_fault_w1 sender 1#u64
        let _ ← R.faults.trap_extra_mrs_loop sender buf 0#usize
        let n1 ← SProg.liftR (faults.TRAP_FULL_LENGTH)
        pure (n1)

