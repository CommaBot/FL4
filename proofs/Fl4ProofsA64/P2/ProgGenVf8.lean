@[irreducible] noncomputable def R.faults.set_mrs_lookup_failure (receiver : obj.Tcb) (buf : Std.U64) (lf : error.LookupFault) (offset : Std.U64) : SProg Std.U64 := do
  let i ← SProg.liftR (error.LookupFault.type_code lf)
  let i1 ← R.msg.set_mr receiver buf offset i
  match lf with
  | error.LookupFault.InvalidRoot => do
      pure (i1)
  | error.LookupFault.MissingCapability bits_left => do
      let i2 ← pure ((core.num.U64.wrapping_add offset 1#u64))
      R.msg.set_mr receiver buf i2 bits_left
  | error.LookupFault.DepthMismatch bits_found bits_left => do
      let i2 ← pure ((core.num.U64.wrapping_add offset 1#u64))
      let _ ← R.msg.set_mr receiver buf i2 bits_left
      let i3 ← pure ((core.num.U64.wrapping_add offset 2#u64))
      R.msg.set_mr receiver buf i3 bits_found
  | error.LookupFault.GuardMismatch guard_found bits_left guard_size => do
      let i2 ← pure ((core.num.U64.wrapping_add offset 1#u64))
      let _ ← R.msg.set_mr receiver buf i2 bits_left
      let i3 ← pure ((core.num.U64.wrapping_add offset 2#u64))
      let _ ← R.msg.set_mr receiver buf i3 guard_found
      let i4 ← pure ((core.num.U64.wrapping_add offset 3#u64))
      R.msg.set_mr receiver buf i4 guard_size

