-- over Fl4CoreA64. Edits beyond the renaming are marked `-- a64:`.
/-
# P2: guarded-store leaf lemmas (shared by every local-path line)

For the per-path obligation of `P2/PathObl.lean` (`<path>_access`: the body
run on `guard st (ReadSet s) (WriteSet s)` ends as on `st`), each extracted
Store helper gets a lemma `<f>.guard`: run on the guarded store it is the
same computation as on `st`, given that the word(s) it reads are in `R` and
the word(s) it writes are in `W`:

    theorem obj.Tcb.sc.guard (self : obj.Tcb) (s : S) (h : R (core.num.U64.wrapping_add self 3464#u64)) :
        obj.Tcb.sc gS self s = obj.Tcb.sc st self s

The address is written as the extraction computes it (offset constants
evaluated), which is definitionally P1's address abbreviation (`scA t`,
`stA t`, `regA t r`, …), so `(h : R (scA t))` is accepted as is.

* generated (`obj.*` field getters and setters: one read or one write at
  `self + offset`): the first part, produced from `Fl4Core/Funs.lean` and
  `P0/Consts.lean` by the script quoted at its head; no `LawfulStore` needed;
* by hand, under `[LawfulStore st]` (the address uses the kernel base or the
  core index): `obj.node_get` / `node_set` (`L.nodeAt s cpu off`),
  `obj.ks_get` / `ks_set`, the `sched` node getters and setters at this
  core's node (`cur_thread`, `cur_sc`, `idle_thread`, `idle_sc`, `action`,
  `consumed`, `cur_time`, `set_action`, `set_consumed`, `cur_domain`,
  `domain_time`), `obj.Slot.cap` (a two-word read), `Slot.set_cap`,
  `Slot.clear`.

Callers compose them with `rw` / `simp only [….guard h]` after unfolding a
function whose body calls them; `gst_read_of` / `gst_write_of` take the
address up to definitional equality.
-/
import Fl4ProofsA64.P2.GSt
import Fl4ProofsA64.P1.Refill
open Aeneas Aeneas.Std Result

namespace Fl4ProofsA64.P2.PathObl
open fl4_core_a64 Fl4ProofsA64.P1

section leaf
variable {S : Type} {st : machine.Store S} {R W : U64 → Prop} {gS : machine.Store S} [GRd gS st R] [GWr gS st W]

theorem eq_ok_of_spec {α : Type _} {m : Result α} {y : α} (h : m ⦃ r => r = y ⦄) : m = ok y := by
  revert h; cases m <;> simp [WP.spec_vis, WP.spec_div, WP.spec_ok]

theorem gst_read_of {s : S} {a b : U64} (h : R a) (e : a = b) : gS.read s b = st.read s b :=
  e ▸ gst_read h

theorem gst_write_of {s : S} {a b v : U64} (h : W a) (e : a = b) :
    gS.write s b v = st.write s b v :=
  e ▸ gst_write h

