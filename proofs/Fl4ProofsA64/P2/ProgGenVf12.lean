@[irreducible] noncomputable def R.sched.schedule_tcb (t : obj.Tcb) : SProg Unit := do
  let t1 ← R.sched.cur_thread
  let b ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq t t1)
  if b then do
    let i ← R.sched.action
    if i = sched.ACTION_RESUME_CURRENT then do
      let b1 ← R.sched.is_schedulable t
      if b1 then do
        pure (())
      else do
        R.sched.set_action sched.ACTION_CHOOSE_NEW
    else do
      pure (())
  else do
    pure (())

