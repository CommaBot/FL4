@[irreducible] noncomputable def R.sched.update_timestamp  : SProg Unit := do
  let prev ← R.sched.cur_time
  let now ← AR.now
  let c ← SProg.curCpu
  let _ ← R.obj.node_set c layout.node.CUR_TIME now
  let used ← pure ((core.num.U64.wrapping_sub now prev))
  let i ← R.sched.consumed
  let total ← pure ((core.num.U64.wrapping_add i used))
  let _ ← R.sched.set_consumed total
  if layout.NUM_DOMAINS > 1#u64 then do
    let dt ← R.sched.domain_time
    let i1 ← R.sporadic.min_budget
    let i2 ← pure ((core.num.U64.saturating_add used i1))
    if i2 >= dt then do
      let _ ← R.obj.ks_set layout.ks.DOMAIN_TIME 0#u64
      pure (())
    else do
      let i3 ← SProg.liftR (dt - used)
      let _ ← R.obj.ks_set layout.ks.DOMAIN_TIME i3
      pure (())
  else do
    pure (())

