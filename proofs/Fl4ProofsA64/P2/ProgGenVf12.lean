@[irreducible] noncomputable def R.sporadic.head_overlapping (sc : obj.Sc) : SProg Bool := do
  let b ← R.sporadic.single sc
  if b then do
    pure (false)
  else do
    let h ← R.sporadic.head sc
    let «end» ← pure ((core.num.U64.wrapping_add h.time h.amount))
    let i ← R.obj.Sc.refill_head sc
    let n ← R.sporadic.next_index sc i
    let r ← R.sporadic.get sc n
    pure ((r.time <= «end»))

