@[irreducible] noncomputable def R.sched.switch_sched_context  : SProg Unit := do
  let ct ← R.sched.cur_thread
  let i ← R.obj.Tcb.sc ct
  let s1 ← R.sched.cur_sc
  let b ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc s1 i)
  let _ ← SProg.blk 0 (
      if b then do
        do
          let _ ← R.sched.set_reprogram
          let b1 ← R.sporadic.sc_constant_bandwidth i
          if b1 then do
            R.sporadic.unblock_check i
          else do
            pure (())
      else do
        pure (()))
  let i1 ← SProg.curCpu
  let i2 ← R.obj.node_get i1 layout.node.REPROGRAM
  let _ ← SProg.blk 1 (
      if i2 != 0#u64 then do
        R.sched.commit_time
      else do
        pure (()))
  let c ← SProg.curCpu
  let _ ← R.obj.node_set c layout.node.CUR_SC i
  pure (())

@[reif_simps] theorem R.sched.switch_sched_context_eq  (sS : S) (aA : A) :
    interp mS mA (R.sched.switch_sched_context ) sS aA =
      (fl4_core_a64.sched.switch_sched_context mS mA sS aA >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.sched.switch_sched_context
  simp only [reif_simps, fl4_core_a64.sched.switch_sched_context]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

