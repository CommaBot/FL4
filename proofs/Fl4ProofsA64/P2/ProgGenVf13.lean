        else do
          pure (false)
    else do
      let i2 ← R.obj.Tcb.sc i1
      let b2 ← R.sporadic.ready i2
      if b2 then do
        pure (false)
      else do
        let b3 ← R.sched.is_cur_domain_expired
        if b3 then do
