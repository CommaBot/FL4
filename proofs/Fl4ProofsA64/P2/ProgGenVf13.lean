@[irreducible] noncomputable def R.sched.set_next_interrupt  : SProg Unit := do
  let now ← R.sched.cur_time
  let t ← R.sched.cur_thread
  let i ← R.obj.Tcb.sc t
  let r ← R.sporadic.head i
  let next ← pure ((core.num.U64.wrapping_add now r.amount))
  let next1 ← SProg.blk 0 (
      if layout.NUM_DOMAINS > 1#u64 then do
        do
          let i1 ← R.sched.domain_time
          let d ← pure ((core.num.U64.wrapping_add now i1))
          if d < next then do
            pure (d)
          else do
            pure (next)
      else do
        pure (next))
  let i1 ← SProg.curCpu
  let i2 ← R.obj.node_get i1 layout.node.RELEASE_HEAD
  let b ← SProg.liftR (obj.Tcb.is_null i2)
  let next2 ← SProg.blk 1 (
      if b then do
        pure (next1)
      else do
        do
          let t1 ← R.sched.ready_time i2
          if t1 < next1 then do
            pure (t1)
          else do
            pure (next1))
  let prec ← AR.us_to_ticks 1#u64
  let deadline ← pure ((core.num.U64.wrapping_sub next2 prec))
  let td ← R.timer.earliest
  let deadline1 ← SProg.blk 2 (
      if td != 0#u64 then do
        if td < deadline then do
          pure (td)
        else do
          pure (deadline)
      else do
        pure (deadline))
  let armed ← R.obj.node_get i1 layout.node.ARMED
  if armed > now then do
    if armed = deadline1 then do
      pure (())
    else do
      if armed < deadline1 then do
        let t1 ← R.sched.idle_thread
        let b1 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Tcb.Insts.CoreCmpPartialEqTcb t t1)
        if b1 then do
          pure (())
        else do
          let _ ← R.obj.node_set i1 layout.node.ARMED deadline1
          let _ ← AR.set_deadline deadline1
          pure (())
      else do
        let _ ← R.obj.node_set i1 layout.node.ARMED deadline1
        let _ ← AR.set_deadline deadline1
        pure (())
  else do
    let _ ← R.obj.node_set i1 layout.node.ARMED deadline1
    let _ ← AR.set_deadline deadline1
    pure (())

