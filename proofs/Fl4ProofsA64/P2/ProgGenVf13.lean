@[irreducible] noncomputable def R.sporadic.budget_check_loop0.body (i : Std.U64) (mrt : Std.U64) (period : Std.U64) (usage : Std.U64) (fuel : Std.U64) : SProg (ControlFlow (Std.U64 × Std.U64) Std.U64) := do
  let h ← R.sporadic.head i
  if h.amount <= usage then do
    if h.time < mrt then do
      if h.amount = 0#u64 then do
        pure (.done usage)
      else do
        if fuel = 0#u64 then do
          pure (.done usage)
        else do
          let fuel1 ← SProg.liftR (fuel - 1#u64)
          let b ← R.sporadic.single i
          let _ ← SProg.blk 0 (
              if b then do
                do
                  let i1 ← pure ((core.num.U64.wrapping_add h.time period))
                  R.sporadic.set_head i { h with time := i1 }
              else do
                do
                  let old ← R.sporadic.pop_head i
                  let i1 ← pure ((core.num.U64.wrapping_add old.time period))
                  R.sporadic.schedule_used i { old with time := i1 })
          let usage1 ← pure ((core.num.U64.wrapping_sub usage h.amount))
          pure (.cont (usage1, fuel1))
    else do
      pure (.done usage)
  else do
    pure (.done usage)

