/-- The measure of `sporadic.budget_check_loop0` drops at every `cont` step, on every store. -/
theorem R.sporadic.budget_check_loop0.body_dec (i : Std.U64) (mrt : Std.U64) (period : Std.U64) (s : S) (usage : Std.U64) (fuel : Std.U64) {σ0}
    (h : fl4_core_a64.sporadic.budget_check_loop0.body mS i mrt period s usage fuel = ok (.cont σ0)) :
    (fun xL => xL.2.val) ((fun (σ0 : S × Std.U64 × Std.U64) => ((σ0.2.1, σ0.2.2), σ0.1)) σ0).1 < (fun xL => xL.2.val) (usage, fuel) := by
  simp only [fl4_core_a64.sporadic.budget_check_loop0.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
