@[irreducible] noncomputable def R.sched.highest_prio (dom : Std.U64) : SProg Std.U64 := do
  let cpu ← SProg.curCpu
  let d ← SProg.liftR (sched.bitmap_dom dom)
  let i ← SProg.liftR (sched.l1_off d)
  let l1 ← R.obj.node_get cpu i
  let l1i ← SProg.liftR (sched.highest_set_bit l1)
  let i1 ← pure ((l1i &&& 3#u64))
  let inv ← SProg.liftR (3#u64 - i1)
  let i2 ← SProg.liftR (sched.l2_off d inv)
  let l2 ← R.obj.node_get cpu i2
  let i3 ← SProg.liftR (l1i <<< 6#i32)
  let i4 ← SProg.liftR (sched.highest_set_bit l2)
  pure ((i3 ||| i4))

