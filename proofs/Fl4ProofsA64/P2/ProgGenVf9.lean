@[irreducible] noncomputable def R.sched.is_schedulable (t : obj.Tcb) : SProg Bool := do
  let b ← R.sched.is_runnable t
  if b then do
    let i ← R.obj.Tcb.sc t
    let b1 ← SProg.liftR (obj.Sc.is_null i)
    if b1 then do
      pure (false)
    else do
      let b2 ← R.sporadic.sc_active i
      if b2 then do
        let b3 ← R.sched.in_release_queue t
        pure ((¬ b3))
      else do
        pure (false)
  else do
    pure (false)

