@[irreducible] noncomputable def R.sporadic.unblock_check (sc : obj.Sc) : SProg Unit := do
  let b ← R.sporadic.is_round_robin sc
  if b then do
    pure (())
  else do
    let b1 ← R.sporadic.ready sc
    if b1 then do
      let now ← R.sporadic.cur_time
      let h ← R.sporadic.head sc
      let _ ← R.sporadic.set_head sc { h with time := now }
      let cpu ← SProg.curCpu
      let _ ← R.obj.node_set cpu layout.node.REPROGRAM 1#u64
      let i ← R.obj.Sc.refill_max sc
      let fuel ← pure ((core.num.U64.wrapping_add i 1#u64))
      R.sporadic.unblock_check_loop sc fuel
    else do
      pure (())

