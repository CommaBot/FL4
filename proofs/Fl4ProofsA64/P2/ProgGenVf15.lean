@[irreducible] noncomputable def R.vspace.set_vm_root (t : obj.Tcb) : SProg Unit := do
  let i ← R.vcpu.bound t
  if i != 0#u64 then do
    let _ ← R.vspace.set_kernel_vm_root
    R.vspace.set_stage2_root t
  else do
    let s1 ← SProg.liftR (obj.Tcb.slot t layout.tcb.SLOT_VTABLE)
    let c ← R.obj.Slot.cap s1
    let _ ← SProg.blk 2 (
        match c with
        | capability.Cap.Null => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Untyped _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Endpoint _ _ _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Notification _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Reply _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.CNode _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Thread _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.IrqControl => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.IrqHandler _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Zombie _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Domain => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.SchedContext _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.SchedControl _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.PageTable _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.PageDirectory _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Pdpt _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Pml4 ptr b asid => do
            if b then do
              do
                let r ← R.vspace.find_vspace_for_asid asid
                match r with
                | core.result.Result.Ok r1 => do
                    if r1 = ptr then do
                      let i1 ← R.obj.Tcb.state t
                      let high ← SProg.blk 0 (
                          if i1 = sched.TS_RUNNING_VM then do
                            pure (0#u64)
                          else do
                            R.vspace.high_root_of t)
                      let _ ← SProg.blk 1 (
                          if high = 0#u64 then do
                            do
                              let _ ← AR.set_high_vspace 0#u64 asid
                              AR.set_vspace ptr asid
                          else do
                            do
                              let _ ← AR.set_vspace ptr asid
                              AR.set_high_vspace high asid)
                      pure (())
                    else do
                      R.vspace.set_kernel_vm_root
                | core.result.Result.Err _ => do
                    R.vspace.set_kernel_vm_root
            else do
              R.vspace.set_kernel_vm_root
        | capability.Cap.Vcpu _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.Ept _ _ _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.AsidControl => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.AsidPool _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.IoPortControl => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.IoPort _ _ _ => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.TdxControl => do
            R.vspace.set_kernel_vm_root
        | capability.Cap.HighVSpace _ _ _ => do
            R.vspace.set_kernel_vm_root)
    let i1 ← R.obj.Tcb.state t
    if i1 = sched.TS_RUNNING_VM then do
      let i2 ← SProg.liftR (layout.tcb.RUN_VCPU)
      let i3 ← pure ((core.num.U64.wrapping_add t i2))
      let run_v ← SProg.read i3
      if run_v != 0#u64 then do
        let i4 ← pure ((core.num.U64.wrapping_add run_v vcpu.TCB))
        let guest_tcb ← SProg.read i4
        if guest_tcb != 0#u64 then do
          R.vspace.set_stage2_root guest_tcb
        else do
          pure (())
      else do
        pure (())
    else do
      pure (())

