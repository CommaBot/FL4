@[irreducible] noncomputable def R.sched.commit_time  : SProg Unit := do
  let sc ← R.sched.cur_sc
  let b ← R.sporadic.sc_active sc
  let _ ← SProg.blk 1 (
      if b then do
        do
          let s2 ← R.sched.idle_sc
          let b1 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc sc s2)
          if b1 then do
            let c ← R.sched.consumed
            let _ ← SProg.blk 0 (
                if c > 0#u64 then do
                  do
                    let b2 ← R.sporadic.is_round_robin sc
                    if b2 then do
                      let hi ← R.obj.Sc.refill_head sc
                      let ti ← R.obj.Sc.refill_tail sc
                      let h ← R.sporadic.get sc hi
                      let i ← pure ((core.num.U64.wrapping_sub h.amount c))
                      let _ ← R.sporadic.put sc hi { h with amount := i }
                      let t ← R.sporadic.get sc ti
                      let i1 ← pure ((core.num.U64.wrapping_add t.amount c))
                      R.sporadic.put sc ti { t with amount := i1 }
                    else do
                      R.sporadic.budget_check c
                else do
                  pure (()))
            let i ← R.obj.Sc.consumed sc
            let used ← pure ((core.num.U64.wrapping_add i c))
            R.obj.Sc.set_consumed sc used
          else do
            pure (())
      else do
        pure (()))
  R.sched.set_consumed 0#u64

