section
variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.syscall.handle_vm_fault_local (addr : Std.U64) (code : Std.U64) : SProg Bool := do
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let _ ← R.sched.update_timestamp
    let csc ← R.sched.cur_sc
    let i ← R.sched.consumed
    let b ← R.sporadic.sufficient csc i
    if b then do
      let t ← R.sched.cur_thread
      let i1 ← SProg.liftR (code >>> 26#i32)
      let i2 ← pure ((i1 &&& 63#u64))
      let f ← SProg.liftR (vspace.vm_fault addr code (i2 = 32#u64))
      R.fastpath_vm.vm_fault t f
    else do
      pure (false)

@[reif_simps] theorem R.syscall.handle_vm_fault_local_eq (addr : Std.U64) (code : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.syscall.handle_vm_fault_local addr code) sS aA =
      (fl4_core_a64.syscall.handle_vm_fault_local mS mA sS aA addr code >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.syscall.handle_vm_fault_local
  simp only [reif_simps, fl4_core_a64.syscall.handle_vm_fault_local]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.syscall.handle_vm_fault_local_nz (addr : Std.U64) (code : Std.U64) : NoZero (R.syscall.handle_vm_fault_local addr code) := by
  unfold R.syscall.handle_vm_fault_local
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.fastpath_vm.vm_fault_nz)
    | (with_reducible apply R.sched.consumed_nz)
    | (with_reducible apply R.sched.cur_sc_nz)
    | (with_reducible apply R.sched.cur_thread_nz)
    | (with_reducible apply R.sched.update_timestamp_nz)
    | (with_reducible apply R.sporadic.sufficient_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

