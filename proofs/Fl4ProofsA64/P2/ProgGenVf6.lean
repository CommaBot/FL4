@[irreducible] noncomputable def R.msg.lookup_ipc_buffer (is_receiver : Bool) (t : obj.Tcb) : SProg Std.U64 := do
  let w ← R.obj.Tcb.ipc_buffer t
  let s1 ← SProg.liftR (obj.Tcb.slot t layout.tcb.SLOT_BUFFER)
  let c ← R.obj.Slot.cap s1
  match c with
  | capability.Cap.Null => do
      pure (0#u64)
  | capability.Cap.Untyped _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.Endpoint _ _ _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.Notification _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.Reply _ _ => do
      pure (0#u64)
  | capability.Cap.CNode _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.Thread _ => do
      pure (0#u64)
  | capability.Cap.IrqControl => do
      pure (0#u64)
  | capability.Cap.IrqHandler _ => do
      pure (0#u64)
  | capability.Cap.Zombie _ _ _ => do
      pure (0#u64)
  | capability.Cap.Domain => do
      pure (0#u64)
  | capability.Cap.SchedContext _ _ => do
      pure (0#u64)
  | capability.Cap.SchedControl _ => do
      pure (0#u64)
  | capability.Cap.Frame ptr size rights is_device _ _ _ _ => do
      if is_device then do
        pure (0#u64)
      else do
        if rights = capability.VM_READ_WRITE then do
          let bits ← SProg.liftR (capability.FrameSize.bits size)
          let i ← pure ((bits &&& 63#u64))
          let i1 ← SProg.liftR (1#u64 <<< i)
          let i2 ← pure ((core.num.U64.wrapping_sub i1 1#u64))
          let i3 ← pure ((w &&& i2))
          pure ((core.num.U64.wrapping_add ptr i3))
        else do
          if is_receiver then do
            pure (0#u64)
          else do
            if rights = capability.VM_READ_ONLY then do
              let bits ← SProg.liftR (capability.FrameSize.bits size)
              let i ← pure ((bits &&& 63#u64))
              let i1 ← SProg.liftR (1#u64 <<< i)
              let i2 ← pure ((core.num.U64.wrapping_sub i1 1#u64))
              let i3 ← pure ((w &&& i2))
              pure ((core.num.U64.wrapping_add ptr i3))
            else do
              pure (0#u64)
  | capability.Cap.PageTable _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.PageDirectory _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.Pdpt _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.Pml4 _ _ _ => do
      pure (0#u64)
  | capability.Cap.Vcpu _ => do
      pure (0#u64)
  | capability.Cap.Ept _ _ _ _ _ => do
      pure (0#u64)
  | capability.Cap.AsidControl => do
      pure (0#u64)
  | capability.Cap.AsidPool _ _ => do
      pure (0#u64)
  | capability.Cap.IoPortControl => do
      pure (0#u64)
  | capability.Cap.IoPort _ _ _ => do
      pure (0#u64)
  | capability.Cap.TdxControl => do
      pure (0#u64)
  | capability.Cap.HighVSpace _ _ _ => do
      pure (0#u64)

