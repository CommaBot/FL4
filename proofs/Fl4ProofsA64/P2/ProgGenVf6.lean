@[irreducible] noncomputable def R.msg.set_mr (t : obj.Tcb) (buf : Std.U64) (i : Std.U64) (v : Std.U64) : SProg Std.U64 := do
  if i < msg.N_MSG_REGISTERS then do
    let i1 ← SProg.liftR (msg.msg_register i)
    let _ ← R.obj.Tcb.set_reg t i1 v
    let i2 ← pure ((core.num.U64.wrapping_add i 1#u64))
    pure (i2)
  else do
    if buf != 0#u64 then do
      let i1 ← pure ((core.num.U64.wrapping_add i 1#u64))
      let _ ← R.msg.buf_set buf i1 v
      let i2 ← pure ((core.num.U64.wrapping_add i 1#u64))
      pure (i2)
    else do
      pure (msg.N_MSG_REGISTERS)

