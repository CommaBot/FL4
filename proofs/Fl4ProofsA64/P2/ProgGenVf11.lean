@[irreducible] noncomputable def R.sched.is_highest_prio (dom : Std.U64) (prio : Std.U64) : SProg Bool := do
  let d ← SProg.liftR (sched.bitmap_dom dom)
  let i ← SProg.curCpu
  let i1 ← SProg.liftR (sched.l1_off d)
  let i2 ← R.obj.node_get i i1
  if i2 = 0#u64 then do
    pure (true)
  else do
    let i3 ← R.sched.highest_prio dom
    pure ((prio >= i3))

