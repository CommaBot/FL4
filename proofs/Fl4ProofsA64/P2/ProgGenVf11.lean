@[irreducible] noncomputable def R.faults.set_mrs_fault (sender : obj.Tcb) (receiver : obj.Tcb) (buf : Std.U64) : SProg Std.U64 := do
  let ty ← R.obj.Tcb.fault_type sender
  let w0 ← R.obj.Tcb.fault_w0 sender
  let w1 ← R.obj.Tcb.fault_w1 sender
  let w2 ← R.obj.Tcb.fault_w2 sender
  let restart_pc ← R.obj.Tcb.reg sender layout.reg.FAULT_IP
  if ty = fl4_abi.consts.fault.CapFault then do
    let _ ← R.msg.set_mr receiver buf 0#u64 restart_pc
    let _ ← R.msg.set_mr receiver buf 1#u64 w0
    let _ ← R.msg.set_mr receiver buf 2#u64 w1
    let lf ← R.faults.lookup_failure sender
    R.faults.set_mrs_lookup_failure receiver buf lf 3#u64
  else do
    if ty = fl4_abi.consts.fault.UnknownSyscall then do
      let s1 ← pure ((Array.to_slice faults.SYSCALL_MESSAGE))
      let _ ← R.faults.copy_mrs_fault sender receiver s1 buf
      let n ← R.msg.set_mr receiver buf 12#u64 w0
      R.faults.trap_extra_mrs sender buf n
    else do
      if ty = fl4_abi.consts.fault.UserException then do
        let s1 ← pure ((Array.to_slice faults.EXCEPTION_MESSAGE))
        let _ ← R.faults.copy_mrs_fault sender receiver s1 buf
        let _ ← R.msg.set_mr receiver buf 3#u64 w0
        R.msg.set_mr receiver buf 4#u64 w1
      else do
        if ty = fl4_abi.consts.fault.Timeout then do
          let i ← R.obj.Tcb.sc sender
          let b ← SProg.liftR (obj.Sc.is_null i)
          if b then do
            R.msg.set_mr receiver buf 0#u64 w0
          else do
            let consumed ← R.schedcontext.update_consumed i
            let len ← R.msg.set_mr receiver buf 0#u64 w0
            R.msg.set_mr receiver buf len consumed
        else do
          if ty = fl4_abi.consts.fault.DebugException then do
            let _ ← R.msg.set_mr receiver buf 0#u64 restart_pc
            let ret ← R.msg.set_mr receiver buf 1#u64 w0
            if w0 != debug.SINGLE_STEP then do
              if w0 != debug.SOFTWARE_BREAK_REQUEST then do
                let _ ← R.msg.set_mr receiver buf 2#u64 w1
                R.msg.set_mr receiver buf 3#u64 w2
              else do
                pure (ret)
            else do
              pure (ret)
          else do
            if ty = fl4_abi.consts.fault.VMFault then do
              let _ ← R.msg.set_mr receiver buf 0#u64 restart_pc
              let _ ← R.msg.set_mr receiver buf 1#u64 w0
              let _ ← R.msg.set_mr receiver buf 2#u64 w2
              R.msg.set_mr receiver buf 3#u64 w1
            else do
              if ty = fl4_abi.consts.fault.VCPUFault then do
                R.msg.set_mr receiver buf 0#u64 w0
              else do
                if ty = fl4_abi.consts.fault.VGICMaintenance then do
                  if w1 != 0#u64 then do
                    R.msg.set_mr receiver buf 0#u64 w0
                  else do
                    pure (0#u64)
                else do
                  if ty = fl4_abi.consts.fault.VPPIEvent then do
                    R.msg.set_mr receiver buf 0#u64 w0
                  else do
                    pure (0#u64)

