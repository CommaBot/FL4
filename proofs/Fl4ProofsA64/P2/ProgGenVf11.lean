@[irreducible] noncomputable def R.ept.find (asid : Std.U64) : SProg (core.result.Result Std.U64 error.LookupFault) := do
  let r ← R.vspace.find_asid_raw asid
  let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val => do
      let i ← pure ((val &&& vspace.ROOT_TAG))
      if i != vspace.ROOT_S2 then do
        pure ((core.result.Result.Err error.LookupFault.InvalidRoot))
      else do
        let i1 ← pure ((~~~ vspace.ROOT_TAG))
        let i2 ← pure ((val &&& i1))
        pure ((core.result.Result.Ok i2))
  | core.ops.control_flow.ControlFlow.Break residual => do
      SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Std.U64 (core.convert.FromSame error.LookupFault) residual)

