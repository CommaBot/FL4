@[irreducible] noncomputable def R.vspace.find_asid_raw (asid : Std.U64) : SProg (core.result.Result Std.U64 error.LookupFault) := do
  let i ← SProg.liftR (asid >>> vspace.ASID_BITS)
  if i != 0#u64 then do
    pure ((core.result.Result.Err error.LookupFault.InvalidRoot))
  else do
    let i1 ← SProg.liftR (asid >>> vspace.ASID_LOW_BITS)
    let pool ← R.vspace.asid_table i1
    if pool = 0#u64 then do
      pure ((core.result.Result.Err error.LookupFault.InvalidRoot))
    else do
      let i2 ← pure ((asid &&& 511#u64))
      let i3 ← pure ((core.num.U64.wrapping_mul i2 8#u64))
      let i4 ← pure ((core.num.U64.wrapping_add pool i3))
      let root ← SProg.read i4
      if root = 0#u64 then do
        pure ((core.result.Result.Err error.LookupFault.InvalidRoot))
      else do
        pure ((core.result.Result.Ok root))

