#!/bin/bash
# afk-build.sh (afkprover2): run from a synced FL4 worktree mirror (cwd = $M/<worktree>).
# MODE=build (full x86 lake build) | mod (MODS="A B ...") | a64 (Fl4ProofsA64)
# SEED=<other mirror name>: clone its proofs/.lake if this mirror has none.  SCR=1: apply the FrameBatch scratch
# (proofs/scratch/fb3scratch.py, else ./m77scratch.py; SCRS=<path> overrides) for this build, reverted on exit.
# AX=<file, relative to the worktree>: `lake env lean <file>` after a green build.  Logs: ./afklogs/b-$MODE.log
# SEED: a cache name under /data/fl4/cache (B, A, ...), a /data/fl4/<name> dir, a mirror name under $M, or an
# absolute path (a .lake dir, or a dir holding proofs/.lake or .lake).  Durable state: /data/fl4 (see afk-setup.sh).
M=/home/debian/.monoid/remote/sessions/de7adef11839efd864675761d4db585096cfaf4f28add8c1607f02966671d599/work
D=/data/fl4; FR=$D/leanq-root
export ELAN_HOME=$D/elan PATH=$FR/bin:$D/elan/bin:$PATH; unset LEAN_NUM_THREADS  # no thread caps (lake/lean defaults)
R=$PWD; MODE=${MODE:-build}; L=$R/afklogs; mkdir -p $L
FR=/data/fl4/leanq-root /data/fl4/leanq-root/bin/lake
