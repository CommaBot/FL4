/-- (p3J gen 35) **The error reply writes only `ProjW`** (module docstring). -/
theorem replyErrProjW (hH : P1.HeapOK H) {s : S}
    (hB : P1.BlkOK st (P1.Heap.tcbs H) Cs (P1.Heap.omega H) H (P1.Heap.frame H) (P1.Heap.replies H)
      (P1.Heap.scs H) (P1.Heap.ntfns H) (P1.Heap.scBits H) Ac s)
    (hN : NoBufCap (L := L) (P1.Heap.tcbs H) s) {t : U64} (ht : t ∈ P1.Heap.tcbs H) (e : error.SysError) :
    syscall.reply_error st s t e ⦃ s' => P1.WritesIn st s s' (ProjW (L := L) H Cs s) ⦄ := by
  have hU : UserOK st (P1.Heap.tcbs H) Cs (P1.Heap.omega H) H ∅ s := fun b hb => absurd hb (Set.notMem_empty b)
  obtain ⟨Q, R, hXS⟩ := BXI.xs hB.bxi hU
  have hXI := hXS.1
  have h0 : XSFC st (P1.Heap.tcbs H) Cs (P1.Heap.omega H) H (P1.Heap.frame H) (P1.Heap.replies H) (P1.Heap.scs H)
      (P1.Heap.ntfns H) (P1.Heap.scBits H) ∅ (fun _ _ => True) Ac ∅ Q R s s :=
    XSFC.start hXI trivial fun _ _ _ _ => trivial
  refine WP.spec_mono (syscall.reply_error.xsfc (e := e) h0 ht hN) fun s' h' => ?_
  have hw := XferWC.ipcN (Kp := ∅) (Nd := False) (Es := EH H) hXI.1 hXI.2.2.1 hU hXI.2.2.2.2.1.sub h'.2.2.1
  exact (WritesA.w hw).mono fun _ hb => ipcWN_projW hH hB.1.choose_spec.choose_spec.nodes hb

set_option maxHeartbeats 4000000 in
/-- (p3J gen 35) **The success tail writes only `ProjW`**, any `call` (module docstring). -/
theorem flTailProjWc (hH : P1.HeapOK H) {s : S} {a : A}
    (hB : P1.BlkOK st (P1.Heap.tcbs H) Cs (P1.Heap.omega H) H (P1.Heap.frame H) (P1.Heap.replies H)
      (P1.Heap.scs H) (P1.Heap.ntfns H) (P1.Heap.scBits H) Ac s)
    {t : U64} (ht : t ∈ P1.Heap.tcbs H) (call : Bool) :
    flTail (st := st) t call s a ⦃ res => P1.WritesIn st s res.2.1 (ProjW (L := L) H Cs s) ⦄ := by
  have sts : ∀ {s2 : S} {Ac2 : Set U64}, P1.BlkOK st (P1.Heap.tcbs H) Cs (P1.Heap.omega H) H (P1.Heap.frame H)
      (P1.Heap.replies H) (P1.Heap.scs H) (P1.Heap.ntfns H) (P1.Heap.scBits H) Ac2 s2 →
      sched.set_thread_state st s2 t sched.TS_RUNNING ⦃ s3 => P1.WritesIn st s2 s3 (ProjW (L := L) H Cs s2) ⦄ := by
    intro s2 Ac2 hB2
    have h0 := hB2.1.choose_spec.choose_spec
    exact WP.spec_mono (P1.sched.set_thread_state.kwN (Kp := ∅) (Nd := False) (Sg := P1.Heap.frame H)
      (Scs := P1.Heap.scs H) (Z := P1.Heap.scBits H) (Es := P1.EH H) s2 t sched.TS_RUNNING h0 ht
      (Set.notMem_empty t)) fun s' f => (P1.WritesA.w f).mono fun _ hb => kwN_projW hH h0.nodes hb
  unfold flTail
  refine WP.spec_bind (P0.obj.Tcb.state.p0 st t s L.total) fun i _ => ?_
  split
  · cases call
    · simp only [Bool.false_eq_true, ↓reduceIte, bind_ok]
      exact WP.spec_bind (sts hB) fun s3 h3 => (WP.spec_ok _).2 h3
    · simp only [↓reduceIte]
      refine WP.spec_bind (msg.reply_success_empty.nb (Kp := ∅) (Nd := False) (Es := P1.EH H) (Eb := P1.EH H)
        s t hB ht) ?_
      rintro s2 ⟨hB2, F2, -⟩
      refine WP.spec_bind (sts hB2) fun s3 h3 => (WP.spec_ok _).2 ?_
      exact ((P1.WritesA.w F2).mono fun _ hb => kwN_projW hH hB.1.choose_spec.choose_spec.nodes hb).projW_trans h3
  · exact (WP.spec_ok _).2 (P1.WritesIn.refl _ _)

end

