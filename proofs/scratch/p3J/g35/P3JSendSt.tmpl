/-- (p3J gen 35) `JSendRestHyp` with the stable post `JStab Z H Cs` (module docstring). -/
def JSendRestSt (arI : machine.Arch A) (AR : A → Fl4Spec.Cr3 → Prop) (Z : XSets) (H : P1.Heap) (Cs : Set U64)
    (s1 : S) (ar : A) (σ1 : Fl4Spec.State Unit) (blk call : Bool) (b : U64) (g gr don : Bool) (ct p : U64) : Prop :=
  ∀ x : Fl4Spec.Endpoint, σ1.kheap p.bv = some (.endpoint x) → ¬ CanBlock false x →
