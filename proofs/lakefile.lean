import Lake
open Lake DSL

-- `.deps/aeneas` links to Aeneas's Lean backend (backends/lean of the
-- Aeneas checkout that extracted Fl4Core); `cargo xtask gate` creates it.
require aeneas from "./.deps/aeneas"

package fl4proofs

-- Aeneas output for fl4-core: regenerated by `cargo xtask extract`, never
-- edited by hand (DESIGN.md §5).
lean_lib Fl4Core

-- The seL4 abstract specification (l4v spec/abstract, MCS) ported to
-- Lean, with FL4's differences and extensions in separate modules
-- (DESIGN.md §9). Independent of Fl4Core.
lean_lib Fl4Spec

-- Specs, invariants and proofs about Fl4Core.
@[default_target]
lean_lib Fl4Proofs
