import Lake
open Lake DSL

-- `.deps/aeneas` links to Aeneas's Lean backend (backends/lean of the
-- Aeneas checkout that extracted Fl4Core); `cargo xtask prove` creates it.
require aeneas from "./.deps/aeneas"

package fl4proofs

-- Aeneas output for fl4-core: regenerated by `cargo xtask extract`, never
-- edited by hand (DESIGN.md §5).
lean_lib Fl4Core

-- Specs, invariants and proofs about Fl4Core.
@[default_target]
lean_lib Fl4Proofs
