/-
FL4 differences (PORTING.md, "FL4 differences"): **the extended kernel
with FL4's VMEnter report** (FL4 #80 / #81 / #85; `Ext/VirtReport`).

`fl4CallKernelVF onCore remoteCur rep ev` is `fl4CallKernelV onCore rep
ev` (`Ext/VirtKernel`) with every VMEnter completion as FL4 main
279c8261 does it: `vmCheckF` at the exit and after a guest step,
`vmEnterF` for `SysVMEnter`, `vcpuDetachF` in finalisation (VCPU caps,
final thread caps) and SetTCB (`associateVcpuTcbF`), and `sendSignalVF`
in every signal (interrupts, the notification invocation, the TCB
timers). `remoteCur t` (FL4 `node_get(cpu, CUR_THREAD) == t` for `t`'s
core `cpu`) is, like `onCore`, a per-core fact the uniprocessor spec does
not have, fixed for the entry.

Each definition here is its `Ext/VirtVcpu` / `Ext/VirtFinalise` /
`Ext/VirtEntry` / `Ext/VirtDispatch` / `Ext/VirtKernel` namesake (suffix
`F`) with these substitutions only; the module is generated by
`proofs/scratch/virt12/genTopF.py` (head `topF_head.lean`).

The ported modules and the `V` definitions are not changed.
-/
import Fl4Spec.Ext.VirtReport
import Fl4Spec.Ext.VirtKernel

namespace Fl4Spec

noncomputable section
open Classical

section
variable {Z : Type} [StateExt Z]

/-- `performVcpuInvocation` (`Ext/VirtVcpu`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: **The VCPU invocations** (l4v ARM_HYP `perform_vcpu_invocation`; FL4's
effects): the reply words. -/
def performVcpuInvocationF : VcpuInvocation → SMonad Z (List Data)
  | .setTcb v t => do
    associateVcpuTcbF v t
    return []
  | .writeRegisters v vals => do
    vcpuUpdate v (VcpuState.setGprs vals)
    return []
  | .flushTlb _ => return []
  | .readVmcs v f => do
    let st ← getVcpu v
    return [if Vmx.readSupported f then st.get virtKind (.vmcs f) else 0]
  | .writeVmcs v f val => do
    vcpuUpdate v fun s => s.set virtKind (.vmcs f) val
    return [val]
  | .readVmcb v off n => do
    let st ← getVcpu v
    -- FL4 code differs until V3 (`hiddenRead` includes 0x058 and 0x0c0).
    return (List.range n.toNat).map fun i =>
      let o := off + BitVec.ofNat 64 (i * 8)
      if Svm.hiddenRead o then 0 else st.get virtKind (.vmcb o)
  | .writeVmcb v off val => do
    vcpuUpdate v fun s => s.set virtKind (.vmcb off) val
    return [val]
  | .readMsr v m => do
    let st ← getVcpu v
    return [st.get virtKind (.msr m)]
  | .readVmxMisc => return [if virtKind = .svm then 0 else vcpuCapability msrVmxMisc]
  | .writeMsr v m val => do
    vcpuUpdate v fun s => s.set virtKind (.msr m) val
    return [val]
  | .enableIoPort v lo hi c _slot => do
    -- The cap's previous grant is revoked; the cap's owner then becomes
    -- `v` (FL4 `ex[0].set_cap`), which needs the shape change of
    -- VIRT-PLAN.md §3.3.1 (decision Q2): until then the cap is unchanged.
    ioPortRevoke c
    vcpuUpdate v (VcpuState.setPorts lo hi false)
    return []
  | .disableIoPort v lo hi => do
    vcpuUpdate v (VcpuState.setPorts lo hi true)
    return []

/-- `finaliseCapV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: **`finalise_cap` with the virtualization hooks** (module docstring). -/
def finaliseCapVF (cap : Cap) (final : Bool) : SMonad Z (Cap × Cap) :=
  match cap with
  | .archObjectCap (.vcpuCap v) =>
    if final then do
      let st ← getVcpu v
      match st.tcb with
      | some t => vcpuDetachF t
      | none => pure ()
      return (.nullCap, .nullCap)
    else return (.nullCap, .nullCap)
  | .archObjectCap (.eptCap ptr level (some (a, gpa))) =>
    if final ∧ level ≠ 0 then do
      guestUnmap a gpa ptr level true
      return (.nullCap, .nullCap)
    else finaliseCap cap final
  | .archObjectCap (.pageCap _ p _ .vmEptMap sz (some (a, gpa))) => do
    NonDet.when (a ≠ 0) <| guestUnmap a gpa p (pageBitsForSize sz) false
    return (.nullCap, .nullCap)
  | .archObjectCap (.ioPortCap f l) => do
    ioPortRevoke (.ioPortCap f l)
    finaliseCap cap final
  | .threadCap t => do
    NonDet.when final <| vcpuDetachF t
    finaliseCap cap final
  | _ => finaliseCap cap final

/-- `recDelFV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `CSpace_A.rec_del`'s equations (`recDelF`) with `finaliseCapV`. -/
def recDelFVF (recDel : RecDelCall → PMonad Z (Bool × Cap)) : RecDelCall → PMonad Z (Bool × Cap)
  | .cTEDeleteCall slot exposed => do
      let (success, cleanupInfo) ← recDel (.finaliseSlotCall slot exposed)
      withoutPreemption <| NonDet.when (exposed ∨ success) <| emptySlot slot cleanupInfo
      NonDetE.returnOk undefined
  | .finaliseSlotCall slot exposed => do
      let cap ← withoutPreemption <| getCap slot
      if cap = .nullCap
      then NonDetE.returnOk (true, .nullCap)
      else do
        let isFinal ← withoutPreemption <| isFinalCap cap
        let (remainder, cleanupInfo) ← withoutPreemption <| finaliseCapVF cap isFinal
        if capRemoveable remainder slot
        then NonDetE.returnOk (true, cleanupInfo)
        else if capCyclicZombie remainder slot ∧ ¬exposed
        then do
          withoutPreemption <| setCap remainder slot
          NonDetE.returnOk (false, .nullCap)
        else do
          withoutPreemption <| setCap remainder slot
          let _ ← recDel (.reduceZombieCall remainder slot exposed)
          preemptionPoint
          recDel (.finaliseSlotCall slot exposed)
  | .reduceZombieCall (.zombie ptr bits (n + 1)) slot false => do
      let cn ← NonDetE.returnOk (firstCslotOf (.zombie ptr bits (n + 1)))
      NonDetE.assertE (cn ≠ slot)
      withoutPreemption <| capSwapForDelete cn slot
      NonDetE.returnOk undefined
  | .reduceZombieCall (.zombie ptr bits (n + 1)) slot true => do
      let endSlot ← NonDetE.returnOk (ptr, natToCref (zombieCteBits bits) n)
      let _ ← recDel (.cTEDeleteCall endSlot false)
      let newCap ← withoutPreemption <| getCap slot
      if newCap = .zombie ptr bits (n + 1)
      then withoutPreemption <| setCap (.zombie ptr bits n) slot
      else NonDetE.assertE (newCap = .nullCap ∨
                            isZombie newCap ∧ firstCslotOf newCap = slot
                              ∧ firstCslotOf (.zombie ptr bits (n + 1)) ≠ slot)
      NonDetE.returnOk undefined
  | .reduceZombieCall _ _ _ => NonDetE.liftE NonDet.fail

/-- `recDelV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `rec_del` with `finaliseCapV` (the least fixed point, as `recDel`). -/
def recDelVF : RecDelCall → PMonad Z (Bool × Cap) :=
  NonDet.lfp (σ := State Z) (α := Except Unit (Bool × Cap)) fun r c => recDelFVF r c

/-- `capDeleteV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `cap_delete` with `recDelV`. -/
def capDeleteVF (slot : CslotPtr) : PMonad Z Unit := do
  let _ ← recDelVF (.cTEDeleteCall slot true)
  NonDetE.returnOk ()

/-- `capRevokeFV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `cap_revoke`'s equation (`capRevokeF`) with `capDeleteV`. -/
def capRevokeFVF (capRevoke : CslotPtr → PMonad Z Unit) (slot : CslotPtr) : PMonad Z Unit := do
  let cap ← withoutPreemption <| getCap slot
  let cdt ← withoutPreemption <| NonDet.gets fun s : State Z => s.cdt
  let descendants ← NonDetE.returnOk (descendantsOf slot cdt)
  NonDetE.whenE (cap ≠ .nullCap ∧ descendants ≠ ∅) (do
    let child ← withoutPreemption <| selectExt (nextRevokeCap slot) descendants
    let cap ← withoutPreemption <| getCap child
    NonDetE.assertE (cap ≠ .nullCap)
    capDeleteVF child
    preemptionPoint
    capRevoke slot)

/-- `capRevokeV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `cap_revoke` with `capDeleteV`. -/
def capRevokeVF : CslotPtr → PMonad Z Unit :=
  NonDet.lfp (σ := State Z) (α := Except Unit Unit) fun r c => capRevokeFVF r c

/-- `invokeCnodeV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `invoke_cnode` with `capRevokeV` / `capDeleteV`. -/
def invokeCnodeVF (i : CnodeInvocation) : PMonad Z Unit :=
  match i with
  | .revokeCall destSlot => capRevokeVF destSlot
  | .deleteCall destSlot => capDeleteVF destSlot
  | i => invokeCnode i

/-- `installTcbCapV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `Tcb_A.install_tcb_cap` with `capDeleteV`. -/
def installTcbCapVF (target : ObjRef) (slot : CslotPtr) (n : Nat) (slotOpt : Option (Cap × CslotPtr)) :
    PMonad Z Unit :=
  match slotOpt with
  | none => NonDetE.returnOk ()
  | some (newCap, srcSlot) => do
    capDeleteVF (target, tcbCnodeIndex n)
    NonDetE.unlessE (newCap = .nullCap) <|
      NonDetE.liftE <| checkCapAt newCap srcSlot
        <| checkCapAt (.threadCap target) slot
        <| capInsert newCap srcSlot (target, tcbCnodeIndex n)

/-- `installTcbFrameCapV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `Tcb_A.install_tcb_frame_cap` with `capDeleteV`. -/
def installTcbFrameCapVF (target : ObjRef) (slot : CslotPtr)
    (buffer : Option (VSpaceRef × Option (Cap × CslotPtr))) : PMonad Z Unit :=
  match buffer with
  | none => NonDetE.returnOk ()
  | some (ptr, frame) => do
    capDeleteVF (target, tcbCnodeIndex 2)
    NonDetE.liftE <| threadSet (fun t => { t with tcbIpcBuffer := ptr }) target
    NonDetE.liftE <| match frame with
      | none => return ()
      | some (newCap, srcSlot) =>
          checkCapAt newCap srcSlot
            <| checkCapAt (.threadCap target) slot
            <| capInsert newCap srcSlot (target, tcbCnodeIndex 2)
    let cur ← NonDetE.liftE <| NonDet.gets fun s : State Z => s.curThread
    NonDetE.liftE <| NonDet.when (target = cur) rescheduleRequired

/-- `invokeTcbV` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `Tcb_A.invoke_tcb` with `installTcbCapV` / `installTcbFrameCapV`
(the two thread-control cases; the others are l4v's). -/
def invokeTcbVF : TcbInvocation → PMonad Z (List Data)
  | .threadControlCaps target slot faultHandler timeoutHandler croot vroot buffer => do
      installTcbCapVF target slot 3 faultHandler
      installTcbCapVF target slot 4 timeoutHandler
      installTcbCapVF target slot 0 croot
      installTcbCapVF target slot 1 vroot
      installTcbFrameCapVF target slot buffer
      NonDetE.returnOk []
  | .threadControlSched target slot faultHandler mcp priority sc => do
      installTcbCapVF target slot 3 faultHandler
      NonDetE.liftE <| NonDet.maybeM (fun (newmcp, _) => setMcpriority target newmcp) mcp
      NonDetE.liftE <| NonDet.maybeM (fun (prio, _) => setPriority target prio) priority
      NonDetE.liftE <| NonDet.maybeM (fun scopt =>
          match scopt with
          | none => do
              let scPtrOpt ← getTcbObjRef Tcb.tcbSchedContext target
              let scPtr ← NonDet.assertOpt scPtrOpt
              schedContextUnbindTcb scPtr
          | some scPtr => schedContextBindTcb scPtr target) sc
      NonDetE.returnOk []
  | i => invokeTcb i

/-- `invokeSetEptRoot` (`Ext/VirtFinalise`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: **TCBSetEPTRoot** (FL4 `cdt::delete` of the target's slot 5, then
`cdt::insert`). -/
def invokeSetEptRootF (i : SetEptRootInvocation) : PMonad Z Unit := do
  capDeleteVF (i.target, tcbCnodeIndex 5)
  NonDetE.liftE <| capInsert i.newCap i.srcSlot (i.target, tcbCnodeIndex 5)

/-- `handleInterruptV` (`Ext/VirtEntry`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `Interrupt_A.handle_interrupt` with `sendSignalV`. -/
def handleInterruptVF (onCore remoteCur : ObjRef → Bool) (irq : Irq) : SMonad Z Unit :=
  if irq > maxIRQ then doMachineOp (do
    maskInterrupt true irq
    ackInterrupt irq)
  else do
    let st ← getIrqState irq
    match st with
    | .irqSignal => do
      let slot ← getIrqSlot irq
      let cap ← getCap slot
      NonDet.when (isNtfnCap cap ∧ AllowSend ∈ capRights cap) <|
        sendSignalVF onCore remoteCur (objRefOf cap) (capEpBadge cap)
      archMaskIrqSignal irq
    | .irqTimer => do
      doMachineOp ackDeadlineIRQ
      NonDet.modify fun s : State Z => { s with reprogramTimer := true }
    | .irqInactive => NonDet.fail
    | .irqReserved => handleReservedIrq irq
    doMachineOp <| ackInterrupt irq

/-- `maybeHandleInterruptV` (`Ext/VirtEntry`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `maybe_handle_interrupt` with `handleInterruptV`. -/
def maybeHandleInterruptVF (onCore remoteCur : ObjRef → Bool) (inKernel : Bool) : SMonad Z Unit := do
  let irqOpt ← doMachineOp <| getActiveIRQ inKernel
  match irqOpt with
  | none => handleSpuriousIrq
  | some irq => handleInterruptVF onCore remoteCur irq

/-- `fl4TimerSignalV` (`Ext/VirtEntry`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: `Ext/Timer`'s `fl4TimerSignal` with `sendSignalV`. -/
def fl4TimerSignalVF (onCore remoteCur : ObjRef → Bool) (σ σ' : State Z) : Prop :=
  ∃ n b, sendSignalVF onCore remoteCur n b σ = ({((), σ')}, False)

/-- `fl4TimerFireV` (`Ext/VirtEntry`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: `Ext/Timer`'s `fl4TimerFire` with `fl4TimerSignalV`. -/
def fl4TimerFireVF (onCore remoteCur : ObjRef → Bool) (σ σ' : State Z) : Prop :=
  ∃ σ1, (σ1 = σ ∨ fl4TimerSignalVF onCore remoteCur σ σ1) ∧ σ' = { σ1 with reprogramTimer := true }

/-- `fl4AwakenV` (`Ext/VirtEntry`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: `Ext/Timer`'s `fl4Awaken` with `fl4TimerFireV`. -/
def fl4AwakenVF (onCore remoteCur : ObjRef → Bool) : SMonad Z Unit :=
  fun σ => ({p | Relation.ReflTransGen (fl4TimerFireVF onCore remoteCur) σ p.2}, False)

/-- `fl4PerformInvocationV` (`Ext/VirtDispatch`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: **The extended invocations** (module docstring). -/
def fl4PerformInvocationVF (onCore remoteCur : ObjRef → Bool) : Bool → Bool → Bool → Fl4InvocationV →
    PMonad Z (List Data)
  | _, _, _, .base (.invokeUntyped i) => do
    fl4InvokeUntypedV i
    NonDetE.returnOk []
  | _, _, _, .base (.invokeNotification ep badge) => do
    withoutPreemption <| sendSignalVF onCore remoteCur ep badge
    NonDetE.returnOk []
  | _, _, _, .base (.invokeTCB i) => invokeTcbVF i
  | _, _, _, .base (.invokeCNode i) => do
    invokeCnodeVF i
    NonDetE.returnOk []
  | block, call, canDonate, .base i => fl4PerformInvocation block call canDonate i
  | _, _, _, .vcpu i => NonDetE.liftE <| performVcpuInvocationF i
  | _, _, _, .ept i => NonDetE.liftE (do
      performEptInvocation i
      return [])
  | _, _, _, .setEptRoot i => do
    invokeSetEptRootF i
    NonDetE.returnOk []

/-- `fl4HandleInvocationV` (`Ext/VirtDispatch`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: `fl4HandleInvocationR` (`Ext/ReplyError`) with the extended
dispatcher. -/
def fl4HandleInvocationVF (onCore remoteCur : ObjRef → Bool) (reportError : Bool)
    (calling blocking canDonate firstPhase : Bool) (cptr : CapRef) : PMonad Z Unit := do
  let thread ← NonDetE.liftE <| NonDet.gets fun s : State Z => s.curThread
  let info ← withoutPreemption <| getMessageInfo thread
  syscall
    (do
       let (cap, slot) ← capFaultOnFailure (ofBl cptr) false <|
                         lookupCapAndSlot thread cptr
       let buffer ← NonDetE.liftE <| lookupIpcBuffer false thread
       let extracaps ← lookupExtraCaps thread buffer info
       NonDetE.returnOk (slot, cap, extracaps, buffer))
    (fun fault => NonDet.when blocking <| handleFault thread fault)
    (fun (slot, cap, extracaps, buffer) => do
          let args ← NonDetE.liftE <| getMrs thread buffer info
          fl4DecodeInvocationV firstPhase info.miLabel args cptr slot cap extracaps buffer)
    (fun err => NonDet.when calling <|
          fl4ReplyFromKernelError reportError thread <| msgFromSyscallError err)
    (fun oper => do
          withoutPreemption <| setThreadState thread .restart
          let reply ← fl4PerformInvocationVF onCore remoteCur blocking calling canDonate oper
          withoutPreemption <| do
              let state ← getThreadState thread
              match state with
              | .restart => do
                NonDet.when calling <|
                  replyFromKernel thread (0, reply)
                setThreadState thread .running
              | _ => return ())

/-- `fl4HandleSyscallV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: `fl4HandleSyscall` with `fl4HandleInvocationV`. -/
def fl4HandleSyscallVF (onCore remoteCur : ObjRef → Bool) (rep : Bool) : Syscall → PMonad Z Unit
  | .sysSend => do
    let cptr ← NonDetE.liftE <| getCapReg cap_register
    fl4HandleInvocationVF onCore remoteCur rep false true false false cptr
  | .sysNBSend => do
    let cptr ← NonDetE.liftE <| getCapReg cap_register
    fl4HandleInvocationVF onCore remoteCur rep false false false false cptr
  | .sysCall => do
    let cptr ← NonDetE.liftE <| getCapReg cap_register
    fl4HandleInvocationVF onCore remoteCur rep true true true false cptr
  | .sysRecv => withoutPreemption <| handleRecv true true
  | .sysYield => withoutPreemption handleYield
  | .sysReplyRecv => do
    let replyCptr ← withoutPreemption <| getCapReg replyRegister
    fl4HandleInvocationVF onCore remoteCur rep false false true true replyCptr
    withoutPreemption <| handleRecv true true
  | .sysNBSendRecv => do
    let dest ← withoutPreemption <| getCapReg nbsendRecvDest
    fl4HandleInvocationVF onCore remoteCur rep false false true true dest
    withoutPreemption <| handleRecv true true
  | .sysNBSendWait => do
    let replyCptr ← withoutPreemption <| getCapReg replyRegister
    fl4HandleInvocationVF onCore remoteCur rep false false true true replyCptr
    withoutPreemption <| handleRecv true false
  | .sysWait => withoutPreemption <| handleRecv true false
  | .sysNBWait => withoutPreemption <| handleRecv false false
  | .sysNBRecv => withoutPreemption <| handleRecv false true

/-- `fl4HandleEventV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: `fl4HandleEvent` with the extended dispatcher, `SysVMEnter` and
`handleInterruptV` (module docstring). -/
def fl4HandleEventVF (onCore remoteCur : ObjRef → Bool) (rep : Bool) : Event → PMonad Z Unit
  | .syscallEvent call => do
    NonDetE.liftE updateTimeStamp
    let restart ← NonDetE.liftE checkBudgetRestart
    NonDetE.whenE restart (fl4HandleSyscallVF onCore remoteCur rep call)
  | .unknownSyscall n => do
    let vm ← NonDetE.liftE <| NonDet.gets (isVmEnterCall n)
    if vm then withoutPreemption <| do
      updateTimeStamp
      let restart ← checkBudgetRestart
      let thread ← NonDet.gets fun s : State Z => s.curThread
      NonDet.when restart <| vmEnterF thread
    else handleEvent (.unknownSyscall n)
  | .interrupt => withoutPreemption <| do
    updateTimeStamp
    let _ ← checkBudget
    maybeHandleInterruptVF onCore remoteCur false
  | ev => handleEvent ev

/-- `preemptionPathV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: l4v `Syscall_A.preemption_path` with `maybeHandleInterruptV`. -/
def preemptionPathVF (onCore remoteCur : ObjRef → Bool) : SMonad Z Unit := do
  let ct ← NonDet.gets fun s : State Z => s.curThread
  let sched ← NonDet.gets (schedulable ct)
  if sched then do
    let _ ← checkBudget
    pure ()
  else do
    let csc ← NonDet.gets fun s : State Z => s.curSc
    let active ← getScActive csc
    if active
    then do
      let consumed ← NonDet.gets fun s : State Z => s.consumedTime
      chargeBudget consumed false
    else NonDet.modify fun s : State Z => { s with consumedTime := 0 }
  maybeHandleInterruptVF onCore remoteCur true

/-- `fl4KernelExitV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: The common tail of every entry: TCB timers, `schedule`,
`activateThreadV`, and the exit's VCPU check of the current thread (FL4
`kernel/entry.rs` `exit`). -/
def fl4KernelExitVF (onCore remoteCur : ObjRef → Bool) : SMonad Z Unit := do
  fl4AwakenVF onCore remoteCur
  schedule
  activateThreadV
  let ct ← NonDet.gets fun s : State Z => s.curThread
  vmCheckF ct

/-- `fl4CallKernelV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: **`fl4CallKernel` with the virtualization extension** (module
docstring). -/
def fl4CallKernelVF (onCore remoteCur : ObjRef → Bool) (rep : Bool) (ev : Event) : SMonad Z Unit := do
  let _ ← ExceptT.run <| NonDetE.handleE (fl4HandleEventVF onCore remoteCur rep ev)
    (fun _ => withoutPreemption (preemptionPathVF onCore remoteCur))
  fl4KernelExitVF onCore remoteCur

/-- `fl4KernelEntrySyscallV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: The syscall entry (`fl4KernelEntrySyscall`) of the extended kernel. -/
def fl4KernelEntrySyscallVF (onCore remoteCur : ObjRef → Bool) (rep : Bool) (c : Syscall) : SMonad Z Unit := do
  let ct ← NonDet.gets fun s : State Z => s.curThread
  fl4SyscallFaultIP ct
  fl4CallKernelVF onCore remoteCur rep (.syscallEvent c)

/-- `fl4VcpuExitV` (`Ext/VirtKernel`) with FL4's VMEnter report (`Ext/VirtReport`). Its docstring: **The entry after a guest step** (FL4 `handle_vcpu_exit`; module
docstring). -/
def fl4VcpuExitVF (onCore remoteCur : ObjRef → Bool) (irq : Option Irq) (stalled : Bool) : SMonad Z Unit := do
  NonDet.unless stalled <| do
    updateTimeStamp
    let ct ← NonDet.gets fun s : State Z => s.curThread
    vmCheckF ct
    let _ ← checkBudget
    pure ()
  match irq with
  | some i => handleInterruptVF onCore remoteCur i
  | none => pure ()
  fl4KernelExitVF onCore remoteCur

end

end

end Fl4Spec
