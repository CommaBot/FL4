/-
Accessors for threads and TCBs: IPC buffer words, message registers, kernel
replies.

Ports `spec/abstract/TcbAcc_A`. Its `arch_requalify_consts` (`in_user_frame`,
`lookup_ipc_buffer`) refer to `Fl4Spec.X64.VSpace`.
-/
import Fl4Spec.X64.VSpace

namespace Fl4Spec

open Classical

noncomputable section

section
variable {Z : Type} [StateExt Z]

/-- l4v: TcbAcc_A.store_word_offs: store a word at an offset from an IPC
buffer. -/
def storeWordOffs (ptr : ObjRef) (offs : Nat) (v : Word) : SMonad Z Unit := do
  let s ← NonDet.get
  NonDet.assert (inUserFrame (ptr + BitVec.ofNat 64 (offs * wordSize)) s)
  doMachineOp (storeWord (ptr + BitVec.ofNat 64 (offs * wordSize)) v)

/-- l4v: TcbAcc_A.set_message_info. -/
def setMessageInfo (thread : ObjRef) (info : MessageInfo) : SMonad Z Unit :=
  asUser thread (setRegister msg_info_register (messageInfoToData info))

/-- l4v: TcbAcc_A.set_mrs: write a message to the message registers and the
IPC buffer, returning its length. -/
def setMrs (thread : ObjRef) (buf : Option ObjRef) (msgs : List Message) : SMonad Z LengthType := do
  let tcb ← NonDet.getsThe (getTcb thread)
  let context ← pure (archTcbGetRegisters tcb.tcbArch)
  let newRegs ← pure (fun reg =>
    if reg ∈ msg_registers.take msgs.length
    then the msgs[theIndex msg_registers reg]?
    else context reg)
  setObject thread (.tcb { tcb with tcbArch := archTcbSetRegisters newRegs tcb.tcbArch })
  let remainingMsgs ← pure (msgs.drop msg_registers.length)
  match buf with
  | none => return natToLen (min msg_registers.length msgs.length)
  | some pptr => do
    NonDet.zipWithMx (fun x => storeWordOffs pptr x)
      (List.range' (msg_registers.length + 1) (msgMaxLength + 1 - (msg_registers.length + 1)))
      remainingMsgs
    return natToLen (min msgs.length msgMaxLength)

/-- l4v: TcbAcc_A.reply_from_kernel: transfer a reply message generated by a
kernel service to a thread. -/
def replyFromKernel (thread : ObjRef) (x : Data × List Data) : SMonad Z Unit := do
  let (label, msg) ← pure x
  let buf ← lookupIpcBuffer true thread
  asUser thread (setRegister badge_register 0)
  let len ← setMrs thread buf msg
  setMessageInfo thread ⟨len, 0, 0, label⟩

end

end

end Fl4Spec
