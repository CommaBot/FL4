            let r1 ← SProg.liftR (tcbqueue.Queue.empty)
            pure (r1)
          else do
            let (t2, t3) ← SProg.blk 1 (
                if b then do
                  do
                    let _ ← R.tcbqueue.set_prev l i1 0#u64
                    pure ((i1, q.end))
                else do
                  do
                    let t5 ← SProg.blk 0 (
                        if b1 then do
                          do
                            let _ ← R.tcbqueue.set_next l i 0#u64
                            pure (i)
                        else do
                          do
                            let _ ← R.tcbqueue.set_next l i i1
                            let _ ← R.tcbqueue.set_prev l i1 i
                            pure (q.end))
                    pure ((q.head, t5)))
            pure (({ head := t2, «end» := t3 } : tcbqueue.Queue))
      else do
        do
          let (t2, t3) ← SProg.blk 3 (
              if b then do
                do
                  let _ ← R.tcbqueue.set_prev l i1 0#u64
                  pure ((i1, q.end))
              else do
                do
                  let b1 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq q.end t)
                  let t5 ← SProg.blk 2 (
                      if b1 then do
                        do
                          let _ ← R.tcbqueue.set_next l i 0#u64
                          pure (i)
                      else do
                        do
                          let _ ← R.tcbqueue.set_next l i i1
                          let _ ← R.tcbqueue.set_prev l i1 i
                          pure (q.end))
                  pure ((q.head, t5)))
          pure (({ head := t2, «end» := t3 } : tcbqueue.Queue)))
  let _ ← R.tcbqueue.set_next l t 0#u64
  let _ ← R.tcbqueue.set_prev l t 0#u64
  pure (r)

