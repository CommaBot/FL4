    | (with_reducible apply bind_congr_r; intro)
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r.2, r.1, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((r.2.1, r.2.2), r.1, aB)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => (r.2, r.1, aB)))
      | ((refine (show BlkShape S A 3 _ _ from ?_)); exact (fun r sB aB => ((r.2.1, r.2.2), r.1, aB)))
      | ((refine (show BlkShape S A 4 _ _ from ?_)); exact (fun r sB aB => (r.2, r.1, aB)))
      ))
    | reif_step)

@[reif_nz] theorem R.tcbqueue.remove_nz (l : tcbqueue.Link) (q : tcbqueue.Queue) (t : obj.Tcb) : NoZero (R.tcbqueue.remove l q t) := by
  unfold R.tcbqueue.remove
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.tcbqueue.next_nz)
    | (with_reducible apply R.tcbqueue.prev_nz)
    | (with_reducible apply R.tcbqueue.set_next_nz)
    | (with_reducible apply R.tcbqueue.set_prev_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
