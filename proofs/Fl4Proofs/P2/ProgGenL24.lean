@[irreducible] noncomputable def R.sched.release_enqueue_loop.body (new_time : Std.U64) (after : obj.Tcb) (fuel : Std.U64) : SProg (ControlFlow (obj.Tcb × Std.U64) obj.Tcb) := do
  let b ← SProg.liftR (obj.Tcb.is_null after)
  if b then do
    pure (.done after)
  else do
    let i ← R.sched.ready_time after
    if new_time >= i then do
      if fuel > 0#u64 then do
        let fuel1 ← SProg.liftR (fuel - 1#u64)
        let i1 ← R.obj.Tcb.sched_next after
        pure (.cont (i1, fuel1))
      else do
        pure (.done after)
    else do
      pure (.done after)

