@[irreducible] noncomputable def R.timer.replace_child (cpu : Std.U64) (p : obj.Tcb) (old : obj.Tcb) (new : obj.Tcb) : SProg Unit := do
  let b ← SProg.liftR (obj.Tcb.is_null p)
  if b then do
    R.timer.set_root cpu new
  else do
    let t ← R.timer.left p
    let b1 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq t old)
    if b1 then do
      R.timer.set_left p new
    else do
      R.timer.set_right p new

