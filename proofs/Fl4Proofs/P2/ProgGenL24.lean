@[irreducible] noncomputable def R.sporadic.schedule_used (sc : obj.Sc) (new : sporadic.Refill) : SProg Unit := do
  let t ← R.sporadic.tail sc
  let i ← pure ((core.num.U64.wrapping_add t.time t.amount))
  if i >= new.time then do
    let i1 ← pure ((core.num.U64.wrapping_add t.amount new.amount))
    R.sporadic.set_tail sc { t with amount := i1 }
  else do
    let b ← R.sporadic.full sc
    if b then do
      let i1 ← pure ((core.num.U64.wrapping_sub new.time t.amount))
      let i2 ← pure ((core.num.U64.wrapping_add t.amount new.amount))
      R.sporadic.set_tail sc { time := i1, amount := i2 }
    else do
      R.sporadic.add_tail sc new

