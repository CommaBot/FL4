/-- The measure of `sched.release_enqueue_loop` drops at every `cont` step, on every store. -/
theorem R.sched.release_enqueue_loop.body_dec (s : S) (new_time : Std.U64) (after : obj.Tcb) (fuel : Std.U64) {σ0}
    (h : fl4_core.sched.release_enqueue_loop.body mS s new_time after fuel = ok (.cont σ0)) :
    (fun xL => xL.2.val) σ0 < (fun xL => xL.2.val) (after, fuel) := by
  simp only [fl4_core.sched.release_enqueue_loop.body] at h
  dec_peel
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.sched.release_enqueue_loop (new_time : Std.U64) (after : obj.Tcb) (fuel : Std.U64) : SProg obj.Tcb :=
  SProg.iter (fun xL => R.sched.release_enqueue_loop.body new_time xL.1 xL.2) ((fun xL => xL.2.val) (after, fuel) + 1) (after, fuel)

@[reif_simps] theorem R.sched.release_enqueue_loop_eq (new_time : Std.U64) (after : obj.Tcb) (fuel : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.sched.release_enqueue_loop new_time after fuel) sS aA =
      (fl4_core.sched.release_enqueue_loop mS sS new_time after fuel >>= fun r => ok (r, sS, aA)) := by
  unfold R.sched.release_enqueue_loop fl4_core.sched.release_enqueue_loop
  exact interp_iterR mS mA (fun (σ0 : obj.Tcb × Std.U64) => fl4_core.sched.release_enqueue_loop.body mS sS new_time σ0.1 σ0.2) (fun xL => R.sched.release_enqueue_loop.body new_time xL.1 xL.2) (fun xL => xL.2.val) sS
    (fun xL aL => R.sched.release_enqueue_loop.body_eq mS mA new_time xL.1 xL.2 sS aL)
    (fun xL cL h => R.sched.release_enqueue_loop.body_dec mS sS new_time xL.1 xL.2 h) _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.sched.release_enqueue_loop_nz (new_time : Std.U64) (after : obj.Tcb) (fuel : Std.U64) : NoZero (R.sched.release_enqueue_loop new_time after fuel) := by
  unfold R.sched.release_enqueue_loop
  exact NoZero.iter (fun x => R.sched.release_enqueue_loop.body_nz _ _ _) _ _

