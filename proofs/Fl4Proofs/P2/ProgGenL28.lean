@[irreducible] noncomputable def R.timer.insert_fixup_loop.body (cpu : Std.U64) (z : obj.Tcb) (fuel : Std.U64) : SProg (ControlFlow (obj.Tcb × Std.U64) Unit) := do
  let p ← R.timer.parent z
  let b ← SProg.liftR (obj.Tcb.is_null p)
  if b then do
    pure (.done ())
  else do
    let b1 ← R.timer.is_red p
    if b1 then do
      if fuel = 0#u64 then do
        pure (.done ())
      else do
        let fuel1 ← SProg.liftR (fuel - 1#u64)
        let g ← R.timer.parent p
        let t ← R.timer.left g
        let b2 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq p t)
        if b2 then do
          let u ← R.timer.right g
          let b3 ← R.timer.is_red u
          if b3 then do
            let _ ← R.timer.set_red p false
            let _ ← R.timer.set_red u false
            let _ ← R.timer.set_red g true
            pure (.cont (g, fuel1))
          else do
            let t1 ← R.timer.right p
            let b4 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq z t1)
            let (z1, pp) ← SProg.blk 0 (
                if b4 then do
                  do
                    let _ ← R.timer.rotate_left cpu p
                    let pp1 ← R.timer.parent p
                    pure ((p, pp1))
                else do
                  pure ((z, p)))
            let _ ← R.timer.set_red pp false
            let _ ← R.timer.set_red g true
            let _ ← R.timer.rotate_right cpu g
            pure (.cont (z1, fuel1))
        else do
          let b3 ← R.timer.is_red t
          if b3 then do
            let _ ← R.timer.set_red p false
            let _ ← R.timer.set_red t false
            let _ ← R.timer.set_red g true
            pure (.cont (g, fuel1))
          else do
            let t1 ← R.timer.left p
            let b4 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq z t1)
            let (z1, pp) ← SProg.blk 1 (
                if b4 then do
                  do
                    let _ ← R.timer.rotate_right cpu p
                    let pp1 ← R.timer.parent p
                    pure ((p, pp1))
                else do
                  pure ((z, p)))
            let _ ← R.timer.set_red pp false
            let _ ← R.timer.set_red g true
            let _ ← R.timer.rotate_left cpu g
            pure (.cont (z1, fuel1))
    else do
      pure (.done ())

