@[irreducible] noncomputable def R.sporadic.budget_check (usage_in : Std.U64) : SProg Unit := do
  let i ← SProg.curCpu
  let i1 ← R.obj.node_get i layout.node.CUR_SC
  let mrt ← R.sporadic.max_release_time
  let period ← R.obj.Sc.period i1
  let usage ← R.sporadic.budget_check_loop0 i1 mrt period usage_in layout.WALK_FUEL
  let h ← R.sporadic.head i1
  let _ ← SProg.blk 0 (
      if usage > 0#u64 then do
        if h.time < mrt then do
          if h.amount > usage then do
            do
              let i2 ← pure ((core.num.U64.wrapping_add h.time period))
              let i3 ← pure ((core.num.U64.wrapping_add h.time usage))
              let i4 ← pure ((core.num.U64.wrapping_sub h.amount usage))
              let _ ← R.sporadic.set_head i1 { time := i3, amount := i4 }
              R.sporadic.schedule_used i1 { time := i2, amount := usage }
          else do
            pure (())
        else do
          pure (())
      else do
        pure (()))
  let mb ← R.sporadic.min_budget
  let i2 ← R.obj.Sc.refill_max i1
  let fuel2 ← pure ((core.num.U64.wrapping_add i2 2#u64))
  R.sporadic.budget_check_loop1 i1 mb fuel2

