  let _ ← SProg.blk 1 (
      if b then do
        pure (())
      else do
        do
          let _ ← R.smp.remote_tcb_stall i
          let _ ← R.sched.dequeue i
          let _ ← R.sched.release_remove i
          let _ ← R.obj.Tcb.set_sc i 0#u64
          let t ← R.sched.cur_thread
          let b1 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq i t)
          let _ ← SProg.blk 0 (
              if b1 then do
                R.sched.reschedule_required
              else do
                do
                  let i1 ← R.sched.action
