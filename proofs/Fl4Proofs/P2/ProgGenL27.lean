@[irreducible] noncomputable def R.sched.release_enqueue (t : obj.Tcb) : SProg Unit := do
  let cpu ← R.obj.Tcb.affinity t
  let q ← R.sched.q_get cpu layout.node.RELEASE_HEAD
  let new_time ← R.sched.ready_time t
  let b ← SProg.liftR (tcbqueue.Queue.is_empty q)
  if b then do
    let nq ← R.tcbqueue.prepend tcbqueue.Link.Sched q t
    let _ ← R.sched.q_set cpu layout.node.RELEASE_HEAD nq
    let _ ← R.sched.set_flag t sched.Q_RELEASE true
    let i ← R.obj.node_get cpu layout.node.RELEASE_HEAD
    let i1 := q.head
    let _ ← SProg.blk 0 (
        if i != i1 then do
          R.sched.set_reprogram_on cpu
        else do
          pure (()))
    R.smp.remote_queue_update t
  else do
    let i ← R.sched.ready_time q.head
    if new_time < i then do
      let nq ← R.tcbqueue.prepend tcbqueue.Link.Sched q t
      let _ ← R.sched.q_set cpu layout.node.RELEASE_HEAD nq
      let _ ← R.sched.set_flag t sched.Q_RELEASE true
      let i1 ← R.obj.node_get cpu layout.node.RELEASE_HEAD
      let i2 := q.head
      let _ ← SProg.blk 1 (
          if i1 != i2 then do
            R.sched.set_reprogram_on cpu
          else do
            pure (()))
      R.smp.remote_queue_update t
    else do
      let i1 ← R.sched.ready_time q.end
      if i1 <= new_time then do
        let nq ← R.tcbqueue.append tcbqueue.Link.Sched q t
        let _ ← R.sched.q_set cpu layout.node.RELEASE_HEAD nq
        let _ ← R.sched.set_flag t sched.Q_RELEASE true
        let i2 ← R.obj.node_get cpu layout.node.RELEASE_HEAD
        let i3 := q.head
        let _ ← SProg.blk 2 (
            if i2 != i3 then do
              R.sched.set_reprogram_on cpu
            else do
              pure (()))
        R.smp.remote_queue_update t
      else do
        let after ← R.sched.release_enqueue_loop new_time q.head layout.WALK_FUEL
        let _ ← R.tcbqueue.insert_before tcbqueue.Link.Sched t after
        let _ ← R.sched.set_flag t sched.Q_RELEASE true
        let i2 ← R.obj.node_get cpu layout.node.RELEASE_HEAD
        let _ ← SProg.blk 3 (
            if i2 != q.head then do
              R.sched.set_reprogram_on cpu
            else do
              pure (()))
        R.smp.remote_queue_update t

