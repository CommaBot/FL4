/-
# P2 (line invj, generation 1): the truncated Delete chain with the true buffer premise (`InvBufJ8`)

stpost gen 14's [J] `InvBufJ` (P2/InvTrunc.lean: the caller's IPC buffer words `b + 8 i`, `i < 512`, are aligned
user words) is **false at P3 states**: the IPC buffer is 1 KiB (128 words, `seL4_IPCBufferSizeBits = 10`) and
`check_valid_ipc_buffer` asks only 1 KiB alignment, so it can sit at offset 3072 of a 4 KiB frame; then
`b + 8 * 128` is the first word of the next physical page, which can be a kernel object (e.g. a CNode retyped
from a neighbouring untyped), not a user word. The decode touches only word 7 of the buffer
(`DEBUG_MESSAGE_START + 1`, `reply_error TruncatedMessage`), so 128 words suffice.

* `InvBufJ8` (`i < 128`), **`invBufJ8_of`**: proved at every `SlJAt` state from P3 (`JAtZ.bufOK`: the buffer's
  words are `BufU` words, hence `Z.B` words, `JAtZ.bufU_B`; aligned, `EPlaced.balign`). No premise.
* `dbg_idx8`, `syscall.reply_error.guard_trunc8`, `truncRun8`, `truncAcc8`, `truncFin8` (P2/InvTrunc.lean),
  `invBlkUW2_of8`, `invBlkGdUW2_of8`, **`inv_pathsKFU8`** (P2/InvDelU.lean): verbatim copies with `i < 512`
  replaced by `i < 128` and `InvBufJ` by `InvBufJ8` (generated by a renaming script from the stpost gen 14 text).

No existing statement changes; no `kernel_entry_reach*` is touched.
-/
import Fl4Proofs.P2.InvDelU
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P2.PathObl
open fl4_core Fl4Proofs.P1
open Fl4Proofs.P2.OwnMap (KLayout InNode InW fld own region RegionOK GateField TimerField NullOrFrame TcbSlot
  oAFFINITY)
open Fl4Proofs.P2.E2E (Once ReadOnce)

/-! ## The buffer premise, 128 words -/

section buf
variable {S : Type} {st : machine.Store S} [L : LawfulStore st]

variable (st) in
/-- (invj gen 1) **The caller's IPC-buffer words are aligned user words**, for the 128 words of the buffer (the
true form of `InvBufJ`; module docstring). -/
def InvBufJ8 (K : KLayout) (s : S) : Prop :=
  ∀ b, msg.lookup_ipc_buffer st s true (L.curW s) = ok b → b ≠ 0#u64 → ∀ i : U64, i.val < 128 →
    UserW K (core.num.U64.wrapping_add b (core.num.U64.wrapping_mul i 8#u64))

/-- **`InvBufJ8` at every bundle state** (`JAtZ.bufOK`, `JAtZ.bufU_B`, `EPlaced.balign`). No premise. -/
theorem invBufJ8_of {K : KLayout} {s : S} (hJ : SlJAt (L := L) K s) : InvBufJ8 st K s := by
  obtain ⟨A', arI, AR, Zx, Cx, Ax, Lst, D, a', σ, B⟩ := hJ
  intro b hb hb0 i hi
  have hcur : L.curW s ∈ Heap.tcbs K.heap := B.j.kern.curH
  obtain ⟨w, hw', hP⟩ := spec_ex_fd (B.j.bufOK hcur)
  rw [hb] at hw'
  have e0 : b = w := ok_inj_ff hw'
  subst e0
  have hw := hP hb0 i hi
  obtain ⟨wp, hwp, e⟩ := B.j.bufU_B hw
  refine ⟨?_, ?_⟩
  · rw [← e]; exact (B.j.xtop.fin.1.2.ep.balign _ hwp).1
  · rw [B.user]; exact ⟨wp, hwp, e⟩

end buf

section run8

theorem dbg_idx8 : ∃ i : U64, syscall.DEBUG_MESSAGE_START + 1#u64 = ok i ∧ i.val < 128 := by
  have h6 : syscall.DEBUG_MESSAGE_START.val = 6 := by simp [syscall.DEBUG_MESSAGE_START]
  have h1 : (1#u64 : U64).val = 1 := by simp
  obtain ⟨v, hv, hvv⟩ := spec_ex_fd (U64.add_spec (x := syscall.DEBUG_MESSAGE_START) (y := 1#u64)
    (by rw [h6, h1]; simp [U64.max, U64.numBits]))
  refine ⟨v, hv, ?_⟩
  omega

end run8

section g
variable {S : Type} {st : machine.Store S} {R W : U64 → Prop} {gS : machine.Store S} [GRd gS st R] [GWr gS st W]
  [L : LawfulStore st]

/-- **`reply_error TruncatedMessage` on the guarded store**, run-relative: the buffer lookup (as `st`), the reply
registers, and the buffer word `DEBUG_MESSAGE_START + 1` when the buffer is set. -/
theorem syscall.reply_error.guard_trunc8 {x : S} {t : U64} {z : S}
    (hlk : msg.lookup_ipc_buffer gS x true t = msg.lookup_ipc_buffer st x true t)
    (hB : W (regA t layout.reg.BADGE)) (hM : W (regA t layout.reg.MSG_INFO))
    (hbuf : ∀ b, msg.lookup_ipc_buffer st x true t = ok b → b ≠ 0#u64 → ∀ i : U64, i.val < 128 →
      R (core.num.U64.wrapping_add b (core.num.U64.wrapping_mul i 8#u64)) ∧
      W (core.num.U64.wrapping_add b (core.num.U64.wrapping_mul i 8#u64)))
    (h : syscall.reply_error st x t .TruncatedMessage = ok z) :
    syscall.reply_error gS x t .TruncatedMessage = ok z := by
  unfold syscall.reply_error at h ⊢
  rw [hlk]
  revert h
  refine tr_bind_same (fun b eb => ?_)
  rw [obj.Tcb.set_reg.guard (gS := gS) t x _ _ hB]
  refine tr_bind_same (fun s1 _ => ?_)
  rw [error_mrs_trunc, error_mrs_trunc]
  simp only [bind_ok, uncurry_apply_pair, fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC, if_true]
  refine tr_bind (fun q eq _ => ?_) (fun q _ => ?_)
  · by_cases hb0 : (b != 0#u64) = true
    · rw [if_pos hb0] at eq ⊢
      have hne : b ≠ 0#u64 := by simpa using hb0
      obtain ⟨i, hi, hiv⟩ := dbg_idx8
      revert eq
      rw [hi]
      simp only [bind_ok]
      rw [msg.buf_get.guard (gS := gS) s1 b i (hbuf b eb hne i hiv).1]
      refine tr_bind_same (fun w _ => ?_)
      simp only [lift, bind_ok]
      rw [msg.buf_set.guard (gS := gS) s1 b i _ (hbuf b eb hne i hiv).2]
      exact id
    · rw [if_neg hb0] at eq ⊢; exact eq
  · obtain ⟨s3, len1⟩ := q
    simp only [uncurry_apply_pair]
    refine tr_bind_same (fun i _ => ?_)
    refine tr_bind_same (fun mi _ => ?_)
    rw [msg.set_msg_info.guard (gS := gS) s3 t _ hM]
    exact id

end g

section trun
variable {S : Type} {st : machine.Store S} [L : LawfulStore st] {A : Type} (ar : machine.Arch A)
variable {K : KLayout}

/-- **The st run of the truncated block**: from the decode state `x`, the reply is `Ok ()` and the state after it is
`KeepU` (the reply registers, and the buffer word, an aligned user word by `hbuf`). -/
theorem truncRun8 {x : S} {a : A} {t length buf slot cp cr cg cgb : U64} {ex : Aeneas.Std.Array obj.Slot 3#usize}
    (F : SchedOK (L := L) x t) (O : UsrOK (L := L) K x t) (ha : L.actionW x = sched.ACTION_RESUME_CURRENT)
    (hr : L.mem x (stA t) = sched.TS_RESTART ∨ L.mem x (stA t) = sched.TS_RUNNING) (hlen : length < 2#u64)
    (hbuf : ∀ b, msg.lookup_ipc_buffer st x true t = ok b → b ≠ 0#u64 → ∀ i : U64, i.val < 128 →
      UserW K (core.num.U64.wrapping_add b (core.num.U64.wrapping_mul i 8#u64)))
    {y : core.result.Result Unit error.Exc × S × A} {z : S × A × core.result.Result Unit error.Exc}
    (hy : syscall.decode_invocation st ar x a fl4_abi.label.CNodeDelete length slot (.CNode cp cr cg cgb)
      true true true false buf ex = ok y)
    (hz : invRep st t y.2.1 y.2.2 y.1 = ok z) : z.2.2 = .Ok () ∧ KeepU st K x t z.1 := by
  rw [decode_cnode_eq ar, cnode_decode_trunc ar st hlen] at hy
  cases ok_inj_ff hy
  unfold invRep at hz
  obtain ⟨q0, eq0, hz⟩ := bind_eq_ok hz
  cases ok_inj_ff hz
  obtain ⟨s5, es5, e5⟩ := bind_eq_ok eq0
  cases ok_inj_ff e5
  refine ⟨rfl, ?_⟩
  simp only
  unfold syscall.reply_error at es5
  obtain ⟨b, eb, es5⟩ := bind_eq_ok es5
  rw [set_reg_ok'] at es5
  simp only [bind_ok, error_mrs_trunc, uncurry_apply_pair, fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC,
    if_true] at es5
  have k1 : KeepA (L := L) x t (L.wr x (regA t layout.reg.BADGE) 0#u64) := (KeepA.refl ha hr).wr_reg F rB384
  have u1 : KeepU st K x t (L.wr x (regA t layout.reg.BADGE) 0#u64) := KeepU.of_keepA k1
  obtain ⟨q, eq, es5⟩ := bind_eq_ok es5
  have uq : KeepU st K x t q.1 := by
    by_cases hb0 : (b != 0#u64) = true
    · rw [if_pos hb0] at eq
      have hne : b ≠ 0#u64 := by simpa using hb0
      obtain ⟨i, hi, hiv⟩ := dbg_idx8
      rw [hi] at eq
      simp only [bind_ok] at eq
      obtain ⟨w, -, eq⟩ := bind_eq_ok eq
      simp only [lift, bind_ok] at eq
      obtain ⟨s4, es4, eq⟩ := bind_eq_ok eq
      cases ok_inj_ff eq
      unfold msg.buf_set at es4
      simp only [lift, bind_ok, L.write_eq] at es4
      cases ok_inj_ff es4
      have hu := hbuf b eb hne i hiv
      exact u1.users F O ((writesIn_wr hu.1).mono fun _ e => by subst e; exact hu)
    · rw [if_neg hb0] at eq
      cases ok_inj_ff eq
      exact u1
  obtain ⟨s3, len1⟩ := q
  simp only [uncurry_apply_pair] at es5 uq
  obtain ⟨i, -, es5⟩ := bind_eq_ok es5
  obtain ⟨mi, -, es5⟩ := bind_eq_ok es5
  unfold msg.set_msg_info at es5
  obtain ⟨wv, -, es5⟩ := bind_eq_ok es5
  rw [set_reg_ok'] at es5
  cases ok_inj_ff es5
  exact uq.keepA ((KeepA.refl uq.2.1 uq.2.2).wr_reg (uq.sched F O) rM384)

end trun

/-! ## The block on the guarded store, and `FinOK` -/

section blk
variable {S : Type} {st : machine.Store S} [L : LawfulStore st]
variable {K : KLayout} {T Cs Ω Sg Rp Scs Nt Ac : Set U64} {H : Heap} {Z : U64 → Nat} {s : S}

/-- (stpost gen 14) **The truncated Delete block on a store reading `IoRS s` and the aligned user words as `st`**
(run-relative): the decode (no access beyond the current-thread read) and the error reply (`reply_error`: the
buffer lookup, `BADGE`, the buffer word, `MSG_INFO`). [J] `hbuf : InvBufJ8`. -/
theorem truncAcc8 {A : Type} {ar : machine.Arch A} (hA : P0.ArchTotal ar)
    {Cs Ω Sg Ac : Set U64} {Locks : S → U64 → Prop} {p : localinv.Plan} {a : A}
    {nx : U64} {s1 s2 : S} {a1 : A} {length buf : U64} {cap : capability.Cap} {cp cr cg cgb : U64}
    {y : (core.result.Result Unit error.Exc) × S × A}
    {R W : U64 → Prop} {gS : machine.Store S} [GRd gS st R] [GWr gS st W]
    (P : IoPre st K K.heap.tcbs Cs Ω K.heap Sg K.heap.replies K.heap.scs K.heap.ntfns K.heap.scBits Ac s)
    (hR : ∀ b, IoRS (st := st) K Locks s b → R b) (hRu : ∀ b, UserW K b → R b)
    (hW : IoWr st W K.heap.scBits s) (hWu : ∀ b, UserW K b → W b)
    (hcs : obj.Slot.cap st p.slot s = ok (.CNode cp cr cg cgb)) (hsl : p.slot ∈ K.slots) (hbuf : InvBufJ8 (st := st) K s)
    (C : InvChk st ar s a (L.curW s) p nx s1 s2 a1)
    (hcap : obj.Slot.cap st p.slot s2 = ok cap) (hlen : length < 2#u64)
    (hy : syscall.decode_invocation st ar s2 a1 fl4_abi.label.CNodeDelete length p.slot cap true true true false
      buf p.extra = ok y) :
    syscall.decode_invocation gS ar s2 a1 fl4_abi.label.CNodeDelete length p.slot cap true true true false
      buf p.extra = ok y ∧
    ∀ z, invRep st (L.curW s) y.2.1 y.2.2 y.1 = ok z → invRep gS (L.curW s) y.2.1 y.2.2 y.1 = ok z := by
  obtain ⟨-, es1, eu, eac, ey, ehere, -⟩ := C
  have Ent := P.ent (Locks := Locks) (P.ioWr (Locks := Locks))
  have Hf := here_facts ehere
  have I := IoS2.of_ent hA Ent es1 eu Hf.sc
  have hct : L.curW s2 = L.curW s := I.cur
  have hL : Slot8 K := fun q hq => P.lay.slot8 q hq
  have w0 := prefix_writes ar hA P.tp P.np P.cT es1 eu
  have ag : ∀ b, SlotW K b → Aligned b → L.mem s2 b = L.mem s b := fun b hs hb => by
    obtain ⟨q, hq, hbq⟩ := hs
    exact P.slot_keep w0 hq hbq hb
  have hcap' : cap = .CNode cp cr cg cgb := by
    rw [cap_agree hL hsl ag, hcs] at hcap; exact (ok_inj_ff hcap).symm
  subst hcap'
  have tk : ∀ k : U64, k.val < 4096 → k.val % 8 = 0 → k.val ≠ 392 →
      L.mem s2 (core.num.U64.wrapping_add (L.curW s) k) = L.mem s (core.num.U64.wrapping_add (L.curW s) k) :=
    fun k h1 h2 h3 => w0.2.2 _ (field_aligned P.tA h1 h2) (preW_tcb P.tA P.np P.cT h1 h3)
  have hlb : msg.lookup_ipc_buffer st s2 true (L.curW s) = msg.lookup_ipc_buffer st s true (L.curW s) :=
    lookup_buf_keep P.tA true tk
  have hbuf2 : ∀ b, msg.lookup_ipc_buffer st s2 true (L.curW s) = ok b → b ≠ 0#u64 → ∀ i : U64, i.val < 128 →
      UserW K (core.num.U64.wrapping_add b (core.num.U64.wrapping_mul i 8#u64)) := fun b eb hne i hi =>
    hbuf b (by rw [← hlb]; exact eb) hne i hi
  have hctR : R (L.nodeAt s2 (L.cpu s2) layout.node.CUR_THREAD) := by
    rw [I.cp, nodeAt_of_ksb I.k]
    exact hR _ (P.nd layout.node.CUR_THREAD (by simp [layout.node.CUR_THREAD]) (by simp [layout.node.CUR_THREAD])).1
  rw [decode_cnode_eq ar, cnode_decode_trunc ar st hlen] at hy
  cases ok_inj_ff hy
  refine ⟨?_, fun z hz => ?_⟩
  · unfold syscall.decode_invocation
    rw [sched.cur_thread.guard (gS := gS) s2 hctR, cur_thread_ok]
    simp only [bind_ok, Bool.false_eq_true, ↓reduceIte]
    exact cnode_decode_trunc ar gS hlen
  · obtain ⟨bsl, hbsl⟩ := buffer_slot_ok (L.curW s)
    obtain ⟨hb1, hb2⟩ := P.lay.tslot _ (P.hT _ P.cT) _ bsl hbsl (by simp [layout.tcb.SLOT_BUFFER])
    have hbs := P.slot (Locks := Locks) hb1 (Or.inl hb2)
    have hI : R (core.num.U64.wrapping_add (L.curW s) 3512#u64) :=
      hR _ (P.gate (off := 3512#u64) P.cT (by simp) (by simp) (by simp) (by simp [GateField]))
    have hlk := msg.lookup_ipc_buffer.guard (gS := gS) s2 true (L.curW s) hbsl hI (hR _ hbs.1) (hR _ hbs.2)
    unfold invRep at hz ⊢
    revert hz
    refine tr_bind (fun q e _ => ?_) (fun _ _ h => h)
    revert e
    exact tr_bind (fun s5 e _ => syscall.reply_error.guard_trunc8 (gS := gS) hlk (hW.reg _ rB384) (hW.reg _ rM384)
      (fun b eb hne i hi => ⟨hRu _ (hbuf2 b eb hne i hi), hWu _ (hbuf2 b eb hne i hi)⟩) e) (fun _ _ h => h)

set_option maxHeartbeats 4000000 in
/-- (stpost gen 14) **`FinOK` after the truncated Delete block** (delFin's route, with the buffer word an aligned
user word written instead of slot words): reply `Ok ()`. [J] `hbuf : InvBufJ8`. -/
theorem truncFin8 {A : Type} {ar : machine.Arch A} (hA : P0.ArchTotal ar)
    {Cs Ω Sg Ac : Set U64} {Locks : S → U64 → Prop} {p : localinv.Plan} {a : A}
    {nx : U64} {s1 s2 : S} {a1 : A} {length buf : U64} {cap : capability.Cap} {cp cr cg cgb : U64}
    {y : (core.result.Result Unit error.Exc) × S × A} {z : S × A × core.result.Result Unit error.Exc}
    {W : U64 → Prop} {gS : machine.Store S} [GRd gS st (IoRS (st := st) K Locks s)] [GWr gS st W]
    (P : IoPre st K K.heap.tcbs Cs Ω K.heap Sg K.heap.replies K.heap.scs K.heap.ntfns K.heap.scBits Ac s)
    (hW : IoWr st W K.heap.scBits s) (hsw : SWr gS st (L.curW s) sched.TS_RUNNING)
    (hcs : obj.Slot.cap st p.slot s = ok (.CNode cp cr cg cgb)) (hsl : p.slot ∈ K.slots) (hbuf : InvBufJ8 (st := st) K s)
    (C : InvChk st ar s a (L.curW s) p nx s1 s2 a1)
    (hcap : obj.Slot.cap st p.slot s2 = ok cap) (hlen : length < 2#u64)
    (hy : syscall.decode_invocation st ar s2 a1 fl4_abi.label.CNodeDelete length p.slot cap true true true false
      buf p.extra = ok y)
    (hz : invRep st (L.curW s) y.2.1 y.2.2 y.1 = ok z) :
    z.2.2 = .Ok () ∧ FinOK (L := L) gS (IoRS (st := st) K Locks s) W ar s z.1 z.2.1 := by
  obtain ⟨-, es1, eu, eac, ey, ehere, -⟩ := C
  have Ent := P.ent (Locks := Locks) hW
  have Hf := here_facts ehere
  have I := IoS2.of_ent hA Ent es1 eu Hf.sc
  have hct : L.curW s2 = L.curW s := I.cur
  have hL : Slot8 K := fun q hq => P.lay.slot8 q hq
  have w0 := prefix_writes ar hA P.tp P.np P.cT es1 eu
  have ag : ∀ b, SlotW K b → Aligned b → L.mem s2 b = L.mem s b := fun b hs hb => by
    obtain ⟨q, hq, hbq⟩ := hs
    exact P.slot_keep w0 hq hbq hb
  have hcap' : cap = .CNode cp cr cg cgb := by
    rw [cap_agree hL hsl ag, hcs] at hcap; exact (ok_inj_ff hcap).symm
  subst hcap'
  have tk : ∀ k : U64, k.val < 4096 → k.val % 8 = 0 → k.val ≠ 392 →
      L.mem s2 (core.num.U64.wrapping_add (L.curW s) k) = L.mem s (core.num.U64.wrapping_add (L.curW s) k) :=
    fun k h1 h2 h3 => w0.2.2 _ (field_aligned P.tA h1 h2) (preW_tcb P.tA P.np P.cT h1 h3)
  have hlb : msg.lookup_ipc_buffer st s2 true (L.curW s) = msg.lookup_ipc_buffer st s true (L.curW s) :=
    lookup_buf_keep P.tA true tk
  have hbuf2 : ∀ b, msg.lookup_ipc_buffer st s2 true (L.curW s) = ok b → b ≠ 0#u64 → ∀ i : U64, i.val < 128 →
      UserW K (core.num.U64.wrapping_add b (core.num.U64.wrapping_mul i 8#u64)) := fun b eb hne i hi =>
    hbuf b (by rw [← hlb]; exact eb) hne i hi
  have ha2 : L.actionW s2 = sched.ACTION_RESUME_CURRENT := by
    rw [eq_of_spec_fd (sched.action.spec (L := L) s2)] at eac; exact ok_inj_ff eac
  have hy2 : L.mem s2 (yieldA (L.curW s)) = 0#u64 := by
    rw [eq_ok_of_spec (obj.Tcb.yield_to.spec (L := L) s2 (L.curW s))] at ey; exact ok_inj_ff ey
  have hrun : L.mem s2 (stA (L.curW s)) = sched.TS_RESTART ∨ L.mem s2 (stA (L.curW s)) = sched.TS_RUNNING := by
    rw [I.st]; exact Ent.run
  have A0 := Ent.acc
  have hK0 := SchedOK.of_sw I.F (by rw [hct]; exact Hf.sc) (by rw [hct]; exact Hf.nr)
  rw [hct] at hK0
  have hK : SchedOK (L := L) s2 (L.curW s) := hK0
  have hn2 : ∀ o : U64, o.val < 4288 → ¬ UserW K (L.nodeAt s2 (L.cpu s2) o) := fun o ho => by
    rw [I.cp, nodeAt_of_ksb I.k]; exact P.node_notUser ho
  have hmx : ¬ UserW K (maxA (L.mem s2 (scA (L.curW s)))) := by
    rw [← hct, I.F.i]
    exact P.sc_notUser (P.hSc _ P.cscS) I.F.q.2.2.2.1
  have O : UsrOK (L := L) K s2 (L.curW s) :=
    ⟨hn2, fun k h1 h2 => P.tcb_notUser (P.hT _ P.cT) h1 h2, hmx⟩
  obtain ⟨hz2, kz⟩ := truncRun8 ar hK O ha2 hrun hlen hbuf2 hy hz
  refine ⟨hz2, ?_⟩
  have hrh0 : L.mem s (rhA (L := L) s) ≠ 0#u64 → L.mem s (scA (L.mem s (rhA (L := L) s))) ∈ K.heap.scs ∧
      InSC (L.mem s (scA (L.mem s (rhA (L := L) s)))) (K.heap.scBits (L.mem s (scA (L.mem s (rhA (L := L) s)))))
        (headA (L.mem s (scA (L.mem s (rhA (L := L) s))))) := fun h0 => by
    obtain ⟨-, hc, -⟩ := bxi_rh P.bxi h0
    obtain ⟨⟨Q, Rq, hq⟩, hbd, ⟨hO, -, hX⟩, -, hS⟩ := P.bxi
    obtain ⟨hP, hz⟩ := hO.sc _ hc
    obtain ⟨h8, h128, -⟩ := sc_lo hP hz
    have hh := headA_val' hP hz
    exact ⟨hc, by omega, by omega⟩
  have F0' := I.F0.shrink P.cscS rfl hrh0
  have F2' := F0'.frame I.w
  have rh0' : RhSc st {b | b ∈ Ω ∧ ∃ c' ∈ K.heap.scs, InSC c' (K.heap.scBits c') b} s := fun h0 => by
    obtain ⟨-, hc, ha⟩ := bxi_rh P.bxi h0
    obtain ⟨hW', hΩ⟩ := bxi_scin P.bxi hc ha
    exact ⟨_, hW', fun b hb hin => ⟨hΩ b hb hin, _, hc, hin⟩⟩
  have rh2' := rh0'.frame F0' I.w
  have Q0 := QOK.of_sw F2' rh2' I.tm
  rw [hct] at Q0
  have ho' : ∀ b ∈ {b | b ∈ Ω ∧ ∃ c' ∈ K.heap.scs, InSC c' (K.heap.scBits c') b}, ¬ UserW K b := by
    rintro b ⟨-, c', hc', hin⟩
    exact P.sc_notUser (P.hSc _ hc') hin
  have stm : L.mem s2 (tmA (L := L) s2) ≠ 0#u64 → ¬ UserW K (tdA (L.mem s2 (tmA (L := L) s2))) := fun h0 => by
    unfold tdA
    exact P.tcb_notUser (I.tm h0) (by simp) (by simp)
  have srh : L.mem s2 (rhA (L := L) s2) ≠ 0#u64 → ¬ UserW K (scA (L.mem s2 (rhA (L := L) s2))) ∧
      ¬ UserW K (headA (L.mem s2 (scA (L.mem s2 (rhA (L := L) s2))))) ∧
      ¬ UserW K (rtA (L.mem s2 (scA (L.mem s2 (rhA (L := L) s2))))
        (L.rhead s2 (L.mem s2 (scA (L.mem s2 (rhA (L := L) s2)))))) := fun h0 => by
    refine ⟨?_, ?_⟩
    · unfold scA; exact P.tcb_notUser (F2'.rh h0).1 (by simp) (by simp)
    obtain ⟨zr, hW', hΩ⟩ := rh2' h0
    obtain ⟨h8, hmm, hfit⟩ := hW'.bounds
    obtain ⟨h96, -, -, hhd, -, hrt⟩ := hW'.inside
    obtain ⟨e1, e2, e3⟩ := hrt _ hW'.head_lt
    exact ⟨ho' _ (hΩ _ (by unfold Aligned; omega) ⟨by omega, by omega⟩),
      ho' _ (hΩ _ (by unfold Aligned; omega) ⟨by omega, by omega⟩)⟩
  have FIN := kz.fin hK O Q0 Hf.nd I.F.td I.F.rs stm srh
  have hcur3 : L.curW z.1 = L.curW s := kz.cur hK O
  have w3 : WritesIn st s2 z.1 (fun b => IoPW st s2 b ∨ UserW K b) :=
    kz.1.mono fun b hb => hb.imp_left fun h => Or.inr (by rw [hct]; exact h)
  have Fz := F2'.frameU w3 hn2 (fun t ht k h1 h2 => P.tcb_notUser ht (by omega) h2) ho'
  refine FinOK.of_sw hA (kz.1.1.trans I.k) (kz.1.2.1.trans I.cp) FIN.1 kz.2.1 Fz ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    (by rw [hcur3]; exact hsw)
  · rw [hcur3]
    exact (kz.tcbF hK O (k := 3472#u64) (by simp) (by simp) (by simp)).trans hy2
  · rw [hcur3]; exact kz.2.2
  · rw [hcur3]; exact A0.ryl
  · rw [hcur3]; exact A0.rst
  · rw [hcur3]; exact A0.rfi
  · rw [hcur3]; exact A0.wnx
  · rw [hcur3]; exact A0.rin


end blk

/-! ## Both arms of the uncut decode block -/

section arm
variable {S : Type} {st : machine.Store S} [L : LawfulStore st]

/-- (stpost gen 14) **`InvBlkUW2` for the uncut CNodeDelete arm** at `Pre := SlJAt K ∧ InvQF`: `length ≥ 2` by
`delAcc` / `delFin` (the `IoRS` / `IoWS` words are user-word-set words), `length < 2` by `truncAcc8` / `truncFin8`;
from [J] `hvs`, [J] `hcdt`, [J] `hz`, [J] `hbuf`. -/
theorem invBlkUW2_of8 {A : Type} {ar : machine.Arch A} (hA : P0.ArchTotal ar) {Cs Ω Sg Ac : Set U64}
    {Locks : S → U64 → Prop} {p : localinv.Plan} {K : KLayout} {μ : U64 → U64}
    (hvs : InvVsJ st K (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s))
    (hcdt : InvCdtJ st K (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s))
    (hz : ∀ s, SlJAt (L := L) K s → (0#u64) ∉ K.slots)
    (hbuf : ∀ s, SlJAt (L := L) K s → InvQF st Cs Ω Sg Ac Locks p K μ s → InvBufJ8 (st := st) K s) :
    InvBlkUW2 st ar p K Locks (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s) := by
  intro s a info nx s1 s2 a1 buf length cap hE emi C hl hcap y hy
  have hqf := hE.2
  have PE := hqf.1.1.1
  obtain ⟨cp, cr, cg, cgb, -, -, -, -, -, -, -, hcs, hsK, -⟩ := del_core hqf
  have hlbl := (hqf.1.2.2.1 (L.curW s) info (cur_thread_ok s) emi).1
  rw [hlbl] at hy ⊢
  by_cases hlen : length < 2#u64
  · obtain ⟨hdec, hrep⟩ := truncAcc8 (gS := (guard st (InvCMRS (st := st) K Locks s) (InvCMWS (st := st) K Locks s))) hA PE
      (fun _ h => ioRS_cm h) (fun _ h => ⟨h.1, Or.inl h.2⟩) (PE.ioWr.mono (fun _ h => ioWS_cm h))
      (fun _ h => ⟨h.1, Or.inl h.2⟩) hcs hsK (hbuf s hE.1 hqf) C hcap hlen hy
    refine ⟨hdec, fun z hz' => ?_⟩
    haveI : GRd (guard st (InvCMRS (st := st) K Locks s) (InvCMWS (st := st) K Locks s)) st
        (IoRS (st := st) K Locks s) := grd_sub (fun _ hy => ioRS_cm hy)
    obtain ⟨h1, h2⟩ := truncFin8 (gS := (guard st (InvCMRS (st := st) K Locks s) (InvCMWS (st := st) K Locks s))) hA PE
      (PE.ioWr.mono (fun _ h => ioWS_cm h)) (SWr.of_W (ioWS_cm PE.stw.2)) hcs hsK (hbuf s hE.1 hqf) C hcap hlen hy hz'
    exact ⟨hrep z hz', h1, h2⟩
  · have E := delEnt_of (P := fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s) hE hqf hvs hcdt
      (hz s hE.1)
    haveI : GRd (guard st (InvCMRS (st := st) K Locks s) (InvCMWS (st := st) K Locks s)) st
        (IoRS (st := st) K Locks s) := grd_sub (fun _ hy => ioRS_cm hy)
    obtain ⟨hdec, hrep⟩ := delAcc (gS := (guard st (InvCMRS (st := st) K Locks s) (InvCMWS (st := st) K Locks s))) hA PE
      (PE.ioWr.mono (fun _ h => ioWS_cm h)) (fun _ h => ioWS_cm h) E hsK hlen
      (fun sl fp rt asid va hsl hc hA => hvs s sl fp rt asid va hE hsl hc hA) C hcap hy
    refine ⟨hdec, fun z hz' => ?_⟩
    obtain ⟨h1, h2⟩ := delFin (gS := (guard st (InvCMRS (st := st) K Locks s) (InvCMWS (st := st) K Locks s))) hA PE
      (PE.ioWr.mono (fun _ h => ioWS_cm h)) (ioWS_cm PE.stw.2) E hsK hlen
      (fun sl fp rt asid va hsl hc hA => hvs s sl fp rt asid va hE hsl hc hA) C hcap hy hz'
    exact ⟨hrep z hz', h1, h2⟩

/-- (stpost gen 14) **`InvBlkGdUW2` for the uncut CNodeDelete arm** (as `invBlkUW2_of8`, on
`gd st (InvCMRS s) (PWs …)`: `delAcc2` / `delFin2`, `truncAcc8` / `truncFin8`; a user word is an aligned word deciding
no owner, so `PW` allows its write). -/
theorem invBlkGdUW2_of8 {A : Type} {ar : machine.Arch A} (hA : P0.ArchTotal ar) {Cs Ω Sg Ac : Set U64}
    {Locks : S → U64 → Prop} {p : localinv.Plan} {K : KLayout} {μ : U64 → U64}
    (hvs : InvVsJ st K (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s))
    (hcdt : InvCdtJ st K (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s))
    (hz : ∀ s, SlJAt (L := L) K s → (0#u64) ∉ K.slots)
    (hbuf : ∀ s, SlJAt (L := L) K s → InvQF st Cs Ω Sg Ac Locks p K μ s → InvBufJ8 (st := st) K s) :
    InvBlkGdUW2 st ar p K Locks (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s) := by
  intro s a info nx s1 s2 a1 buf length cap hE emi C hl hcap y hy
  have hqf := hE.2
  have PE := hqf.1.1.1
  have hK := hE.1.regionOK
  have hU := hE.1.userOK
  have hLA := hE.1.ioLayA
  obtain ⟨cp, cr, cg, cgb, -, -, -, -, -, -, -, hcs, hsK, -⟩ := del_core hqf
  have hlbl := (hqf.1.2.2.1 (L.curW s) info (cur_thread_ok s) emi).1
  rw [hlbl] at hy ⊢
  have hW := mvWrS PE hK hLA (c := L.cpu s) (lk := Locks s) (m := L.mem s)
  have hS0 : OwnMap.Safe0 (L.cpu s) (Locks s) (L.mem s) (L.curW s) := by
    refine ⟨?_, fun hq => absurd hq ?_⟩
    · rw [← OwnMap.affA_fld]; exact PE.curAff
    · rw [← OwnMap.stA_fld]; exact nq_run PE.run
  have hst : ∀ v, v = sched.TS_RESTART ∨ v = sched.TS_RUNNING →
      SWr (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s))) st (L.curW s) v :=
    fun v hv X => OwnMap.gds_write_state (PE.hT _ PE.cT) hS0 (fun hq => absurd hq (nq_run hv))
  have hWu : ∀ b, UserW K b → WAll (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s)) b :=
    fun b hb _ _ => Or.inl (Or.inl ⟨hb.1, fun hd => (OwnMap.decW_ok hU hd).2 hb.2⟩)
  by_cases hlen : length < 2#u64
  · obtain ⟨hdec, hrep⟩ := truncAcc8 (gS := (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s)))) hA PE
      (fun _ h => ioRS_cm h) (fun _ h => ⟨h.1, Or.inl h.2⟩) hW hWu hcs hsK (hbuf s hE.1 hqf) C hcap hlen hy
    refine ⟨hdec, fun z hz' => ?_⟩
    haveI : GRd (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s))) st
        (IoRS (st := st) K Locks s) := gdr_sub (fun _ hy => ioRS_cm hy)
    obtain ⟨h1, h2⟩ := truncFin8 (gS := (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s)))) hA PE
      hW (hst _ (Or.inr rfl)) hcs hsK (hbuf s hE.1 hqf) C hcap hlen hy hz'
    exact ⟨hrep z hz', h1, h2⟩
  · have E := delEnt_of (P := fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K μ s) hE hqf hvs hcdt
      (hz s hE.1)
    haveI : GRd (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s))) st
        (IoRS (st := st) K Locks s) := gdr_sub (fun _ hy => ioRS_cm hy)
    have hwS : ∀ q o, q ∈ K.slots → Locks s q → o.val < 32 → o.val % 8 = 0 → 8 ≤ o.val →
        (16 ≤ o.val ∨ (¬ TcbSlot K q ∧ NullOrFrame (L.mem s q))) →
        WAll (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s)) (core.num.U64.wrapping_add q o) := by
      intro q o hq _ ho h8 h8' _
      obtain ⟨q8, qf⟩ := PE.lay.slot8 q hq
      have hv := slot_word_val qf ho
      have hr := PE.lay.slotw q hq _ (slot_inW qf ho)
      have hne : core.num.U64.wrapping_add q o ≠ q := fun e => by
        have := congrArg UScalar.val e; rw [hv] at this; omega
      have ha : Aligned (core.num.U64.wrapping_add q o) := by unfold Aligned; rw [hv]; omega
      exact fun _ _ => Or.inl (Or.inl ⟨ha, OwnMap.nondec_slotw hK hr hne⟩)
    have hw0 : ∀ q, q ∈ K.slots → Locks s q → ¬ TcbSlot K q → NullOrFrame (L.mem s q) →
        ∀ x, (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s))).write x q 0#u64 = st.write x q 0#u64 :=
      fun q hq hl hT hn x => OwnMap.gds_write_cap0 hq hT hl hn OwnMap.nof_zero
    obtain ⟨hdec, hrep⟩ := delAcc2 (gS := (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s)))) hA PE hW hwS hw0 hst E hsK hlen
      (fun sl fp rt asid va hsl hc hA => hvs s sl fp rt asid va hE hsl hc hA) C hcap hy
    refine ⟨hdec, fun z hz' => ?_⟩
    obtain ⟨h1, h2⟩ := delFin2 (gS := (gd st (InvCMRS (st := st) K Locks s) (OwnMap.PWs (L := L) K (L.cpu s) (Locks s) (L.mem s)))) hA PE hW (hst _ (Or.inr rfl)) E hsK hlen
      (fun sl fp rt asid va hsl hc hA => hvs s sl fp rt asid va hE hsl hc hA) C hcap hy hz'
    exact ⟨hrep z hz', h1, h2⟩

end arm

section paths
variable {S : Type} {st : machine.Store S} [L : LawfulStore st]
variable {Cs Ω Sg Ac : Set U64} {Locks : S → U64 → Prop}
variable {A : Type}

/-- (stpost gen 14) **The uncut CNodeDelete local path** (`Q := InvQF`, truncated Deletes included): `inv_pathsKDelU`
with `hacc` from `invUAccW_of2` + `invBlkUW2_of8`, `hdec` / `hra` from `invDecW_of` / `invRaW_of` (`hSeen` from
`invSeen_of`), `hmv` from `invMoveW_ofU` + `invBlkGdUW2_of8`, `hps` from `invPs_of`. Premises: `hA`, [P] `hm`,
[J] `hvs : InvVsJ`, [J] `hcdt : InvCdtJ`, [J] `hz`, [J] `hbuf : InvBufJ8`, [J] `huf`, `hpz` ([P] IsProgOn ∧ [W] NoZero ∧
[W] InvRoW ∧ [W] InvURoAccW). -/
noncomputable def inv_pathsKFU8 (ar : machine.Arch A) (hA : P0.ArchTotal ar) (number : I64) (p : localinv.Plan)
    (hm : E2E.MasksWr st)
    (hvs : ∀ K m, InvVsJ st K (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K m s))
    (hcdt : ∀ K m, InvCdtJ st K (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K m s))
    (hz : ∀ K s, SlJAt (L := L) K s → (0#u64) ∉ K.slots)
    (hbuf : ∀ K m s, SlJAt (L := L) K s → InvQF st Cs Ω Sg Ac Locks p K m s → InvBufJ8 (st := st) K s)
    (huf : ∀ K m s b v, SlJAt (L := L) K s → InvQF st Cs Ω Sg Ac Locks p K m s → b ∈ K.user → Aligned b →
      (SlJAt (L := L) K (L.wr s b v) ∧ InvQF st Cs Ω Sg Ac Locks p K m (L.wr s b v)) ∧ Locks (L.wr s b v) = Locks s ∧
        IoRS (st := st) K Locks (L.wr s b v) = IoRS (st := st) K Locks s ∧
        IoWS (st := st) K Locks (L.wr s b v) = IoWS (st := st) K Locks s ∧
        IoDS (st := st) (L.wr s b v) = IoDS (st := st) s)
    (hpz : ∀ K m, ∃ q : SProg Bool, IsProgOn (fun m s a => syscall.handle_invocation_local m ar s a number p) ar st
      (AltOf st (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K m s) (IoRS (st := st) K Locks)
        (OwnMap.cls K) (OwnMap.ko K m) (· ∈ K.user)) q ∧ NoZero q ∧
      InvRoW st ar number p K Locks m q (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K m s) ∧
      InvURoAccW st ar number p K Locks m q (fun s => SlJAt (L := L) K s ∧ InvQF st Cs Ω Sg Ac Locks p K m s)) :
    E2E.Paths Unit :=
  inv_pathsKDelU ar hA number p hm (InvQF st Cs Ω Sg Ac Locks p) (fun _ _ _ _ hq => hq.1.1.1)
    (fun K m => invUAccW_of2 hA (fun _ h => h.2.1.1.1)
      (fun s h => invSeen_of (fun K _ s hJ _ => hz K s hJ) K m s h.1 h.2)
      (fun s h => invPs_of K m s h.1 h.2) (invBlkUW2_of8 hA (hvs K m) (hcdt K m) (hz K) (hbuf K m)))
    (fun K m => invDecW_of hA (fun _ h => h.1.regionOK) (fun _ h => h.1.ioLayA) (fun _ h => h.2.1.1.1)
      (fun s h => invSeen_of (fun K _ s hJ _ => hz K s hJ) K m s h.1 h.2))
    (fun K m => invMoveW_ofU hA (fun _ h => h.1.regionOK) (fun _ h => h.1.userOK) (fun _ h => h.1.ioLayA)
      (fun _ h => h.2.1.1.1) (fun s h => invSeen_of (fun K _ s hJ _ => hz K s hJ) K m s h.1 h.2)
      (fun s h => invPs_of K m s h.1 h.2) (fun _ h => h.2.1.1.2) (hpz K m).choose_spec.1
      (invBlkGdUW2_of8 hA (hvs K m) (hcdt K m) (hz K) (hbuf K m)))
    (fun K m => invRaW_of hA (fun _ h => h.2.1.1.1)
      (fun s h => invSeen_of (fun K _ s hJ _ => hz K s hJ) K m s h.1 h.2))
    huf hpz

end paths

end Fl4Proofs.P2.PathObl
