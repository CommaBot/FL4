@[irreducible] noncomputable def R.cdt.ensure_no_children (slot : obj.Slot) : SProg (core.result.Result Unit error.Exc) := do
  let next ← R.obj.Slot.next slot
  let b ← SProg.liftR (obj.Slot.is_null next)
  if b then do
    pure ((core.result.Result.Ok ()))
  else do
    let b1 ← R.cdt.is_mdb_parent_of slot next
    if b1 then do
      pure ((core.result.Result.Err (error.Exc.Sys error.SysError.RevokeFirst)))
    else do
      pure ((core.result.Result.Ok ()))

