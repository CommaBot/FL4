@[irreducible] noncomputable def R.cspace.lookup_slot_for_cnode_op (is_source : Bool) (root : capability.Cap) (cptr : Std.U64) (depth : Std.U64) : SProg (core.result.Result obj.Slot error.Exc) := do
  let b ← SProg.blk 0 (
      match root with
      | capability.Cap.Null => do
          pure (false)
      | capability.Cap.Untyped _ _ _ _ => do
          pure (false)
      | capability.Cap.Endpoint _ _ _ _ _ _ => do
          pure (false)
      | capability.Cap.Notification _ _ _ _ => do
          pure (false)
      | capability.Cap.Reply _ _ => do
          pure (false)
      | capability.Cap.CNode _ _ _ _ => do
          pure (true)
      | capability.Cap.Thread _ => do
          pure (false)
      | capability.Cap.IrqControl => do
          pure (false)
      | capability.Cap.IrqHandler _ => do
          pure (false)
      | capability.Cap.Zombie _ _ _ => do
          pure (false)
      | capability.Cap.Domain => do
          pure (false)
      | capability.Cap.SchedContext _ _ => do
          pure (false)
      | capability.Cap.SchedControl _ => do
          pure (false)
      | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
          pure (false)
      | capability.Cap.PageTable _ _ _ _ => do
          pure (false)
      | capability.Cap.PageDirectory _ _ _ _ => do
          pure (false)
      | capability.Cap.Pdpt _ _ _ _ => do
          pure (false)
      | capability.Cap.Pml4 _ _ _ => do
          pure (false)
      | capability.Cap.Vcpu _ => do
          pure (false)
      | capability.Cap.Ept _ _ _ _ _ => do
          pure (false)
      | capability.Cap.AsidControl => do
          pure (false)
      | capability.Cap.AsidPool _ _ => do
          pure (false)
      | capability.Cap.IoPortControl => do
          pure (false)
      | capability.Cap.IoPort _ _ _ => do
          pure (false)
      | capability.Cap.TdxControl => do
          pure (false))
  if b then do
    if depth < 1#u64 then do
      pure ((core.result.Result.Err (error.Exc.Sys (error.SysError.RangeError 1#u64 cspace.WORD_BITS))))
    else do
      if depth > cspace.WORD_BITS then do
        pure ((core.result.Result.Err (error.Exc.Sys (error.SysError.RangeError 1#u64 cspace.WORD_BITS))))
      else do
        let r ← R.cspace.resolve_address_bits root cptr depth
        match r with
        | core.result.Result.Ok r1 => do
            if r1.bits_left != 0#u64 then do
              pure ((core.result.Result.Err (error.Exc.Sys (error.SysError.FailedLookup is_source (error.LookupFault.DepthMismatch 0#u64 r1.bits_left)))))
            else do
              pure ((core.result.Result.Ok r1.slot))
        | core.result.Result.Err lf => do
            pure ((core.result.Result.Err (error.Exc.Sys (error.SysError.FailedLookup is_source lf))))
  else do
    pure ((core.result.Result.Err (error.Exc.Sys (error.SysError.FailedLookup is_source error.LookupFault.InvalidRoot))))

