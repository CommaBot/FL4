@[irreducible] noncomputable def R.syscall.reply_error (t : obj.Tcb) (e : error.SysError) : SProg Unit := do
  let buf ← R.msg.lookup_ipc_buffer true t
  let _ ← R.obj.Tcb.set_reg t layout.reg.BADGE 0#u64
  let len ← R.syscall.error_mrs t buf e
  let len1 ← SProg.blk 0 (
      if fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC then do
        if buf != 0#u64 then do
          do
            let i ← SProg.liftR (syscall.DEBUG_MESSAGE_START + 1#u64)
            let w ← R.msg.buf_get buf i
            let i1 ← pure ((~~~ 255#u64))
            let i2 ← pure ((w &&& i1))
            let _ ← R.msg.buf_set buf i i2
            let len2 ← pure ((core.num.U64.wrapping_add len 1#u64))
            pure (len2)
        else do
          pure (len)
      else do
        pure (len))
  let i ← SProg.liftR (error.SysError.code e)
  let mi ← SProg.liftR (msginfo.MessageInfo.new i 0#u64 0#u64 len1)
  R.msg.set_msg_info t mi

