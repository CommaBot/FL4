@[irreducible] noncomputable def R.cspace.lookup_slot (thread : obj.Tcb) (cptr : Std.U64) : SProg (core.result.Result cspace.Resolved error.LookupFault) := do
  let s1 ← SProg.liftR (obj.Tcb.slot thread layout.tcb.SLOT_CTABLE)
  let root ← R.obj.Slot.cap s1
  R.cspace.resolve_address_bits root cptr cspace.WORD_BITS

