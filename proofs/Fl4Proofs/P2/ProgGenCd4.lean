@[irreducible] noncomputable def R.cnode.rotate_slots (buf : Std.U64) (extra : Array obj.Slot 3#usize) (dest : obj.Slot) : SProg (core.result.Result (obj.Slot × obj.Slot) error.Exc) := do
  let ct ← R.sched.cur_thread
  let pivot_index ← R.msg.syscall_arg ct buf 3#u64
  let pivot_depth ← R.msg.syscall_arg ct buf 4#u64
  let src_index ← R.msg.syscall_arg ct buf 6#u64
  let src_depth ← R.msg.syscall_arg ct buf 7#u64
  let s1 ← SProg.liftR (Array.index_usize extra 0#usize)
  let pivot_root ← R.obj.Slot.cap s1
  let s2 ← SProg.liftR (Array.index_usize extra 1#usize)
  let src_root ← R.obj.Slot.cap s2
  let r ← R.cspace.lookup_source_slot src_root src_index src_depth
  let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val => do
      let r1 ← R.cspace.lookup_pivot_slot pivot_root pivot_index pivot_depth
      let cf1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r1)
      match cf1 with
      | core.ops.control_flow.ControlFlow.Continue val1 => do
          let b ← SProg.liftR (obj.Slot.Insts.CoreCmpPartialEqSlot.eq val1 val)
          if b then do
            SProg.liftR (error.illegal (obj.Slot × obj.Slot))
          else do
            let b1 ← SProg.liftR (obj.Slot.Insts.CoreCmpPartialEqSlot.eq val1 dest)
            if b1 then do
              SProg.liftR (error.illegal (obj.Slot × obj.Slot))
            else do
              let b2 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Slot.Insts.CoreCmpPartialEqSlot val dest)
              if b2 then do
                let r2 ← R.cdt.ensure_empty_slot dest
                let cf2 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r2)
                match cf2 with
                | core.ops.control_flow.ControlFlow.Continue _ => do
                    let c ← R.obj.Slot.cap val
                    let b3 ← SProg.liftR (capability.Cap.is_null c)
                    if b3 then do
                      SProg.liftR (cnode.missing_source (obj.Slot × obj.Slot) src_depth true)
                    else do
                      let c1 ← R.obj.Slot.cap val1
                      let b4 ← SProg.liftR (capability.Cap.is_null c1)
                      if b4 then do
                        SProg.liftR (cnode.missing_source (obj.Slot × obj.Slot) pivot_depth false)
                      else do
                        pure ((core.result.Result.Ok (val, val1)))
                | core.ops.control_flow.ControlFlow.Break residual => do
                    SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual (obj.Slot × obj.Slot) (core.convert.FromSame error.Exc) residual)
              else do
                let c ← R.obj.Slot.cap val
                let b3 ← SProg.liftR (capability.Cap.is_null c)
                if b3 then do
                  SProg.liftR (cnode.missing_source (obj.Slot × obj.Slot) src_depth true)
                else do
                  let c1 ← R.obj.Slot.cap val1
                  let b4 ← SProg.liftR (capability.Cap.is_null c1)
                  if b4 then do
                    SProg.liftR (cnode.missing_source (obj.Slot × obj.Slot) pivot_depth false)
                  else do
                    pure ((core.result.Result.Ok (val, val1)))
      | core.ops.control_flow.ControlFlow.Break residual => do
          SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual (obj.Slot × obj.Slot) (core.convert.FromSame error.Exc) residual)
  | core.ops.control_flow.ControlFlow.Break residual => do
      SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual (obj.Slot × obj.Slot) (core.convert.FromSame error.Exc) residual)

