@[irreducible] noncomputable def R.cdt.move_cap (new_cap : capability.Cap) (src : obj.Slot) (dest : obj.Slot) : SProg Unit := do
  let prev ← R.obj.Slot.prev src
  let next ← R.obj.Slot.next src
  let revocable ← R.obj.Slot.revocable src
  let first_badged ← R.obj.Slot.first_badged src
  let _ ← R.obj.Slot.set_cap dest new_cap
  let _ ← R.obj.Slot.set_prev dest prev
  let _ ← R.obj.Slot.set_next_flags dest next revocable first_badged
  let _ ← R.obj.Slot.clear src
  let b ← SProg.liftR (obj.Slot.is_null prev)
  let _ ← SProg.blk 0 (
      if b then do
        pure (())
      else do
        R.obj.Slot.set_next prev dest)
  let b1 ← SProg.liftR (obj.Slot.is_null next)
  if b1 then do
    pure (())
  else do
    R.obj.Slot.set_prev next dest

