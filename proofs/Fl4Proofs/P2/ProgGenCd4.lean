/-- The measure of `endpoint.cancel_badged_sends_loop` drops at every `cont` step, on every store. -/
theorem R.endpoint.cancel_badged_sends_loop.body_dec (ep_ptr : Std.U64) (badge : Std.U64) (s : S) (t : obj.Tcb) (fuel : Std.U64) {σ0}
    (h : fl4_core.endpoint.cancel_badged_sends_loop.body mS ep_ptr badge s t fuel = ok (.cont σ0)) :
    (fun xL => xL.2.val) ((fun (σ0 : S × obj.Tcb × Std.U64) => ((σ0.2.1, σ0.2.2), σ0.1)) σ0).1 < (fun xL => xL.2.val) (t, fuel) := by
  simp only [fl4_core.endpoint.cancel_badged_sends_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.endpoint.cancel_badged_sends_loop (ep_ptr : Std.U64) (badge : Std.U64) (t : obj.Tcb) (fuel : Std.U64) : SProg Unit :=
