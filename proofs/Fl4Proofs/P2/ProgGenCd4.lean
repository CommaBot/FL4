@[irreducible] noncomputable def R.endpoint.cancel_all_ipc_loop.body (ep_ptr : Std.U64) (t : obj.Tcb) (fuel : Std.U64) : SProg (ControlFlow (obj.Tcb × Std.U64) Unit) := do
  let b ← SProg.liftR (obj.Tcb.is_null t)
  if b then do
    pure (.done ())
  else do
    if fuel > 0#u64 then do
      let fuel1 ← SProg.liftR (fuel - 1#u64)
      let next ← R.tcbqueue.next_of tcbqueue.Link.Ep t
      let _ ← R.endpoint.ep_dequeue ep_ptr t
      let i ← R.obj.Tcb.state t
      let _ ← SProg.blk 0 (
          if i = sched.TS_BLOCKED_ON_RECV then do
            do
              let i1 ← R.obj.Tcb.reply_obj t
              if i1 != 0#u64 then do
                R.ipc.reply_unlink i1 t
              else do
                pure (())
          else do
            pure (()))
      let _ ← R.endpoint.restart_thread_if_no_fault t
      pure (.cont (next, fuel1))
    else do
      pure (.done ())

