@[irreducible] noncomputable def R.endpoint.cancel_badged_sends_loop.body (ep_ptr : Std.U64) (badge : Std.U64) (t : obj.Tcb) (fuel : Std.U64) : SProg (ControlFlow (obj.Tcb × Std.U64) Unit) := do
  let b ← SProg.liftR (obj.Tcb.is_null t)
  if b then do
    pure (.done ())
  else do
    if fuel > 0#u64 then do
      let fuel1 ← SProg.liftR (fuel - 1#u64)
      let next ← R.tcbqueue.next_of tcbqueue.Link.Ep t
      let i ← R.obj.Tcb.block_badge t
      if i = badge then do
        let _ ← R.endpoint.ep_dequeue ep_ptr t
        let _ ← R.endpoint.restart_thread_if_no_fault t
        pure (.cont (next, fuel1))
      else do
        pure (.cont (next, fuel1))
    else do
      pure (.done ())

@[reif_simps] theorem R.endpoint.cancel_badged_sends_loop.body_eq (ep_ptr : Std.U64) (badge : Std.U64) (t : obj.Tcb) (fuel : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.endpoint.cancel_badged_sends_loop.body ep_ptr badge t fuel) sS aA =
      (fl4_core.endpoint.cancel_badged_sends_loop.body mS ep_ptr badge sS t fuel >>= cfIn (fun (σ0 : S × obj.Tcb × Std.U64) => ((σ0.2.1, σ0.2.2), σ0.1)) (fun (b : S) => ((), b)) aA) := by
  unfold R.endpoint.cancel_badged_sends_loop.body
  simp only [reif_simps, fl4_core.endpoint.cancel_badged_sends_loop.body]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.endpoint.cancel_badged_sends_loop.body_nz (ep_ptr : Std.U64) (badge : Std.U64) (t : obj.Tcb) (fuel : Std.U64) : NoZero (R.endpoint.cancel_badged_sends_loop.body ep_ptr badge t fuel) := by
