@[reif_simps] theorem R.vspace.decode_page_map_eq (length : Std.U64) (slot : obj.Slot) (f : vspace.FrameCap) (buf : Std.U64) (ex : Array obj.Slot 3#usize) (sS : S) (aA : A) :
    interp mS mA (R.vspace.decode_page_map length slot f buf ex) sS aA =
      (fl4_core.vspace.decode_page_map mS mA sS aA length slot f buf ex >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.vspace.decode_page_map
  simp only [reif_simps, fl4_core.vspace.decode_page_map]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 3 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 4 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 5 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 6 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 7 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 8 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

