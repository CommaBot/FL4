section
variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.obj.Sc.refill_max (self : obj.Sc) : SProg Std.U64 := do
  let i ← pure ((core.num.U64.wrapping_add self layout.sc.REFILL_MAX))
  SProg.read i

@[reif_simps] theorem R.obj.Sc.refill_max_eq (self : obj.Sc) (sS : S) (aA : A) :
    interp mS mA (R.obj.Sc.refill_max self) sS aA =
      (fl4_core.obj.Sc.refill_max mS self sS >>= fun r => ok (r, sS, aA)) := by
  unfold R.obj.Sc.refill_max
  simp only [reif_simps, fl4_core.obj.Sc.refill_max]
  reif_loop

@[reif_nz] theorem R.obj.Sc.refill_max_nz (self : obj.Sc) : NoZero (R.obj.Sc.refill_max self) := by
  unfold R.obj.Sc.refill_max
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

