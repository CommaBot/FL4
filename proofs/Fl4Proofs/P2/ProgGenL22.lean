@[irreducible] noncomputable def R.sched.next_domain  : SProg Unit := do
  let i ← R.obj.ks_get layout.ks.DOM_SCHED_IDX
  let idx ← pure ((core.num.U64.wrapping_add i 1#u64))
  let idx1 ← SProg.blk 0 (
      if idx >= layout.NUM_DOMAIN_SCHEDULES then do
        R.obj.ks_get layout.ks.DOM_SCHED_START
      else do
        do
          let i1 ← R.sched.dom_sched_duration idx
          if i1 = 0#u64 then do
            R.obj.ks_get layout.ks.DOM_SCHED_START
          else do
            pure (idx))
  let _ ← R.obj.ks_set layout.ks.DOM_SCHED_IDX idx1
  let _ ← R.sched.set_reprogram
  let _ ← R.obj.ks_set layout.ks.WORK_UNITS 0#u64
  let d ← R.sched.dom_sched_domain idx1
  let t ← R.sched.dom_sched_duration idx1
  let _ ← R.obj.ks_set layout.ks.CUR_DOMAIN d
  R.obj.ks_set layout.ks.DOMAIN_TIME t

