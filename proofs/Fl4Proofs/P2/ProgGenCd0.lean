@[irreducible] noncomputable def R.cnode.copied_cap (lbl : Std.U64) (length : Std.U64) (buf : Std.U64) (src : obj.Slot) (src_cap : capability.Cap) : SProg (core.result.Result (capability.Cap × Bool) error.Exc) := do
  let ct ← R.sched.cur_thread
  if lbl = fl4_abi.label.CNodeCopy then do
    if length < 5#u64 then do
      SProg.liftR (error.truncated (capability.Cap × Bool))
    else do
      let i ← R.msg.syscall_arg ct buf 4#u64
      let r ← SProg.liftR (capability.Rights.from_word i)
      let c ← SProg.liftR (capability.mask_cap_rights r src_cap)
      let r1 ← R.objects.derive_cap src c
      let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r1)
      match cf with
      | core.ops.control_flow.ControlFlow.Continue val => do
          pure ((core.result.Result.Ok (val, false)))
      | core.ops.control_flow.ControlFlow.Break residual => do
          SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual (capability.Cap × Bool) (core.convert.FromSame error.Exc) residual)
  else do
    if lbl = fl4_abi.label.CNodeMint then do
      if length < 6#u64 then do
        SProg.liftR (error.truncated (capability.Cap × Bool))
      else do
        let i ← R.msg.syscall_arg ct buf 4#u64
        let r ← SProg.liftR (capability.Rights.from_word i)
        let data ← R.msg.syscall_arg ct buf 5#u64
        let c ← SProg.liftR (capability.mask_cap_rights r src_cap)
        let c1 ← SProg.liftR (objects.update_cap_data false data c)
        let r1 ← R.objects.derive_cap src c1
        let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r1)
        match cf with
        | core.ops.control_flow.ControlFlow.Continue val => do
            pure ((core.result.Result.Ok (val, false)))
        | core.ops.control_flow.ControlFlow.Break residual => do
            SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual (capability.Cap × Bool) (core.convert.FromSame error.Exc) residual)
    else do
      if lbl = fl4_abi.label.CNodeMove then do
        pure ((core.result.Result.Ok (src_cap, true)))
      else do
        if length < 5#u64 then do
          SProg.liftR (error.truncated (capability.Cap × Bool))
        else do
          let data ← R.msg.syscall_arg ct buf 4#u64
          let c ← SProg.liftR (objects.update_cap_data true data src_cap)
          pure ((core.result.Result.Ok (c, true)))

