@[irreducible] noncomputable def R.ept.invalidate (root : Std.U64) : SProg Unit := do
  let i ← SProg.liftR (ept.CORES)
  let i1 ← pure ((core.num.U64.wrapping_add root i))
  let i2 ← SProg.read i1
  let i3 ← SProg.liftR (i2 >>> 32#i32)
  let i4 ← SProg.liftR (i + 8#u64)
  let i5 ← pure ((core.num.U64.wrapping_add root i4))
  let i6 ← SProg.read i5
  let i7 ← pure ((i6 &&& 18446744069414584320#u64))
  let mask ← pure ((i3 ||| i7))
  let _ ← AR.invalidate_ept root mask
  pure (())

@[reif_simps] theorem R.ept.invalidate_eq (root : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.ept.invalidate root) sS aA =
      (fl4_core.ept.invalidate mS mA sS aA root >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.ept.invalidate
  simp only [reif_simps, fl4_core.ept.invalidate]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.ept.invalidate_nz (root : Std.U64) : NoZero (R.ept.invalidate root) := by
  unfold R.ept.invalidate
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply AR.invalidate_ept_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.ept.lookup_loop.body (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) : SProg (ControlFlow (Std.U64 × Std.U64) (core.result.Result Std.U64 error.LookupFault)) := do
  if shift > level then do
    if shift >= 21#u64 then do
      let i ← pure ((shift &&& 63#u64))
      let i1 ← SProg.liftR (gpa >>> i)
      let i2 ← pure ((i1 &&& 511#u64))
      let i3 ← SProg.liftR (i2 * 8#u64)
      let i4 ← pure ((core.num.U64.wrapping_add table i3))
      let e ← SProg.read i4
      let i5 ← pure ((e &&& 1#u64))
      if i5 = 0#u64 then do
        pure (.done (core.result.Result.Err (error.LookupFault.MissingCapability shift)))
      else do
        let i6 ← pure ((e &&& 128#u64))
        if i6 != 0#u64 then do
          pure (.done (core.result.Result.Err (error.LookupFault.MissingCapability shift)))
        else do
          let i7 ← pure ((e &&& ept.ADDRESS))
          let table1 ← SProg.liftR (layout.pptr i7)
          let shift1 ← SProg.liftR (shift - 9#u64)
          pure (.cont (table1, shift1))
    else do
      let i ← pure ((level &&& 63#u64))
      let i1 ← SProg.liftR (gpa >>> i)
      let i2 ← pure ((i1 &&& 511#u64))
      let i3 ← SProg.liftR (i2 * 8#u64)
      let i4 ← pure ((core.num.U64.wrapping_add table i3))
      pure (.done (core.result.Result.Ok i4))
  else do
    let i ← pure ((level &&& 63#u64))
    let i1 ← SProg.liftR (gpa >>> i)
    let i2 ← pure ((i1 &&& 511#u64))
    let i3 ← SProg.liftR (i2 * 8#u64)
    let i4 ← pure ((core.num.U64.wrapping_add table i3))
    pure (.done (core.result.Result.Ok i4))

@[reif_simps] theorem R.ept.lookup_loop.body_eq (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.ept.lookup_loop.body gpa level table shift) sS aA =
      (fl4_core.ept.lookup_loop.body mS sS gpa level table shift >>= fun r => ok (r, sS, aA)) := by
  unfold R.ept.lookup_loop.body
  simp only [reif_simps, fl4_core.ept.lookup_loop.body]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.ept.lookup_loop.body_nz (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) : NoZero (R.ept.lookup_loop.body gpa level table shift) := by
  unfold R.ept.lookup_loop.body
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

/-- The measure of `ept.lookup_loop` drops at every `cont` step, on every store. -/
theorem R.ept.lookup_loop.body_dec (s : S) (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) {σ0}
    (h : fl4_core.ept.lookup_loop.body mS s gpa level table shift = ok (.cont σ0)) :
    (fun xL => xL.2.val) σ0 < (fun xL => xL.2.val) (table, shift) := by
  simp only [fl4_core.ept.lookup_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals (apply usub_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.ept.lookup_loop (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) : SProg (core.result.Result Std.U64 error.LookupFault) :=
  SProg.iter (fun xL => R.ept.lookup_loop.body gpa level xL.1 xL.2) ((fun xL => xL.2.val) (table, shift) + 1) (table, shift)

@[reif_simps] theorem R.ept.lookup_loop_eq (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.ept.lookup_loop gpa level table shift) sS aA =
      (fl4_core.ept.lookup_loop mS sS gpa level table shift >>= fun r => ok (r, sS, aA)) := by
  unfold R.ept.lookup_loop fl4_core.ept.lookup_loop
  exact interp_iterR mS mA (fun (σ0 : Std.U64 × Std.U64) => fl4_core.ept.lookup_loop.body mS sS gpa level σ0.1 σ0.2) (fun xL => R.ept.lookup_loop.body gpa level xL.1 xL.2) (fun xL => xL.2.val) sS
    (fun xL aL => R.ept.lookup_loop.body_eq mS mA gpa level xL.1 xL.2 sS aL)
    (fun xL cL h => R.ept.lookup_loop.body_dec mS sS gpa level xL.1 xL.2 h) _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.ept.lookup_loop_nz (gpa : Std.U64) (level : Std.U64) (table : Std.U64) (shift : Std.U64) : NoZero (R.ept.lookup_loop gpa level table shift) := by
  unfold R.ept.lookup_loop
  exact NoZero.iter (fun x => R.ept.lookup_loop.body_nz _ _ _ _) _ _

end

