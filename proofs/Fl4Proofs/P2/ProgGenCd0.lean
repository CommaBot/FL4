@[irreducible] noncomputable def R.endpoint.restart_thread_if_no_fault (t : obj.Tcb) : SProg Unit := do
  let i ← R.obj.Tcb.fault_type t
  if i = fl4_abi.consts.fault.NullFault then do
    let _ ← R.sched.set_thread_state t sched.TS_RESTART
    let _ ← R.endpoint.unblock_sporadic t
    R.sched.possible_switch_to t
  else do
    R.sched.set_thread_state t sched.TS_INACTIVE

