@[irreducible] noncomputable def R.vspace.xd_bit (attr : Std.U64) : SProg Std.U64 := do
  let i ← pure ((attr &&& fl4_abi.consts.vm_attr.EXECUTE_NEVER))
  if i != 0#u64 then do
    let b ← R.vspace.nx_enabled
    if b then do
      SProg.liftR (vspace.P_XD)
    else do
      pure (0#u64)
  else do
    pure (0#u64)

@[reif_simps] theorem R.vspace.xd_bit_eq (attr : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.vspace.xd_bit attr) sS aA =
      (fl4_core.vspace.xd_bit mS sS attr >>= fun r => ok (r, sS, aA)) := by
  unfold R.vspace.xd_bit
  simp only [reif_simps, fl4_core.vspace.xd_bit]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.vspace.xd_bit_nz (attr : Std.U64) : NoZero (R.vspace.xd_bit attr) := by
  unfold R.vspace.xd_bit
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.nx_enabled_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.vspace.make_user_page (paddr : Std.U64) (attr : Std.U64) (rights : Std.U64) (large : Bool) : SProg Std.U64 := do
  let pat ← SProg.blk 0 (
      if large then do
        SProg.liftR (vspace.P_PAT_LARGE)
      else do
        SProg.liftR (vspace.P_PAT_4K))
  let i ← pure ((paddr &&& vspace.ADDR_MASK))
  let i1 ← SProg.liftR (vspace.attr_bits attr pat)
  let i2 ← pure ((i ||| i1))
  let i3 ← SProg.liftR (vspace.super_user rights)
  let i4 ← pure ((i2 ||| i3))
  let i5 ← SProg.liftR (vspace.writable rights)
  let i6 ← pure ((i4 ||| i5))
  let i7 ← SProg.liftR (vspace.P_PRESENT)
  let i8 ← pure ((i6 ||| i7))
  let i9 ← SProg.blk 1 (
      if large then do
        SProg.liftR (vspace.P_PS)
      else do
        pure (0#u64))
  let i10 ← pure ((i8 ||| i9))
  let i11 ← R.vspace.xd_bit attr
  pure ((i10 ||| i11))

@[reif_simps] theorem R.vspace.make_user_page_eq (paddr : Std.U64) (attr : Std.U64) (rights : Std.U64) (large : Bool) (sS : S) (aA : A) :
    interp mS mA (R.vspace.make_user_page paddr attr rights large) sS aA =
      (fl4_core.vspace.make_user_page mS sS paddr attr rights large >>= fun r => ok (r, sS, aA)) := by
  unfold R.vspace.make_user_page
  simp only [reif_simps, fl4_core.vspace.make_user_page]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.vspace.make_user_page_nz (paddr : Std.U64) (attr : Std.U64) (rights : Std.U64) (large : Bool) : NoZero (R.vspace.make_user_page paddr attr rights large) := by
  unfold R.vspace.make_user_page
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.xd_bit_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

