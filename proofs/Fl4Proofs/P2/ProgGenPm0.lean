@[irreducible] noncomputable def R.vspace.page_entry_slot (root : Std.U64) (vaddr : Std.U64) (size : capability.FrameSize) : SProg (core.result.Result Std.U64 error.Exc) := do
  let r ← SProg.blk 0 (
      match size with
      | capability.FrameSize.Small => do
          R.vspace.lookup_pt_slot root vaddr
      | capability.FrameSize.Large => do
          R.vspace.lookup_pd_slot root vaddr
      | capability.FrameSize.Huge => do
          R.vspace.lookup_pdpt_slot root vaddr)
  match r with
  | core.result.Result.Ok x => do
      let b ← SProg.blk 1 (
          match size with
          | capability.FrameSize.Small => do
              pure (true)
          | capability.FrameSize.Large => do
              pure (false)
          | capability.FrameSize.Huge => do
              pure (false))
      if b then do
        pure ((core.result.Result.Ok x))
      else do
        let old ← SProg.read x
        let i ← SProg.liftR (vspace.P_PRESENT)
        let i1 ← pure ((old &&& i))
        if i1 != 0#u64 then do
          let i2 ← SProg.liftR (vspace.P_PS)
          let i3 ← pure ((old &&& i2))
          if i3 = 0#u64 then do
            pure ((core.result.Result.Err (error.Exc.Sys error.SysError.DeleteFirst)))
          else do
            pure ((core.result.Result.Ok x))
        else do
          pure ((core.result.Result.Ok x))
  | core.result.Result.Err lf => do
      SProg.liftR (vspace.failed_lookup Std.U64 lf)

