@[irreducible] noncomputable def R.vspace.check_vspace (vcap : capability.Cap) : SProg (core.result.Result (Std.U64 × Std.U64) error.Exc) := do
  match vcap with
  | capability.Cap.Null => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Untyped _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Endpoint _ _ _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Notification _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Reply _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.CNode _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Thread _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.IrqControl => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.IrqHandler _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Zombie _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Domain => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.SchedContext _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.SchedControl _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.PageTable _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.PageDirectory _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Pdpt _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Pml4 ptr b asid => do
      if b then do
        let r ← R.vspace.find_vspace_for_asid asid
        match r with
        | core.result.Result.Ok r1 => do
            if r1 != ptr then do
              SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
            else do
              pure ((core.result.Result.Ok (ptr, asid)))
        | core.result.Result.Err lf => do
            pure ((core.result.Result.Err (error.Exc.Sys (error.SysError.FailedLookup false lf))))
      else do
        SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Vcpu _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.Ept _ _ _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.AsidControl => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.AsidPool _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.IoPortControl => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.IoPort _ _ _ => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)
  | capability.Cap.TdxControl => do
      SProg.liftR (error.invalid_cap (Std.U64 × Std.U64) 1#u64)

@[reif_simps] theorem R.vspace.check_vspace_eq (vcap : capability.Cap) (sS : S) (aA : A) :
    interp mS mA (R.vspace.check_vspace vcap) sS aA =
      (fl4_core.vspace.check_vspace mS sS vcap >>= fun r => ok (r, sS, aA)) := by
  unfold R.vspace.check_vspace
  simp only [reif_simps, fl4_core.vspace.check_vspace]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.vspace.check_vspace_nz (vcap : capability.Cap) : NoZero (R.vspace.check_vspace vcap) := by
  unfold R.vspace.check_vspace
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.find_vspace_for_asid_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.vspace.frame_address (f : vspace.FrameCap) : SProg Std.U64 := do
  let pa ← SProg.liftR (layout.paddr f.ptr)
  let («private», shared) ← SProg.frameMasks
  let i ← pure ((«private» ||| shared))
  if i = 0#u64 then do
    pure (pa)
  else do
    if f.is_device then do
      let b ← AR.private_device_frame pa
      if b then do
        pure ((pa ||| «private»))
      else do
        pure ((pa ||| shared))
    else do
      pure ((pa ||| «private»))

