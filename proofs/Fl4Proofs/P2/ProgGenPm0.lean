@[irreducible] noncomputable def R.vspace.write_mapping (slot : Std.U64) (e : Std.U64) (asid : Std.U64) (vaddr : Std.U64) (defer : Bool) : SProg Unit := do
  let old ← SProg.read slot
  let _ ← SProg.write slot e
  let i ← SProg.liftR (vspace.P_PRESENT)
  let i1 ← pure ((old &&& i))
  if i1 = 0#u64 then do
    pure (())
  else do
    let b ← SProg.liftR (vspace.rights_raised old e)
    if b then do
      let _ ← AR.invalidate_page asid vaddr
      pure (())
    else do
      if defer then do
        let b1 ← SProg.liftR (vspace.rights_lowered old e)
        if b1 then do
          pure (())
        else do
          let _ ← AR.invalidate_asid asid
          pure (())
      else do
        let _ ← AR.invalidate_asid asid
        pure (())

