@[irreducible] noncomputable def R.faults.handle_fault_reply (receiver : obj.Tcb) (sender : obj.Tcb) : SProg Bool := do
  let tag ← R.msg.msg_info sender
  let ty ← R.obj.Tcb.fault_type receiver
  if ty = fl4_abi.consts.fault.CapFault then do
    pure (true)
  else do
    if ty = fl4_abi.consts.fault.UnknownSyscall then do
      let s1 ← pure ((Array.to_slice faults.SYSCALL_MESSAGE))
      let _ ← R.faults.copy_mrs_fault_reply sender receiver s1 tag.length
      pure (tag.label = 0#u64)
    else do
      if ty = fl4_abi.consts.fault.UserException then do
        let s1 ← pure ((Array.to_slice faults.EXCEPTION_MESSAGE))
        let _ ← R.faults.copy_mrs_fault_reply sender receiver s1 tag.length
        pure (tag.label = 0#u64)
      else do
        if ty = fl4_abi.consts.fault.Timeout then do
          let s1 ← pure ((Array.to_slice faults.TIMEOUT_REPLY_MESSAGE))
          let _ ← R.faults.copy_mrs_fault_reply sender receiver s1 tag.length
          pure (tag.label = 0#u64)
        else do
          if ty = fl4_abi.consts.fault.DebugException then do
            let i ← R.obj.Tcb.fault_w0 receiver
            if i != debug.SINGLE_STEP then do
              pure (tag.label = 0#u64)
            else do
              let n_instrs ← SProg.blk 0 (
                  if tag.length < 1#u64 then do
                    pure (1#u64)
                  else do
                    do
                      let i1 ← SProg.liftR (msg.msg_register 0#u64)
                      R.obj.Tcb.reg sender i1)
              let _ ← R.debug.configure_single_stepping receiver 0#u64 n_instrs true
              pure (tag.label = 0#u64)
          else do
            pure (true)

