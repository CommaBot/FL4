@[irreducible] noncomputable def R.localtimer.set_timer_target_ok (cpu : Std.U64) (target : obj.Tcb) : SProg Bool := do
  let i ← R.obj.Tcb.affinity target
  if i != cpu then do
    pure (false)
  else do
    let d ← R.obj.Tcb.timer_deadline target
