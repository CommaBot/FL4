@[irreducible] noncomputable def R.localtimer.current_ok (cpu : Std.U64) (ct : obj.Tcb) (csc : obj.Sc) : SProg Bool := do
  let b ← R.localtimer.may_run_here cpu ct
  if b then do
    let i ← R.obj.Tcb.sc ct
    if i = csc then do
      let i1 ← R.obj.Sc.cpu csc
      if i1 = cpu then do
        let t ← R.sched.idle_thread
        let b1 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq ct t)
        if b1 then do
          pure (true)
        else do
          let i2 ← R.obj.Tcb.domain ct
          let i3 ← R.sched.cur_domain
          pure ((i2 = i3))
      else do
        pure (false)
    else do
      pure (false)
  else do
    pure (false)

