@[irreducible] noncomputable def R.hinvIoG (is_call : Bool) (blocking : Bool) (can_donate : Bool) (first_phase : Bool) (cptr : U64) : SProg (core.result.Result Unit error.Exc) := do
  let t ← R.sched.cur_thread
  let info ← R.msg.msg_info t
  let r ← R.cspace.lookup_slot t cptr
  match r with
  | core.result.Result.Ok r1 => do
      let cap ← R.obj.Slot.cap r1.slot
      let buf ← R.msg.lookup_ipc_buffer false t
      let r2 ← R.ipc.lookup_extra_caps t buf info
      match r2 with
      | core.result.Result.Ok e => do
          let length ← SProg.blk 0 (
              if info.length > msg.N_MSG_REGISTERS then do
                if buf = 0#u64 then do
                  pure (msg.N_MSG_REGISTERS)
                else do
                  pure (info.length)
              else do
                pure (info.length))
          let r3 ← R.decIoG info.label length r1.slot cap blocking is_call can_donate first_phase buf e
          R.hinvPost t is_call r3
      | core.result.Result.Err f => do
          if blocking then do
            let _ ← R.faults.handle_fault t f
            pure (core.result.Result.Ok ())
          else do
            pure (core.result.Result.Ok ())
  | core.result.Result.Err lf => do
      if blocking then do
        let _ ← R.faults.handle_fault t (error.Fault.Cap cptr false lf)
        pure (core.result.Result.Ok ())
      else do
        pure (core.result.Result.Ok ())

