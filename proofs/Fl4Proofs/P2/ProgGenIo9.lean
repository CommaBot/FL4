@[irreducible] noncomputable def R.faults.handle_fault (t : obj.Tcb) (f : error.Fault) : SProg Unit := do
  let s1 ← SProg.liftR (obj.Tcb.slot t layout.tcb.SLOT_FAULT_HANDLER)
  let handler ← R.obj.Slot.cap s1
  let i ← R.obj.Tcb.sc t
  let b ← R.faults.send_fault_ipc t handler (i != 0#u64) f
  if b then do
    pure (())
  else do
    let _ ← R.sched.set_thread_state t sched.TS_INACTIVE
    pure (())

