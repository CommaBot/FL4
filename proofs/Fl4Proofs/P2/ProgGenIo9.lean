@[irreducible] noncomputable def R.sched.charge_budget (used : Std.U64) (can_timeout_fault : Bool) : SProg Unit := do
  let sc ← R.sched.cur_sc
  let s1 ← R.sched.idle_sc
  let b ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc sc s1)
  let _ ← SProg.blk 1 (
      if b then do
        do
          let b1 ← R.sporadic.is_round_robin sc
          let _ ← SProg.blk 0 (
              if b1 then do
                do
                  let hi ← R.obj.Sc.refill_head sc
                  let ti ← R.obj.Sc.refill_tail sc
                  let h ← R.sporadic.get sc hi
                  let t ← R.sporadic.get sc ti
                  let i ← pure ((core.num.U64.wrapping_add h.amount t.amount))
                  let _ ← R.sporadic.put sc hi { h with amount := i }
                  R.sporadic.put sc ti { t with amount := 0#u64 }
              else do
                R.sporadic.budget_check used)
          let i ← R.obj.Sc.consumed sc
          let total ← pure ((core.num.U64.wrapping_add i used))
          R.obj.Sc.set_consumed sc total
      else do
        pure (()))
  let _ ← R.sched.set_consumed 0#u64
  let ct ← R.sched.cur_thread
  let b1 ← R.sched.is_schedulable ct
  if b1 then do
    let _ ← R.sched.end_timeslice can_timeout_fault
    let _ ← R.sched.reschedule_required
    let _ ← R.sched.set_reprogram
    pure (())
  else do
    pure (())

