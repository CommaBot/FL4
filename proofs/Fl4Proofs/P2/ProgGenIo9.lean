@[irreducible] noncomputable def R.sched.end_timeslice (can_timeout_fault : Bool) : SProg Unit := do
  let sc ← R.sched.cur_sc
  let ct ← R.sched.cur_thread
  let rr ← R.sporadic.is_round_robin sc
  let i ← R.obj.Tcb.state ct
  let valid ← SProg.blk 0 (
      if i != sched.TS_RUNNING_VM then do
        R.faults.valid_timeout_handler ct
      else do
        pure (false))
  if can_timeout_fault then do
    if rr then do
      let b ← R.sporadic.ready sc
      if b then do
        let b1 ← R.sporadic.sufficient sc 0#u64
        if b1 then do
          let _ ← R.sched.append ct
          pure (())
        else do
          let _ ← R.sched.postpone sc
          pure (())
      else do
        let _ ← R.sched.postpone sc
        pure (())
    else do
      if valid then do
        let badge ← R.obj.Sc.badge sc
        R.faults.handle_timeout ct (error.Fault.Timeout badge)
      else do
        let b ← R.sporadic.ready sc
        if b then do
          let b1 ← R.sporadic.sufficient sc 0#u64
          if b1 then do
            let _ ← R.sched.append ct
            pure (())
          else do
            let _ ← R.sched.postpone sc
            pure (())
        else do
          let _ ← R.sched.postpone sc
          pure (())
  else do
    let b ← R.sporadic.ready sc
    if b then do
      let b1 ← R.sporadic.sufficient sc 0#u64
      if b1 then do
        let _ ← R.sched.append ct
        pure (())
      else do
        let _ ← R.sched.postpone sc
        pure (())
    else do
      let _ ← R.sched.postpone sc
      pure (())

