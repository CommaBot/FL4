@[irreducible] noncomputable def R.notification.maybe_donate_sched_context (t : obj.Tcb) (n : obj.Ntfn) : SProg Unit := do
  let i ← R.obj.Tcb.sc t
  if i = 0#u64 then do
    let i1 ← R.obj.Ntfn.sc n
    let b ← SProg.liftR (obj.Sc.is_null i1)
    if b then do
      pure (())
    else do
      let i2 ← R.obj.Sc.tcb i1
      if i2 = 0#u64 then do
        let _ ← R.schedcontext.donate i1 t
        R.schedcontext.resume i1
      else do
        pure (())
  else do
    pure (())

