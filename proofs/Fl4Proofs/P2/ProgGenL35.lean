@[irreducible] noncomputable def R.vcpu.check (t : obj.Tcb) : SProg Unit := do
  let i ← R.obj.Tcb.state t
  if i != sched.TS_RUNNING_VM then do
    pure (())
  else do
    let v ← R.vcpu.bound t
    if v != 0#u64 then do
      let i1 ← R.vcpu.get v vcpu.PENDING
      if i1 != 0#u64 then do
        let _ ← R.vcpu.report t 0#u64
        pure (())
      else do
        let i2 ← R.obj.Tcb.bound_ntfn t
        if i2 != 0#u64 then do
          let i3 ← R.obj.Ntfn.state i2
          if i3 = obj.NTFN_ACTIVE then do
            let badge ← R.obj.Ntfn.badge i2
            let _ ← R.obj.Ntfn.set_state i2 obj.NTFN_IDLE
            let _ ← R.vcpu.report t badge
            pure (())
          else do
            if v = 0#u64 then do
              let _ ← R.vcpu.report t 0#u64
              pure (())
            else do
              pure (())
        else do
          if v = 0#u64 then do
            let _ ← R.vcpu.report t 0#u64
            pure (())
          else do
            pure (())
    else do
      let i1 ← R.obj.Tcb.bound_ntfn t
      if i1 != 0#u64 then do
        let i2 ← R.obj.Ntfn.state i1
        if i2 = obj.NTFN_ACTIVE then do
          let badge ← R.obj.Ntfn.badge i1
          let _ ← R.obj.Ntfn.set_state i1 obj.NTFN_IDLE
          let _ ← R.vcpu.report t badge
          pure (())
        else do
          if v = 0#u64 then do
            let _ ← R.vcpu.report t 0#u64
            pure (())
          else do
            pure (())
      else do
        if v = 0#u64 then do
          let _ ← R.vcpu.report t 0#u64
          pure (())
        else do
          pure (())

@[reif_simps] theorem R.vcpu.check_eq (t : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.vcpu.check t) sS aA =
      (fl4_core.vcpu.check mS mA sS aA t >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.vcpu.check
  simp only [reif_simps, fl4_core.vcpu.check]
  reif_loop

@[reif_nz] theorem R.vcpu.check_nz (t : obj.Tcb) : NoZero (R.vcpu.check t) := by
  unfold R.vcpu.check
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Ntfn.badge_nz)
    | (with_reducible apply R.obj.Ntfn.set_state_nz)
    | (with_reducible apply R.obj.Ntfn.state_nz)
    | (with_reducible apply R.obj.Tcb.bound_ntfn_nz)
    | (with_reducible apply R.obj.Tcb.state_nz)
    | (with_reducible apply R.vcpu.bound_nz)
    | (with_reducible apply R.vcpu.get_nz)
    | (with_reducible apply R.vcpu.report_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.fastpath.switch_to («to» : obj.Tcb) : SProg Unit := do
  let _ ← R.vspace.set_vm_root «to»
  let _ ← R.sched.set_cur_thread «to»
  let _ ← R.sched.set_action sched.ACTION_RESUME_CURRENT
  let _ ← R.sched.switch_sched_context
  let c ← SProg.curCpu
  let i ← R.obj.node_get c layout.node.REPROGRAM
  let _ ← SProg.blk 0 (
      if i != 0#u64 then do
        do
          let _ ← R.sched.set_next_interrupt
          let _ ← R.obj.node_set c layout.node.REPROGRAM 0#u64
          pure (())
      else do
        pure (()))
  let _ ← R.smp.send_pending
  R.sched.activate_thread

