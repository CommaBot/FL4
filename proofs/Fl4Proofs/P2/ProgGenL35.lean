@[irreducible] noncomputable def R.timer.insert (t : obj.Tcb) (deadline : Std.U64) (badge : Std.U64) : SProg Unit := do
  let _ ← R.timer.remove t
  if deadline = 0#u64 then do
    pure (())
  else do
    let cpu ← SProg.curCpu
    let cur ← R.timer.root cpu
    let (p, go_left, first) ← R.timer.insert_loop deadline 0#u64 cur false true layout.TREE_FUEL
    let b ← SProg.liftR (obj.Tcb.is_null p)
    let t1 ← SProg.blk 1 (
        if b then do
          do
            let _ ← R.timer.set_root cpu t
            pure (t)
        else do
          do
            let _ ← SProg.blk 0 (
                if go_left then do
                  R.timer.set_left p t
                else do
                  R.timer.set_right p t)
            pure (t))
    let i ← SProg.liftR (cpu <<< 8#i32)
    let i1 ← pure ((i ||| timer.RED))
    let _ ← R.obj.Tcb.set_timer_height t1 i1
    let _ ← R.obj.Tcb.set_timer_deadline t1 deadline
    let _ ← R.obj.Tcb.set_timer_badge t1 badge
    let _ ← R.timer.set_parent t1 p
    let _ ← R.timer.set_left t1 0#u64
    let _ ← R.timer.set_right t1 0#u64
    let _ ← R.timer.insert_fixup cpu t1
    if first then do
      let _ ← R.obj.node_set cpu layout.node.TIMER_MIN t1
      R.obj.node_set cpu layout.node.REPROGRAM 1#u64
    else do
      pure (())

