/-
# P2: generated program trees, part 2 of `Pm` (line hpzg)

GENERATED by `xtask/scripts/gen_prog.py Pm invBodyPmG`; do not edit. For each Store/Arch-generic function `f` of
the call closure: the tree `R.f` (the body with the store / Arch threading removed), its equation `R.f_eq`
(`interp` of the tree is `f` followed by `ok` of the threaded state, on every store and Arch instance) and
`R.f_nz` (`NoZero`). Loops: `R.<loop>.body` with its equation, the measure lemma `_dec`, the wrapper through
`interp_iterS`. No premises.
-/
import Fl4Proofs.P2.ProgGenPm1
open Aeneas Aeneas.Std Result

set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace Fl4Proofs.P2.PathObl
open fl4_core

section
variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.decPmG (lbl : U64) (length : U64) (slot : obj.Slot) (cap : capability.Cap) (_block : Bool) (_call : Bool) (_cd : Bool) (_fp : Bool) (buf : U64) (extra : Array obj.Slot 3#usize) : SProg (core.result.Result Unit error.Exc) := do
  match cap with
  | capability.Cap.Frame ptr size rights is_device mapped is_ept asid vaddr => do
      let _ ← R.sched.cur_thread
      let _ ← R.sched.cur_thread
      if lbl = fl4_abi.label.X86PageMap then do
        if mapped then do
          if is_ept then do
            let r ← SProg.liftR (error.invalid_cap Unit 0#u64)
            pure (r)
          else do
            R.vspace.decode_page_map length slot { ptr, size, rights, is_device, mapped, is_ept, asid, vaddr } buf extra
        else do
          R.vspace.decode_page_map length slot { ptr, size, rights, is_device, mapped, is_ept, asid, vaddr } buf extra
      else do
        SProg.err (.panic)
  | _ => do
      SProg.err (.panic)

@[reif_simps] theorem R.decPmG_eq (lbl : U64) (length : U64) (slot : obj.Slot) (cap : capability.Cap) (_block : Bool) (_call : Bool) (_cd : Bool) (_fp : Bool) (buf : U64) (extra : Array obj.Slot 3#usize) (sS : S) (aA : A) :
    interp mS mA (R.decPmG lbl length slot cap _block _call _cd _fp buf extra) sS aA =
      (Fl4Proofs.P2.PathObl.decPmG mS mA sS aA lbl length slot cap _block _call _cd _fp buf extra >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.decPmG
  simp only [reif_simps, Fl4Proofs.P2.PathObl.decPmG]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.decPmG_nz (lbl : U64) (length : U64) (slot : obj.Slot) (cap : capability.Cap) (_block : Bool) (_call : Bool) (_cd : Bool) (_fp : Bool) (buf : U64) (extra : Array obj.Slot 3#usize) : NoZero (R.decPmG lbl length slot cap _block _call _cd _fp buf extra) := by
  unfold R.decPmG
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.sched.cur_thread_nz)
    | (with_reducible apply R.vspace.decode_page_map_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.invTailPmG (t : U64) (info : msginfo.MessageInfo) (p : localinv.Plan) : SProg Bool := do
  let b ← SProg.liftR (localinv.is_local_label info.label)
  if b then do
    let next ← R.obj.Tcb.reg t layout.reg.NEXT_IP
    let i2 ← pure ((core.num.U64.wrapping_sub next 2#u64))
    let _ ← R.obj.Tcb.set_reg t layout.reg.FAULT_IP i2
    let _ ← R.sched.update_timestamp
    let csc ← R.sched.cur_sc
    let i3 ← R.sched.action
    if i3 != sched.ACTION_RESUME_CURRENT then do
      pure (false)
    else do
      let i4 ← R.obj.Tcb.yield_to t
      if i4 != 0#u64 then do
        pure (false)
      else do
        let i5 ← R.sched.consumed
        let b1 ← R.sporadic.sufficient csc i5
        if b1 then do
          let b2 ← R.fastpath.schedulable_here t
          if b2 then do
            let b3 ← R.localinv.Plan.still_holds p
            if b3 then do
              let buf ← R.msg.lookup_ipc_buffer false t
              let length ← SProg.blk 0 (
                  if info.length > msg.N_MSG_REGISTERS then do
                    if buf = 0#u64 then do
                      pure (msg.N_MSG_REGISTERS)
                    else do
                      pure (info.length)
                  else do
                    pure (info.length))
              let cap ← R.obj.Slot.cap p.slot
              let r ← R.decPmG info.label length p.slot cap true true true false buf p.extra
              let r1 ← R.invPostG t r
              let _ ← R.syscall.after_invocation r1
              let _ ← R.syscall.finish
              pure (true)
            else do
              pure (false)
          else do
            pure (false)
        else do
          pure (false)
  else do
    pure (false)

@[reif_simps] theorem R.invTailPmG_eq (t : U64) (info : msginfo.MessageInfo) (p : localinv.Plan) (sS : S) (aA : A) :
    interp mS mA (R.invTailPmG t info p) sS aA =
      (Fl4Proofs.P2.PathObl.invTailPmG mS mA sS aA t info p >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.invTailPmG
  simp only [reif_simps, Fl4Proofs.P2.PathObl.invTailPmG]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.invTailPmG_nz (t : U64) (info : msginfo.MessageInfo) (p : localinv.Plan) : NoZero (R.invTailPmG t info p) := by
  unfold R.invTailPmG
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.decPmG_nz)
    | (with_reducible apply R.fastpath.schedulable_here_nz)
    | (with_reducible apply R.invPostG_nz)
    | (with_reducible apply R.localinv.Plan.still_holds_nz)
    | (with_reducible apply R.msg.lookup_ipc_buffer_nz)
    | (with_reducible apply R.obj.Slot.cap_nz)
    | (with_reducible apply R.obj.Tcb.reg_nz)
    | (with_reducible apply R.obj.Tcb.set_reg_nz)
    | (with_reducible apply R.obj.Tcb.yield_to_nz)
    | (with_reducible apply R.sched.action_nz)
    | (with_reducible apply R.sched.consumed_nz)
    | (with_reducible apply R.sched.cur_sc_nz)
    | (with_reducible apply R.sched.update_timestamp_nz)
    | (with_reducible apply R.sporadic.sufficient_nz)
    | (with_reducible apply R.syscall.after_invocation_nz)
    | (with_reducible apply R.syscall.finish_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.invBodyPmG (number : I64) (p : localinv.Plan) : SProg Bool := do
  let t ← R.sched.cur_thread
  let info ← R.msg.msg_info t
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let i ← R.obj.Tcb.flags t
    let i1 ← pure ((i &&& fl4_abi.consts.tcb_flag.TRAP_SYSCALLS))
    if i1 != 0#u64 then do
      pure (false)
    else do
      if number != fl4_abi.syscall.SysCall then do
        pure (false)
      else do
        R.invTailPmG t info p

@[reif_simps] theorem R.invBodyPmG_eq (number : I64) (p : localinv.Plan) (sS : S) (aA : A) :
    interp mS mA (R.invBodyPmG number p) sS aA =
      (Fl4Proofs.P2.PathObl.invBodyPmG mS mA sS aA number p >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.invBodyPmG
  simp only [reif_simps, Fl4Proofs.P2.PathObl.invBodyPmG]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.invBodyPmG_nz (number : I64) (p : localinv.Plan) : NoZero (R.invBodyPmG number p) := by
  unfold R.invBodyPmG
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.invTailPmG_nz)
    | (with_reducible apply R.msg.msg_info_nz)
    | (with_reducible apply R.obj.Tcb.flags_nz)
    | (with_reducible apply R.sched.cur_thread_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
