@[irreducible] noncomputable def R.ipc.lookup_extra_caps_loop.body (thread : obj.Tcb) (buf : Std.U64) (n : Std.U64) (caps : Array obj.Slot 3#usize) (i : Std.U64) : SProg (ControlFlow ((Array obj.Slot 3#usize) × Std.U64) (core.result.Result (Array obj.Slot 3#usize) error.Fault)) := do
  if i < n then do
    if i < 3#u64 then do
      let i1 ← SProg.liftR (msg.BUF_CAPS)
      let i2 ← pure ((core.num.U64.wrapping_add i1 i))
      let cptr ← R.msg.buf_get buf i2
      let r ← R.cspace.lookup_slot thread cptr
      match r with
      | core.result.Result.Ok r1 => do
          let i3 ← pure ((UScalar.cast .Usize i))
          let a ← SProg.liftR (Array.update caps i3 r1.slot)
          let i4 ← SProg.liftR (i + 1#u64)
          pure (.cont (a, i4))
      | core.result.Result.Err lf => do
          pure (.done (core.result.Result.Err (error.Fault.Cap cptr false lf)))
    else do
      pure (.done (core.result.Result.Ok caps))
  else do
    pure (.done (core.result.Result.Ok caps))

