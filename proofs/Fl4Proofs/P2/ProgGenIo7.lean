@[irreducible] noncomputable def R.ioport.invocation_ok (t : obj.Tcb) (cptr : Std.U64) (info : msginfo.MessageInfo) : SProg Bool := do
  let size ← SProg.liftR (ioport.port_size info.label)
  if size = 0#u64 then do
    pure (false)
  else do
    let r ← R.cspace.lookup_slot t cptr
    match r with
    | core.result.Result.Ok r1 => do
        if r1.bits_left != 0#u64 then do
          pure (false)
        else do
          let c ← R.obj.Slot.cap r1.slot
          match c with
          | capability.Cap.Null => do
              pure (false)
          | capability.Cap.Untyped _ _ _ _ => do
              pure (false)
          | capability.Cap.Endpoint _ _ _ _ _ _ => do
              pure (false)
          | capability.Cap.Notification _ _ _ _ => do
              pure (false)
          | capability.Cap.Reply _ _ => do
              pure (false)
          | capability.Cap.CNode _ _ _ _ => do
              pure (false)
          | capability.Cap.Thread _ => do
              pure (false)
          | capability.Cap.IrqControl => do
              pure (false)
          | capability.Cap.IrqHandler _ => do
              pure (false)
          | capability.Cap.Zombie _ _ _ => do
              pure (false)
          | capability.Cap.Domain => do
              pure (false)
          | capability.Cap.SchedContext _ _ => do
              pure (false)
          | capability.Cap.SchedControl _ => do
              pure (false)
          | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
              pure (false)
          | capability.Cap.PageTable _ _ _ _ => do
              pure (false)
          | capability.Cap.PageDirectory _ _ _ _ => do
              pure (false)
          | capability.Cap.Pdpt _ _ _ _ => do
              pure (false)
          | capability.Cap.Pml4 _ _ _ => do
              pure (false)
          | capability.Cap.Vcpu _ => do
              pure (false)
          | capability.Cap.Ept _ _ _ _ _ => do
              pure (false)
          | capability.Cap.AsidControl => do
              pure (false)
          | capability.Cap.AsidPool _ _ => do
              pure (false)
          | capability.Cap.IoPortControl => do
              pure (false)
          | capability.Cap.IoPort first last _ => do
              let buf ← R.msg.lookup_ipc_buffer false t
              let length ← SProg.blk 0 (
                  if info.length > msg.N_MSG_REGISTERS then do
                    if buf = 0#u64 then do
                      pure (msg.N_MSG_REGISTERS)
                    else do
                      pure (info.length)
                  else do
                    pure (info.length))
              let b ← SProg.liftR (ioport.is_port_in info.label)
              let i ← SProg.blk 1 (
                  if b then do
                    pure (1#u64)
                  else do
                    pure (2#u64))
              if length < i then do
                pure (false)
              else do
                let i1 ← R.msg.syscall_arg t buf 0#u64
                let port ← pure ((i1 &&& 65535#u64))
                let r2 ← SProg.liftR (ioport.allowed first last port size)
                SProg.liftR (core.result.Result.is_ok r2)
          | capability.Cap.TdxControl => do
              pure (false)
    | core.result.Result.Err _ => do
        pure (false)

