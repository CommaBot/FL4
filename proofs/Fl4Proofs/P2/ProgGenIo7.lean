@[irreducible] noncomputable def R.hinvPost (t : U64) (is_call : Bool) (r3 : core.result.Result Unit error.Exc) : SProg (core.result.Result Unit error.Exc) := do
  match r3 with
  | core.result.Result.Ok _ => do
      let i ← R.obj.Tcb.state t
      if i = sched.TS_RESTART then do
        let _ ← SProg.blk 0 (
            if is_call then do
              R.msg.reply_success_empty t
            else do
              pure (()))
        let _ ← R.sched.set_thread_state t sched.TS_RUNNING
        pure (core.result.Result.Ok ())
      else do
        pure (core.result.Result.Ok ())
  | core.result.Result.Err e1 => do
      match e1 with
      | error.Exc.Fault _ => do
          pure (core.result.Result.Ok ())
      | error.Exc.Lookup _ => do
          pure (core.result.Result.Ok ())
      | error.Exc.Sys e2 => do
          if is_call then do
            let _ ← R.syscall.reply_error t e2
            pure (core.result.Result.Ok ())
          else do
            pure (core.result.Result.Ok ())
      | error.Exc.Preempted => do
          pure (r3)

