/-- The measure of `ipc.lookup_extra_caps_loop` drops at every `cont` step, on every store. -/
theorem R.ipc.lookup_extra_caps_loop.body_dec (s : S) (thread : obj.Tcb) (buf : Std.U64) (n : Std.U64) (caps : Array obj.Slot 3#usize) (i : Std.U64) {σ0}
    (h : fl4_core.ipc.lookup_extra_caps_loop.body mS s thread buf n caps i = ok (.cont σ0)) :
    (fun xL => 2 ^ UScalarTy.U64.numBits - xL.2.val) σ0 < (fun xL => 2 ^ UScalarTy.U64.numBits - xL.2.val) (caps, i) := by
  simp only [fl4_core.ipc.lookup_extra_caps_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

