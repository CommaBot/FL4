@[irreducible] noncomputable def R.objects.derive_cap (slot : obj.Slot) (c : capability.Cap) : SProg (core.result.Result capability.Cap error.Exc) := do
  match c with
  | capability.Cap.Null => do
      pure ((core.result.Result.Ok capability.Cap.Null))
  | capability.Cap.Untyped _ _ _ _ => do
      let r ← R.cdt.ensure_no_children slot
      let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
      match cf with
      | core.ops.control_flow.ControlFlow.Continue _ => do
          pure ((core.result.Result.Ok c))
      | core.ops.control_flow.ControlFlow.Break residual => do
          SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual capability.Cap (core.convert.FromSame error.Exc) residual)
  | capability.Cap.Endpoint _ _ _ _ _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.Notification _ _ _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.Reply _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.CNode _ _ _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.Thread _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.IrqControl => do
      pure ((core.result.Result.Ok capability.Cap.Null))
  | capability.Cap.IrqHandler _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.Zombie _ _ _ => do
      pure ((core.result.Result.Ok capability.Cap.Null))
  | capability.Cap.Domain => do
      pure ((core.result.Result.Ok capability.Cap.Domain))
  | capability.Cap.SchedContext _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.SchedControl _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.Frame ptr size rights is_device _ _ _ _ => do
      pure ((core.result.Result.Ok (capability.Cap.Frame ptr size rights is_device false false 0#u64 0#u64)))
  | capability.Cap.PageTable _ mapped _ _ => do
      if mapped then do
        pure ((core.result.Result.Ok c))
      else do
        pure ((core.result.Result.Err (error.Exc.Sys error.SysError.IllegalOperation)))
  | capability.Cap.PageDirectory _ mapped _ _ => do
      if mapped then do
        pure ((core.result.Result.Ok c))
      else do
        pure ((core.result.Result.Err (error.Exc.Sys error.SysError.IllegalOperation)))
  | capability.Cap.Pdpt _ mapped _ _ => do
      if mapped then do
        pure ((core.result.Result.Ok c))
      else do
        pure ((core.result.Result.Err (error.Exc.Sys error.SysError.IllegalOperation)))
  | capability.Cap.Pml4 _ mapped _ => do
      if mapped then do
        pure ((core.result.Result.Ok c))
      else do
        pure ((core.result.Result.Err (error.Exc.Sys error.SysError.IllegalOperation)))
  | capability.Cap.Vcpu _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.Ept _ _ mapped _ _ => do
      if mapped then do
        pure ((core.result.Result.Ok c))
      else do
        pure ((core.result.Result.Err (error.Exc.Sys error.SysError.IllegalOperation)))
  | capability.Cap.AsidControl => do
      pure ((core.result.Result.Ok capability.Cap.AsidControl))
  | capability.Cap.AsidPool _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.IoPortControl => do
      pure ((core.result.Result.Ok capability.Cap.Null))
  | capability.Cap.IoPort _ _ _ => do
      pure ((core.result.Result.Ok c))
  | capability.Cap.TdxControl => do
      pure ((core.result.Result.Ok capability.Cap.TdxControl))

@[reif_simps] theorem R.objects.derive_cap_eq (slot : obj.Slot) (c : capability.Cap) (sS : S) (aA : A) :
    interp mS mA (R.objects.derive_cap slot c) sS aA =
      (fl4_core.objects.derive_cap mS sS slot c >>= fun r => ok (r, sS, aA)) := by
  unfold R.objects.derive_cap
  simp only [reif_simps, fl4_core.objects.derive_cap]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.objects.derive_cap_nz (slot : obj.Slot) (c : capability.Cap) : NoZero (R.objects.derive_cap slot c) := by
  unfold R.objects.derive_cap
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.cdt.ensure_no_children_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
