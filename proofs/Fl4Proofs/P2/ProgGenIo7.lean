@[irreducible] noncomputable def R.ipc.get_receive_slot (thread : obj.Tcb) (buf : Std.U64) : SProg obj.Slot := do
  if buf = 0#u64 then do
    pure (0#u64)
  else do
    let i ← SProg.liftR (msg.BUF_RECV_CNODE)
    let root_cptr ← R.msg.buf_get buf i
    let i1 ← SProg.liftR (msg.BUF_RECV_INDEX)
    let index ← R.msg.buf_get buf i1
    let i2 ← SProg.liftR (msg.BUF_RECV_DEPTH)
    let depth ← R.msg.buf_get buf i2
    let r ← R.cspace.lookup_cap thread root_cptr
    match r with
    | core.result.Result.Ok c => do
        let r1 ← R.cspace.lookup_target_slot c index depth
        match r1 with
        | core.result.Result.Ok slot => do
            let c1 ← R.obj.Slot.cap slot
            let b ← SProg.liftR (capability.Cap.is_null c1)
            if b then do
              pure (slot)
            else do
              pure (0#u64)
        | core.result.Result.Err _ => do
            pure (0#u64)
    | core.result.Result.Err _ => do
        pure (0#u64)

