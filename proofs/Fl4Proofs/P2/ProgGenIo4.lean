@[irreducible] noncomputable def R.tcbqueue.append_by_prio (l : tcbqueue.Link) (q : tcbqueue.Queue) (t : obj.Tcb) : SProg tcbqueue.Queue := do
  let p ← R.obj.Tcb.prio t
  let b ← SProg.liftR (tcbqueue.Queue.is_empty q)
  if b then do
    R.tcbqueue.prepend l q t
  else do
    let i ← R.obj.Tcb.prio q.head
    if p > i then do
      R.tcbqueue.prepend l q t
    else do
      let i1 ← R.obj.Tcb.prio q.end
      if i1 >= p then do
        R.tcbqueue.append l q t
      else do
        let before ← R.tcbqueue.append_by_prio_loop l p q.end layout.WALK_FUEL
        let _ ← R.tcbqueue.insert_after l t before
        pure (q)

