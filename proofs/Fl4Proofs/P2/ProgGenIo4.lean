@[irreducible] noncomputable def R.obj.Slot.set_next_flags (self : obj.Slot) (n : obj.Slot) (revocable : Bool) (first_badged : Bool) : SProg Unit := do
  let i ← R.obj.Slot.next_word self
  let i1 ← SProg.liftR (obj.MDB_REVOCABLE)
  let i2 ← pure ((obj.MDB_PTR_MASK ||| i1))
  let i3 ← SProg.liftR (obj.MDB_FIRST_BADGED)
  let i4 ← pure ((i2 ||| i3))
  let i5 ← pure ((~~~ i4))
  let w ← pure ((i &&& i5))
  let r ← SProg.blk 0 (
      if revocable then do
        pure (i1)
      else do
        pure (0#u64))
  let f ← SProg.blk 1 (
      if first_badged then do
        pure (i3)
      else do
        pure (0#u64))
  let i6 ← pure ((core.num.U64.wrapping_add self layout.cte.NEXT))
  let i7 ← pure ((n &&& obj.MDB_PTR_MASK))
  let i8 ← pure ((w ||| i7))
  let i9 ← pure ((i8 ||| r))
  let i10 ← pure ((i9 ||| f))
  SProg.write i6 i10

