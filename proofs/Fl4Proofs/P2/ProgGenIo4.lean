@[irreducible] noncomputable def R.cdt.insert_with_cap (new_cap : capability.Cap) (src_cap : capability.Cap) (src : obj.Slot) (dest : obj.Slot) : SProg Unit := do
  let revocable ← SProg.liftR (objects.is_cap_revocable new_cap src_cap)
  let next ← R.obj.Slot.next src
  let _ ← R.cdt.set_untyped_cap_as_full src_cap new_cap src
  let _ ← R.obj.Slot.set_cap dest new_cap
  let _ ← R.obj.Slot.set_prev dest src
  let _ ← R.obj.Slot.set_next_flags dest next revocable revocable
  let _ ← R.obj.Slot.set_next src dest
  let b ← SProg.liftR (obj.Slot.is_null next)
  if b then do
    pure (())
  else do
    R.obj.Slot.set_prev next dest

