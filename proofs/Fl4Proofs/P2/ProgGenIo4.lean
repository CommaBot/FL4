@[irreducible] noncomputable def R.syscall.error_mrs (t : obj.Tcb) (buf : Std.U64) (e : error.SysError) : SProg Std.U64 := do
  match e with
  | error.SysError.InvalidArgument arg => do
      R.msg.set_mr t buf 0#u64 arg
  | error.SysError.InvalidCapability arg => do
      R.msg.set_mr t buf 0#u64 arg
  | error.SysError.IllegalOperation => do
      pure (0#u64)
  | error.SysError.RangeError min max => do
      let _ ← R.msg.set_mr t buf 0#u64 min
      R.msg.set_mr t buf 1#u64 max
  | error.SysError.AlignmentError => do
      pure (0#u64)
  | error.SysError.FailedLookup source lf => do
      if source then do
        let _ ← R.msg.set_mr t buf 0#u64 1#u64
        R.faults.set_mrs_lookup_failure_at t buf lf 1#u64
      else do
        let _ ← R.msg.set_mr t buf 0#u64 0#u64
        R.faults.set_mrs_lookup_failure_at t buf lf 1#u64
  | error.SysError.TruncatedMessage => do
      pure (0#u64)
  | error.SysError.DeleteFirst => do
      pure (0#u64)
  | error.SysError.RevokeFirst => do
      pure (0#u64)
  | error.SysError.NotEnoughMemory bytes => do
      R.msg.set_mr t buf 0#u64 bytes

