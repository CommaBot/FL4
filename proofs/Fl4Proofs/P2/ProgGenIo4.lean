  let i ← pure ((core.num.U64.wrapping_add self layout.cte.NEXT))
  let i1 ← pure ((~~~ obj.MDB_PTR_MASK))
  let i2 ← pure ((w &&& i1))
  let i3 ← pure ((n &&& obj.MDB_PTR_MASK))
  let i4 ← pure ((i2 ||| i3))
