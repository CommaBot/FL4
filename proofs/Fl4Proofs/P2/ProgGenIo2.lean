/-- The measure of `tcbqueue.append_by_prio_loop` drops at every `cont` step, on every store. -/
theorem R.tcbqueue.append_by_prio_loop.body_dec (s : S) (l : tcbqueue.Link) (p : Std.U64) (before : obj.Tcb) (fuel : Std.U64) {σ0}
    (h : fl4_core.tcbqueue.append_by_prio_loop.body mS s l p before fuel = ok (.cont σ0)) :
    (fun xL => xL.2.val) σ0 < (fun xL => xL.2.val) (before, fuel) := by
  simp only [fl4_core.tcbqueue.append_by_prio_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

