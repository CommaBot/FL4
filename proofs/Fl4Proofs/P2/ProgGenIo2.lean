@[irreducible] noncomputable def R.tcbqueue.append_by_prio_loop.body (l : tcbqueue.Link) (p : Std.U64) (before : obj.Tcb) (fuel : Std.U64) : SProg (ControlFlow (obj.Tcb × Std.U64) obj.Tcb) := do
  let b ← SProg.liftR (obj.Tcb.is_null before)
  if b then do
    pure (.done before)
  else do
    let i ← R.obj.Tcb.prio before
    if p > i then do
      if fuel > 0#u64 then do
        let fuel1 ← SProg.liftR (fuel - 1#u64)
        let i1 ← R.tcbqueue.prev l before
        pure (.cont (i1, fuel1))
      else do
        pure (.done before)
    else do
      pure (.done before)

