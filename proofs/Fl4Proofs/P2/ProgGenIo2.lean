@[reif_simps] theorem R.cdt.set_untyped_cap_as_full_eq (src_cap : capability.Cap) (new_cap : capability.Cap) (src : obj.Slot) (sS : S) (aA : A) :
    interp mS mA (R.cdt.set_untyped_cap_as_full src_cap new_cap src) sS aA =
      (fl4_core.cdt.set_untyped_cap_as_full mS sS src_cap new_cap src >>= fun r => ok ((), r, aA)) := by
  unfold R.cdt.set_untyped_cap_as_full
  simp only [reif_simps, fl4_core.cdt.set_untyped_cap_as_full]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.cdt.set_untyped_cap_as_full_nz (src_cap : capability.Cap) (new_cap : capability.Cap) (src : obj.Slot) : NoZero (R.cdt.set_untyped_cap_as_full src_cap new_cap src) := by
  unfold R.cdt.set_untyped_cap_as_full
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Slot.set_cap_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

