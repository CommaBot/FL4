@[irreducible] noncomputable def R.cdt.set_untyped_cap_as_full (src_cap : capability.Cap) (new_cap : capability.Cap) (src : obj.Slot) : SProg Unit := do
  match src_cap with
  | capability.Cap.Null => do
      pure (())
  | capability.Cap.Untyped p1 b1 _ is_device => do
      match new_cap with
      | capability.Cap.Null => do
          pure (())
      | capability.Cap.Untyped p2 b2 _ _ => do
          if p1 = p2 then do
            if b1 = b2 then do
              let i ← pure ((b1 &&& 63#u64))
              let i1 ← SProg.liftR (1#u64 <<< i)
              R.obj.Slot.set_cap src (capability.Cap.Untyped p1 b1 i1 is_device)
            else do
              pure (())
          else do
            pure (())
      | capability.Cap.Endpoint _ _ _ _ _ _ => do
          pure (())
      | capability.Cap.Notification _ _ _ _ => do
          pure (())
