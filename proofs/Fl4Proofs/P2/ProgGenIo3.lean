@[irreducible] noncomputable def R.msg.copy_mrs (sender : obj.Tcb) (send_buf : Std.U64) (receiver : obj.Tcb) (recv_buf : Std.U64) (n : Std.U64) : SProg Std.U64 := do
  let i ← R.msg.copy_mrs_loop0 sender receiver n 0#u64
  if recv_buf = 0#u64 then do
    pure (i)
  else do
    if send_buf = 0#u64 then do
      pure (i)
    else do
      R.msg.copy_mrs_loop1 send_buf recv_buf n i

