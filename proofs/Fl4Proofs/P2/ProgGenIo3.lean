@[irreducible] noncomputable def R.interrupt.handle_interrupt (irq : Std.U64) : SProg Unit := do
  let i ← SProg.liftR (layout.irq.MAX)
  if irq > i then do
    let _ ← AR.mask_irq irq true
    let _ ← AR.ack_irq irq
    pure (())
  else do
    let st ← R.interrupt.irq_state irq
    let _ ← SProg.blk 2 (
        if st = interrupt.IRQ_SIGNAL then do
          do
            let s2 ← R.interrupt.irq_slot irq
            let c ← R.obj.Slot.cap s2
            let _ ← SProg.blk 0 (
                match c with
                | capability.Cap.Null => do
                    pure (())
                | capability.Cap.Untyped _ _ _ _ => do
                    pure (())
                | capability.Cap.Endpoint _ _ _ _ _ _ => do
                    pure (())
                | capability.Cap.Notification ptr badge b _ => do
                    if b then do
                      R.notification.send_signal ptr badge
                    else do
                      pure (())
                | capability.Cap.Reply _ _ => do
                    pure (())
                | capability.Cap.CNode _ _ _ _ => do
                    pure (())
                | capability.Cap.Thread _ => do
                    pure (())
                | capability.Cap.IrqControl => do
                    pure (())
                | capability.Cap.IrqHandler _ => do
                    pure (())
                | capability.Cap.Zombie _ _ _ => do
                    pure (())
                | capability.Cap.Domain => do
                    pure (())
                | capability.Cap.SchedContext _ _ => do
                    pure (())
                | capability.Cap.SchedControl _ => do
                    pure (())
                | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
                    pure (())
                | capability.Cap.PageTable _ _ _ _ => do
                    pure (())
                | capability.Cap.PageDirectory _ _ _ _ => do
                    pure (())
                | capability.Cap.Pdpt _ _ _ _ => do
                    pure (())
                | capability.Cap.Pml4 _ _ _ => do
                    pure (())
                | capability.Cap.Vcpu _ => do
                    pure (())
                | capability.Cap.Ept _ _ _ _ _ => do
                    pure (())
                | capability.Cap.AsidControl => do
                    pure (())
                | capability.Cap.AsidPool _ _ => do
                    pure (())
                | capability.Cap.IoPortControl => do
                    pure (())
                | capability.Cap.IoPort _ _ _ => do
                    pure (())
                | capability.Cap.TdxControl => do
                    pure (()))
            let _ ← AR.mask_irq irq true
            pure (())
        else do
          if st = interrupt.IRQ_TIMER then do
            do
              let c ← SProg.curCpu
              let _ ← R.obj.node_set c layout.node.REPROGRAM 1#u64
              let _ ← R.obj.node_set c layout.node.ARMED 0#u64
              pure (())
          else do
            if st = interrupt.IRQ_IPI then do
              R.smp.handle_ipi irq
            else do
              do
                let _ ← SProg.blk 1 (
                    if st = interrupt.IRQ_INACTIVE then do
                      AR.mask_irq irq true
                    else do
                      pure (()))
                pure (()))
    let _ ← AR.ack_irq irq
    pure (())

@[reif_simps] theorem R.interrupt.handle_interrupt_eq (irq : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.interrupt.handle_interrupt irq) sS aA =
      (fl4_core.interrupt.handle_interrupt mS mA sS aA irq >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.interrupt.handle_interrupt
  simp only [reif_simps, fl4_core.interrupt.handle_interrupt]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro)
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r.1, r.2)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), sB, r)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => ((), r.1, r.2)))
      ))
    | reif_step)
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

