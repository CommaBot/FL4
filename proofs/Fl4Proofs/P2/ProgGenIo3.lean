@[irreducible] noncomputable def R.ipc.reply_push (caller : obj.Tcb) (callee : obj.Tcb) (r : obj.Reply) (can_donate : Bool) : SProg Unit := do
  let i ← R.obj.Tcb.sc caller
  let _ ← R.obj.Reply.set_tcb r caller
  let _ ← R.sched.set_blocked_on_reply caller r
  let b ← SProg.liftR (obj.Sc.is_null i)
  if b then do
    pure (())
  else do
    let i1 ← R.obj.Tcb.sc callee
    if i1 = 0#u64 then do
      if can_donate then do
        let i2 ← R.obj.Sc.reply i
        let _ ← SProg.blk 0 (
            if i2 != 0#u64 then do
              R.obj.Reply.set_next i2 r false
            else do
              pure (()))
        let _ ← R.obj.Reply.set_prev r i2
        let _ ← R.obj.Sc.set_reply i r
        let _ ← R.obj.Reply.set_next r i true
        R.schedcontext.donate i callee
      else do
        pure (())
    else do
      pure (())

