  let b ← SProg.liftR (obj.Tcb.is_null t)
  if b then do
    pure (.done ())
  else do
    if fuel > 0#u64 then do
      let fuel1 ← SProg.liftR (fuel - 1#u64)
      let next ← R.tcbqueue.next_of tcbqueue.Link.Ep t
      let _ ← R.notification.ntfn_dequeue n_ptr t
      let _ ← R.sched.set_thread_state t sched.TS_RESTART
      let _ ← R.notification.unblock_sporadic t
      let _ ← R.sched.possible_switch_to t
      pure (.cont (next, fuel1))
    else do
      pure (.done ())

