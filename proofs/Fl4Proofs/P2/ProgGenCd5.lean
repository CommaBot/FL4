@[irreducible] noncomputable def R.objects.retire_dma_frame (ptr : Std.U64) (size : capability.FrameSize) : SProg Unit := do
  let b ← R.machine.sharing_enabled
  if b then do
    let i ← SProg.liftR (capability.FrameSize.bits size)
    let i1 ← pure ((i &&& 63#u64))
    let bytes ← SProg.liftR (1#u64 <<< i1)
    let b1 ← AR.dma_ram ptr bytes
    if b1 then do
      AR.dma_frame ptr bytes false
    else do
      pure (())
  else do
    pure (())

@[reif_simps] theorem R.objects.retire_dma_frame_eq (ptr : Std.U64) (size : capability.FrameSize) (sS : S) (aA : A) :
    interp mS mA (R.objects.retire_dma_frame ptr size) sS aA =
      (fl4_core.objects.retire_dma_frame mS mA sS aA ptr size >>= fun r => ok ((), sS, r)) := by
  unfold R.objects.retire_dma_frame
  simp only [reif_simps, fl4_core.objects.retire_dma_frame]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.objects.retire_dma_frame_nz (ptr : Std.U64) (size : capability.FrameSize) : NoZero (R.objects.retire_dma_frame ptr size) := by
  unfold R.objects.retire_dma_frame
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.machine.sharing_enabled_nz)
    | (with_reducible apply AR.dma_frame_nz)
    | (with_reducible apply AR.dma_ram_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.sched.suspend (t : obj.Tcb) : SProg Unit := do
  let _ ← R.vcpu.cancel_run t
  let _ ← R.ipc.cancel_ipc t
  let i ← R.obj.Tcb.state t
  let _ ← SProg.blk 0 (
      if i = sched.TS_RUNNING then do
        do
          let ip ← R.obj.Tcb.reg t layout.reg.NEXT_IP
          R.obj.Tcb.set_reg t layout.reg.FAULT_IP ip
      else do
        pure (()))
  let _ ← R.sched.dequeue t
  let _ ← R.sched.release_remove t
  let _ ← R.schedcontext.cancel_yield_to t
  let _ ← R.sched.set_thread_state t sched.TS_INACTIVE
  pure (())

@[reif_simps] theorem R.sched.suspend_eq (t : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.sched.suspend t) sS aA =
      (fl4_core.sched.suspend mS mA sS aA t >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.sched.suspend
  simp only [reif_simps, fl4_core.sched.suspend]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.sched.suspend_nz (t : obj.Tcb) : NoZero (R.sched.suspend t) := by
  unfold R.sched.suspend
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.ipc.cancel_ipc_nz)
    | (with_reducible apply R.obj.Tcb.reg_nz)
    | (with_reducible apply R.obj.Tcb.set_reg_nz)
    | (with_reducible apply R.obj.Tcb.state_nz)
    | (with_reducible apply R.sched.dequeue_nz)
    | (with_reducible apply R.sched.release_remove_nz)
    | (with_reducible apply R.sched.set_thread_state_nz)
    | (with_reducible apply R.schedcontext.cancel_yield_to_nz)
    | (with_reducible apply R.vcpu.cancel_run_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

