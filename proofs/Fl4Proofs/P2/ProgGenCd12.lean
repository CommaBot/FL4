@[irreducible] noncomputable def R.cdt.finalise_slot_deferred_loop.body (slot : obj.Slot) (fuel : Std.U64) : SProg (ControlFlow Std.U64 (core.result.Result cdt.Finalised error.Exc)) := do
  if fuel > 0#u64 then do
    let fuel1 ← SProg.liftR (fuel - 1#u64)
    let cap ← R.obj.Slot.cap slot
    let b ← SProg.liftR (capability.Cap.is_null cap)
    if b then do
      pure (.done (core.result.Result.Ok { success := true, cleanup := capability.Cap.Null }))
    else do
      let fin ← R.cdt.is_final_capability_with_cap slot cap
      let (remainder, cleanup) ← R.objects.finalise_cap cap fin false
      let b1 ← SProg.liftR (cdt.cap_removable remainder slot)
      if b1 then do
        pure (.done (core.result.Result.Ok { success := true, cleanup }))
      else do
        let _ ← R.obj.Slot.set_cap slot remainder
        let b2 ← SProg.liftR (cdt.cap_cyclic_zombie remainder slot)
        if b2 then do
          pure (.done (core.result.Result.Ok { success := false, cleanup }))
        else do
          let _ ← SProg.blk 0 (
              match remainder with
              | capability.Cap.Null => do
                  pure (())
              | capability.Cap.Untyped _ _ _ _ => do
                  pure (())
              | capability.Cap.Endpoint _ _ _ _ _ _ => do
                  pure (())
              | capability.Cap.Notification _ _ _ _ => do
                  pure (())
              | capability.Cap.Reply _ _ => do
                  pure (())
              | capability.Cap.CNode _ _ _ _ => do
                  pure (())
              | capability.Cap.Thread _ => do
                  pure (())
              | capability.Cap.IrqControl => do
                  pure (())
              | capability.Cap.IrqHandler _ => do
                  pure (())
              | capability.Cap.Zombie ptr _ _ => do
                  R.cdt.cap_swap_for_delete ptr slot
              | capability.Cap.Domain => do
                  pure (())
              | capability.Cap.SchedContext _ _ => do
                  pure (())
              | capability.Cap.SchedControl _ => do
                  pure (())
              | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
                  pure (())
              | capability.Cap.PageTable _ _ _ _ => do
                  pure (())
              | capability.Cap.PageDirectory _ _ _ _ => do
                  pure (())
              | capability.Cap.Pdpt _ _ _ _ => do
                  pure (())
              | capability.Cap.Pml4 _ _ _ => do
                  pure (())
              | capability.Cap.Vcpu _ => do
                  pure (())
              | capability.Cap.Ept _ _ _ _ _ => do
                  pure (())
              | capability.Cap.AsidControl => do
                  pure (())
              | capability.Cap.AsidPool _ _ => do
                  pure (())
              | capability.Cap.IoPortControl => do
                  pure (())
              | capability.Cap.IoPort _ _ _ => do
                  pure (())
              | capability.Cap.TdxControl => do
                  pure (()))
          let r ← R.sched.preemption_point
          let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
          match cf with
          | core.ops.control_flow.ControlFlow.Continue _ => do
              pure (.cont fuel1)
          | core.ops.control_flow.ControlFlow.Break residual => do
              let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual cdt.Finalised (core.convert.FromSame error.Exc) residual)
              pure (.done r1)
  else do
    pure (.done (core.result.Result.Err error.Exc.Preempted))

