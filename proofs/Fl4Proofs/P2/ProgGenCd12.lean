@[irreducible] noncomputable def R.cdt.delete_deferred (slot : obj.Slot) : SProg (core.result.Result Unit error.Exc) := do
  let r ← R.cdt.finalise_slot_deferred slot
  let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val => do
      if val.success then do
        let _ ← R.cdt.empty_slot slot val.cleanup
        pure (core.result.Result.Ok ())
      else do
        pure (core.result.Result.Ok ())
  | core.ops.control_flow.ControlFlow.Break residual => do
      let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
      pure (r1)

@[reif_simps] theorem R.cdt.delete_deferred_eq (slot : obj.Slot) (sS : S) (aA : A) :
    interp mS mA (R.cdt.delete_deferred slot) sS aA =
      (fl4_core.cdt.delete_deferred mS mA sS aA slot >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.cdt.delete_deferred
  simp only [reif_simps, fl4_core.cdt.delete_deferred]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.cdt.delete_deferred_nz (slot : obj.Slot) : NoZero (R.cdt.delete_deferred slot) := by
  unfold R.cdt.delete_deferred
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.cdt.empty_slot_nz)
    | (with_reducible apply R.cdt.finalise_slot_deferred_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
