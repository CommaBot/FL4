@[irreducible] noncomputable def R.cdt.is_mdb_parent_of (a : obj.Slot) (b : obj.Slot) : SProg Bool := do
  let b1 ← R.obj.Slot.revocable a
  if b1 then do
    let ca ← R.obj.Slot.cap a
    let cb ← R.obj.Slot.cap b
    let b2 ← SProg.liftR (objects.same_region_as ca cb)
    if b2 then do
      match ca with
      | capability.Cap.Null => do
          pure (true)
      | capability.Cap.Untyped _ _ _ _ => do
          pure (true)
      | capability.Cap.Endpoint _ badge _ _ _ _ => do
          if badge = 0#u64 then do
            pure (true)
          else do
            let bb ← SProg.blk 0 (
                match cb with
                | capability.Cap.Null => do
                    pure (0#u64)
                | capability.Cap.Untyped _ _ _ _ => do
                    pure (0#u64)
                | capability.Cap.Endpoint _ badge1 _ _ _ _ => do
                    pure (badge1)
                | capability.Cap.Notification _ _ _ _ => do
                    pure (0#u64)
                | capability.Cap.Reply _ _ => do
                    pure (0#u64)
                | capability.Cap.CNode _ _ _ _ => do
                    pure (0#u64)
                | capability.Cap.Thread _ => do
                    pure (0#u64)
