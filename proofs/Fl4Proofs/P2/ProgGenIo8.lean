@[irreducible] noncomputable def R.ipc.do_ipc_transfer (sender : obj.Tcb) (ep : Std.U64) (badge : Std.U64) (grant : Bool) (receiver : obj.Tcb) : SProg Unit := do
  let recv_buf ← R.msg.lookup_ipc_buffer true receiver
  let i ← R.obj.Tcb.fault_type sender
  if i = fl4_abi.consts.fault.NullFault then do
    let send_buf ← R.msg.lookup_ipc_buffer false sender
    R.ipc.do_normal_transfer sender send_buf ep badge grant receiver recv_buf
  else do
    R.ipc.do_fault_transfer badge sender receiver recv_buf

