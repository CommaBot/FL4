    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 3 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 4 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 5 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 6 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 7 _ _ from ?_)); exact (fun r sB aB => ((), r.1, r.2)))
      ))
    | reif_step)
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.endpoint.send_ipc_nz (blocking : Bool) (do_call : Bool) (badge : Std.U64) (can_grant : Bool) (can_grant_reply : Bool) (can_donate : Bool) (thread : obj.Tcb) (ep_ptr : Std.U64) : NoZero (R.endpoint.send_ipc blocking do_call badge can_grant can_grant_reply can_donate thread ep_ptr) := by
  unfold R.endpoint.send_ipc
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.endpoint.ep_append_nz)
    | (with_reducible apply R.endpoint.ep_dequeue_nz)
    | (with_reducible apply R.endpoint.get_queue_nz)
    | (with_reducible apply R.endpoint.unblock_sporadic_nz)
    | (with_reducible apply R.ipc.do_ipc_transfer_nz)
    | (with_reducible apply R.ipc.reply_push_nz)
    | (with_reducible apply R.ipc.reply_unlink_nz)
    | (with_reducible apply R.obj.Ep.state_nz)
    | (with_reducible apply R.obj.Tcb.fault_type_nz)
    | (with_reducible apply R.obj.Tcb.reply_obj_nz)
    | (with_reducible apply R.obj.Tcb.sc_nz)
    | (with_reducible apply R.obj.Tcb.set_block_badge_nz)
    | (with_reducible apply R.obj.Tcb.set_block_flags_nz)
    | (with_reducible apply R.obj.Tcb.set_block_obj_nz)
    | (with_reducible apply R.obj.Tcb.set_state_nz)
    | (with_reducible apply R.sched.possible_switch_to_nz)
    | (with_reducible apply R.sched.schedule_tcb_nz)
    | (with_reducible apply R.sched.set_thread_state_nz)
    | (with_reducible apply R.schedcontext.donate_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

