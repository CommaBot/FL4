@[irreducible] noncomputable def R.endpoint.send_ipc (blocking : Bool) (do_call : Bool) (badge : Std.U64) (can_grant : Bool) (can_grant_reply : Bool) (can_donate : Bool) (thread : obj.Tcb) (ep_ptr : Std.U64) : SProg Unit := do
  let st ← R.obj.Ep.state ep_ptr
  if st = obj.EP_IDLE then do
    if blocking then do
      let _ ← R.obj.Tcb.set_state thread sched.TS_BLOCKED_ON_SEND
      let _ ← R.obj.Tcb.set_block_obj thread ep_ptr
      let _ ← R.obj.Tcb.set_block_badge thread badge
      let i ← SProg.blk 0 (
          if can_grant then do
            pure (endpoint.FLAG_GRANT)
          else do
            pure (0#u64))
      let i1 ← SProg.blk 1 (
          if can_grant_reply then do
            pure (endpoint.FLAG_GRANT_REPLY)
          else do
            pure (0#u64))
      let i2 ← pure ((i ||| i1))
      let i3 ← SProg.blk 2 (
          if do_call then do
            pure (endpoint.FLAG_CALL)
          else do
            pure (0#u64))
      let f ← pure ((i2 ||| i3))
      let _ ← R.obj.Tcb.set_block_flags thread f
      let _ ← R.sched.schedule_tcb thread
      let _ ← R.endpoint.ep_append ep_ptr thread obj.EP_SEND
      pure (())
    else do
      pure (())
  else do
    if st = obj.EP_SEND then do
      if blocking then do
        let _ ← R.obj.Tcb.set_state thread sched.TS_BLOCKED_ON_SEND
        let _ ← R.obj.Tcb.set_block_obj thread ep_ptr
        let _ ← R.obj.Tcb.set_block_badge thread badge
        let i ← SProg.blk 3 (
            if can_grant then do
              pure (endpoint.FLAG_GRANT)
            else do
              pure (0#u64))
        let i1 ← SProg.blk 4 (
            if can_grant_reply then do
              pure (endpoint.FLAG_GRANT_REPLY)
            else do
              pure (0#u64))
        let i2 ← pure ((i ||| i1))
        let i3 ← SProg.blk 5 (
            if do_call then do
              pure (endpoint.FLAG_CALL)
            else do
              pure (0#u64))
        let f ← pure ((i2 ||| i3))
        let _ ← R.obj.Tcb.set_block_flags thread f
        let _ ← R.sched.schedule_tcb thread
        let _ ← R.endpoint.ep_append ep_ptr thread obj.EP_SEND
        pure (())
      else do
        pure (())
    else do
      let q ← R.endpoint.get_queue ep_ptr
      let _ ← R.endpoint.ep_dequeue ep_ptr q.head
      let _ ← R.ipc.do_ipc_transfer thread ep_ptr badge can_grant q.head
      let i ← R.obj.Tcb.reply_obj q.head
      let _ ← SProg.blk 6 (
          if i != 0#u64 then do
            R.ipc.reply_unlink i q.head
          else do
            pure (()))
      let _ ← SProg.blk 7 (
          if do_call then do
            if i != 0#u64 then do
              if can_grant then do
                R.ipc.reply_push thread q.head i can_donate
              else do
                if can_grant_reply then do
                  R.ipc.reply_push thread q.head i can_donate
                else do
                  do
                    let _ ← R.sched.set_thread_state thread sched.TS_INACTIVE
                    pure (())
            else do
              do
                let _ ← R.sched.set_thread_state thread sched.TS_INACTIVE
                pure (())
          else do
            do
              let i1 ← R.obj.Tcb.fault_type thread
              if i1 != fl4_abi.consts.fault.NullFault then do
                if i != 0#u64 then do
                  if can_grant then do
                    R.ipc.reply_push thread q.head i can_donate
                  else do
                    if can_grant_reply then do
                      R.ipc.reply_push thread q.head i can_donate
                    else do
                      let _ ← R.sched.set_thread_state thread sched.TS_INACTIVE
                      pure (())
                else do
                  let _ ← R.sched.set_thread_state thread sched.TS_INACTIVE
                  pure (())
              else do
                if can_donate then do
                  let i2 ← R.obj.Tcb.sc q.head
                  if i2 = 0#u64 then do
                    let i3 ← R.obj.Tcb.sc thread
                    R.schedcontext.donate i3 q.head
                  else do
                    pure (())
                else do
                  pure (()))
      let _ ← R.sched.set_thread_state q.head sched.TS_RUNNING
      let _ ← R.endpoint.unblock_sporadic q.head
      let _ ← R.sched.possible_switch_to q.head
      pure (())

