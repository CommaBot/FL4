/-
# P2: generated program trees, part 11 of `Cd` (line hpzg)

GENERATED by `xtask/scripts/gen_prog.py Cd invBodyG`; do not edit. For each Store/Arch-generic function `f` of
the call closure: the tree `R.f` (the body with the store / Arch threading removed), its equation `R.f_eq`
(`interp` of the tree is `f` followed by `ok` of the threaded state, on every store and Arch instance) and
`R.f_nz` (`NoZero`). Loops: `R.<loop>.body` with its equation, the measure lemma `_dec`, the wrapper through
`interp_iterS`. No premises.
-/
import Fl4Proofs.P2.ProgGenCd10
open Aeneas Aeneas.Std Result

set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace Fl4Proofs.P2.PathObl
open fl4_core

section
variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.objects.finalise_cap_object (c : capability.Cap) (fin : Bool) : SProg (capability.Cap × capability.Cap) := do
  match c with
  | capability.Cap.Null => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Untyped _ _ _ _ => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Endpoint ptr _ _ _ _ _ => do
      if fin then do
        let _ ← R.endpoint.cancel_all_ipc ptr
        pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Notification ptr _ _ _ => do
      if fin then do
        let _ ← R.schedcontext.maybe_unbind_ntfn ptr
        let _ ← R.notification.unbind_maybe_notification ptr
        let _ ← R.notification.cancel_all_signals ptr
        pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Reply ptr _ => do
      if fin then do
        let i ← R.obj.Reply.tcb ptr
        let b ← SProg.liftR (obj.Tcb.is_null i)
        if b then do
          pure ((capability.Cap.Null, capability.Cap.Null))
        else do
          let st ← R.obj.Tcb.state i
          if st = sched.TS_BLOCKED_ON_REPLY then do
            let _ ← R.ipc.reply_remove ptr i
            pure ((capability.Cap.Null, capability.Cap.Null))
          else do
            if st = sched.TS_BLOCKED_ON_RECV then do
              let _ ← R.ipc.cancel_ipc i
              pure ((capability.Cap.Null, capability.Cap.Null))
            else do
              pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.CNode ptr radix _ _ => do
      if fin then do
        let i ← pure ((radix &&& 63#u64))
        let i1 ← SProg.liftR (1#u64 <<< i)
        pure ((capability.Cap.Zombie ptr radix i1, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Thread ptr => do
      if fin then do
        let _ ← R.smp.remote_tcb_stall ptr
        let _ ← R.vcpu.detach ptr
        let _ ← R.notification.unbind_notification ptr
        let _ ← R.timer.remove ptr
        let i ← R.obj.Tcb.sc ptr
        let b ← SProg.liftR (obj.Sc.is_null i)
        let _ ← SProg.blk 0 (
            if b then do
              pure (())
            else do
              do
                let _ ← R.schedcontext.unbind_tcb i
                let i1 ← R.obj.Sc.yield_from i
                let b1 ← SProg.liftR (obj.Tcb.is_null i1)
                if b1 then do
                  pure (())
                else do
                  R.schedcontext.complete_yield_to i1)
        let _ ← R.sched.suspend ptr
        let _ ← R.objects.debug_remove ptr
        let _ ← AR.fpu_release ptr
        let s8 ← SProg.liftR (obj.Tcb.slot ptr layout.tcb.SLOT_CTABLE)
        pure ((capability.Cap.Zombie s8 capability.ZOMBIE_TCB layout.tcb.NUM_SLOTS, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.IrqControl => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.IrqHandler _ => do
      if fin then do
        pure ((capability.Cap.Null, c))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Zombie _ _ _ => do
      pure ((c, capability.Cap.Null))
  | capability.Cap.Domain => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.SchedContext ptr _ => do
      if fin then do
        let _ ← R.schedcontext.unbind_all_tcbs ptr
        let _ ← R.schedcontext.unbind_ntfn ptr
        let _ ← R.schedcontext.unbind_reply ptr
        let i ← R.obj.Sc.yield_from ptr
        let b ← SProg.liftR (obj.Tcb.is_null i)
        let _ ← SProg.blk 1 (
            if b then do
              pure (())
            else do
              R.schedcontext.complete_yield_to i)
        let _ ← R.obj.Sc.set_refill_max ptr 0#u64
        let _ ← R.obj.Sc.set_sporadic ptr 0#u64
        pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.SchedControl _ => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Frame ptr size _ is_device mapped is_ept asid vaddr => do
      let _ ← SProg.blk 2 (
          if mapped then do
            if asid != 0#u64 then do
              if is_ept then do
                do
                  let i ← SProg.liftR (capability.FrameSize.bits size)
                  R.ept.unmap asid vaddr ptr i false
              else do
                R.vspace.unmap_page size asid vaddr ptr
            else do
              pure (())
          else do
            pure (()))
      if fin then do
        if is_device then do
          let _ ← R.objects.retire_dma_frame ptr size
          pure ((capability.Cap.Null, capability.Cap.Null))
        else do
          pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.PageTable ptr mapped asid vaddr => do
      if fin then do
        if mapped then do
          let _ ← R.vspace.unmap_page_table asid vaddr ptr
          pure ((capability.Cap.Null, capability.Cap.Null))
        else do
          pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.PageDirectory ptr mapped asid vaddr => do
      if fin then do
        if mapped then do
          let _ ← R.vspace.unmap_page_directory asid vaddr ptr
          pure ((capability.Cap.Null, capability.Cap.Null))
        else do
          pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Pdpt ptr mapped asid vaddr => do
      if fin then do
        if mapped then do
          let _ ← R.vspace.unmap_pdpt asid vaddr ptr
          pure ((capability.Cap.Null, capability.Cap.Null))
        else do
          pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Pml4 ptr mapped asid => do
      if fin then do
        if mapped then do
          let _ ← R.vspace.delete_asid asid ptr
          pure ((capability.Cap.Null, capability.Cap.Null))
        else do
          pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Vcpu ptr => do
      if fin then do
        let _ ← R.vcpu.finalise ptr
        pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.Ept _ _ _ _ _ => do
      if fin then do
        let _ ← R.ept.finalise c
        pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.AsidControl => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.AsidPool ptr asid_base => do
      if fin then do
        let _ ← R.vspace.delete_asid_pool asid_base ptr
        pure ((capability.Cap.Null, capability.Cap.Null))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.IoPortControl => do
      pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.IoPort first last owner => do
      let _ ← R.vcpu.revoke_ports owner first last
      if fin then do
        pure ((capability.Cap.Null, c))
      else do
        pure ((capability.Cap.Null, capability.Cap.Null))
  | capability.Cap.TdxControl => do
      pure ((capability.Cap.Null, capability.Cap.Null))

@[reif_simps] theorem R.objects.finalise_cap_object_eq (c : capability.Cap) (fin : Bool) (sS : S) (aA : A) :
    interp mS mA (R.objects.finalise_cap_object c fin) sS aA =
      (fl4_core.objects.finalise_cap_object mS mA sS aA c fin >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.objects.finalise_cap_object
  simp only [reif_simps, fl4_core.objects.finalise_cap_object]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r.1, r.2)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), r.1, r.2)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => ((), r.1, r.2)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.objects.finalise_cap_object_nz (c : capability.Cap) (fin : Bool) : NoZero (R.objects.finalise_cap_object c fin) := by
  unfold R.objects.finalise_cap_object
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.endpoint.cancel_all_ipc_nz)
    | (with_reducible apply R.ept.finalise_nz)
    | (with_reducible apply R.ept.unmap_nz)
    | (with_reducible apply R.ipc.cancel_ipc_nz)
    | (with_reducible apply R.ipc.reply_remove_nz)
    | (with_reducible apply R.notification.cancel_all_signals_nz)
    | (with_reducible apply R.notification.unbind_maybe_notification_nz)
    | (with_reducible apply R.notification.unbind_notification_nz)
    | (with_reducible apply R.obj.Reply.tcb_nz)
    | (with_reducible apply R.obj.Sc.set_refill_max_nz)
    | (with_reducible apply R.obj.Sc.set_sporadic_nz)
    | (with_reducible apply R.obj.Sc.yield_from_nz)
    | (with_reducible apply R.obj.Tcb.sc_nz)
    | (with_reducible apply R.obj.Tcb.state_nz)
    | (with_reducible apply R.objects.debug_remove_nz)
    | (with_reducible apply R.objects.retire_dma_frame_nz)
    | (with_reducible apply R.sched.suspend_nz)
    | (with_reducible apply R.schedcontext.complete_yield_to_nz)
    | (with_reducible apply R.schedcontext.maybe_unbind_ntfn_nz)
    | (with_reducible apply R.schedcontext.unbind_all_tcbs_nz)
    | (with_reducible apply R.schedcontext.unbind_ntfn_nz)
    | (with_reducible apply R.schedcontext.unbind_reply_nz)
    | (with_reducible apply R.schedcontext.unbind_tcb_nz)
    | (with_reducible apply R.smp.remote_tcb_stall_nz)
    | (with_reducible apply R.timer.remove_nz)
    | (with_reducible apply R.vcpu.detach_nz)
    | (with_reducible apply R.vcpu.finalise_nz)
    | (with_reducible apply R.vcpu.revoke_ports_nz)
    | (with_reducible apply R.vspace.delete_asid_nz)
    | (with_reducible apply R.vspace.delete_asid_pool_nz)
    | (with_reducible apply R.vspace.unmap_page_nz)
    | (with_reducible apply R.vspace.unmap_page_directory_nz)
    | (with_reducible apply R.vspace.unmap_page_table_nz)
    | (with_reducible apply R.vspace.unmap_pdpt_nz)
    | (with_reducible apply AR.fpu_release_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

