                pure (r2)
              else do
                let r2 ← R.cnode.copied_cap lbl length buf val src_cap
                let cf2 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r2)
                match cf2 with
                | core.ops.control_flow.ControlFlow.Continue val1 => do
                    let (new_cap, is_move) := val1
                    let b2 ← SProg.liftR (capability.Cap.is_null new_cap)
                    if b2 then do
                      let r3 ← SProg.liftR (error.illegal Unit)
                      pure (r3)
                    else do
                      let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                      if is_move then do
                        let _ ← R.cdt.move_cap new_cap val dest
                        pure (core.result.Result.Ok ())
                      else do
                        let _ ← R.cdt.insert_with_cap new_cap src_cap val dest
                        pure (core.result.Result.Ok ())
