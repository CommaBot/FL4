@[irreducible] noncomputable def R.ioport.set_mask (low : Std.U64) (high : Std.U64) (set : Bool) : SProg Unit := do
  let lw ← SProg.liftR (low >>> 6#i32)
  let hw ← SProg.liftR (high >>> 6#i32)
  let li ← pure ((low &&& 63#u64))
  let hi ← pure ((high &&& 63#u64))
  if lw = hw then do
    let i ← pure ((core.num.U64.wrapping_add hi 1#u64))
    let i1 ← SProg.liftR (ioport.pattern li i)
    R.ioport.apply lw i1 set
  else do
    let i ← SProg.liftR (ioport.pattern li 64#u64)
    let _ ← R.ioport.apply lw i set
    let w ← SProg.liftR (lw + 1#u64)
    let _ ← R.ioport.set_mask_loop set hw w
    let i1 ← pure ((core.num.U64.wrapping_add hi 1#u64))
    let i2 ← SProg.liftR (ioport.pattern 0#u64 i1)
    R.ioport.apply hw i2 set

