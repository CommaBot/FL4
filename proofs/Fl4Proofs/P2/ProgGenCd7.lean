@[irreducible] noncomputable def R.cnode.decode_rotate (length : Std.U64) (buf : Std.U64) (extra : Array obj.Slot 3#usize) (dest : obj.Slot) : SProg (core.result.Result Unit error.Exc) := do
  if length < 8#u64 then do
    let r ← SProg.liftR (error.truncated Unit)
    pure (r)
  else do
    let s1 ← SProg.liftR (Array.index_usize extra 0#usize)
    let b ← SProg.liftR (obj.Slot.is_null s1)
    if b then do
      let r ← SProg.liftR (error.truncated Unit)
      pure (r)
    else do
      let s2 ← SProg.liftR (Array.index_usize extra 1#usize)
      let b1 ← SProg.liftR (obj.Slot.is_null s2)
      if b1 then do
        let r ← SProg.liftR (error.truncated Unit)
        pure (r)
      else do
        let ct ← R.sched.cur_thread
        let pivot_data ← R.msg.syscall_arg ct buf 2#u64
        let src_data ← R.msg.syscall_arg ct buf 5#u64
        let r ← R.cnode.rotate_slots buf extra dest
        let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
        match cf with
        | core.ops.control_flow.ControlFlow.Continue val => do
            let (src, pivot) := val
            let c ← R.obj.Slot.cap src
            let new_src ← SProg.liftR (objects.update_cap_data true src_data c)
            let c1 ← R.obj.Slot.cap pivot
            let new_pivot ← SProg.liftR (objects.update_cap_data true pivot_data c1)
            let b2 ← SProg.liftR (capability.Cap.is_null new_src)
            if b2 then do
              let r1 ← SProg.liftR (error.illegal Unit)
              pure (r1)
            else do
              let b3 ← SProg.liftR (capability.Cap.is_null new_pivot)
              if b3 then do
                let r1 ← SProg.liftR (error.illegal Unit)
                pure (r1)
              else do
                let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                let b4 ← SProg.liftR (obj.Slot.Insts.CoreCmpPartialEqSlot.eq src dest)
                if b4 then do
                  let _ ← R.cdt.swap new_src src new_pivot pivot
                  pure (core.result.Result.Ok ())
                else do
                  let _ ← R.cdt.move_cap new_pivot pivot dest
                  let _ ← R.cdt.move_cap new_src src pivot
                  pure (core.result.Result.Ok ())
        | core.ops.control_flow.ControlFlow.Break residual => do
            let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
            pure (r1)

