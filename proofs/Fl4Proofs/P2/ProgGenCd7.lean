      | core.ops.control_flow.ControlFlow.Continue _ => do
          let r1 ← R.cspace.lookup_source_slot src_root src_index src_depth
          let cf1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r1)
