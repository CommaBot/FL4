@[irreducible] noncomputable def R.ept.unmap (asid : Std.U64) (gpa : Std.U64) (ptr : Std.U64) (level : Std.U64) (table : Bool) : SProg Unit := do
  let r ← R.ept.find asid
  match r with
  | core.result.Result.Ok r1 => do
      let r2 ← R.ept.lookup r1 gpa level
      match r2 with
      | core.result.Result.Ok x => do
          let e ← SProg.read x
          let large ← SProg.blk 0 (
              if table then do
                pure (false)
              else do
                if level > 12#u64 then do
                  pure (true)
                else do
                  pure (false))
          let mask ← SProg.blk 1 (
              if large then do
                do
                  let i ← pure ((level &&& 63#u64))
                  let i1 ← SProg.liftR (1#u64 <<< i)
                  let i2 ← SProg.liftR (i1 - 1#u64)
                  let i3 ← pure ((~~~ i2))
                  pure ((ept.ADDRESS &&& i3))
              else do
                pure (ept.ADDRESS))
          let i ← pure ((e &&& 1#u64))
          if i = 0#u64 then do
            pure (())
          else do
            if level != 12#u64 then do
              let i1 ← pure ((e &&& 128#u64))
              if (i1 != 0#u64) != large then do
                pure (())
              else do
                let i2 ← pure ((e &&& mask))
                let i3 ← SProg.liftR (layout.paddr ptr)
                if i2 != i3 then do
                  pure (())
                else do
                  let _ ← SProg.write x 0#u64
                  R.ept.invalidate r1
            else do
              let i1 ← pure ((e &&& mask))
              let i2 ← SProg.liftR (layout.paddr ptr)
              if i1 != i2 then do
                pure (())
              else do
                let _ ← SProg.write x 0#u64
                R.ept.invalidate r1
      | core.result.Result.Err _ => do
          pure (())
  | core.result.Result.Err _ => do
      pure (())

