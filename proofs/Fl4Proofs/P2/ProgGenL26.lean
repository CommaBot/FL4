@[irreducible] noncomputable def R.sched.activate_thread  : SProg Unit := do
  let ct ← R.sched.cur_thread
  let i ← R.obj.Tcb.yield_to ct
  let _ ← SProg.blk 0 (
      if i != 0#u64 then do
        R.schedcontext.complete_yield_to ct
      else do
        pure (()))
  let st ← R.obj.Tcb.state ct
  if st = sched.TS_RESTART then do
    let pc ← R.obj.Tcb.reg ct layout.reg.FAULT_IP
    let _ ← R.obj.Tcb.set_reg ct layout.reg.NEXT_IP pc
    let _ ← R.sched.set_thread_state ct sched.TS_RUNNING
    pure (())
  else do
    pure (())

