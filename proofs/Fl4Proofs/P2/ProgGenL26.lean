@[irreducible] noncomputable def R.sporadic.unblock_check_loop.body (sc : obj.Sc) (fuel : Std.U64) : SProg (ControlFlow Std.U64 Unit) := do
  let b ← R.sporadic.head_overlapping sc
  if b then do
    if fuel > 0#u64 then do
      let fuel1 ← SProg.liftR (fuel - 1#u64)
      let old ← R.sporadic.pop_head sc
      let h ← R.sporadic.head sc
      let i ← pure ((core.num.U64.wrapping_add h.amount old.amount))
      let _ ← R.sporadic.set_head sc { old with amount := i }
      pure (.cont fuel1)
    else do
      pure (.done ())
  else do
    pure (.done ())

