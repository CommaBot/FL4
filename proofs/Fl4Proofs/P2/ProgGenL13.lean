@[irreducible] noncomputable def R.sporadic.size (sc : obj.Sc) : SProg Std.U64 := do
  let h ← R.obj.Sc.refill_head sc
  let t ← R.obj.Sc.refill_tail sc
  if h <= t then do
    let i ← pure ((core.num.U64.wrapping_sub t h))
    pure ((core.num.U64.wrapping_add i 1#u64))
  else do
    let i ← pure ((core.num.U64.wrapping_add t 1#u64))
    let i1 ← R.obj.Sc.refill_max sc
    let i2 ← pure ((core.num.U64.wrapping_sub i1 h))
    pure ((core.num.U64.wrapping_add i i2))

