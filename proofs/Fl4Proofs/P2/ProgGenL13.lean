@[irreducible] noncomputable def R.sporadic.sc_sporadic (sc : obj.Sc) : SProg Bool := do
  let b ← SProg.liftR (obj.Sc.is_null sc)
  if b then do
    pure (false)
  else do
    let i ← R.obj.Sc.sporadic sc
    pure ((i != 0#u64))

@[reif_simps] theorem R.sporadic.sc_sporadic_eq (sc : obj.Sc) (sS : S) (aA : A) :
    interp mS mA (R.sporadic.sc_sporadic sc) sS aA =
      (fl4_core.sporadic.sc_sporadic mS sS sc >>= fun r => ok (r, sS, aA)) := by
  unfold R.sporadic.sc_sporadic
  simp only [reif_simps, fl4_core.sporadic.sc_sporadic]
  reif_loop

@[reif_nz] theorem R.sporadic.sc_sporadic_nz (sc : obj.Sc) : NoZero (R.sporadic.sc_sporadic sc) := by
  unfold R.sporadic.sc_sporadic
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Sc.sporadic_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

