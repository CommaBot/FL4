    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.msg.lookup_ipc_buffer_nz)
    | (with_reducible apply R.msg.set_mr_nz)
    | (with_reducible apply R.msg.syscall_arg_nz)
    | (with_reducible apply R.obj.Tcb.reg_nz)
    | (with_reducible apply R.obj.Tcb.set_reg_nz)
    | (with_reducible apply R.sched.set_thread_state_nz)
    | (with_reducible apply R.vcpu.bound_nz)
    | (with_reducible apply R.vcpu.finish_notification_nz)
    | (with_reducible apply R.vcpu.full_reply_nz)
    | (with_reducible apply R.vcpu.get_nz)
    | (with_reducible apply R.vcpu.read_vmcs_nz)
    | (with_reducible apply R.vcpu.report_loop0_nz)
    | (with_reducible apply R.vcpu.report_loop1_nz)
    | (with_reducible apply R.vcpu.report_loop2_nz)
    | (with_reducible apply R.vcpu.report_loop3_nz)
    | (with_reducible apply R.vcpu.set_nz)
    | (with_reducible apply AR.virtualization_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
