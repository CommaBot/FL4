@[irreducible] noncomputable def R.timer.remove_fixup (cpu : Std.U64) (x0 : obj.Tcb) (parent0 : obj.Tcb) : SProg Unit := do
  let x ← R.timer.remove_fixup_loop cpu x0 parent0 256#u64
  let b ← SProg.liftR (obj.Tcb.is_null x)
  if b then do
    pure (())
  else do
    R.timer.set_red x false

