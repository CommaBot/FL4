variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.sched.postpone (sc : obj.Sc) : SProg Unit := do
  let i ← R.obj.Sc.tcb sc
  let _ ← R.sched.dequeue i
  let _ ← R.sched.release_enqueue i
  let cpu ← R.obj.Sc.cpu sc
  R.sched.set_reprogram_on cpu

@[reif_simps] theorem R.sched.postpone_eq (sc : obj.Sc) (sS : S) (aA : A) :
    interp mS mA (R.sched.postpone sc) sS aA =
      (fl4_core.sched.postpone mS sS sc >>= fun r => ok ((), r, aA)) := by
  unfold R.sched.postpone
  simp only [reif_simps, fl4_core.sched.postpone]
  reif_loop

@[reif_nz] theorem R.sched.postpone_nz (sc : obj.Sc) : NoZero (R.sched.postpone sc) := by
  unfold R.sched.postpone
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Sc.cpu_nz)
    | (with_reducible apply R.obj.Sc.tcb_nz)
    | (with_reducible apply R.sched.dequeue_nz)
    | (with_reducible apply R.sched.release_enqueue_nz)
    | (with_reducible apply R.sched.set_reprogram_on_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

