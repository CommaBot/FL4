                        let _ ← R.obj.Tcb.set_reg ct layout.reg.BADGE 0#u64
                        let n ← R.msg.set_mr ct b 0#u64 v
                        let mi ← SProg.liftR (msginfo.MessageInfo.new 0#u64 0#u64 0#u64 n)
                        R.msg.set_msg_info ct mi
                    else do
                      pure (()))
                let _ ← R.sched.set_thread_state ct sched.TS_RUNNING
                pure (core.result.Result.Ok ())
            | core.ops.control_flow.ControlFlow.Break residual => do
                let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
                pure (r1)
        else do
          if length < 2#u64 then do
            let r ← SProg.liftR (error.truncated Unit)
            pure (r)
          else do
            let i ← R.msg.syscall_arg ct buf 0#u64
            let port ← pure ((i &&& 65535#u64))
            let raw ← R.msg.syscall_arg ct buf 1#u64
            let r ← SProg.liftR (ioport.allowed first last port size)
            let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
            match cf with
            | core.ops.control_flow.ControlFlow.Continue _ => do
                let data ← SProg.blk 1 (
                    if size = 1#u64 then do
                      pure ((raw &&& 255#u64))
                    else do
                      if size = 2#u64 then do
                        pure ((raw &&& 65535#u64))
                      else do
                        pure ((raw &&& 4294967295#u64)))
                let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                let _ ← AR.port_out port size data
                pure (core.result.Result.Ok ())
            | core.ops.control_flow.ControlFlow.Break residual => do
                let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
                pure (r1)
  | capability.Cap.TdxControl => do
      let r ← SProg.liftR (error.illegal Unit)
      pure (r)

