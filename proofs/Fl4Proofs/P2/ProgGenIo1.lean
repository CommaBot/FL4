@[irreducible] noncomputable def R.ipc.do_fault_transfer (badge : Std.U64) (sender : obj.Tcb) (receiver : obj.Tcb) (recv_buf : Std.U64) : SProg Unit := do
  let sent ← R.faults.set_mrs_fault sender receiver recv_buf
  let ftype ← R.obj.Tcb.fault_type sender
  let mi ← SProg.liftR (msginfo.MessageInfo.new ftype 0#u64 0#u64 sent)
  let _ ← R.msg.set_msg_info receiver mi
  R.obj.Tcb.set_reg receiver layout.reg.BADGE badge

