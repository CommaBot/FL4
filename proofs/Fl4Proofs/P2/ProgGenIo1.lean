      pure (r)
  | capability.Cap.IoPortControl => do
      let r ← SProg.liftR (error.illegal Unit)
      pure (r)
  | capability.Cap.IoPort first last _ => do
      let ct ← R.sched.cur_thread
      let size ← SProg.liftR (ioport.port_size lbl)
      if size = 0#u64 then do
        let r ← SProg.liftR (error.illegal Unit)
        pure (r)
      else do
        let is_in ← SProg.liftR (ioport.is_port_in lbl)
