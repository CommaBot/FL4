@[irreducible] noncomputable def R.obj.Sc.badge (self : obj.Sc) : SProg Std.U64 := do
  let i ← pure ((core.num.U64.wrapping_add self layout.sc.BADGE))
  SProg.read i

@[reif_simps] theorem R.obj.Sc.badge_eq (self : obj.Sc) (sS : S) (aA : A) :
    interp mS mA (R.obj.Sc.badge self) sS aA =
      (fl4_core.obj.Sc.badge mS self sS >>= fun r => ok (r, sS, aA)) := by
  unfold R.obj.Sc.badge
  simp only [reif_simps, fl4_core.obj.Sc.badge]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.obj.Sc.badge_nz (self : obj.Sc) : NoZero (R.obj.Sc.badge self) := by
  unfold R.obj.Sc.badge
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

