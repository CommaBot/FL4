namespace Fl4Proofs.P2.PathObl
open fl4_core

section
variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.localtimer.fire_ok (cpu : Std.U64) (ct : obj.Tcb) (p : localtimer.TimerIrqPlan) (now : Std.U64) : SProg Bool := do
  if p.tm = 0#u64 then do
    pure (false)
  else do
    let i ← R.obj.Tcb.timer_right p.tm
    let i1 ← R.obj.Tcb.timer_parent p.tm
    let b ← SProg.liftR (obj.Tcb.is_null i)
    if b then do
      let b1 ← SProg.liftR (obj.Tcb.is_null i1)
      if b1 then do
        if p.ntfn = 0#u64 then do
          pure (true)
        else do
          let st ← R.obj.Ntfn.state p.ntfn
          if st = obj.NTFN_ACTIVE then do
            pure (true)
          else do
            if st = obj.NTFN_IDLE then do
              let b2 ← R.obj.Ntfn.bound_tcb p.ntfn
              if b2 = 0#u64 then do
                pure (true)
              else do
                if b2 != p.tm then do
                  pure (false)
                else do
                  let bs ← R.obj.Tcb.state p.tm
                  if bs = sched.TS_RUNNING_VM then do
                    pure (false)
                  else do
                    if bs = sched.TS_BLOCKED_ON_RECV then do
                      if p.waiter = p.tm then do
                        if p.ep != 0#u64 then do
                          R.localtimer.wake_ok cpu ct p.tm p.ntfn
                        else do
                          pure (false)
                      else do
                        pure (false)
                    else do
                      pure (true)
            else do
              if st = obj.NTFN_WAITING then do
                let i2 ← R.obj.Ntfn.head p.ntfn
                R.localtimer.wake_ok cpu ct i2 p.ntfn
              else do
                pure (false)
      else do
        let i2 ← R.obj.Tcb.timer_deadline i1
        if i2 <= now then do
          pure (false)
        else do
          if p.ntfn = 0#u64 then do
            pure (true)
          else do
            let st ← R.obj.Ntfn.state p.ntfn
            if st = obj.NTFN_ACTIVE then do
              pure (true)
            else do
              if st = obj.NTFN_IDLE then do
                let b2 ← R.obj.Ntfn.bound_tcb p.ntfn
                if b2 = 0#u64 then do
                  pure (true)
                else do
                  if b2 != p.tm then do
                    pure (false)
                  else do
                    let bs ← R.obj.Tcb.state p.tm
                    if bs = sched.TS_RUNNING_VM then do
                      pure (false)
                    else do
                      if bs = sched.TS_BLOCKED_ON_RECV then do
                        if p.waiter = p.tm then do
                          if p.ep != 0#u64 then do
                            R.localtimer.wake_ok cpu ct p.tm p.ntfn
                          else do
                            pure (false)
                        else do
                          pure (false)
                      else do
                        pure (true)
              else do
                if st = obj.NTFN_WAITING then do
                  let i3 ← R.obj.Ntfn.head p.ntfn
                  R.localtimer.wake_ok cpu ct i3 p.ntfn
                else do
                  pure (false)
    else do
      let i2 ← R.localtimer.fire_ok_loop i layout.TREE_FUEL
      let b1 ← SProg.liftR (obj.Tcb.is_null i2)
      if b1 then do
        if p.ntfn = 0#u64 then do
          pure (true)
        else do
          let st ← R.obj.Ntfn.state p.ntfn
          if st = obj.NTFN_ACTIVE then do
            pure (true)
          else do
            if st = obj.NTFN_IDLE then do
              let b2 ← R.obj.Ntfn.bound_tcb p.ntfn
              if b2 = 0#u64 then do
                pure (true)
              else do
                if b2 != p.tm then do
                  pure (false)
                else do
                  let bs ← R.obj.Tcb.state p.tm
                  if bs = sched.TS_RUNNING_VM then do
                    pure (false)
                  else do
                    if bs = sched.TS_BLOCKED_ON_RECV then do
                      if p.waiter = p.tm then do
                        if p.ep != 0#u64 then do
                          R.localtimer.wake_ok cpu ct p.tm p.ntfn
                        else do
                          pure (false)
                      else do
                        pure (false)
                    else do
                      pure (true)
            else do
              if st = obj.NTFN_WAITING then do
                let i3 ← R.obj.Ntfn.head p.ntfn
                R.localtimer.wake_ok cpu ct i3 p.ntfn
              else do
                pure (false)
      else do
        let i3 ← R.obj.Tcb.timer_deadline i2
        if i3 <= now then do
          pure (false)
        else do
          if p.ntfn = 0#u64 then do
            pure (true)
          else do
            let st ← R.obj.Ntfn.state p.ntfn
            if st = obj.NTFN_ACTIVE then do
              pure (true)
            else do
              if st = obj.NTFN_IDLE then do
                let b2 ← R.obj.Ntfn.bound_tcb p.ntfn
                if b2 = 0#u64 then do
                  pure (true)
                else do
                  if b2 != p.tm then do
                    pure (false)
                  else do
                    let bs ← R.obj.Tcb.state p.tm
                    if bs = sched.TS_RUNNING_VM then do
                      pure (false)
                    else do
                      if bs = sched.TS_BLOCKED_ON_RECV then do
                        if p.waiter = p.tm then do
                          if p.ep != 0#u64 then do
                            R.localtimer.wake_ok cpu ct p.tm p.ntfn
                          else do
                            pure (false)
                        else do
                          pure (false)
                      else do
                        pure (true)
              else do
                if st = obj.NTFN_WAITING then do
                  let i4 ← R.obj.Ntfn.head p.ntfn
                  R.localtimer.wake_ok cpu ct i4 p.ntfn
                else do
                  pure (false)

@[reif_simps] theorem R.localtimer.fire_ok_eq (cpu : Std.U64) (ct : obj.Tcb) (p : localtimer.TimerIrqPlan) (now : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.localtimer.fire_ok cpu ct p now) sS aA =
      (fl4_core.localtimer.fire_ok mS sS cpu ct p now >>= fun r => ok (r, sS, aA)) := by
  unfold R.localtimer.fire_ok
  simp only [reif_simps, fl4_core.localtimer.fire_ok]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.localtimer.fire_ok_nz (cpu : Std.U64) (ct : obj.Tcb) (p : localtimer.TimerIrqPlan) (now : Std.U64) : NoZero (R.localtimer.fire_ok cpu ct p now) := by
  unfold R.localtimer.fire_ok
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.localtimer.fire_ok_loop_nz)
    | (with_reducible apply R.localtimer.wake_ok_nz)
    | (with_reducible apply R.obj.Ntfn.bound_tcb_nz)
    | (with_reducible apply R.obj.Ntfn.head_nz)
    | (with_reducible apply R.obj.Ntfn.state_nz)
    | (with_reducible apply R.obj.Tcb.state_nz)
    | (with_reducible apply R.obj.Tcb.timer_deadline_nz)
    | (with_reducible apply R.obj.Tcb.timer_parent_nz)
    | (with_reducible apply R.obj.Tcb.timer_right_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

