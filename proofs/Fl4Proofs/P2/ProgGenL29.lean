    if b1 then do
      pure (.done x)
    else do
      let b2 ← SProg.liftR (obj.Tcb.is_null p)
      if b2 then do
        pure (.done x)
      else do
        if fuel > 0#u64 then do
          let fuel1 ← SProg.liftR (fuel - 1#u64)
          let t1 ← R.timer.left p
          let b3 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq x t1)
          if b3 then do
            let w ← R.timer.right p
            let b4 ← R.timer.is_red w
            let w1 ← SProg.blk 0 (
                if b4 then do
                  do
                    let _ ← R.timer.set_red w false
                    let _ ← R.timer.set_red p true
                    let _ ← R.timer.rotate_left cpu p
                    let w2 ← R.timer.right p
                    pure (w2)
                else do
                  pure (w))
            let t2 ← R.timer.left w1
            let b5 ← R.timer.is_red t2
            if b5 then do
              let t3 ← R.timer.right w1
              let b6 ← R.timer.is_red t3
              let w2 ← SProg.blk 1 (
                  if b6 then do
                    pure (w1)
                  else do
                    do
                      let _ ← R.timer.set_red t2 false
                      let _ ← R.timer.set_red w1 true
                      let _ ← R.timer.rotate_right cpu w1
                      let w3 ← R.timer.right p
