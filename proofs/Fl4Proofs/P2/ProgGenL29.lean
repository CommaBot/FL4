    (h : fl4_core.timer.remove_fixup_loop.body mS cpu s x p fuel = ok (.cont σ0)) :
    (fun xL => xL.2.2.val) ((fun (σ0 : S × obj.Tcb × obj.Tcb × Std.U64) => ((σ0.2.1, σ0.2.2.1, σ0.2.2.2), σ0.1)) σ0).1 < (fun xL => xL.2.2.val) (x, p, fuel) := by
  simp only [fl4_core.timer.remove_fixup_loop.body] at h
  dec_peel
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

