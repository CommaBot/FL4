              let _ ← R.timer.set_red w2 pr
              let _ ← R.timer.set_red p false
              let wr ← R.timer.right w2
              let _ ← R.timer.set_red wr false
              let _ ← R.timer.rotate_left cpu p
              let x1 ← R.timer.root cpu
              pure (.cont (x1, 0#u64, fuel1))
            else do
              let t3 ← R.timer.right w1
              let b6 ← R.timer.is_red t3
              if b6 then do
                let b7 ← R.timer.is_red t3
                let w2 ← SProg.blk 2 (
                    if b7 then do
                      pure (w1)
                    else do
                      do
                        let _ ← R.timer.set_red t2 false
                        let _ ← R.timer.set_red w1 true
                        let _ ← R.timer.rotate_right cpu w1
                        let w3 ← R.timer.right p
                        pure (w3))
                let pr ← R.timer.is_red p
                let _ ← R.timer.set_red w2 pr
                let _ ← R.timer.set_red p false
                let wr ← R.timer.right w2
                let _ ← R.timer.set_red wr false
                let _ ← R.timer.rotate_left cpu p
                let x1 ← R.timer.root cpu
                pure (.cont (x1, 0#u64, fuel1))
              else do
                let _ ← R.timer.set_red w1 true
                let p1 ← R.timer.parent p
                pure (.cont (p, p1, fuel1))
          else do
            let b4 ← R.timer.is_red t1
            let w ← SProg.blk 3 (
                if b4 then do
                  do
                    let _ ← R.timer.set_red t1 false
                    let _ ← R.timer.set_red p true
                    let _ ← R.timer.rotate_right cpu p
                    let w1 ← R.timer.left p
                    pure (w1)
                else do
                  pure (t1))
            let t2 ← R.timer.left w
            let b5 ← R.timer.is_red t2
            if b5 then do
              let b6 ← R.timer.is_red t2
              let w1 ← SProg.blk 4 (
                  if b6 then do
                    pure (w)
                  else do
                    do
                      let wr ← R.timer.right w
                      let _ ← R.timer.set_red wr false
                      let _ ← R.timer.set_red w true
                      let _ ← R.timer.rotate_left cpu w
                      let w2 ← R.timer.left p
                      pure (w2))
              let pr ← R.timer.is_red p
              let _ ← R.timer.set_red w1 pr
              let _ ← R.timer.set_red p false
              let wl ← R.timer.left w1
              let _ ← R.timer.set_red wl false
              let _ ← R.timer.rotate_right cpu p
              let x1 ← R.timer.root cpu
              pure (.cont (x1, 0#u64, fuel1))
            else do
