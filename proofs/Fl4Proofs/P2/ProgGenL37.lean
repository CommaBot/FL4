@[reif_simps] theorem R.fastpath.reply_recv_found_eq (t : obj.Tcb) (rptr : Std.U64) (ep_ptr : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.fastpath.reply_recv_found t rptr ep_ptr) sS aA =
      (fl4_core.fastpath.reply_recv_found mS mA sS aA t rptr ep_ptr >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.fastpath.reply_recv_found
  simp only [reif_simps, fl4_core.fastpath.reply_recv_found]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro)
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 3 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 4 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 5 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 6 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 7 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 8 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 9 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 10 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 11 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 12 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 13 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 14 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 15 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      | ((refine (show BlkShape S A 16 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 17 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      ))
    | reif_step)

