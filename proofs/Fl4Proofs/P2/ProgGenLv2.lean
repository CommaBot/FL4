GENERATED by `xtask/scripts/gen_prog.py Lv syscall.handle_reply_recv_vm_local localvm.handle_vcpu_exit_local localvm.handle_vm_timer_irq_local`; do not edit. For each Store/Arch-generic function `f` of
the call closure: the tree `R.f` (the body with the store / Arch threading removed), its equation `R.f_eq`
(`interp` of the tree is `f` followed by `ok` of the threaded state, on every store and Arch instance) and
`R.f_nz` (`NoZero`). Loops: `R.<loop>.body` with its equation, the measure lemma `_dec`, the wrapper through
`interp_iterS`. No premises.
-/
import Fl4Proofs.P2.ProgGenLv1
open Aeneas Aeneas.Std Result

set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace Fl4Proofs.P2.PathObl
open fl4_core

section
variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.syscall.handle_reply_recv_vm_local (found : (Std.U64 × Std.U64)) : SProg Bool := do
  let t ← R.sched.cur_thread
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let i ← R.obj.Tcb.flags t
    let i1 ← pure ((i &&& fl4_abi.consts.tcb_flag.TRAP_SYSCALLS))
    if i1 != 0#u64 then do
      pure (false)
    else do
      let next ← R.obj.Tcb.reg t layout.reg.NEXT_IP
      let i2 ← pure ((core.num.U64.wrapping_sub next 2#u64))
      let _ ← R.obj.Tcb.set_reg t layout.reg.FAULT_IP i2
      let _ ← R.sched.update_timestamp
      let csc ← R.sched.cur_sc
      let i3 ← R.sched.consumed
      let b ← R.sporadic.sufficient csc i3
      if b then do
        let (i4, i5) := found
        R.fastpath_vm.reply_recv_vm_found t i4 i5
      else do
        pure (false)

@[reif_simps] theorem R.syscall.handle_reply_recv_vm_local_eq (found : (Std.U64 × Std.U64)) (sS : S) (aA : A) :
    interp mS mA (R.syscall.handle_reply_recv_vm_local found) sS aA =
      (fl4_core.syscall.handle_reply_recv_vm_local mS mA sS aA found >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.syscall.handle_reply_recv_vm_local
  simp only [reif_simps, fl4_core.syscall.handle_reply_recv_vm_local]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.syscall.handle_reply_recv_vm_local_nz (found : (Std.U64 × Std.U64)) : NoZero (R.syscall.handle_reply_recv_vm_local found) := by
  unfold R.syscall.handle_reply_recv_vm_local
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.fastpath_vm.reply_recv_vm_found_nz)
    | (with_reducible apply R.obj.Tcb.flags_nz)
    | (with_reducible apply R.obj.Tcb.reg_nz)
    | (with_reducible apply R.obj.Tcb.set_reg_nz)
    | (with_reducible apply R.sched.consumed_nz)
    | (with_reducible apply R.sched.cur_sc_nz)
    | (with_reducible apply R.sched.cur_thread_nz)
    | (with_reducible apply R.sched.update_timestamp_nz)
    | (with_reducible apply R.sporadic.sufficient_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
