@[irreducible] noncomputable def R.vspace.unmap_page_directory (asid : Std.U64) (vaddr : Std.U64) (pd : Std.U64) : SProg Unit := do
  let r ← R.vspace.find_vspace_for_asid asid
  match r with
  | core.result.Result.Ok r1 => do
      let r2 ← R.vspace.lookup_pdpt_slot r1 vaddr
      match r2 with
      | core.result.Result.Ok x => do
          let e ← SProg.read x
          let i ← SProg.liftR (vspace.P_PRESENT)
          let i1 ← pure ((e &&& i))
          if i1 = 0#u64 then do
            pure (())
          else do
            let i2 ← SProg.liftR (vspace.P_PS)
            let i3 ← pure ((e &&& i2))
            if i3 != 0#u64 then do
              pure (())
            else do
              let i4 ← pure ((e &&& vspace.ADDR_MASK))
              let i5 ← SProg.liftR (layout.paddr pd)
              if i4 != i5 then do
                pure (())
              else do
                let _ ← AR.invalidate_asid asid
                let _ ← SProg.write x 0#u64
                let _ ← AR.invalidate_page_structures asid
                pure (())
      | core.result.Result.Err _ => do
          pure (())
  | core.result.Result.Err _ => do
      pure (())

@[reif_simps] theorem R.vspace.unmap_page_directory_eq (asid : Std.U64) (vaddr : Std.U64) (pd : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.vspace.unmap_page_directory asid vaddr pd) sS aA =
      (fl4_core.vspace.unmap_page_directory mS mA sS aA asid vaddr pd >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.vspace.unmap_page_directory
  simp only [reif_simps, fl4_core.vspace.unmap_page_directory]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.vspace.unmap_page_directory_nz (asid : Std.U64) (vaddr : Std.U64) (pd : Std.U64) : NoZero (R.vspace.unmap_page_directory asid vaddr pd) := by
  unfold R.vspace.unmap_page_directory
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.find_vspace_for_asid_nz)
    | (with_reducible apply R.vspace.lookup_pdpt_slot_nz)
    | (with_reducible apply AR.invalidate_asid_nz)
    | (with_reducible apply AR.invalidate_page_structures_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
