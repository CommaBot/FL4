@[irreducible] noncomputable def R.fastpath_vm.vm_fault (t : obj.Tcb) (f : error.Fault) : SProg Bool := do
  let i ← R.sched.action
  if i != sched.ACTION_RESUME_CURRENT then do
    pure (false)
  else do
    let s1 ← SProg.liftR (obj.Tcb.slot t layout.tcb.SLOT_FAULT_HANDLER)
    let c ← R.obj.Slot.cap s1
    match c with
    | capability.Cap.Null => do
        pure (false)
    | capability.Cap.Untyped _ _ _ _ => do
        pure (false)
    | capability.Cap.Endpoint ptr badge _ _ grant grant_reply => do
        if grant then do
          let i1 ← R.obj.Ep.state ptr
          if i1 != obj.EP_RECV then do
            pure (false)
          else do
            let i2 ← R.obj.Ep.head ptr
            let i3 ← R.obj.Tcb.reply_obj i2
            if i3 = 0#u64 then do
              pure (false)
            else do
              let b ← R.fastpath.schedulable_here i2
              if b then do
                let i4 ← R.sched.cur_domain
                let i5 ← R.obj.Tcb.prio i2
                let b1 ← R.sched.is_highest_prio i4 i5
                if b1 then do
                  let _ ← R.faults.set_fault t f
                  let tail ← R.obj.Ep.tail ptr
                  let _ ← SProg.blk 0 (
                      if tail = i2 then do
                        R.obj.Ep.set_queue ptr 0#u64 0#u64 obj.EP_IDLE
                      else do
                        do
                          let i6 ← R.obj.Tcb.ep_next i2
                          let _ ← R.obj.Tcb.set_ep_prev i6 0#u64
                          R.obj.Ep.set_queue ptr i6 tail obj.EP_RECV)
                  let _ ← R.obj.Tcb.set_ep_next i2 0#u64
                  let _ ← R.obj.Tcb.set_ep_prev i2 0#u64
                  let recv_buf ← R.msg.lookup_ipc_buffer true i2
                  let sent ← R.faults.set_mrs_fault t i2 recv_buf
                  let mi ← SProg.liftR (msginfo.MessageInfo.new fl4_abi.consts.fault.VMFault 0#u64 0#u64 sent)
                  let _ ← R.msg.set_msg_info i2 mi
                  let _ ← R.obj.Tcb.set_reg i2 layout.reg.BADGE badge
                  let _ ← R.obj.Reply.set_tcb i3 0#u64
                  let _ ← R.obj.Tcb.set_state i2 sched.TS_INACTIVE
                  let _ ← R.obj.Reply.set_tcb i3 t
                  let _ ← R.obj.Tcb.set_state t sched.TS_BLOCKED_ON_REPLY
                  let _ ← R.obj.Tcb.set_reply_obj t i3
                  let _ ← R.obj.Tcb.set_state i2 sched.TS_RUNNING
                  let i6 ← R.obj.Tcb.sc i2
                  let b2 ← R.sporadic.sc_sporadic i6
                  let _ ← SProg.blk 1 (
                      if b2 then do
                        do
                          let s16 ← R.sched.cur_sc
                          let b3 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc i6 s16)
                          if b3 then do
                            R.sporadic.unblock_check i6
                          else do
                            pure (())
                      else do
                        pure (()))
                  let _ ← R.obj.Tcb.set_sched_next i2 0#u64
                  let _ ← R.obj.Tcb.set_sched_prev i2 0#u64
                  let _ ← R.fastpath.switch_to i2
                  pure (true)
                else do
                  pure (false)
              else do
                pure (false)
        else do
          if grant_reply then do
            let i1 ← R.obj.Ep.state ptr
            if i1 != obj.EP_RECV then do
              pure (false)
            else do
              let i2 ← R.obj.Ep.head ptr
              let i3 ← R.obj.Tcb.reply_obj i2
              if i3 = 0#u64 then do
                pure (false)
              else do
                let b ← R.fastpath.schedulable_here i2
                if b then do
                  let i4 ← R.sched.cur_domain
                  let i5 ← R.obj.Tcb.prio i2
                  let b1 ← R.sched.is_highest_prio i4 i5
                  if b1 then do
                    let _ ← R.faults.set_fault t f
                    let tail ← R.obj.Ep.tail ptr
                    let _ ← SProg.blk 2 (
                        if tail = i2 then do
                          R.obj.Ep.set_queue ptr 0#u64 0#u64 obj.EP_IDLE
                        else do
                          do
                            let i6 ← R.obj.Tcb.ep_next i2
                            let _ ← R.obj.Tcb.set_ep_prev i6 0#u64
                            R.obj.Ep.set_queue ptr i6 tail obj.EP_RECV)
                    let _ ← R.obj.Tcb.set_ep_next i2 0#u64
                    let _ ← R.obj.Tcb.set_ep_prev i2 0#u64
                    let recv_buf ← R.msg.lookup_ipc_buffer true i2
                    let sent ← R.faults.set_mrs_fault t i2 recv_buf
                    let mi ← SProg.liftR (msginfo.MessageInfo.new fl4_abi.consts.fault.VMFault 0#u64 0#u64 sent)
                    let _ ← R.msg.set_msg_info i2 mi
                    let _ ← R.obj.Tcb.set_reg i2 layout.reg.BADGE badge
                    let _ ← R.obj.Reply.set_tcb i3 0#u64
                    let _ ← R.obj.Tcb.set_state i2 sched.TS_INACTIVE
                    let _ ← R.obj.Reply.set_tcb i3 t
                    let _ ← R.obj.Tcb.set_state t sched.TS_BLOCKED_ON_REPLY
                    let _ ← R.obj.Tcb.set_reply_obj t i3
                    let _ ← R.obj.Tcb.set_state i2 sched.TS_RUNNING
                    let i6 ← R.obj.Tcb.sc i2
                    let b2 ← R.sporadic.sc_sporadic i6
                    let _ ← SProg.blk 3 (
                        if b2 then do
                          do
                            let s16 ← R.sched.cur_sc
                            let b3 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc i6 s16)
                            if b3 then do
