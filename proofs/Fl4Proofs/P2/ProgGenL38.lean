@[reif_simps] theorem R.fastpath_vm.vm_fault_eq (t : obj.Tcb) (f : error.Fault) (sS : S) (aA : A) :
    interp mS mA (R.fastpath_vm.vm_fault t f) sS aA =
      (fl4_core.fastpath_vm.vm_fault mS mA sS aA t f >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.fastpath_vm.vm_fault
  simp only [reif_simps, fl4_core.fastpath_vm.vm_fault]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro)
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 2 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 3 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      ))
    | reif_step)

