@[irreducible] noncomputable def R.interrupt.irq_slot (irq : Std.U64) : SProg obj.Slot := do
  let i ← SProg.ksBase
  let i1 ← SProg.liftR (layout.ks.IRQ_NODE)
  let i2 ← pure ((core.num.U64.wrapping_add i i1))
  let i3 ← pure ((core.num.U64.wrapping_mul irq layout.cte.SIZE))
  let i4 ← pure ((core.num.U64.wrapping_add i2 i3))
  pure (i4)

