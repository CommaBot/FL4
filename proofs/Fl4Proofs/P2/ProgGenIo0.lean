@[irreducible] noncomputable def R.endpoint.unblock_sporadic (t : obj.Tcb) : SProg Unit := do
  let i ← R.obj.Tcb.sc t
  let b ← R.sporadic.sc_sporadic i
  if b then do
    let s1 ← R.sched.cur_sc
    let b1 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc i s1)
    if b1 then do
      R.sporadic.unblock_check i
    else do
      pure (())
  else do
    pure (())

