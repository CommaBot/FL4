@[irreducible] noncomputable def R.cspace.resolve_address_bits_loop.body (cptr : Std.U64) (cap : capability.Cap) (n : Std.U64) (fuel : Std.U64) : SProg (ControlFlow (capability.Cap × Std.U64 × Std.U64) (core.result.Result cspace.Resolved error.LookupFault)) := do
  match cap with
  | capability.Cap.Null => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Untyped _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Endpoint _ _ _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Notification _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Reply _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.CNode ptr radix guard_size guard => do
      let level ← pure ((core.num.U64.wrapping_add radix guard_size))
      if level = 0#u64 then do
        pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
      else do
        if fuel = 0#u64 then do
          pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
        else do
          let fuel1 ← SProg.liftR (fuel - 1#u64)
          let i ← pure ((core.num.U64.wrapping_sub n guard_size))
          let shift ← pure ((i &&& 63#u64))
          let i1 ← SProg.liftR (cptr >>> shift)
          let i2 ← SProg.liftR (cspace.mask guard_size)
          let g ← pure ((i1 &&& i2))
          if guard_size > n then do
            pure (.done (core.result.Result.Err (error.LookupFault.GuardMismatch guard n guard_size)))
          else do
            if g != guard then do
              pure (.done (core.result.Result.Err (error.LookupFault.GuardMismatch guard n guard_size)))
            else do
              if level > n then do
                pure (.done (core.result.Result.Err (error.LookupFault.DepthMismatch level n)))
              else do
                let i3 ← SProg.liftR (n - level)
                let i4 ← pure ((i3 &&& 63#u64))
                let i5 ← SProg.liftR (cptr >>> i4)
                let i6 ← SProg.liftR (cspace.mask radix)
                let offset ← pure ((i5 &&& i6))
                let slot ← SProg.liftR (obj.Slot.index ptr offset)
                if n = level then do
                  pure (.done (core.result.Result.Ok { slot, bits_left := 0#u64 }))
                else do
                  let next ← R.obj.Slot.cap slot
                  match next with
                  | capability.Cap.Null => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Untyped _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Endpoint _ _ _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Notification _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Reply _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.CNode _ _ _ _ => do
                      pure (.cont (next, i3, fuel1))
                  | capability.Cap.Thread _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.IrqControl => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.IrqHandler _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Zombie _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Domain => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.SchedContext _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.SchedControl _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.PageTable _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.PageDirectory _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Pdpt _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Pml4 _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Vcpu _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.Ept _ _ _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.AsidControl => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.AsidPool _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.IoPortControl => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.IoPort _ _ _ => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
                  | capability.Cap.TdxControl => do
                      pure (.done (core.result.Result.Ok { slot, bits_left := i3 }))
  | capability.Cap.Thread _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.IrqControl => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.IrqHandler _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Zombie _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Domain => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.SchedContext _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.SchedControl _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Frame _ _ _ _ _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.PageTable _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.PageDirectory _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Pdpt _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Pml4 _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Vcpu _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.Ept _ _ _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.AsidControl => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.AsidPool _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.IoPortControl => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.IoPort _ _ _ => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))
  | capability.Cap.TdxControl => do
      pure (.done (core.result.Result.Err error.LookupFault.InvalidRoot))

