/-- The measure of `cspace.resolve_address_bits_loop` drops at every `cont` step, on every store. -/
theorem R.cspace.resolve_address_bits_loop.body_dec (s : S) (cptr : Std.U64) (cap : capability.Cap) (n : Std.U64) (fuel : Std.U64) {σ0}
    (h : fl4_core.cspace.resolve_address_bits_loop.body mS s cptr cap n fuel = ok (.cont σ0)) :
    (fun xL => xL.2.2.val) σ0 < (fun xL => xL.2.2.val) (cap, n, fuel) := by
  simp only [fl4_core.cspace.resolve_address_bits_loop.body] at h
  split at h
  all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done))
  dec_peel
  rename_i hm
  split at hm
  all_goals (simp only [ok_eq_ok_iff, reduceCtorEq, ControlFlow.cont.injEq] at hm)
  subst hm
  simp only
  apply ge_sub1_lt <;> first | assumption | scalar_tac

