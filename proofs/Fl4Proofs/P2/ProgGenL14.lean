@[irreducible] noncomputable def R.faults.copy_mrs_fault_reply (sender : obj.Tcb) (receiver : obj.Tcb) (regs_list : Slice Std.U64) (length : Std.U64) : SProg Unit := do
  let i := Slice.len regs_list
  let i1 ← pure ((UScalar.cast .U64 i))
  let n ← SProg.blk 0 (
      if length < i1 then do
        pure ((UScalar.cast .Usize length))
      else do
        pure ((Slice.len regs_list)))
  let i2 ← R.faults.copy_mrs_fault_reply_loop0 sender receiver regs_list n 0#usize
  if i2 < n then do
    let buf ← R.msg.lookup_ipc_buffer false sender
    if buf != 0#u64 then do
      R.faults.copy_mrs_fault_reply_loop1 receiver regs_list n i2 buf
    else do
      pure (())
  else do
    pure (())

