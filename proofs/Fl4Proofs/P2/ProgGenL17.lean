@[irreducible] noncomputable def R.smp.remote_queue_update (t : obj.Tcb) : SProg Unit := do
  let cpu ← R.obj.Tcb.affinity t
  let i ← SProg.curCpu
  if cpu = i then do
    pure (())
  else do
    let i1 ← R.obj.Tcb.domain t
    let i2 ← R.sched.cur_domain
    if i1 != i2 then do
      pure (())
    else do
      let i3 ← R.obj.node_get cpu layout.node.CUR_THREAD
      let idle ← R.obj.node_get cpu layout.node.IDLE_THREAD
      if i3 = idle then do
        let i4 ← R.obj.node_get i layout.node.IPI_PENDING
        let i5 ← pure ((cpu &&& 63#u64))
        let i6 ← SProg.liftR (1#u64 <<< i5)
        let m ← pure ((i4 ||| i6))
        R.obj.node_set i layout.node.IPI_PENDING m
      else do
        let i4 ← R.obj.Tcb.prio t
        let i5 ← R.obj.Tcb.prio i3
        if i4 > i5 then do
          let i6 ← R.obj.node_get i layout.node.IPI_PENDING
          let i7 ← pure ((cpu &&& 63#u64))
          let i8 ← SProg.liftR (1#u64 <<< i7)
          let m ← pure ((i6 ||| i8))
          R.obj.node_set i layout.node.IPI_PENDING m
        else do
          let i6 ← R.obj.node_get cpu layout.node.REPROGRAM
          if i6 != 0#u64 then do
            let i7 ← R.obj.node_get i layout.node.IPI_PENDING
            let i8 ← pure ((cpu &&& 63#u64))
            let i9 ← SProg.liftR (1#u64 <<< i8)
            let m ← pure ((i7 ||| i9))
            R.obj.node_set i layout.node.IPI_PENDING m
          else do
            pure (())

