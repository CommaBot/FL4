/-- The measure of `localinv.Plan.still_holds_loop` drops at every `cont` step, on every store. -/
theorem R.localinv.Plan.still_holds_loop.body_dec (self : localinv.Plan) (s : S) (i : Std.Usize) {σ0}
    (h : fl4_core.localinv.Plan.still_holds_loop.body mS self s i = ok (.cont σ0)) :
    (fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) σ0 < (fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) i := by
  simp only [fl4_core.localinv.Plan.still_holds_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.localinv.Plan.still_holds_loop (self : localinv.Plan) (i : Std.Usize) : SProg Bool :=
  SProg.iter (fun xL => R.localinv.Plan.still_holds_loop.body self xL) ((fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) i + 1) i

@[reif_simps] theorem R.localinv.Plan.still_holds_loop_eq (self : localinv.Plan) (i : Std.Usize) (sS : S) (aA : A) :
    interp mS mA (R.localinv.Plan.still_holds_loop self i) sS aA =
      (fl4_core.localinv.Plan.still_holds_loop mS self sS i >>= fun r => ok (r, sS, aA)) := by
  unfold R.localinv.Plan.still_holds_loop fl4_core.localinv.Plan.still_holds_loop
  exact interp_iterR mS mA (fun (σ0 : Std.Usize) => fl4_core.localinv.Plan.still_holds_loop.body mS self sS σ0) (fun xL => R.localinv.Plan.still_holds_loop.body self xL) (fun xL => 2 ^ UScalarTy.Usize.numBits - xL.val) sS
    (fun xL aL => R.localinv.Plan.still_holds_loop.body_eq mS mA self xL sS aL)
    (fun xL cL h => R.localinv.Plan.still_holds_loop.body_dec mS self sS xL h) _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.localinv.Plan.still_holds_loop_nz (self : localinv.Plan) (i : Std.Usize) : NoZero (R.localinv.Plan.still_holds_loop self i) := by
  unfold R.localinv.Plan.still_holds_loop
  exact NoZero.iter (fun x => R.localinv.Plan.still_holds_loop.body_nz _ _) _ _

