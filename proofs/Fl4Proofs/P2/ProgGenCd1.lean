@[irreducible] noncomputable def R.invPostG (t : U64) (r : core.result.Result Unit error.Exc) : SProg (core.result.Result Unit error.Exc) := do
  match r with
  | core.result.Result.Ok _ => do
      let i6 ← R.obj.Tcb.state t
      let _ ← SProg.blk 0 (
          if i6 = sched.TS_RESTART then do
            do
              let _ ← R.msg.reply_success_empty t
              R.sched.set_thread_state t sched.TS_RUNNING
          else do
            pure (()))
      pure (core.result.Result.Ok ())
  | core.result.Result.Err e => do
      let r2 ← SProg.blk 1 (
          match e with
          | error.Exc.Fault _ => do
              pure (core.result.Result.Ok ())
          | error.Exc.Lookup _ => do
              pure (core.result.Result.Ok ())
          | error.Exc.Sys e1 => do
              do
                let _ ← R.syscall.reply_error t e1
                pure (core.result.Result.Ok ())
          | error.Exc.Preempted => do
              pure (r))
      pure (r2)

