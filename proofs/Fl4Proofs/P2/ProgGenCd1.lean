@[irreducible] noncomputable def R.ioport.apply (w : Std.U64) (p : Std.U64) (set : Bool) : SProg Unit := do
  let i ← SProg.liftR (ioport.word_off w)
  let v ← R.obj.ks_get i
  if set then do
    let i1 ← pure ((v ||| p))
    R.obj.ks_set i i1
  else do
    let i1 ← pure ((~~~ p))
    let i2 ← pure ((v &&& i1))
    R.obj.ks_set i i2

