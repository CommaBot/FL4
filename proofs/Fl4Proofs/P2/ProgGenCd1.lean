@[irreducible] noncomputable def R.localinv.Plan.still_holds_loop.body (self : localinv.Plan) (i : Std.Usize) : SProg (ControlFlow Std.Usize Bool) := do
  if i < self.nseen then do
    if i < localinv.MAX_LOCKS then do
      let p ← SProg.liftR (Array.index_usize self.seen i)
      let (addr, _) := p
      let (_, v) := p
      let i1 ← SProg.read addr
      if i1 != v then do
        pure (.done false)
      else do
        let i2 ← SProg.liftR (i + 1#usize)
        pure (.cont i2)
    else do
      pure (.done true)
  else do
    pure (.done true)

