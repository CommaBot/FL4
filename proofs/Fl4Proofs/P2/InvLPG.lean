/-
# P2 (line hpzg, generation 6): the frame-cap invocation local path with its program premise discharged

`inv_localPath` (`P2/InvLP.lean`, stpost gen 11) takes the program premise
`hpz : ∃ q, IsProgOn … q ∧ NoZero q ∧ InvRoW … q`. Here, for the tree `q := R.invBodyG number p` of the pruned
body (`P2/InvProgSrc.lean`, generated by `xtask/scripts/gen_prog.py` as `P2/ProgGenCd*.lean` on top of the L / Io /
Tm / Lv chains):

* `inv_isProg` (`IsProg (invBodyP S number p) (R.invBodyG number p)`), `inv_noZero`;
* `inv_hpz`: the whole of `hpz`, from `inv_isProgOn` (`P2/InvPrune.lean`, [J] `hSC`) and `invRoW_of`
  (`P2/InvOnce.lean`, [J] `hSeen`);
* **`inv_localPathG2`**: `inv_localPath` with `hpz` replaced by `hSC` [J] and `hSeen` [J]; the other premises
  (`hacc`, `hdec`, `hmv`, `hra` [W], `hK`, `hU`, `huf` [J], `hm` [P], `hPE`) as they are;
* **`inv_pathsKDG2`** / **`inv_pathsKDG2_startAt`**: stpost gen 12's `inv_pathsKD` (dec_alt / read_aligned
  discharged) with `hpz` discharged as well: `hSeen` is `InvSeenRS` (already a premise there), the new premise is
  [J] `hSC : InvSlotCNK` (at `Pre := SlJAt K ∧ Q K m`, the plan's slot is a slot of `K` holding a CNode cap).

No statement of an existing declaration changes; no `kernel_entry_reach*` is touched.
-/
import Fl4Proofs.P2.InvOnce
import Fl4Proofs.P2.ProgGenCdTop
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P2.PathObl
open fl4_core Fl4Proofs.P1
open Fl4Proofs.P2.OwnMap (KLayout own RegionOK fld oAFFINITY)
open Fl4Proofs.P2.E2E (Once ReadOnce)

/-- **`IsProg` for the pruned frame-cap invocation body**: it is the generated tree, on every store and Arch
instance. -/
theorem inv_isProg (S : Type) (number : I64) (p : localinv.Plan) :
    IsProg (invBodyP S number p) (R.invBodyG number p) := by
  intro A ar st
  funext s a
  show invBodyG st ar s a number p = _
  rw [R.invBodyG_eq st ar, bind_proj3]

theorem inv_noZero (number : I64) (p : localinv.Plan) : NoZero (R.invBodyG number p) :=
  R.invBodyG_nz number p

section
variable {S : Type} {st : machine.Store S} [L : LawfulStore st]
variable {T Cs Ω Sg Rp Scs Nt Ac : Set U64} {H : Heap} {Z : U64 → Nat} {K : KLayout}
variable {Locks : S → U64 → Prop} {m0 : U64 → U64}
variable {A : Type}

/-- **The program premise `hpz` of `inv_localPath`**, for the tree `R.invBodyG number p` (premises `hA`, `hPE`,
[J] `hSC`, [J] `hSeen`). -/
theorem inv_hpz {ar : machine.Arch A} (hA : P0.ArchTotal ar) {number : I64} {p : localinv.Plan}
    {P : S → Prop} (hPE : ∀ s, P s → IoPre st K T Cs Ω H Sg Rp Scs Nt Z Ac s)
    (hSC : InvSlotCN st K p P)
    (hSeen : ∀ s, P s → ∀ x, SeenW p x → IoRS (st := st) K Locks s x) :
    ∃ q : SProg Bool, IsProgOn (fun m s a => syscall.handle_invocation_local m ar s a number p) ar st
      (AltOf st P (IoRS (st := st) K Locks) (OwnMap.cls K) (OwnMap.ko K m0) (· ∈ K.user)) q ∧ NoZero q ∧
      InvRoW st ar number p K Locks m0 q P :=
  ⟨R.invBodyG number p, inv_isProgOn hA hPE hSC (inv_isProg S number p), inv_noZero number p,
    invRoW_of hA hPE hSeen (inv_isProgOn hA hPE hSC (inv_isProg S number p)) (inv_noZero number p)⟩

/-- **The frame-cap invocation local path, program premise discharged** (module docstring): `inv_localPath` with
`hpz` from `inv_hpz`. Premises: `hA`, `hK` [J], `hU` [J], `hm` [P], `hPE`, `hacc` [W], `hdec` [W], `hmv` [W],
`hra` [W], `huf` [J] (as `inv_localPath`), **`hSC` [J]** (`InvSlotCN`), **`hSeen` [J]**. -/
noncomputable def inv_localPathG2 (ar : machine.Arch A) (hA : P0.ArchTotal ar) (hK : RegionOK K)
    (hU : E2E.UserOK K) (number : I64) (p : localinv.Plan) (hm : E2E.MasksWr st)
    {P : S → Prop} (hPE : ∀ s, P s → IoPre st K T Cs Ω H Sg Rp Scs Nt Z Ac s)
    (hacc : InvAccW st ar number p K Locks P) (hdec : InvDecW st ar number p K Locks m0 P)
    (hmv : InvMoveW st ar number p K Locks m0 P) (hra : InvRaW st ar number p K Locks m0 P)
    (huf : ∀ s b v, P s → b ∈ K.user → Aligned b →
      P (L.wr s b v) ∧ Locks (L.wr s b v) = Locks s ∧
        IoRS (st := st) K Locks (L.wr s b v) = IoRS (st := st) K Locks s ∧
        IoWS (st := st) K Locks (L.wr s b v) = IoWS (st := st) K Locks s ∧
        IoDS (st := st) (L.wr s b v) = IoDS (st := st) s)
    (hSC : InvSlotCN st K p P)
    (hSeen : ∀ s, P s → ∀ x, SeenW p x → IoRS (st := st) K Locks s x) :
    E2E.LocalPath (own K) (OwnMap.cls K) (OwnMap.ko K m0) (· ∈ K.user) :=
  inv_localPath (m0 := m0) ar hA hK hU number p hm hPE hacc hdec hmv hra huf (inv_hpz hA hPE hSC hSeen)

end

/-! ## At chain states (`inv_pathsKD` with `hpz` discharged) -/

section paths
variable {S : Type} {st : machine.Store S} [L : LawfulStore st]
variable {Cs Ω Sg Ac : Set U64} {Locks : S → U64 → Prop}
variable {A : Type}

/-- [J] **The plan's slot holds a CNode cap** at the path's `Pre` (`SlJAt K ∧ Q K m`), for every layout and
memory: `InvSlotCN` at that `Pre`. -/
def InvSlotCNK (st : machine.Store S) [L : LawfulStore st] (p : localinv.Plan)
    (Q : KLayout → (U64 → U64) → S → Prop) : Prop :=
  ∀ K m, InvSlotCN st K p (fun s => SlJAt (L := L) K s ∧ Q K m s)

/-- (hpzg gen 6) **`inv_pathsKD` with the program premise discharged**: `hpz` from `inv_hpz` (`hSeen` is
`InvSeenRS`, already a premise; new [J] `hSC : InvSlotCNK`). Other premises as `inv_pathsKD`: `hA`, `hm` [P],
`Q`, `hPE`, `hacc` [W], `hSeen` [J], `hmv` [W], `huf` [J]. -/
noncomputable def inv_pathsKDG2 (ar : machine.Arch A) (hA : P0.ArchTotal ar) (number : I64) (p : localinv.Plan)
    (hm : E2E.MasksWr st) (Q : KLayout → (U64 → U64) → S → Prop)
    (hPE : ∀ K m s, SlJAt (L := L) K s → Q K m s →
      IoPre st K K.heap.tcbs Cs Ω K.heap Sg K.heap.replies K.heap.scs K.heap.ntfns K.heap.scBits Ac s)
    (hacc : ∀ K m, InvAccW st ar number p K Locks (fun s => SlJAt (L := L) K s ∧ Q K m s))
    (hSeen : InvSeenRS st Locks p Q)
    (hmv : ∀ K m, InvMoveW st ar number p K Locks m (fun s => SlJAt (L := L) K s ∧ Q K m s))
    (huf : ∀ K m s b v, SlJAt (L := L) K s → Q K m s → b ∈ K.user → Aligned b →
      (SlJAt (L := L) K (L.wr s b v) ∧ Q K m (L.wr s b v)) ∧ Locks (L.wr s b v) = Locks s ∧
        IoRS (st := st) K Locks (L.wr s b v) = IoRS (st := st) K Locks s ∧
        IoWS (st := st) K Locks (L.wr s b v) = IoWS (st := st) K Locks s ∧
        IoDS (st := st) (L.wr s b v) = IoDS (st := st) s)
    (hSC : InvSlotCNK st p Q) :
    E2E.Paths Unit :=
  inv_pathsKD ar hA number p hm Q hPE hacc hSeen hmv huf
    (fun K m => inv_hpz hA (fun s h => hPE K m s h.1 h.2) (hSC K m) (fun s h => hSeen K m s h.1 h.2))

/-- (hpzg gen 6) **`StartAt` of `inv_pathsKDG2` at a chain state** (as `inv_pathsKD_startAt`). -/
theorem inv_pathsKDG2_startAt (ar : machine.Arch A) (hA : P0.ArchTotal ar) (number : I64) (p : localinv.Plan)
    (hm : E2E.MasksWr st) (Q : KLayout → (U64 → U64) → S → Prop)
    (hPE : ∀ K m s, SlJAt (L := L) K s → Q K m s →
      IoPre st K K.heap.tcbs Cs Ω K.heap Sg K.heap.replies K.heap.scs K.heap.ntfns K.heap.scBits Ac s)
    (hacc : ∀ K m, InvAccW st ar number p K Locks (fun s => SlJAt (L := L) K s ∧ Q K m s))
    (hSeen : InvSeenRS st Locks p Q)
    (hmv : ∀ K m, InvMoveW st ar number p K Locks m (fun s => SlJAt (L := L) K s ∧ Q K m s))
    (huf : ∀ K m s b v, SlJAt (L := L) K s → Q K m s → b ∈ K.user → Aligned b →
      (SlJAt (L := L) K (L.wr s b v) ∧ Q K m (L.wr s b v)) ∧ Locks (L.wr s b v) = Locks s ∧
        IoRS (st := st) K Locks (L.wr s b v) = IoRS (st := st) K Locks s ∧
        IoWS (st := st) K Locks (L.wr s b v) = IoWS (st := st) K Locks s ∧
        IoDS (st := st) (L.wr s b v) = IoDS (st := st) s)
    (hSC : InvSlotCNK st p Q)
    (K : KLayout) (m : U64 → U64) (hK : RegionOK K) (hU : E2E.UserOK K)
    {A3 : Type} {Rc : S → A3 → Fl4Spec.State Unit → Prop}
    (h7 : ∀ (σ : S) (a : A3) (τ : Fl4Spec.State Unit), Rc σ a τ → SlJAt (L := L) K σ)
    {σ : S} {a3 : A3} {τ : Fl4Spec.State Unit} (hR : Rc σ a3 τ) (a : A) (hq : Q K m σ)
    {c : U64} {hs : U64 → Prop} (hc : L.cpu σ = c) (hl : Locks σ = hs) {μ : U64 → U64}
    (hμ : ∀ x, Aligned x → x ∉ K.user → L.mem σ x = μ x) :
    E2E.StartAt (inv_pathsKDG2 ar hA number p hm Q hPE hacc hSeen hmv huf hSC () K m hK hU) c hs μ
      ((inv_pathsKDG2 ar hA number p hm Q hPE hacc hSeen hmv huf hSC () K m hK hU).body σ a) :=
  ⟨σ, a, ⟨h7 σ a3 τ hR, hq⟩, hc, hl, hμ, rfl⟩

end paths

end Fl4Proofs.P2.PathObl
