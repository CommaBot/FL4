@[irreducible] noncomputable def R.cnode.decode (lbl : Std.U64) (length : Std.U64) (cap : capability.Cap) (buf : Std.U64) (extra : Array obj.Slot 3#usize) : SProg (core.result.Result Unit error.Exc) := do
  if lbl < fl4_abi.label.CNodeRevoke then do
    let r ← SProg.liftR (error.illegal Unit)
    pure (r)
  else do
    if lbl > fl4_abi.label.CNodeRotate then do
      let r ← SProg.liftR (error.illegal Unit)
      pure (r)
    else do
      if length < 2#u64 then do
        let r ← SProg.liftR (error.truncated Unit)
        pure (r)
      else do
        let ct ← R.sched.cur_thread
        let index ← R.msg.syscall_arg ct buf 0#u64
        let depth ← R.msg.syscall_arg ct buf 1#u64
        let r ← R.cspace.lookup_target_slot cap index depth
        let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
        match cf with
        | core.ops.control_flow.ControlFlow.Continue val => do
            if lbl >= fl4_abi.label.CNodeCopy then do
              if lbl <= fl4_abi.label.CNodeMutate then do
                let r1 ← R.cnode.decode_copy lbl length buf extra val
                pure (r1)
              else do
                if lbl = fl4_abi.label.CNodeRevoke then do
                  let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                  R.cdt.revoke val
                else do
                  if lbl = fl4_abi.label.CNodeDelete then do
                    let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                    R.cdt.delete val true
                  else do
                    if lbl = fl4_abi.label.CNodeCancelBadgedSends then do
                      let r1 ← R.cnode.decode_cancel_badged_sends val
                      pure (r1)
                    else do
                      if lbl = fl4_abi.label.CNodeRotate then do
                        let r1 ← R.cnode.decode_rotate length buf extra val
                        pure (r1)
                      else do
                        pure (core.result.Result.Ok ())
            else do
              if lbl = fl4_abi.label.CNodeRevoke then do
                let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                R.cdt.revoke val
              else do
                if lbl = fl4_abi.label.CNodeDelete then do
                  let _ ← R.sched.set_thread_state ct sched.TS_RESTART
                  R.cdt.delete val true
                else do
                  if lbl = fl4_abi.label.CNodeCancelBadgedSends then do
                    let r1 ← R.cnode.decode_cancel_badged_sends val
                    pure (r1)
                  else do
                    if lbl = fl4_abi.label.CNodeRotate then do
                      let r1 ← R.cnode.decode_rotate length buf extra val
                      pure (r1)
                    else do
                      pure (core.result.Result.Ok ())
        | core.ops.control_flow.ControlFlow.Break residual => do
            let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
            pure (r1)

