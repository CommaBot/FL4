@[irreducible] noncomputable def R.cdt.revoke_loop.body (slot : obj.Slot) (fuel : Std.U64) : SProg (ControlFlow Std.U64 (core.result.Result Unit error.Exc)) := do
  if fuel > 0#u64 then do
    let fuel1 ← SProg.liftR (fuel - 1#u64)
    let next ← R.obj.Slot.next slot
    let b ← SProg.liftR (obj.Slot.is_null next)
    if b then do
      pure (.done (core.result.Result.Ok ()))
    else do
      let b1 ← R.cdt.is_mdb_parent_of slot next
      if b1 then do
        let r ← R.cdt.delete next true
        let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
        match cf with
        | core.ops.control_flow.ControlFlow.Continue _ => do
            let r1 ← R.sched.preemption_point
            let cf1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r1)
            match cf1 with
            | core.ops.control_flow.ControlFlow.Continue _ => do
                pure (.cont fuel1)
            | core.ops.control_flow.ControlFlow.Break residual => do
                let r2 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
                pure (.done r2)
        | core.ops.control_flow.ControlFlow.Break residual => do
            let r1 ← SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Unit (core.convert.FromSame error.Exc) residual)
            pure (.done r1)
      else do
        pure (.done (core.result.Result.Ok ()))
  else do
    pure (.done (core.result.Result.Err error.Exc.Preempted))

