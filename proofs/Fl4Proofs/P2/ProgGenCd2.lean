@[irreducible] noncomputable def R.schedcontext.unbind_tcb (sc : obj.Sc) : SProg Unit := do
  let i ← R.obj.Sc.tcb sc
  let b ← SProg.liftR (obj.Tcb.is_null i)
  if b then do
    pure (())
  else do
    let t ← R.sched.cur_thread
    let b1 ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq i t)
    let _ ← SProg.blk 0 (
        if b1 then do
          R.sched.reschedule_required
        else do
          pure (()))
    let _ ← R.sched.dequeue i
    let _ ← R.sched.release_remove i
    let _ ← R.obj.Tcb.set_sc i 0#u64
