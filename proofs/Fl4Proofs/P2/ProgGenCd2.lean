@[irreducible] noncomputable def R.sched.preemption_point  : SProg (core.result.Result Unit error.Exc) := do
  let i ← R.obj.ks_get layout.ks.WORK_UNITS
  let w ← pure ((core.num.U64.wrapping_add i 1#u64))
  let _ ← R.obj.ks_set layout.ks.WORK_UNITS w
  if w >= sched.MAX_WORK_UNITS_PER_PREEMPTION then do
    let _ ← R.obj.ks_set layout.ks.WORK_UNITS 0#u64
    let _ ← R.sched.update_timestamp
    let irq ← AR.irq_pending
    let sc ← R.sched.cur_sc
    let c ← R.sched.consumed
    let b ← R.sporadic.sc_active sc
    let ok1 ← SProg.blk 0 (
        if b then do
          R.sporadic.sufficient sc c
        else do
          pure (false))
    if irq then do
      pure (core.result.Result.Err error.Exc.Preempted)
    else do
      let b1 ← R.sched.is_cur_domain_expired
      if b1 then do
        pure (core.result.Result.Err error.Exc.Preempted)
      else do
        if ok1 then do
          pure (core.result.Result.Ok ())
        else do
          pure (core.result.Result.Err error.Exc.Preempted)
  else do
    pure (core.result.Result.Ok ())

