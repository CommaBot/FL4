@[irreducible] noncomputable def R.ipc.reply_remove (r : obj.Reply) (t : obj.Tcb) : SProg Unit := do
  let next ← R.obj.Reply.next r
  let prev ← R.obj.Reply.prev r
  if next != 0#u64 then do
    let b ← R.obj.Reply.next_is_head r
    if b then do
      R.ipc.reply_pop r t
    else do
      let _ ← SProg.blk 0 (
          if next != 0#u64 then do
            R.obj.Reply.set_prev next 0#u64
          else do
            pure (()))
      let _ ← SProg.blk 1 (
          if prev != 0#u64 then do
            R.obj.Reply.set_next prev 0#u64 false
          else do
            pure (()))
      let _ ← R.obj.Reply.set_prev r 0#u64
      let _ ← R.obj.Reply.set_next r 0#u64 false
      let _ ← R.ipc.reply_unlink r t
      pure (())
  else do
    let _ ← SProg.blk 2 (
        if next != 0#u64 then do
          R.obj.Reply.set_prev next 0#u64
        else do
          pure (()))
    let _ ← SProg.blk 3 (
        if prev != 0#u64 then do
          R.obj.Reply.set_next prev 0#u64 false
        else do
          pure (()))
    let _ ← R.obj.Reply.set_prev r 0#u64
    let _ ← R.obj.Reply.set_next r 0#u64 false
    let _ ← R.ipc.reply_unlink r t
    pure (())

