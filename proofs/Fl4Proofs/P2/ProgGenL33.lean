@[irreducible] noncomputable def R.ipc.cancel_ipc (t : obj.Tcb) : SProg Unit := do
  let _ ← R.faults.clear_fault t
  let st ← R.obj.Tcb.state t
  if st = sched.TS_BLOCKED_ON_SEND then do
    let ep ← R.obj.Tcb.block_obj t
    let _ ← R.endpoint.ep_dequeue ep t
    let _ ← SProg.blk 0 (
        if st = sched.TS_BLOCKED_ON_RECV then do
          do
            let i ← R.obj.Tcb.reply_obj t
            if i != 0#u64 then do
              R.ipc.reply_unlink i t
            else do
              pure (())
        else do
          pure (()))
    let _ ← R.sched.set_thread_state t sched.TS_INACTIVE
    pure (())
  else do
    if st = sched.TS_BLOCKED_ON_RECV then do
      let ep ← R.obj.Tcb.block_obj t
      let _ ← R.endpoint.ep_dequeue ep t
      let _ ← SProg.blk 1 (
          if st = sched.TS_BLOCKED_ON_RECV then do
            do
              let i ← R.obj.Tcb.reply_obj t
              if i != 0#u64 then do
                R.ipc.reply_unlink i t
              else do
                pure (())
          else do
            pure (()))
      let _ ← R.sched.set_thread_state t sched.TS_INACTIVE
      pure (())
    else do
      if st = sched.TS_BLOCKED_ON_NTFN then do
        let i ← R.obj.Tcb.block_obj t
        let _ ← R.notification.cancel_signal t i
        pure (())
      else do
        if st = sched.TS_BLOCKED_ON_REPLY then do
          let _ ← R.ipc.reply_remove_tcb t
          pure (())
        else do
          pure (())

