@[irreducible] noncomputable def R.schedcontext.resume (sc : obj.Sc) : SProg Unit := do
  let b ← SProg.liftR (obj.Sc.is_null sc)
  if b then do
    pure (())
  else do
    let i ← R.obj.Sc.tcb sc
    let b1 ← SProg.liftR (obj.Tcb.is_null i)
    if b1 then do
      pure (())
    else do
      let b2 ← R.sched.is_schedulable i
      if b2 then do
        let b3 ← R.sporadic.ready sc
        if b3 then do
          let b4 ← R.sporadic.sufficient sc 0#u64
          if b4 then do
            pure (())
          else do
            let _ ← R.sched.postpone sc
            pure (())
        else do
          let _ ← R.sched.postpone sc
          pure (())
      else do
        pure (())

