@[irreducible] noncomputable def R.obj.Tcb.state (self : obj.Tcb) : SProg Std.U64 := do
  let i ← pure ((core.num.U64.wrapping_add self layout.tcb.STATE))
  SProg.read i

@[reif_simps] theorem R.obj.Tcb.state_eq (self : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.obj.Tcb.state self) sS aA =
      (fl4_core.obj.Tcb.state mS self sS >>= fun r => ok (r, sS, aA)) := by
  unfold R.obj.Tcb.state
  simp only [reif_simps, fl4_core.obj.Tcb.state]
  reif_loop

@[reif_nz] theorem R.obj.Tcb.state_nz (self : obj.Tcb) : NoZero (R.obj.Tcb.state self) := by
  unfold R.obj.Tcb.state
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

