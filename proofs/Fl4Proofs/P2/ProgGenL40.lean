@[irreducible] noncomputable def R.sched.schedule  : SProg Unit := do
  let _ ← R.sched.awaken
  let _ ← R.sched.check_domain_time
  let act ← R.sched.action
  let _ ← SProg.blk 2 (
      if act != sched.ACTION_RESUME_CURRENT then do
        do
          let ct ← R.sched.cur_thread
          let was_runnable ← R.sched.is_schedulable ct
          let _ ← SProg.blk 0 (
              if was_runnable then do
                R.sched.enqueue ct
              else do
                pure (()))
          if act = sched.ACTION_CHOOSE_NEW then do
            R.sched.schedule_choose_new_thread
          else do
            let ct1 ← R.sched.cur_thread
            let t ← R.sched.idle_thread
            let b ← SProg.liftR (obj.Tcb.Insts.CoreCmpPartialEqTcb.eq ct1 t)
            let fastfail ← SProg.blk 1 (
                if b then do
                  pure (true)
                else do
                  do
                    let i ← R.obj.Tcb.prio act
                    let i1 ← R.obj.Tcb.prio ct1
                    if i < i1 then do
                      pure (true)
                    else do
                      pure (false))
            if fastfail then do
              let i ← R.sched.cur_domain
              let i1 ← R.obj.Tcb.prio act
              let b1 ← R.sched.is_highest_prio i i1
              if b1 then do
                if was_runnable then do
                  let i2 ← R.obj.Tcb.prio ct1
                  if i1 = i2 then do
                    let _ ← R.sched.append act
                    let _ ← R.sched.set_action sched.ACTION_CHOOSE_NEW
                    R.sched.schedule_choose_new_thread
                  else do
                    R.sched.switch_to_thread act
                else do
                  R.sched.switch_to_thread act
              else do
                let _ ← R.sched.enqueue act
                let _ ← R.sched.set_action sched.ACTION_CHOOSE_NEW
                R.sched.schedule_choose_new_thread
            else do
              if was_runnable then do
                let i ← R.obj.Tcb.prio act
                let i1 ← R.obj.Tcb.prio ct1
                if i = i1 then do
                  let _ ← R.sched.append act
                  let _ ← R.sched.set_action sched.ACTION_CHOOSE_NEW
                  R.sched.schedule_choose_new_thread
                else do
                  R.sched.switch_to_thread act
              else do
                R.sched.switch_to_thread act
      else do
        pure (()))
  let _ ← R.sched.set_action sched.ACTION_RESUME_CURRENT
  let _ ← R.sched.switch_sched_context
  let c ← SProg.curCpu
  let i ← R.obj.node_get c layout.node.REPROGRAM
  let _ ← SProg.blk 3 (
      if i != 0#u64 then do
        do
          let _ ← R.sched.set_next_interrupt
          let _ ← R.obj.node_set c layout.node.REPROGRAM 0#u64
          pure (())
      else do
        pure (()))
  R.smp.send_pending

