@[irreducible] noncomputable def R.timer.fire_loop.body (now : Std.U64) (i : Std.U64) : SProg (ControlFlow Std.U64 Unit) := do
  if i < timer.FIRE_BATCH then do
    let i1 ← SProg.curCpu
    let i2 ← R.obj.node_get i1 layout.node.TIMER_MIN
    let b ← SProg.liftR (obj.Tcb.is_null i2)
    if b then do
      pure (.done ())
    else do
      let i3 ← R.obj.Tcb.timer_deadline i2
      if i3 > now then do
        pure (.done ())
      else do
        let badge ← R.obj.Tcb.timer_badge i2
        let _ ← R.timer.remove i2
        let n ← R.obj.Tcb.bound_ntfn i2
        let _ ← SProg.blk 0 (
            if n != 0#u64 then do
              R.notification.send_signal n badge
            else do
              pure (()))
        let c ← SProg.curCpu
        let _ ← R.obj.node_set c layout.node.REPROGRAM 1#u64
        let i4 ← SProg.liftR (i + 1#u64)
        pure (.cont i4)
  else do
    pure (.done ())

