        pure (false)
      else do
        let next ← R.obj.Tcb.reg t layout.reg.NEXT_IP
        let i2 ← pure ((core.num.U64.wrapping_sub next 2#u64))
        let _ ← R.obj.Tcb.set_reg t layout.reg.FAULT_IP i2
        let _ ← R.sched.update_timestamp
        let csc ← R.sched.cur_sc
        let i3 ← R.sched.consumed
        let b ← R.sporadic.sufficient csc i3
        if b then do
          if i1 != 0#u64 then do
            let i4 ← pure ((IScalar.hcast .U64 number))
