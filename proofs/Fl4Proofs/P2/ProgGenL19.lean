        let cur1 ← R.timer.left cur
        pure (.cont (cur, cur1, true, first, fuel1))
      else do
        let cur1 ← R.timer.right cur
        pure (.cont (cur, cur1, false, false, fuel1))
    else do
      pure (.done (p, go_left, first))

