  let b ← SProg.liftR (obj.Tcb.is_null cur)
  if b then do
    pure (.done (p, go_left, first))
  else do
    if fuel > 0#u64 then do
      let fuel1 ← SProg.liftR (fuel - 1#u64)
      let i ← R.obj.Tcb.timer_deadline cur
