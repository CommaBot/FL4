    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.timer.remove_loop3 (y : obj.Tcb) (fuel : Std.U64) : SProg obj.Tcb :=
  SProg.iter (fun xL => R.timer.remove_loop3.body xL.1 xL.2) ((fun xL => xL.2.val) (y, fuel) + 1) (y, fuel)

@[reif_simps] theorem R.timer.remove_loop3_eq (y : obj.Tcb) (fuel : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.timer.remove_loop3 y fuel) sS aA =
      (fl4_core.timer.remove_loop3 mS sS y fuel >>= fun r => ok (r, sS, aA)) := by
  unfold R.timer.remove_loop3 fl4_core.timer.remove_loop3
  exact interp_iterR mS mA (fun (σ0 : obj.Tcb × Std.U64) => fl4_core.timer.remove_loop3.body mS sS σ0.1 σ0.2) (fun xL => R.timer.remove_loop3.body xL.1 xL.2) (fun xL => xL.2.val) sS
    (fun xL aL => R.timer.remove_loop3.body_eq mS mA xL.1 xL.2 sS aL)
    (fun xL cL h => R.timer.remove_loop3.body_dec mS sS xL.1 xL.2 h) _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.timer.remove_loop3_nz (y : obj.Tcb) (fuel : Std.U64) : NoZero (R.timer.remove_loop3 y fuel) := by
  unfold R.timer.remove_loop3
  exact NoZero.iter (fun x => R.timer.remove_loop3.body_nz _ _) _ _

@[irreducible] noncomputable def R.timer.root (cpu : Std.U64) : SProg obj.Tcb := do
  let i ← R.obj.node_get cpu layout.node.TIMER_ROOT
  pure (i)

@[reif_simps] theorem R.timer.root_eq (cpu : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.timer.root cpu) sS aA =
      (fl4_core.timer.root mS sS cpu >>= fun r => ok (r, sS, aA)) := by
  unfold R.timer.root
  simp only [reif_simps, fl4_core.timer.root]
  reif_loop

@[reif_nz] theorem R.timer.root_nz (cpu : Std.U64) : NoZero (R.timer.root cpu) := by
  unfold R.timer.root
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.node_get_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
