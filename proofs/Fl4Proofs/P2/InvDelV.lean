    have Fx := kx.sched hK O
    refine invRep.guard_okS (gS := gS) rstR (hst _ (Or.inr rfl)) rsc riq (hW.reg _ rB384) (hW.reg _ rM384) ?_ hz'
    intro s5 es5
    have k5 : KeepA (L := L) x (L.curW s) s5 := by
