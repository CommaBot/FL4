@[irreducible] noncomputable def R.vspace.unmap_page_table (asid : Std.U64) (vaddr : Std.U64) (pt : Std.U64) : SProg Unit := do
  let r ← R.vspace.find_vspace_for_asid asid
  match r with
  | core.result.Result.Ok r1 => do
      let r2 ← R.vspace.lookup_pd_slot r1 vaddr
      match r2 with
      | core.result.Result.Ok x => do
          let e ← SProg.read x
          let i ← SProg.liftR (vspace.P_PRESENT)
          let i1 ← pure ((e &&& i))
          if i1 = 0#u64 then do
            pure (())
          else do
            let i2 ← SProg.liftR (vspace.P_PS)
            let i3 ← pure ((e &&& i2))
            if i3 != 0#u64 then do
              pure (())
            else do
              let i4 ← pure ((e &&& vspace.ADDR_MASK))
              let i5 ← SProg.liftR (layout.paddr pt)
              if i4 != i5 then do
                pure (())
              else do
                let _ ← AR.invalidate_asid asid
                let _ ← SProg.write x 0#u64
                let _ ← AR.invalidate_page_structures asid
                pure (())
      | core.result.Result.Err _ => do
          pure (())
  | core.result.Result.Err _ => do
      pure (())

