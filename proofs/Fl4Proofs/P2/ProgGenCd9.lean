@[irreducible] noncomputable def R.cnode.decode_cancel_badged_sends (dest : obj.Slot) : SProg (core.result.Result Unit error.Exc) := do
  let c ← R.obj.Slot.cap dest
  let o ← SProg.liftR (cnode.full_endpoint c)
  match o with
  | none => do
      let r ← SProg.liftR (error.illegal Unit)
      pure (r)
  | some x => do
      let (ptr, badge) := x
      let ct ← R.sched.cur_thread
      let _ ← R.sched.set_thread_state ct sched.TS_RESTART
      if badge != 0#u64 then do
        let _ ← R.endpoint.cancel_badged_sends ptr badge
        pure (core.result.Result.Ok ())
      else do
        pure (core.result.Result.Ok ())

