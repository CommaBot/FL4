@[irreducible] noncomputable def R.vspace.lookup_pt_slot (pml4 : Std.U64) (vaddr : Std.U64) : SProg (core.result.Result Std.U64 error.LookupFault) := do
  let r ← R.vspace.lookup_pd_slot pml4 vaddr
  let cf ← SProg.liftR (core.result.Result.Insts.CoreOpsTry.branch r)
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val => do
      let e ← SProg.read val
      let i ← SProg.liftR (vspace.P_PRESENT)
      let i1 ← pure ((e &&& i))
      if i1 = 0#u64 then do
        pure ((core.result.Result.Err (error.LookupFault.MissingCapability vspace.PD_INDEX_OFFSET)))
      else do
        let i2 ← SProg.liftR (vspace.P_PS)
        let i3 ← pure ((e &&& i2))
        if i3 != 0#u64 then do
          pure ((core.result.Result.Err (error.LookupFault.MissingCapability vspace.PD_INDEX_OFFSET)))
        else do
          let i4 ← SProg.liftR (vspace.table_of e)
          let i5 ← SProg.liftR (vspace.idx vaddr 12#u64)
          let i6 ← SProg.liftR (vspace.entry_addr i4 i5)
          pure ((core.result.Result.Ok i6))
  | core.ops.control_flow.ControlFlow.Break residual => do
      SProg.liftR (core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual Std.U64 (core.convert.FromSame error.LookupFault) residual)

