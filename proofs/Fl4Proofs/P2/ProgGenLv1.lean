@[irreducible] noncomputable def R.localvm.current_vm_ok (cpu : Std.U64) (ct : obj.Tcb) (csc : obj.Sc) : SProg Bool := do
  let b ← SProg.liftR (obj.Tcb.is_null ct)
  if b then do
    pure (false)
  else do
    let t ← R.sched.idle_thread
    let b1 ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Tcb.Insts.CoreCmpPartialEqTcb ct t)
    if b1 then do
      let i ← R.obj.Tcb.affinity ct
      if i = cpu then do
        let i1 ← R.obj.Tcb.yield_to ct
        if i1 = 0#u64 then do
          let b2 ← SProg.liftR (obj.Sc.is_null csc)
          if b2 then do
            pure (false)
          else do
            let i2 ← R.obj.Tcb.sc ct
            if i2 = csc then do
              let i3 ← R.obj.Sc.cpu csc
              if i3 = cpu then do
                let i4 ← R.obj.Tcb.domain ct
                let i5 ← R.sched.cur_domain
                pure ((i4 = i5))
              else do
                pure (false)
            else do
              pure (false)
        else do
          pure (false)
      else do
        pure (false)
    else do
      pure (false)

