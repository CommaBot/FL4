@[irreducible] noncomputable def R.localvm.handle_vcpu_exit_local (v : Std.U64) (n : Std.U64) : SProg Bool := do
  let ct ← R.sched.cur_thread
  let cpu ← SProg.curCpu
  let csc ← R.sched.cur_sc
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let i ← R.obj.Tcb.state ct
    if i != sched.TS_RUNNING_VM then do
      pure (false)
    else do
      if v = 0#u64 then do
        pure (false)
      else do
        let i1 ← R.vcpu.bound ct
        if i1 != v then do
          pure (false)
        else do
          let i2 ← R.obj.Tcb.bound_ntfn ct
          if i2 != n then do
            pure (false)
          else do
            let i3 ← R.vcpu.get v vcpu.PENDING
            if i3 = 0#u64 then do
              let b ← R.localvm.ntfn_quiet n
              if b then do
                let b1 ← R.localvm.current_vm_ok cpu ct csc
                if b1 then do
                  let b2 ← R.sched.is_schedulable ct
                  if b2 then do
                    let b3 ← R.localtimer.sched_quiet cpu
                    if b3 then do
                      let _ ← R.sched.update_timestamp
                      let now ← R.sched.cur_time
                      let i4 ← R.sched.consumed
                      let b4 ← R.sporadic.sufficient csc i4
                      if b4 then do
                        let b5 ← R.localvm.awaken_quiet cpu now
                        if b5 then do
                          let _ ← R.vcpu.check ct
                          let _ ← R.sched.check_budget
                          let _ ← R.localvm.finish
                          pure (true)
                        else do
                          pure (false)
                      else do
                        pure (false)
                    else do
                      pure (false)
                  else do
                    pure (false)
                else do
                  pure (false)
              else do
                pure (false)
            else do
              let b ← R.localvm.current_vm_ok cpu ct csc
              if b then do
                let b1 ← R.sched.is_schedulable ct
                if b1 then do
                  let b2 ← R.localtimer.sched_quiet cpu
                  if b2 then do
                    let _ ← R.sched.update_timestamp
                    let now ← R.sched.cur_time
                    let i4 ← R.sched.consumed
                    let b3 ← R.sporadic.sufficient csc i4
                    if b3 then do
                      let b4 ← R.localvm.awaken_quiet cpu now
                      if b4 then do
                        let _ ← R.vcpu.check ct
                        let _ ← R.sched.check_budget
                        let _ ← R.localvm.finish
                        pure (true)
                      else do
                        pure (false)
                    else do
                      pure (false)
                  else do
                    pure (false)
                else do
                  pure (false)
              else do
                pure (false)

