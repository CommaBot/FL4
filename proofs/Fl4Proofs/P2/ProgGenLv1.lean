@[irreducible] noncomputable def R.localvm.handle_vm_timer_irq_local (irq : Std.U64) (p : localtimer.TimerIrqPlan) (n : Std.U64) : SProg Bool := do
  let cpu ← SProg.curCpu
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let i ← SProg.liftR (layout.irq.MAX)
    if irq > i then do
      pure (false)
    else do
      let i1 ← R.interrupt.irq_state irq
      if i1 != interrupt.IRQ_TIMER then do
        pure (false)
      else do
        let tip ← R.localtimer.plan_objects
        let b ← SProg.liftR (localtimer.same_plan tip p)
        if b then do
          let ct ← R.sched.cur_thread
          let csc ← R.sched.cur_sc
          let i2 ← R.obj.Tcb.state ct
          if i2 != sched.TS_RUNNING_VM then do
            pure (false)
          else do
            let i3 ← R.obj.Tcb.bound_ntfn ct
            if i3 != n then do
              pure (false)
            else do
              let b1 ← R.localvm.ntfn_quiet n
              if b1 then do
                let b2 ← R.localvm.vm_running ct
                if b2 then do
                  let b3 ← R.localvm.current_vm_ok cpu ct csc
                  if b3 then do
                    let b4 ← R.localtimer.sched_quiet cpu
                    if b4 then do
                      let _ ← R.sched.update_timestamp
                      let now ← R.sched.cur_time
                      let b5 ← R.localtimer.release_due cpu
                      if b5 then do
                        pure (false)
                      else do
                        let i4 ← R.sched.consumed
                        let b6 ← R.sporadic.sufficient csc i4
                        let due ← R.localtimer.timer_due cpu now
                        let ok1 ← SProg.blk 0 (
                            if ¬ b6 then do
                              if due then do
                                pure (false)
                              else do
                                if ¬ b6 then do
                                  R.localtimer.round_robin_ok cpu ct csc now
                                else do
                                  if due then do
                                    do
                                      let b7 ← R.localtimer.fire_ok cpu ct p now
                                      if b7 then do
                                        pure (true)
                                      else do
                                        pure (false)
                                  else do
                                    pure (true)
                            else do
                              if ¬ b6 then do
                                R.localtimer.round_robin_ok cpu ct csc now
                              else do
                                if due then do
                                  do
                                    let b7 ← R.localtimer.fire_ok cpu ct p now
                                    if b7 then do
                                      pure (true)
                                    else do
                                      pure (false)
                                else do
                                  pure (true))
                        if ok1 then do
                          let _ ← R.vcpu.check ct
                          let _ ← R.sched.check_budget
                          let _ ← R.interrupt.handle_interrupt irq
                          let _ ← R.localvm.finish
                          pure (true)
                        else do
                          pure (false)
                    else do
                      pure (false)
                  else do
                    pure (false)
                else do
                  pure (false)
              else do
                pure (false)
        else do
          pure (false)

