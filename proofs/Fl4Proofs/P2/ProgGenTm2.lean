variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.localtimer.handle_timer_irq_local (irq : Std.U64) (p : localtimer.TimerIrqPlan) : SProg Bool := do
  let cpu ← SProg.curCpu
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let i ← SProg.liftR (layout.irq.MAX)
    if irq > i then do
      pure (false)
    else do
      let i1 ← R.interrupt.irq_state irq
      if i1 != interrupt.IRQ_TIMER then do
        pure (false)
      else do
        let tip ← R.localtimer.plan_objects
        let b ← SProg.liftR (localtimer.same_plan tip p)
        if b then do
          let ct ← R.sched.cur_thread
          let csc ← R.sched.cur_sc
          let b1 ← R.localtimer.current_ok cpu ct csc
          if b1 then do
            let b2 ← R.localtimer.sched_quiet cpu
            if b2 then do
              let _ ← R.sched.update_timestamp
              let now ← R.sched.cur_time
              let b3 ← R.localtimer.release_due cpu
              if b3 then do
                pure (false)
              else do
                let i2 ← R.sched.consumed
                let b4 ← R.sporadic.sufficient csc i2
                let due ← R.localtimer.timer_due cpu now
                let ok1 ← SProg.blk 0 (
                    if ¬ b4 then do
                      if due then do
                        pure (false)
                      else do
                        if ¬ b4 then do
                          R.localtimer.round_robin_ok cpu ct csc now
                        else do
                          if due then do
                            R.localtimer.fire_ok cpu ct p now
                          else do
                            pure (true)
                    else do
                      if ¬ b4 then do
                        R.localtimer.round_robin_ok cpu ct csc now
                      else do
                        if due then do
                          R.localtimer.fire_ok cpu ct p now
                        else do
                          pure (true))
                if ok1 then do
                  let _ ← R.sched.check_budget
                  let _ ← R.interrupt.handle_interrupt irq
                  let _ ← R.sched.schedule
                  let _ ← R.sched.activate_thread
                  let t ← R.sched.cur_thread
                  let _ ← R.vcpu.check t
                  pure (true)
                else do
                  pure (false)
            else do
              pure (false)
          else do
            pure (false)
        else do
          pure (false)

@[reif_simps] theorem R.localtimer.handle_timer_irq_local_eq (irq : Std.U64) (p : localtimer.TimerIrqPlan) (sS : S) (aA : A) :
    interp mS mA (R.localtimer.handle_timer_irq_local irq p) sS aA =
      (fl4_core.localtimer.handle_timer_irq_local mS mA sS aA irq p >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.localtimer.handle_timer_irq_local
  simp only [reif_simps, fl4_core.localtimer.handle_timer_irq_local]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro)
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      ))
    | reif_step)
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.localtimer.handle_timer_irq_local_nz (irq : Std.U64) (p : localtimer.TimerIrqPlan) : NoZero (R.localtimer.handle_timer_irq_local irq p) := by
  unfold R.localtimer.handle_timer_irq_local
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.interrupt.handle_interrupt_nz)
    | (with_reducible apply R.interrupt.irq_state_nz)
    | (with_reducible apply R.localtimer.current_ok_nz)
    | (with_reducible apply R.localtimer.fire_ok_nz)
    | (with_reducible apply R.localtimer.plan_objects_nz)
    | (with_reducible apply R.localtimer.release_due_nz)
    | (with_reducible apply R.localtimer.round_robin_ok_nz)
    | (with_reducible apply R.localtimer.sched_quiet_nz)
    | (with_reducible apply R.localtimer.timer_due_nz)
    | (with_reducible apply R.sched.activate_thread_nz)
    | (with_reducible apply R.sched.check_budget_nz)
    | (with_reducible apply R.sched.consumed_nz)
    | (with_reducible apply R.sched.cur_sc_nz)
    | (with_reducible apply R.sched.cur_thread_nz)
    | (with_reducible apply R.sched.cur_time_nz)
    | (with_reducible apply R.sched.schedule_nz)
    | (with_reducible apply R.sched.update_timestamp_nz)
    | (with_reducible apply R.sporadic.sufficient_nz)
    | (with_reducible apply R.vcpu.check_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

