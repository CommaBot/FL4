@[irreducible] noncomputable def R.obj.Ntfn.tail_state (self : obj.Ntfn) : SProg Std.U64 := do
  let i ← pure ((core.num.U64.wrapping_add self layout.ntfn.TAIL_STATE))
  SProg.read i

@[reif_simps] theorem R.obj.Ntfn.tail_state_eq (self : obj.Ntfn) (sS : S) (aA : A) :
    interp mS mA (R.obj.Ntfn.tail_state self) sS aA =
      (fl4_core.obj.Ntfn.tail_state mS self sS >>= fun r => ok (r, sS, aA)) := by
  unfold R.obj.Ntfn.tail_state
  simp only [reif_simps, fl4_core.obj.Ntfn.tail_state]
  reif_loop

@[reif_nz] theorem R.obj.Ntfn.tail_state_nz (self : obj.Ntfn) : NoZero (R.obj.Ntfn.tail_state self) := by
  unfold R.obj.Ntfn.tail_state
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

