  unfold R.vspace.unmap_page
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.find_vspace_for_asid_nz)
    | (with_reducible apply R.vspace.frame_gpa_nz)
    | (with_reducible apply R.vspace.lookup_pd_slot_nz)
    | (with_reducible apply R.vspace.lookup_pdpt_slot_nz)
    | (with_reducible apply R.vspace.lookup_pt_slot_nz)
    | (with_reducible apply AR.invalidate_page_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.cdt.empty_slot (slot : obj.Slot) (cleanup : capability.Cap) : SProg Unit := do
  let c ← R.obj.Slot.cap slot
  let b ← SProg.liftR (capability.Cap.is_null c)
  if b then do
    pure (())
  else do
    let prev ← R.obj.Slot.prev slot
    let next ← R.obj.Slot.next slot
    let fb ← R.obj.Slot.first_badged slot
    let b1 ← SProg.liftR (obj.Slot.is_null prev)
    let _ ← SProg.blk 0 (
        if b1 then do
          pure (())
        else do
          R.obj.Slot.set_next prev next)
    let b2 ← SProg.liftR (obj.Slot.is_null next)
    let _ ← SProg.blk 1 (
        if b2 then do
          pure (())
        else do
          do
            let _ ← R.obj.Slot.set_prev next prev
            let nfb ← R.obj.Slot.first_badged next
            if nfb then do
              R.obj.Slot.set_first_badged next true
            else do
              R.obj.Slot.set_first_badged next fb)
    let _ ← R.obj.Slot.clear slot
    R.objects.post_cap_deletion cleanup

@[reif_simps] theorem R.cdt.empty_slot_eq (slot : obj.Slot) (cleanup : capability.Cap) (sS : S) (aA : A) :
    interp mS mA (R.cdt.empty_slot slot cleanup) sS aA =
      (fl4_core.cdt.empty_slot mS mA sS aA slot cleanup >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.cdt.empty_slot
  simp only [reif_simps, fl4_core.cdt.empty_slot]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

