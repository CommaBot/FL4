@[reif_simps] theorem R.vspace.unmap_page_eq (size : capability.FrameSize) (asid : Std.U64) (vaddr : Std.U64) (pptr : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.vspace.unmap_page size asid vaddr pptr) sS aA =
      (fl4_core.vspace.unmap_page mS mA sS aA size asid vaddr pptr >>= fun r => ok ((), r.1, r.2)) := by
  unfold R.vspace.unmap_page
  simp only [reif_simps, fl4_core.vspace.unmap_page]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

