                    pure (())
                  else do
                    let i4 ← SProg.liftR (vspace.frame_base e capability.FrameSize.Small)
                    let i5 ← R.vspace.frame_gpa i4
                    if i5 != pa then do
                      pure (())
                    else do
                      let _ ← SProg.write x 0#u64
                      let _ ← AR.invalidate_page asid vaddr
                      pure (())
                else do
                  let i2 ← SProg.liftR (vspace.frame_base e capability.FrameSize.Small)
                  let i3 ← R.vspace.frame_gpa i2
                  if i3 != pa then do
                    pure (())
                  else do
                    let _ ← SProg.write x 0#u64
