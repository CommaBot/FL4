  | core.result.Result.Ok r1 => do
      let pa ← SProg.liftR (layout.paddr pptr)
      match size with
      | capability.FrameSize.Small => do
          let r2 ← R.vspace.lookup_pt_slot r1 vaddr
          match r2 with
          | core.result.Result.Ok x => do
              let e ← SProg.read x
              let i ← SProg.liftR (vspace.P_PRESENT)
              let i1 ← pure ((e &&& i))
              if i1 = 0#u64 then do
                pure (())
              else do
                if ¬ true then do
                  let i2 ← SProg.liftR (vspace.P_PS)
                  let i3 ← pure ((e &&& i2))
