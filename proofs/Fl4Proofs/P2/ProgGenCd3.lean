@[irreducible] noncomputable def R.vcpu.ports_loop.body (v : Std.U64) (high : Std.U64) (disable : Bool) (port : Std.U64) : SProg (ControlFlow Std.U64 Unit) := do
  if port <= high then do
    if port < 65536#u64 then do
      let i ← pure ((core.num.U64.wrapping_add v vcpu.IO))
      let i1 ← SProg.liftR (port >>> 6#i32)
      let i2 ← SProg.liftR (i1 * 8#u64)
      let addr ← pure ((core.num.U64.wrapping_add i i2))
      let i3 ← pure ((port &&& 63#u64))
      let bit ← SProg.liftR (1#u64 <<< i3)
      let old ← SProg.read addr
      if disable then do
        let i4 ← pure ((old ||| bit))
        let _ ← SProg.write addr i4
        let port1 ← SProg.liftR (port + 1#u64)
        pure (.cont port1)
      else do
        let i4 ← pure ((~~~ bit))
        let i5 ← pure ((old &&& i4))
        let _ ← SProg.write addr i5
        let port1 ← SProg.liftR (port + 1#u64)
        pure (.cont port1)
    else do
      pure (.done ())
  else do
    pure (.done ())

