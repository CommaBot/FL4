@[irreducible] noncomputable def R.cdt.is_final_capability_with_cap (slot : obj.Slot) (cap : capability.Cap) : SProg Bool := do
  let prev ← R.obj.Slot.prev slot
  let b ← SProg.liftR (obj.Slot.is_null prev)
  let prev_same ← SProg.blk 0 (
      if b then do
        pure (false)
      else do
        do
          let c ← R.obj.Slot.cap prev
          SProg.liftR (objects.same_object_as c cap))
  if prev_same then do
    pure (false)
  else do
    let next ← R.obj.Slot.next slot
    let b1 ← SProg.liftR (obj.Slot.is_null next)
    if b1 then do
      pure (true)
    else do
      let c ← R.obj.Slot.cap next
      let b2 ← SProg.liftR (objects.same_object_as cap c)
      pure ((¬ b2))

@[reif_simps] theorem R.cdt.is_final_capability_with_cap_eq (slot : obj.Slot) (cap : capability.Cap) (sS : S) (aA : A) :
    interp mS mA (R.cdt.is_final_capability_with_cap slot cap) sS aA =
      (fl4_core.cdt.is_final_capability_with_cap mS sS slot cap >>= fun r => ok (r, sS, aA)) := by
  unfold R.cdt.is_final_capability_with_cap
  simp only [reif_simps, fl4_core.cdt.is_final_capability_with_cap]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => (r, sB, aB)))
      ))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.cdt.is_final_capability_with_cap_nz (slot : obj.Slot) (cap : capability.Cap) : NoZero (R.cdt.is_final_capability_with_cap slot cap) := by
  unfold R.cdt.is_final_capability_with_cap
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Slot.cap_nz)
    | (with_reducible apply R.obj.Slot.next_nz)
    | (with_reducible apply R.obj.Slot.prev_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
