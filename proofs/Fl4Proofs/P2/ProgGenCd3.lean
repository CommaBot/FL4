theorem R.vcpu.ports_loop.body_dec (v : Std.U64) (high : Std.U64) (disable : Bool) (s : S) (port : Std.U64) {σ0}
    (h : fl4_core.vcpu.ports_loop.body mS v high disable s port = ok (.cont σ0)) :
    (fun xL => 2 ^ UScalarTy.U64.numBits - xL.val) ((fun (σ0 : S × Std.U64) => (σ0.2, σ0.1)) σ0).1 < (fun xL => 2 ^ UScalarTy.U64.numBits - xL.val) port := by
  simp only [fl4_core.vcpu.ports_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

