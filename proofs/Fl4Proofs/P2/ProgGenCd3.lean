@[irreducible] noncomputable def R.vspace.unmap_pdpt (asid : Std.U64) (vaddr : Std.U64) (pdpt : Std.U64) : SProg Unit := do
  let r ← R.vspace.find_vspace_for_asid asid
  match r with
  | core.result.Result.Ok r1 => do
      let i ← SProg.liftR (vspace.idx vaddr 39#u64)
      let slot ← SProg.liftR (vspace.entry_addr r1 i)
      let e ← SProg.read slot
      let i1 ← SProg.liftR (vspace.P_PRESENT)
      let i2 ← pure ((e &&& i1))
      if i2 = 0#u64 then do
        pure (())
      else do
        let i3 ← pure ((e &&& vspace.ADDR_MASK))
        let i4 ← SProg.liftR (layout.paddr pdpt)
        if i3 != i4 then do
          pure (())
        else do
          let _ ← AR.invalidate_asid asid
          let _ ← SProg.write slot 0#u64
          let _ ← AR.invalidate_page_structures asid
          pure (())
  | core.result.Result.Err _ => do
      pure (())

