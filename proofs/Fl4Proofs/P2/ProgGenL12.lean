@[irreducible] noncomputable def R.schedcontext.cancel_yield_to (t : obj.Tcb) : SProg Unit := do
  let b ← SProg.liftR (obj.Tcb.is_null t)
  if b then do
    pure (())
  else do
    let i ← R.obj.Tcb.yield_to t
