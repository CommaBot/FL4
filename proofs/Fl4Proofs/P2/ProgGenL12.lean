@[irreducible] noncomputable def R.sched.is_runnable (t : obj.Tcb) : SProg Bool := do
  let st ← R.obj.Tcb.state t
  if st = sched.TS_RUNNING then do
    pure (true)
  else do
    if st = sched.TS_RESTART then do
      pure (true)
    else do
      pure ((st = sched.TS_RUNNING_VM))

