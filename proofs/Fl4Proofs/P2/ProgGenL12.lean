@[irreducible] noncomputable def R.schedcontext.update_consumed (sc : obj.Sc) : SProg Std.U64 := do
  let c ← R.obj.Sc.consumed sc
  if c >= core.num.U64.MAX then do
    let i ← SProg.liftR (c - core.num.U64.MAX)
    let _ ← R.obj.Sc.set_consumed sc i
    let i1 ← AR.ticks_to_us core.num.U64.MAX
    pure (i1)
  else do
    let _ ← R.obj.Sc.set_consumed sc 0#u64
    let i ← AR.ticks_to_us c
