    interp mS mA (R.sched.is_runnable t) sS aA =
      (fl4_core.sched.is_runnable mS sS t >>= fun r => ok (r, sS, aA)) := by
  unfold R.sched.is_runnable
  simp only [reif_simps, fl4_core.sched.is_runnable]
  reif_loop

