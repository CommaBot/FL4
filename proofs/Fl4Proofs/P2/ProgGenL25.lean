  pure ((i >= i1))

@[reif_simps] theorem R.sporadic.sufficient_eq (sc : obj.Sc) (usage : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.sporadic.sufficient sc usage) sS aA =
      (fl4_core.sporadic.sufficient mS mA sS aA sc usage >>= fun r => ok (r, sS, aA)) := by
  unfold R.sporadic.sufficient
  simp only [reif_simps, fl4_core.sporadic.sufficient]
  reif_loop

@[reif_nz] theorem R.sporadic.sufficient_nz (sc : obj.Sc) (usage : Std.U64) : NoZero (R.sporadic.sufficient sc usage) := by
  unfold R.sporadic.sufficient
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.sporadic.capacity_nz)
    | (with_reducible apply R.sporadic.min_budget_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
