@[irreducible] noncomputable def R.sched.awaken_loop.body (fuel : Std.U64) : SProg (ControlFlow Std.U64 Unit) := do
  if fuel > 0#u64 then do
    let fuel1 ← SProg.liftR (fuel - 1#u64)
    let i ← SProg.curCpu
    let i1 ← R.obj.node_get i layout.node.RELEASE_HEAD
    let b ← SProg.liftR (obj.Tcb.is_null i1)
    if b then do
      pure (.done ())
    else do
      let i2 ← R.obj.Tcb.sc i1
      let b1 ← R.sporadic.ready i2
      if b1 then do
        let _ ← R.sched.release_remove i1
        let _ ← R.sched.possible_switch_to i1
        pure (.cont fuel1)
      else do
        pure (.done ())
  else do
    pure (.done ())

