theorem R.sched.awaken_loop.body_dec (s : S) (fuel : Std.U64) {σ0}
    (h : fl4_core.sched.awaken_loop.body mS s fuel = ok (.cont σ0)) :
    (fun xL => xL.val) ((fun (σ0 : S × Std.U64) => (σ0.2, σ0.1)) σ0).1 < (fun xL => xL.val) fuel := by
  simp only [fl4_core.sched.awaken_loop.body] at h
  dec_peel
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

