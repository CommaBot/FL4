@[irreducible] noncomputable def R.sched.choose_thread  : SProg Unit := do
  let dom ← SProg.blk 0 (
      if layout.NUM_DOMAINS > 1#u64 then do
        R.sched.cur_domain
      else do
        pure (0#u64))
  let cpu ← SProg.curCpu
  let i ← SProg.liftR (sched.bitmap_dom dom)
  let i1 ← SProg.liftR (sched.l1_off i)
  let i2 ← R.obj.node_get cpu i1
  if i2 != 0#u64 then do
    let prio ← R.sched.highest_prio dom
    let i3 ← SProg.liftR (sched.rq_head_off dom prio)
    let q ← R.sched.q_get cpu i3
    R.sched.switch_to_thread q.head
  else do
    R.sched.switch_to_idle_thread

