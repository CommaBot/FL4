    interp mS mA (R.sched.commit_time ) sS aA =
      (fl4_core.sched.commit_time mS mA sS aA >>= fun r => ok ((), r, aA)) := by
  unfold R.sched.commit_time
  simp only [reif_simps, fl4_core.sched.commit_time]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro)
    | (with_reducible refine ite_congr' (fun _ => ?_) (fun _ => ?_))
    | (with_reducible refine ite_bind_congr' (fun _ => ?_) (fun _ => ?_))
    | (simp only [reif_simps])
    | ((with_reducible refine bind_cut mS mA ?sh ?_ (fun _ => ?_)); (case sh => first
      | ((refine (show BlkShape S A 0 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      | ((refine (show BlkShape S A 1 _ _ from ?_)); exact (fun r sB aB => ((), r, aB)))
      ))
    | reif_step)

@[reif_nz] theorem R.sched.commit_time_nz  : NoZero (R.sched.commit_time ) := by
  unfold R.sched.commit_time
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Sc.consumed_nz)
    | (with_reducible apply R.obj.Sc.refill_head_nz)
    | (with_reducible apply R.obj.Sc.refill_tail_nz)
    | (with_reducible apply R.obj.Sc.set_consumed_nz)
    | (with_reducible apply R.sched.consumed_nz)
    | (with_reducible apply R.sched.cur_sc_nz)
    | (with_reducible apply R.sched.idle_sc_nz)
    | (with_reducible apply R.sched.set_consumed_nz)
    | (with_reducible apply R.sporadic.budget_check_nz)
    | (with_reducible apply R.sporadic.get_nz)
    | (with_reducible apply R.sporadic.is_round_robin_nz)
    | (with_reducible apply R.sporadic.put_nz)
    | (with_reducible apply R.sporadic.sc_active_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

