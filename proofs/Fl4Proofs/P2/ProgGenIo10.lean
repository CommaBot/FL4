@[irreducible] noncomputable def R.ioTailP (t : obj.Tcb) (info : msginfo.MessageInfo) (number : I64) : SProg Bool := do
  let b ← SProg.liftR (ioport.is_port_label info.label)
  if b then do
    let next ← R.obj.Tcb.reg t layout.reg.NEXT_IP
    let i2 ← pure ((core.num.U64.wrapping_sub next 2#u64))
    let _ ← R.obj.Tcb.set_reg t layout.reg.FAULT_IP i2
    let _ ← R.sched.update_timestamp
    let cptr ← R.obj.Tcb.reg t layout.reg.CAP
    let csc ← R.sched.cur_sc
    let i3 ← R.sched.action
    if i3 != sched.ACTION_RESUME_CURRENT then do
      pure (false)
    else do
      let i4 ← R.obj.Tcb.yield_to t
      if i4 != 0#u64 then do
        pure (false)
      else do
        if info.extra_caps != 0#u64 then do
          pure (false)
        else do
          let b1 ← R.ioport.invocation_ok t cptr info
          if b1 then do
            let i5 ← R.sched.consumed
            let b2 ← R.sporadic.sufficient csc i5
            if b2 then do
              let b3 ← R.fastpath.schedulable_here t
              if b3 then do
                let r ← R.hinvIoG (number = fl4_abi.syscall.SysCall) true (number = fl4_abi.syscall.SysCall) false cptr
                let _ ← R.syscall.after_invocation r
                let _ ← R.syscall.finish
                pure (true)
              else do
                pure (false)
            else do
              pure (false)
          else do
            pure (false)
  else do
    pure (false)

