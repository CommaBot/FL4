    interp mS mA (R.ioTailP t info number) sS aA =
      (Fl4Proofs.P2.PathObl.ioTailP mS mA sS aA t info number >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.ioTailP
