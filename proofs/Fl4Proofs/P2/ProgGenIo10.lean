@[irreducible] noncomputable def R.ioBodyG (number : I64) : SProg Bool := do
  let t ← R.sched.cur_thread
  let info ← R.msg.msg_info t
  if layout.NUM_DOMAINS != 1#u64 then do
    pure (false)
  else do
    let i ← R.obj.Tcb.flags t
    let i1 ← pure ((i &&& fl4_abi.consts.tcb_flag.TRAP_SYSCALLS))
    if i1 != 0#u64 then do
      pure (false)
    else do
      if number != fl4_abi.syscall.SysCall then do
        if number != fl4_abi.syscall.SysSend then do
          pure (false)
        else do
          R.ioTailP t info number
      else do
        R.ioTailP t info number

