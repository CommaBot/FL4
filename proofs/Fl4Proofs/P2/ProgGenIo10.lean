@[irreducible] noncomputable def R.syscall.after_invocation (r : core.result.Result Unit error.Exc) : SProg Bool := do
  match r with
  | core.result.Result.Ok _ => do
      pure (true)
  | core.result.Result.Err _ => do
      let _ ← R.syscall.mcs_preemption_point
      let irq ← AR.take_pending_irq
      let _ ← R.syscall.check_interrupt irq
      pure (false)

