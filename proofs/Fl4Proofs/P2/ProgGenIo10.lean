@[irreducible] noncomputable def R.sched.check_budget  : SProg Bool := do
  let sc ← R.sched.cur_sc
  let c ← R.sched.consumed
  let b ← R.sporadic.sufficient sc c
  if b then do
    let b1 ← R.sched.is_cur_domain_expired
    pure (¬ b1)
  else do
    let _ ← R.sched.charge_budget c true
    pure (false)

@[reif_simps] theorem R.sched.check_budget_eq  (sS : S) (aA : A) :
    interp mS mA (R.sched.check_budget ) sS aA =
      (fl4_core.sched.check_budget mS mA sS aA >>= fun r => ok (r.1, r.2.1, r.2.2)) := by
  unfold R.sched.check_budget
  simp only [reif_simps, fl4_core.sched.check_budget]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.sched.check_budget_nz  : NoZero (R.sched.check_budget ) := by
  unfold R.sched.check_budget
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.sched.charge_budget_nz)
    | (with_reducible apply R.sched.consumed_nz)
    | (with_reducible apply R.sched.cur_sc_nz)
    | (with_reducible apply R.sched.is_cur_domain_expired_nz)
    | (with_reducible apply R.sporadic.sufficient_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.syscall.mcs_preemption_point  : SProg Unit := do
  let ct ← R.sched.cur_thread
  let b ← R.sched.is_schedulable ct
  if b then do
    let _ ← R.sched.check_budget
    pure (())
  else do
    let s1 ← R.sched.cur_sc
    let b1 ← R.sporadic.sc_active s1
    if b1 then do
      let c ← R.sched.consumed
      R.sched.charge_budget c false
    else do
      let cpu ← SProg.curCpu
      let _ ← R.obj.node_set cpu layout.node.CONSUMED 0#u64
      pure (())

