  exact interp_iterR mS mA (fun (σ0 : (Array Std.U64 32#usize) × Std.Usize × Std.U64 × Bool × Bool) => fl4_core.localtimer.in_core_timer_tree_loop.body mS sS i d σ0.1 σ0.2.1 σ0.2.2.1 σ0.2.2.2.1 σ0.2.2.2.2) (fun xL => R.localtimer.in_core_timer_tree_loop.body i d xL.1 xL.2.1 xL.2.2.1 xL.2.2.2.1 xL.2.2.2.2) (fun xL => 2 ^ UScalarTy.U64.numBits - xL.2.2.1.val) sS
    (fun xL aL => R.localtimer.in_core_timer_tree_loop.body_eq mS mA i d xL.1 xL.2.1 xL.2.2.1 xL.2.2.2.1 xL.2.2.2.2 sS aL)
    (fun xL cL h => R.localtimer.in_core_timer_tree_loop.body_dec mS sS i d xL.1 xL.2.1 xL.2.2.1 xL.2.2.2.1 xL.2.2.2.2 h) _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.localtimer.in_core_timer_tree_loop_nz (i : Std.U64) (d : Std.U64) (stack : Array Std.U64 32#usize) (sp : Std.Usize) (visits : Std.U64) (found : Bool) (overflow : Bool) : NoZero (R.localtimer.in_core_timer_tree_loop i d stack sp visits found overflow) := by
  unfold R.localtimer.in_core_timer_tree_loop
  exact NoZero.iter (fun x => R.localtimer.in_core_timer_tree_loop.body_nz _ _ _ _ _ _ _) _ _

@[irreducible] noncomputable def R.localtimer.may_run_here (cpu : Std.U64) (t : obj.Tcb) : SProg Bool := do
  let b ← SProg.liftR (obj.Tcb.is_null t)
  if b then do
    pure (false)
  else do
    let i ← R.obj.Tcb.affinity t
    if i = cpu then do
      let i1 ← R.obj.Tcb.state t
      if i1 != sched.TS_RUNNING_VM then do
        let i2 ← R.obj.Tcb.yield_to t
        if i2 = 0#u64 then do
          let i3 ← R.obj.Tcb.sc t
          if i3 = 0#u64 then do
            pure (true)
          else do
            let i4 ← R.obj.Sc.cpu i3
            pure ((i4 = cpu))
        else do
          pure (false)
      else do
        pure (false)
    else do
      pure (false)

@[reif_simps] theorem R.localtimer.may_run_here_eq (cpu : Std.U64) (t : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.localtimer.may_run_here cpu t) sS aA =
      (fl4_core.localtimer.may_run_here mS sS cpu t >>= fun r => ok (r, sS, aA)) := by
  unfold R.localtimer.may_run_here
  simp only [reif_simps, fl4_core.localtimer.may_run_here]
  reif_loop

@[reif_nz] theorem R.localtimer.may_run_here_nz (cpu : Std.U64) (t : obj.Tcb) : NoZero (R.localtimer.may_run_here cpu t) := by
  unfold R.localtimer.may_run_here
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Sc.cpu_nz)
    | (with_reducible apply R.obj.Tcb.affinity_nz)
    | (with_reducible apply R.obj.Tcb.sc_nz)
    | (with_reducible apply R.obj.Tcb.state_nz)
    | (with_reducible apply R.obj.Tcb.yield_to_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

