      let _ ← R.msg.set_mr receiver buf i2 bits_left
      let i3 ← pure ((core.num.U64.wrapping_add offset 2#u64))
      let _ ← R.msg.set_mr receiver buf i3 guard_found
      let i4 ← pure ((core.num.U64.wrapping_add offset 3#u64))
