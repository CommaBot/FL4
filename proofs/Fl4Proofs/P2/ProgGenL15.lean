    | (with_reducible apply R.obj.node_get_nz)
    | (with_reducible apply R.obj.node_set_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

end Fl4Proofs.P2.PathObl
