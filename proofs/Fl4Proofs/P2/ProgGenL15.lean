@[irreducible] noncomputable def R.localtimer.in_core_timer_tree (cpu : Std.U64) (target : obj.Tcb) (d : Std.U64) : SProg Bool := do
  let b ← SProg.liftR (obj.Tcb.is_null target)
  if b then do
    pure (false)
  else do
    let root ← R.obj.node_get cpu layout.node.TIMER_ROOT
    let i ← R.obj.node_get cpu layout.node.TIMER_MIN
    if i = target then do
      pure (true)
    else do
      if root = target then do
        pure (true)
      else do
        let stack := Array.repeat 32#usize 0#u64
        let (stack1, sp) ← SProg.blk 0 (
            if root != 0#u64 then do
              do
                let a ← SProg.liftR (Array.update stack 0#usize root)
                pure ((a, 1#usize))
            else do
              pure ((stack, 0#usize)))
        R.localtimer.in_core_timer_tree_loop target d stack1 sp 0#u64 false false

