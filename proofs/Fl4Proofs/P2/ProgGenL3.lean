variable {S : Type} {A : Type} (mS : machine.Store S) (mA : machine.Arch A)

@[irreducible] noncomputable def R.obj.Tcb.affinity (self : obj.Tcb) : SProg Std.U64 := do
  let i ← SProg.liftR (layout.tcb.AFFINITY)
  let i1 ← pure ((core.num.U64.wrapping_add self i))
  SProg.read i1

@[reif_simps] theorem R.obj.Tcb.affinity_eq (self : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.obj.Tcb.affinity self) sS aA =
      (fl4_core.obj.Tcb.affinity mS self sS >>= fun r => ok (r, sS, aA)) := by
  unfold R.obj.Tcb.affinity
  simp only [reif_simps, fl4_core.obj.Tcb.affinity]
  reif_loop

@[reif_nz] theorem R.obj.Tcb.affinity_nz (self : obj.Tcb) : NoZero (R.obj.Tcb.affinity self) := by
  unfold R.obj.Tcb.affinity
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

