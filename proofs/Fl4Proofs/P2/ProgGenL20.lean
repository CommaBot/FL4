@[reif_simps] theorem R.vcpu.report_loop3_eq (t : obj.Tcb) (v : Std.U64) (b : Std.U64) (j : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.vcpu.report_loop3 t v b j) sS aA =
      (fl4_core.vcpu.report_loop3 mS sS t v b j >>= fun r => ok ((), r, aA)) := by
  unfold R.vcpu.report_loop3 fl4_core.vcpu.report_loop3
  exact interp_iterS mS mA (fun (σ0 : S × Std.U64) => fl4_core.vcpu.report_loop3.body mS t v b σ0.1 σ0.2) (fun xL => R.vcpu.report_loop3.body t v b xL) (fun (xL : Std.U64) (sL : S) => (sL, xL)) (fun (σ0 : S × Std.U64) => (σ0.2, σ0.1)) (fun (b : S) => ((), b)) (fun xL => 2 ^ UScalarTy.U64.numBits - xL.val) (fun _ => rfl)
    (fun xL sL aL => R.vcpu.report_loop3.body_eq mS mA t v b xL sL aL)
    (fun xL sL cL h => R.vcpu.report_loop3.body_dec mS t v b sL xL h) _ _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.vcpu.report_loop3_nz (t : obj.Tcb) (v : Std.U64) (b : Std.U64) (j : Std.U64) : NoZero (R.vcpu.report_loop3 t v b j) := by
  unfold R.vcpu.report_loop3
  exact NoZero.iter (fun x => R.vcpu.report_loop3.body_nz _ _ _ _) _ _

@[irreducible] noncomputable def R.vcpu.signal_completes (t : obj.Tcb) : SProg Bool := do
  let v ← R.vcpu.bound t
  let cpu ← R.obj.Tcb.affinity t
  if v != 0#u64 then do
    let i ← R.vcpu.get v vcpu.PENDING
    if i = 0#u64 then do
      let i1 ← SProg.curCpu
      if cpu = i1 then do
        pure (true)
      else do
        let b ← R.vcpu.full_reply t
        if b then do
          let i2 ← R.obj.node_get cpu layout.node.CUR_THREAD
          pure ((i2 != t))
        else do
          pure (false)
    else do
      pure (false)
  else do
    pure (false)

@[reif_simps] theorem R.vcpu.signal_completes_eq (t : obj.Tcb) (sS : S) (aA : A) :
    interp mS mA (R.vcpu.signal_completes t) sS aA =
      (fl4_core.vcpu.signal_completes mS sS t >>= fun r => ok (r, sS, aA)) := by
  unfold R.vcpu.signal_completes
  simp only [reif_simps, fl4_core.vcpu.signal_completes]
  reif_loop

@[reif_nz] theorem R.vcpu.signal_completes_nz (t : obj.Tcb) : NoZero (R.vcpu.signal_completes t) := by
  unfold R.vcpu.signal_completes
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Tcb.affinity_nz)
    | (with_reducible apply R.obj.node_get_nz)
    | (with_reducible apply R.vcpu.bound_nz)
    | (with_reducible apply R.vcpu.full_reply_nz)
    | (with_reducible apply R.vcpu.get_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.vspace.find_asid (asid : Std.U64) : SProg (core.result.Result Std.U64 error.LookupFault) := do
  let i ← SProg.liftR (asid >>> vspace.ASID_LOW_BITS)
  let pool ← R.vspace.asid_table i
  if pool = 0#u64 then do
    pure ((core.result.Result.Err error.LookupFault.InvalidRoot))
  else do
    let i1 ← pure ((asid &&& 511#u64))
    let i2 ← pure ((core.num.U64.wrapping_mul i1 8#u64))
    let i3 ← pure ((core.num.U64.wrapping_add pool i2))
    let root ← SProg.read i3
    if root = 0#u64 then do
      pure ((core.result.Result.Err error.LookupFault.InvalidRoot))
    else do
      pure ((core.result.Result.Ok root))

@[reif_simps] theorem R.vspace.find_asid_eq (asid : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.vspace.find_asid asid) sS aA =
      (fl4_core.vspace.find_asid mS sS asid >>= fun r => ok (r, sS, aA)) := by
  unfold R.vspace.find_asid
  simp only [reif_simps, fl4_core.vspace.find_asid]
  reif_loop

@[reif_nz] theorem R.vspace.find_asid_nz (asid : Std.U64) : NoZero (R.vspace.find_asid asid) := by
  unfold R.vspace.find_asid
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.asid_table_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

