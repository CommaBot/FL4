@[irreducible] noncomputable def R.vspace.delete_asid (asid : Std.U64) (root : Std.U64) : SProg Unit := do
  let i ← SProg.liftR (asid >>> vspace.ASID_LOW_BITS)
  let pool ← R.vspace.asid_table i
  if pool = 0#u64 then do
    pure (())
  else do
    let i1 ← pure ((asid &&& 511#u64))
    let i2 ← pure ((core.num.U64.wrapping_mul i1 8#u64))
    let e ← pure ((core.num.U64.wrapping_add pool i2))
    let old ← SProg.read e
    let i3 ← pure ((~~~ 1#u64))
    let i4 ← pure ((old &&& i3))
    if i4 = root then do
      let i5 ← pure ((old &&& 1#u64))
      if i5 != 0#u64 then do
        let _ ← R.ept.invalidate root
        let _ ← SProg.write e 0#u64
        pure (())
      else do
        let _ ← AR.invalidate_asid asid
        let _ ← SProg.write e 0#u64
        let ct ← R.sched.cur_thread
        R.vspace.set_vm_root ct
    else do
      pure (())

