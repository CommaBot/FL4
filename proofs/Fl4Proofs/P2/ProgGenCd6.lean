    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.vspace.entry_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

@[irreducible] noncomputable def R.cdt.cap_swap_for_delete (slot1 : obj.Slot) (slot2 : obj.Slot) : SProg Unit := do
  let b ← SProg.liftR (obj.Slot.Insts.CoreCmpPartialEqSlot.eq slot1 slot2)
  if b then do
    pure (())
  else do
    let c1 ← R.obj.Slot.cap slot1
    let c2 ← R.obj.Slot.cap slot2
    R.cdt.swap c1 slot1 c2 slot2

@[reif_simps] theorem R.cdt.cap_swap_for_delete_eq (slot1 : obj.Slot) (slot2 : obj.Slot) (sS : S) (aA : A) :
    interp mS mA (R.cdt.cap_swap_for_delete slot1 slot2) sS aA =
      (fl4_core.cdt.cap_swap_for_delete mS sS slot1 slot2 >>= fun r => ok ((), r, aA)) := by
  unfold R.cdt.cap_swap_for_delete
  simp only [reif_simps, fl4_core.cdt.cap_swap_for_delete]
  repeat' (first
    | (with_reducible apply bind_congr_r; intro x; try (rcases (x : (capability.Cap × capability.Cap) × S × A) with ⟨⟨_, _⟩, _, _⟩))
    | reif_step)
  all_goals (try (simp_all only [reduceCtorEq]; done))
  all_goals (try (injections; subst_vars; (repeat' reif_step); done))
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.cdt.cap_swap_for_delete_nz (slot1 : obj.Slot) (slot2 : obj.Slot) : NoZero (R.cdt.cap_swap_for_delete slot1 slot2) := by
  unfold R.cdt.cap_swap_for_delete
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.cdt.swap_nz)
    | (with_reducible apply R.obj.Slot.cap_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

end

