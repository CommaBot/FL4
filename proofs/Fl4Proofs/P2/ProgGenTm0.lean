@[irreducible] noncomputable def R.localtimer.wake_ok (cpu : Std.U64) (ct : obj.Tcb) (w : obj.Tcb) (n : obj.Ntfn) : SProg Bool := do
  let b ← SProg.liftR (core.cmp.PartialEq.ne.trait_default obj.Tcb.Insts.CoreCmpPartialEqTcb w ct)
  if b then do
    let b1 ← R.localtimer.may_run_here cpu w
    if b1 then do
      let i ← R.obj.Tcb.domain w
      let i1 ← R.sched.cur_domain
      if i = i1 then do
        let b2 ← R.sched.queued w
        if b2 then do
          pure (false)
        else do
          let i2 ← R.obj.Tcb.sc w
          if i2 = 0#u64 then do
            let i3 ← R.obj.Ntfn.sc n
            if i3 != 0#u64 then do
              pure (false)
            else do
              R.localtimer.top_ok cpu
          else do
            R.localtimer.top_ok cpu
      else do
        pure (false)
    else do
      pure (false)
  else do
    pure (false)

