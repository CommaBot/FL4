@[irreducible] noncomputable def R.localtimer.top_ok (cpu : Std.U64) : SProg Bool := do
  let i ← R.obj.node_get cpu layout.node.L1_BITMAP
  if i = 0#u64 then do
    pure (true)
  else do
    let i1 ← R.sched.cur_domain
    let prio ← R.sched.highest_prio i1
    let i2 ← pure ((core.num.U64.wrapping_mul prio 16#u64))
    let i3 ← SProg.liftR (layout.node.READY_QUEUES)
    let i4 ← pure ((core.num.U64.wrapping_add i3 i2))
    let i5 ← R.obj.node_get cpu i4
    R.localtimer.may_run_here cpu i5

