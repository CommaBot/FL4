@[irreducible] noncomputable def R.localtimer.fire_ok_loop.body (i : Std.U64) (fuel : Std.U64) : SProg (ControlFlow (Std.U64 × Std.U64) Std.U64) := do
  let i1 ← R.obj.Tcb.timer_left i
  if i1 != 0#u64 then do
    if fuel > 0#u64 then do
      let fuel1 ← SProg.liftR (fuel - 1#u64)
      pure (.cont (i1, fuel1))
    else do
      pure (.done i)
  else do
    pure (.done i)

@[reif_simps] theorem R.localtimer.fire_ok_loop.body_eq (i : Std.U64) (fuel : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.localtimer.fire_ok_loop.body i fuel) sS aA =
      (fl4_core.localtimer.fire_ok_loop.body mS sS i fuel >>= fun r => ok (r, sS, aA)) := by
  unfold R.localtimer.fire_ok_loop.body
  simp only [reif_simps, fl4_core.localtimer.fire_ok_loop.body]
  reif_loop
  all_goals (exfalso; simp only [*, reduceCtorEq] at *)

@[reif_nz] theorem R.localtimer.fire_ok_loop.body_nz (i : Std.U64) (fuel : Std.U64) : NoZero (R.localtimer.fire_ok_loop.body i fuel) := by
  unfold R.localtimer.fire_ok_loop.body
  try simp only [SProg.bind_eq_sbind, SProg.pure_eq_ret]
  repeat' (first
    | (with_reducible apply NoZero.sbind)
    | (with_reducible apply NoZero.blk)
    | (with_reducible apply NoZero.ite')
    | (with_reducible exact NoZero.liftR _)
    | (with_reducible exact NoZero.read _)
    | (with_reducible exact NoZero.readPair _)
    | (with_reducible exact NoZero.write _ _)
    | (with_reducible exact NoZero.ksBase)
    | (with_reducible exact NoZero.curCpu)
    | (with_reducible exact NoZero.frameMasks)
    | (intro; try dsimp only)
    | (with_reducible apply R.obj.Tcb.timer_left_nz)
    | (simp only [reif_nz])
    | split
    | (exact trivial)
    | (dsimp only))

/-- The measure of `localtimer.fire_ok_loop` drops at every `cont` step, on every store. -/
theorem R.localtimer.fire_ok_loop.body_dec (s : S) (i : Std.U64) (fuel : Std.U64) {σ0}
    (h : fl4_core.localtimer.fire_ok_loop.body mS s i fuel = ok (.cont σ0)) :
    (fun xL => xL.2.val) σ0 < (fun xL => xL.2.val) (i, fuel) := by
  simp only [fl4_core.localtimer.fire_ok_loop.body] at h
  dec_peel
  all_goals (repeat (rename_i h; split at h; all_goals (try (simp only [ok_eq_ok_iff, reduceCtorEq] at h; done)); all_goals (try dec_peel)))
  all_goals (try simp only at *)
  all_goals first
    | (apply ge_sub1_lt <;> assumption)
    | (apply ge_sub1_lt' <;> assumption)
    | (apply uadd_lt <;> first | assumption | scalar_tac)

@[irreducible] noncomputable def R.localtimer.fire_ok_loop (i : Std.U64) (fuel : Std.U64) : SProg Std.U64 :=
  SProg.iter (fun xL => R.localtimer.fire_ok_loop.body xL.1 xL.2) ((fun xL => xL.2.val) (i, fuel) + 1) (i, fuel)

@[reif_simps] theorem R.localtimer.fire_ok_loop_eq (i : Std.U64) (fuel : Std.U64) (sS : S) (aA : A) :
    interp mS mA (R.localtimer.fire_ok_loop i fuel) sS aA =
      (fl4_core.localtimer.fire_ok_loop mS sS i fuel >>= fun r => ok (r, sS, aA)) := by
  unfold R.localtimer.fire_ok_loop fl4_core.localtimer.fire_ok_loop
  exact interp_iterR mS mA (fun (σ0 : Std.U64 × Std.U64) => fl4_core.localtimer.fire_ok_loop.body mS sS σ0.1 σ0.2) (fun xL => R.localtimer.fire_ok_loop.body xL.1 xL.2) (fun xL => xL.2.val) sS
    (fun xL aL => R.localtimer.fire_ok_loop.body_eq mS mA xL.1 xL.2 sS aL)
    (fun xL cL h => R.localtimer.fire_ok_loop.body_dec mS sS xL.1 xL.2 h) _ _ _ (Nat.lt_succ_self _)

@[reif_nz] theorem R.localtimer.fire_ok_loop_nz (i : Std.U64) (fuel : Std.U64) : NoZero (R.localtimer.fire_ok_loop i fuel) := by
  unfold R.localtimer.fire_ok_loop
  exact NoZero.iter (fun x => R.localtimer.fire_ok_loop.body_nz _ _) _ _

@[irreducible] noncomputable def R.localtimer.plan_objects  : SProg localtimer.TimerIrqPlan := do
  let cpu ← SProg.curCpu
  let a := Array.repeat 3#usize (0#u64, 0#u64)
  let i ← R.obj.node_get cpu layout.node.TIMER_MIN
  let b ← SProg.liftR (obj.Tcb.is_null i)
  if b then do
    pure ({ tm := 0#u64, ntfn := 0#u64, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a, n := 0#usize })
  else do
    let i1 ← R.obj.Tcb.affinity i
    if i1 != cpu then do
      pure ({ tm := 0#u64, ntfn := 0#u64, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a, n := 0#usize })
    else do
      let i2 ← R.localtimer.core_of i
      if i2 != cpu then do
        pure ({ tm := 0#u64, ntfn := 0#u64, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a, n := 0#usize })
      else do
        let n ← R.obj.Tcb.bound_ntfn i
        if n = 0#u64 then do
          pure ({ tm := i, ntfn := 0#u64, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a, n := 0#usize })
        else do
          let (_, index_mut_back) ← SProg.liftR (Array.index_mut_usize a 0#usize)
          let i3 ← R.obj.Ntfn.state n
          if i3 != obj.NTFN_IDLE then do
            let a1 := index_mut_back (n, 64#u64)
            pure ({ tm := i, ntfn := n, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a1, n := 1#usize })
          else do
            let i4 ← R.obj.Ntfn.bound_tcb n
            if i4 != i then do
              let a1 := index_mut_back (n, 64#u64)
              pure ({ tm := i, ntfn := n, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a1, n := 1#usize })
            else do
              let i5 ← R.obj.Tcb.state i
              if i5 != sched.TS_BLOCKED_ON_RECV then do
                let a1 := index_mut_back (n, 64#u64)
                pure ({ tm := i, ntfn := n, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a1, n := 1#usize })
              else do
                let ep ← R.obj.Tcb.block_obj i
                if ep = 0#u64 then do
                  let a1 := index_mut_back (n, 64#u64)
                  pure ({ tm := i, ntfn := n, waiter := 0#u64, ep := 0#u64, reply := 0#u64, objects := a1, n := 1#usize })
                else do
                  let a1 := index_mut_back (n, 64#u64)
                  let (_, index_mut_back1) ← SProg.liftR (Array.index_mut_usize a1 1#usize)
                  let r ← R.obj.Tcb.reply_obj i
                  if r != 0#u64 then do
                    let a2 := index_mut_back1 (ep, 16#u64)
                    let a3 ← SProg.liftR (Array.update a2 2#usize (r, 32#u64))
                    pure ({ tm := i, ntfn := n, waiter := i, ep, reply := r, objects := a3, n := 3#usize })
                  else do
                    let a2 := index_mut_back1 (ep, 16#u64)
                    pure ({ tm := i, ntfn := n, waiter := i, ep, reply := 0#u64, objects := a2, n := 2#usize })

