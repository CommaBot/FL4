@[reif_simps] theorem nd.obj.Sc.Insts.CoreCmpPartialEqSc.eq (self : obj.Sc) (other : obj.Sc) : fl4_core.obj.Sc.Insts.CoreCmpPartialEqSc.eq self other ≠ div :=
