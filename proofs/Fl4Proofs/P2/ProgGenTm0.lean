@[irreducible] noncomputable def R.localtimer.round_robin_ok (cpu : Std.U64) (ct : obj.Tcb) (csc : obj.Sc) (now : Std.U64) : SProg Bool := do
  let s1 ← R.sched.idle_sc
  let b ← SProg.liftR (obj.Sc.Insts.CoreCmpPartialEqSc.eq csc s1)
  if b then do
    pure (false)
  else do
    let b1 ← R.sporadic.is_round_robin csc
    if b1 then do
      let b2 ← R.sched.is_schedulable ct
      if b2 then do
        let b3 ← R.sched.queued ct
        if b3 then do
          pure (false)
        else do
          let hi ← R.obj.Sc.refill_head csc
          let ti ← R.obj.Sc.refill_tail csc
          if hi = ti then do
            pure (false)
          else do
            let h ← R.sporadic.get csc hi
            let t ← R.sporadic.get csc ti
            if h.time > now then do
              pure (false)
            else do
              let i ← pure ((core.num.U64.wrapping_add h.amount t.amount))
              let i1 ← R.sporadic.min_budget
              if i < i1 then do
                pure (false)
              else do
                let i2 ← R.obj.node_get cpu layout.node.L1_BITMAP
                if i2 = 0#u64 then do
                  pure (true)
                else do
                  let i3 ← R.sched.cur_domain
                  let i4 ← R.sched.highest_prio i3
                  let i5 ← R.obj.Tcb.prio ct
                  pure ((i4 < i5))
      else do
        pure (false)
    else do
      pure (false)

