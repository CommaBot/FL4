/-
**p3J gen 15 copy** of JBoot1St (namespace `JBootQ`, generated by scratch/p3J/genQ1.py): the same proofs
at the root-thread witness `JBootQ.w1` / `JBootQ.σ1` on FL4's boot IRQ layout (`JBootQ.fInitASt`, `JBootQ.img`:
line 125 `IRQ_TIMER`, 126 / 127 `IRQ_IPI`; spec 125 `irqTimer`, 126 / 127 `irqReserved`). Original docstring:

P3 (line jboot, gen 4): **the richer witness's spec state `σ1`**: `fInitASt` (JBootSt) plus a root thread.

Three new objects in the kernel image's free pages (`kernelBase + 0x8000 .. + 0xA040`):
* the root TCB `rootTcbV` at `rT = kernelBase + 0x8000`: `Running`, bound to the root SC, CSpace root the
  CNode cap `cnodeCap rC 1 []`, every other slot null, priority / MCP / domain / registers as the idle TCB's;
* the root SC `rootScV` at `rS = kernelBase + 0x9000` (size 0, i.e. `2 ^ 7` bytes): the idle SC's refills and
  budget, bound to the root TCB;
* the root CNode `rootCs` at `rC = kernelBase + 0xA000`, radix 1: slot `[false]` the root TCB's thread cap,
  slot `[true]` the root SC's cap.

`σ1` is `fInitASt` with this heap, the root TCB current on the root SC, and no original cap (the CDT empty).
Why three caps (handoff jboot.md, gen 4): `JCovD` asks every typed / P1-heap object to be covered by a
physical non-untyped cap of the MDB, idle, inside the kernel-state block or dead. The root TCB (running) and
its SC (bound) cannot be dead, are not the idle objects and lie outside the block (`SchedCore.ksOut`,
`SchedRel.scOut`), so each needs its own cap; the TCB's slots admit no thread or SC cap (`JPlaced.fh` /
`bfs`, `vfhQ`), so they sit in a CNode, which in turn needs the TCB's CSpace-root cap.

* `kh1_some` (the heap by cases), `capAt1` (the spec caps by slot), lookups `kh1_rT`, `kh1_rS`, `kh1_rC`,
  `kh1_old` (every other address reads `fInitKheap`).

No sorry; no premises. New module; no existing statement changed.
-/
import Fl4Proofs.P3.JBootQZ
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3.JBootQ
open Fl4Proofs.P3.JBoot
open fl4_core Fl4Spec Fl4Proofs.P3

noncomputable section

set_option maxHeartbeats 1000000

/-! ## The new objects -/

/-- The root TCB's address `kernelBase + 0x8000`. -/
def rT : U64 := 18446744071562100736#u64
/-- The root SC's address `kernelBase + 0x9000`. -/
def rS : U64 := 18446744071562104832#u64
/-- The root CNode's address `kernelBase + 0xA000`. -/
def rC : U64 := 18446744071562108928#u64

theorem rT_val : rT.val = 18446744071562100736 := rfl
theorem rS_val : rS.val = 18446744071562104832 := rfl
theorem rC_val : rC.val = 18446744071562108928 := rfl
theorem rT_toNat : rT.bv.toNat = 18446744071562100736 := rfl
theorem rS_toNat : rS.bv.toNat = 18446744071562104832 := rfl
theorem rC_toNat : rC.bv.toNat = 18446744071562108928 := rfl

/-- The root CNode cap (radix 1, no guard). -/
abbrev rootCnCap : Cap := .cnodeCap rC.bv 1 []

/-- **The root TCB** (module docstring). -/
def rootTcbV : Tcb :=
  { idleTcbV with tcbCtable := rootCnCap, tcbState := .running, tcbSchedContext := some rS.bv }

/-- **The root SC** (module docstring). -/
def rootScV : SchedContext := { idleScV with scTcb := some rT.bv }

/-- **The root CNode's contents** (radix 1). -/
def rootCs : CnodeContents := fun l =>
  if l = [false] then some (.threadCap rT.bv) else if l = [true] then some (.schedContextCap rS.bv 0) else none

/-- **The richer witness's heap.** -/
def kh1 : KHeap :=
  Function.update (Function.update (Function.update fInitKheap rT.bv (some (.tcb rootTcbV)))
    rS.bv (some (.schedContext rootScV 0))) rC.bv (some (.cnode 1 rootCs))

/-- **The richer witness's spec state** (module docstring). -/
def σ1 : State Unit :=
  { fInitASt with kheap := kh1, curThread := rT.bv, curSc := rS.bv, isOriginalCap := fun _ => false }

theorem σ1_kheap : σ1.kheap = kh1 := rfl
theorem σ1_cur : σ1.curThread = rT.bv := rfl
theorem σ1_curSc : σ1.curSc = rS.bv := rfl
theorem σ1_idle : σ1.idleThread = idleThreadPtr := rfl
theorem σ1_idleSc : σ1.idleSc = idleScPtr := rfl

/-! ## The heap -/

theorem rT_ne_rS : rT.bv ≠ rS.bv := by decide
theorem rT_ne_rC : rT.bv ≠ rC.bv := by decide
theorem rS_ne_rC : rS.bv ≠ rC.bv := by decide

/-- An address of none of `fInitKheap`'s objects reads `none`. -/
theorem fInitKheap_none {x : ObjRef} (h1 : x ≠ initGlobalPd) (h2 : x ≠ initGlobalPdpt) (h3 : x ≠ initGlobalPml4)
    (h4 : x ≠ idleScPtr) (h5 : x ≠ idleThreadPtr) (h6 : ∀ irq : Irq, fIrqNode irq ≠ x) : fInitKheap x = none := by
  unfold fInitKheap
  rw [Function.update_of_ne h1, Function.update_of_ne h2, Function.update_of_ne h3, Function.update_of_ne h4,
    Function.update_of_ne h5, if_neg (fun ⟨irq, e⟩ => h6 irq e)]

/-- No IRQ-node CNode at an address in `[kernelBase + 0x4000, kernelBase + 0x10000)` but... (by value). -/
theorem fIrqNode_ne {x : ObjRef} (hx : 18446744071562084352 ≤ x.toNat ∧ x.toNat + 4096 ≤ 18446744071562133504)
    (irq : Irq) : fIrqNode irq ≠ x := by
  intro e
  rcases fIrqNode_cases irq with ⟨_, h2⟩ | ⟨_, _, h3⟩
  · rw [e] at h2; omega
  · rw [e] at h3; omega

theorem fInitKheap_rT : fInitKheap rT.bv = none :=
  fInitKheap_none (by decide) (by decide) (by decide) (by decide) (by decide)
    (fIrqNode_ne (by rw [rT_toNat]; omega))

theorem fInitKheap_rS : fInitKheap rS.bv = none :=
  fInitKheap_none (by decide) (by decide) (by decide) (by decide) (by decide)
    (fIrqNode_ne (by rw [rS_toNat]; omega))

theorem fInitKheap_rC : fInitKheap rC.bv = none :=
  fInitKheap_none (by decide) (by decide) (by decide) (by decide) (by decide)
    (fIrqNode_ne (by rw [rC_toNat]; omega))

theorem kh1_rT : kh1 rT.bv = some (.tcb rootTcbV) := by
  unfold kh1; rw [Function.update_of_ne rT_ne_rC, Function.update_of_ne rT_ne_rS, Function.update_self]

theorem kh1_rS : kh1 rS.bv = some (.schedContext rootScV 0) := by
  unfold kh1; rw [Function.update_of_ne rS_ne_rC, Function.update_self]

theorem kh1_rC : kh1 rC.bv = some (.cnode 1 rootCs) := by
  unfold kh1; rw [Function.update_self]

theorem kh1_old {x : ObjRef} (h1 : x ≠ rT.bv) (h2 : x ≠ rS.bv) (h3 : x ≠ rC.bv) : kh1 x = fInitKheap x := by
  unfold kh1; rw [Function.update_of_ne h3, Function.update_of_ne h2, Function.update_of_ne h1]

/-- **The richer heap by cases.** -/
theorem kh1_some {p : ObjRef} {o : KernelObject} (h : kh1 p = some o) :
    (p = rT.bv ∧ o = .tcb rootTcbV) ∨ (p = rS.bv ∧ o = .schedContext rootScV 0) ∨
      (p = rC.bv ∧ o = .cnode 1 rootCs) ∨ (p ≠ rT.bv ∧ p ≠ rS.bv ∧ p ≠ rC.bv ∧ fInitKheap p = some o) := by
  by_cases e1 : p = rT.bv
  · subst e1; rw [kh1_rT] at h; cases h; exact Or.inl ⟨rfl, rfl⟩
  by_cases e2 : p = rS.bv
  · subst e2; rw [kh1_rS] at h; cases h; exact Or.inr (Or.inl ⟨rfl, rfl⟩)
  by_cases e3 : p = rC.bv
  · subst e3; rw [kh1_rC] at h; cases h; exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
  rw [kh1_old e1 e2 e3] at h
  exact Or.inr (Or.inr (Or.inr ⟨e1, e2, e3, h⟩))

/-- Objects of the richer heap: the three new ones or `fInitASt`'s (JBootInv's `fInit_objs`). -/
theorem kh1_objs {p : ObjRef} {o : KernelObject} (h : kh1 p = some o) :
    (p = rT.bv ∧ o = .tcb rootTcbV) ∨ (p = rS.bv ∧ o = .schedContext rootScV 0) ∨
      (p = rC.bv ∧ o = .cnode 1 rootCs) ∨ o = .tcb idleTcbV ∨ o = .schedContext idleScV 0 ∨ o = cn0 ∨
      o = .archObj (.pageMapL4 globalPml4) ∨ o = .archObj (.pdPointerTable globalPdpt) ∨
      o = .archObj (.pageDirectory globalPd) := by
  rcases kh1_some h with h1 | h1 | h1 | ⟨-, -, -, h'⟩
  · exact Or.inl h1
  · exact Or.inr (Or.inl h1)
  · exact Or.inr (Or.inr (Or.inl h1))
  · right; right; right
    rcases bootHeap_fInit.obj _ _ h' with rfl | rfl | e | e | e | e
    · rw [bootHeap_fInit.tcb] at h'; cases h'; exact Or.inl rfl
    · rw [bootHeap_fInit.sc] at h'; cases h'; exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl e))
    · exact Or.inr (Or.inr (Or.inr (Or.inl e)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl e))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr e))))

theorem kh1_tcb_of {p : ObjRef} {x : Tcb} (h : kh1 p = some (.tcb x)) :
    (p = rT.bv ∧ x = rootTcbV) ∨ (p = idleThreadPtr ∧ x = idleTcbV) := by
  rcases kh1_some h with ⟨rfl, e⟩ | ⟨-, e⟩ | ⟨-, e⟩ | ⟨-, -, -, h'⟩
  · cases e; exact Or.inl ⟨rfl, rfl⟩
  · cases e
  · cases e
  · exact Or.inr (bootHeap_fInit.tcb_of h')

theorem kh1_sc_of {p : ObjRef} {y : SchedContext} {n : Nat} (h : kh1 p = some (.schedContext y n)) :
    (p = rS.bv ∧ y = rootScV ∧ n = 0) ∨ (p = idleScPtr ∧ y = idleScV ∧ n = 0) := by
  rcases kh1_some h with ⟨-, e⟩ | ⟨rfl, e⟩ | ⟨-, e⟩ | ⟨-, -, -, h'⟩
  · cases e
  · cases e; exact Or.inl ⟨rfl, rfl, rfl⟩
  · cases e
  · exact Or.inr (bootHeap_fInit.sc_of h')

theorem kh1_no_ep {p : ObjRef} {x : Endpoint} (h : kh1 p = some (.endpoint x)) : False := by
  rcases kh1_some h with ⟨-, e⟩ | ⟨-, e⟩ | ⟨-, e⟩ | ⟨-, -, -, h'⟩
  · cases e
  · cases e
  · cases e
  · exact bootHeap_fInit.no_ep h'

theorem kh1_no_ntfn {p : ObjRef} {x : Notification} (h : kh1 p = some (.notification x)) : False := by
  rcases kh1_some h with ⟨-, e⟩ | ⟨-, e⟩ | ⟨-, e⟩ | ⟨-, -, -, h'⟩
  · cases e
  · cases e
  · cases e
  · exact bootHeap_fInit.no_ntfn h'

theorem kh1_no_reply {p : ObjRef} {x : Reply} (h : kh1 p = some (.reply x)) : False := by
  rcases kh1_objs h with ⟨-, e⟩ | ⟨-, e⟩ | ⟨-, e⟩ | e | e | e | e | e | e <;> cases e

theorem kh1_idleT : kh1 idleThreadPtr = some (.tcb idleTcbV) := by
  rw [kh1_old (by decide) (by decide) (by decide)]; exact bootHeap_fInit.tcb

theorem kh1_idleS : kh1 idleScPtr = some (.schedContext idleScV 0) := by
  rw [kh1_old (by decide) (by decide) (by decide)]; exact bootHeap_fInit.sc

/-! ## The caps -/

theorem rootCs_wf : wellFormedCnodeN 1 rootCs := by
  unfold wellFormedCnodeN dom
  ext l
  simp only [Set.mem_setOf_eq]
  unfold rootCs
  constructor
  · intro h
    split_ifs at h with h1 h2
    · subst h1; rfl
    · subst h2; rfl
    · exact absurd h (by simp)
  · intro hl
    match l, hl with
    | [false], _ => simp
    | [true], _ => simp

theorem rootCs_cases {l : CnodeIndex} {c : Cap} (h : rootCs l = some c) :
    (l = [false] ∧ c = .threadCap rT.bv) ∨ (l = [true] ∧ c = .schedContextCap rS.bv 0) := by
  unfold rootCs at h
  split_ifs at h with h1 h2
  · cases h; exact Or.inl ⟨h1, rfl⟩
  · cases h; exact Or.inr ⟨h2, rfl⟩

theorem capView_rC : SInvU.capView (.cnode 1 rootCs) = rootCs := by
  simp [SInvU.capView, rootCs_wf]

theorem capOpt_rC (l : CnodeIndex) : capOpt (some (.cnode 1 rootCs)) l = rootCs l := by
  simp [capOpt, rootCs_wf]

/-- The root TCB's slots: the CSpace root is the CNode cap, the others null. -/
theorem rootTcb_map {l : CnodeIndex} {c : Cap} (h : tcbCnodeMap rootTcbV l = some c) :
    (l = tcbCnodeIndex 0 ∧ c = rootCnCap) ∨ c = .nullCap := by
  unfold tcbCnodeMap at h
  simp only [Function.update_apply] at h
  split_ifs at h with h1 h2 h3 h4 h5 h6 <;> (try cases h) <;> (try exact Or.inr rfl)
  exact Or.inl ⟨h6, rfl⟩

theorem idleTcb_map {l : CnodeIndex} {c : Cap} (h : tcbCnodeMap idleTcbV l = some c) : c = .nullCap := by
  unfold tcbCnodeMap at h
  simp only [Function.update_apply] at h
  split_ifs at h <;> (try cases h) <;> rfl

/-- **The spec caps of `σ1` by slot**: null, or one of the three root caps at its slot. -/
theorem capAt1 {sl : CslotPtr} {c : Cap} (h : SInvU.capAt σ1 sl = some c) :
    c = .nullCap ∨ (sl = (rT.bv, tcbCnodeIndex 0) ∧ c = rootCnCap) ∨
      (sl = (rC.bv, [false]) ∧ c = .threadCap rT.bv) ∨ (sl = (rC.bv, [true]) ∧ c = .schedContextCap rS.bv 0) := by
  obtain ⟨p, i⟩ := sl
  unfold SInvU.capAt at h
  rw [σ1_kheap] at h
  split at h
  · rename_i o ho
    rcases kh1_some ho with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨-, -, -, h'⟩
    · rcases rootTcb_map h with ⟨rfl, rfl⟩ | rfl
      · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
      · exact Or.inl rfl
    · cases h
    · rw [capView_rC] at h
      rcases rootCs_cases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
      · exact Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩))
    · left
      have hb := bootHeap_fInit.capAt (N := fIrqNode) (sl := (p, i)) (c := c)
      apply hb
      unfold SInvU.capAt
      show (match fInitKheap p with | some o => SInvU.capView o i | none => none) = some c
      rw [h']; exact h
  · cases h

end

end Fl4Proofs.P3.JBootQ
