/-
P3 (line mmuAD, gen 33): **TCB register words and IPC-buffer words at `JAtZV3`** — the one-word steps
`vcpu::report` (and every reply path) is made of, toward `ReportJ3` (P3/JAtZV3Report).

* `JAtZB.regWrJZ`: XTopJointReply's `JAtZ.regWrJ` over `JAtZB` (generated by `scratch/mmu32_jatzb_gen.py regWrJ`),
  ending in gen 31's `JAtZB.reg_frameFZ`: post at `Z` itself plus the `FinW` footprint.
* `JAtZB.userWrJ`: XTopJointData's `JAtZ.userWrJ` over `JAtZB` (generated; post `JAtZ` → `JAtZB`, the `JExt`-only
  VCPU-word argument of `cs_frameK` dropped as in gen 32's `tmw_step`).
* **`JAtZV3.regWr`**: FL4's write of register `r` of a thread `t ∈ T` paired with the spec's `setReg` keeps
  `JAtZV3` (any register, the badge register included; `IRel` after by XTopJointWriteRegs' `reg_wr_irelN`); lifted by
  `JAtZV3.ofBS` (a TCB word is `OObj`, not the VCPU head, not a TCB VCPU word; the spec changes one TCB's registers:
  `zv_qky`).
* **`JAtZV3.userWr`**: FL4's write of a buffer word of `Z.B` paired with the spec's `storeMem` keeps `JAtZV3` (same
  hypotheses as `JAtZ.userWrJ`); lifted by `JAtZV3.ofB` (the spec heap is unchanged; the word is `OObj`'s buffer
  case, far from the kernel globals (`BufPlaced.far`), outside every TCB (`hAp`)).

No named premise. No existing statement changed.

(mmuAD gen 42b18) Removed (the originals are stated over `JAtZB` in place, the `JAtZ` names their corollaries with
`ext` rebuilt): P3/XTopJointData `userWrJ`.
-/
import Fl4Proofs.P3.JAtZV3Sched
import Fl4Proofs.P3.XTopJointData
import Fl4Proofs.P3.XTopJointWriteRegs
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3
open fl4_core

noncomputable section

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit} {V X : Set U64}

section
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P1 Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched

set_option maxHeartbeats 8000000 in
/-- **One register write of a thread at `JAtZB`** (XTopJointReply's `JAtZ.regWrJ`, generated copy; post at `Z` with
the `FinW` footprint via `JAtZB.reg_frameFZ`). -/
theorem JAtZB.regWrJZ (J : JAtZB (L := L) arI AR Z H Cs Ac Lst D s a σ) {t : U64} (ht : t ∈ Z.T)
    {x : Fl4Spec.Tcb} (hk : σ.kheap t.bv = some (.tcb x)) (r : Fl4Spec.Register) (v : U64)
    (hX2 : IRel st Z.th σ.archState.x64CurrentCr3 Z.N Z.T Z.C Z.E Z.R Z.B Z.c (L.wr s (Endp.regA t (regIdx r)) v)
      (updK σ t.bv (.tcb (setReg x r v.bv)))) :
    P1.WritesIn st s (L.wr s (Endp.regA t (regIdx r)) v) (Ipc.FinW (st := st) Z.T Z.N Z.C Z.c s σ) ∧
      JAtZB (L := L) arI AR Z H Cs Ac Lst D (L.wr s (Endp.regA t (regIdx r)) v) a
        (updK σ t.bv (.tcb (setReg x r v.bv))) := by
  have hP0 := J.ip
  have hT : TcbPlaced Z.T := hP0.e.tcb
  have hta := hT t ht
  have htH : t ∈ P1.Heap.tcbs H := J.zH.1 t ht
  have hTH : P1.TcbPlaced (P1.Heap.tcbs H) := by rw [← J.tcbs_eq.1]; exact hT
  have hil := regIdx_lt r
  set K : U64 := ⟨BitVec.ofNat 64 (256 + 8 * (regIdx r).val)⟩ with hKdef
  have hKv : K.val = 256 + 8 * (regIdx r).val := by
    show (BitVec.ofNat 64 (256 + 8 * (regIdx r).val)).toNat = _
    rw [BitVec.toNat_ofNat]; exact Nat.mod_eq_of_lt (by omega)
  have hra : (Endp.regA t (regIdx r)).val = t.val + 256 + 8 * (regIdx r).val := regA_val hta hil
  have hKt : (core.num.U64.wrapping_add t K).val = t.val + K.val := tfield_val hta (by rw [hKv]; omega)
  have hreq : Endp.regA t (regIdx r) = core.num.U64.wrapping_add t K :=
    UScalar.eq_of_val_eq (by rw [hra, hKt, hKv]; omega)
  have hwr : P1.WritesIn st s (L.wr s (Endp.regA t (regIdx r)) v) (· = Endp.regA t (regIdx r)) :=
    writesIn_wr (a_reg hta r).1
  have hblk := (blk_rf J.blk (hwr.mono fun b hb => Or.inl ⟨t, htH, K, by rw [hKv]; omega,
    by rw [hKv]; omega, by rw [hb, hreq]⟩)).1
  have hfoot : P1.WritesIn st s (L.wr s (Endp.regA t (regIdx r)) v) (P1.KW st (P1.Heap.tcbs H) Cs
      (P1.Heap.frame H) (P1.Heap.scs H) (P1.Heap.scBits H) ∅ s) := by
    rw [hreq]
    exact foot_field hTH htH (by rw [hKv]; omega) (by rw [hKv]; omega) (by rw [hKv]; omega)
      ⟨by rw [hKv]; omega, by rw [hKv]; omega⟩
  have hA : QKY σ (updK σ t.bv (.tcb (setReg x r v.bv))) := by
    refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, fun p => ?_⟩
    by_cases hp : p = t.bv
    · subst hp; exact Or.inr (Or.inl ⟨x, setReg x r v.bv, hk, by simp [updK], rfl⟩)
    · exact Or.inl (by simp [updK, hp])
  exact J.reg_frameFZ hX2 (hwr.mono fun b hb => Or.inl (Or.inl ⟨t, ht, by rw [hb, hra]; omega,
    by rw [hb, hra]; omega⟩)) hA (YK.YKS.updTcb (y := setReg x r v.bv) hk rfl).ykeep
    (J.inv.updSame (y := setReg x r v.bv) hk rfl rfl (Or.inl rfl)) hblk hfoot

end

section
open Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched

/-- **A register write of a thread at `JAtZV3`** (module docstring). -/
theorem JAtZV3.regWr (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) {t : U64} (ht : t ∈ Z.T)
    {x : Fl4Spec.Tcb} (hk : σ.kheap t.bv = some (.tcb x)) (r : Fl4Spec.Register) (v : U64) :
    JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D (L.wr s (Endp.regA t (regIdx r)) v) a
      (Notif.updK σ t.bv (.tcb (Notif.setReg x r v.bv))) := by
  have B := J.z2.zv.base
  have hS := B.xtop.fin.1.1.1
  have hX2 := reg_wr_irelN B.ip (B.xtop.irelK B.ks B.buf) ht hk r v
  obtain ⟨hwF, B'⟩ := B.regWrJZ ht hk r v hX2
  have hA : QKY σ (Notif.updK σ t.bv (.tcb (Notif.setReg x r v.bv))) := by
    refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, fun p => ?_⟩
    by_cases hp : p = t.bv
    · subst hp; exact Or.inr (Or.inl ⟨x, Notif.setReg x r v.bv, hk, by simp [Notif.updK], rfl⟩)
    · exact Or.inl (by simp [Notif.updK, hp])
  obtain ⟨h1, h2, h3, h4⟩ := zv_qky hA
  exact J.ofBS B' hwF (fun b hb => Ipc.FinW.oobj hS hb) (fun b hb => B.finW_nh hb)
    (B.vkeep_of hwF fun b hb => Ipc.FinW.nv hS hb)
    (fun u hu => by obtain ⟨vu, hvu⟩ := J.z2.zv.vm.spec u hu; exact h1 _ _ hvu) h2 h3 h4

/-- **An IPC-buffer word written at `JAtZV3`** (module docstring). -/
theorem JAtZV3.userWr (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ)
    (hBP : BufPlaced (L := L) Z.N Z.C Z.B Z.c s σ) {wp : U64 × Fl4Spec.Word} (hwB : wp ∈ Z.B)
    (hAp : ∀ q k, H q = some k → (∀ z, k ≠ .other z) → wp.1.val + 8 ≤ q.val ∨ q.val + 2 ^ k.bits ≤ wp.1.val)
    (hObj : ∃ o ko, σ.kheap o = some ko ∧ o.toNat ≤ wp.1.val ∧ wp.1.val < o.toNat + 2 ^ Fl4Spec.objBits ko)
    (v : U64) :
    JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D (L.wr s wp.1 v) a
      (Endp.setUm σ (Endp.storeMem σ.machineState.underlyingMemory wp.2 v.bv)) := by
  have B := J.z2.zv.base
  have hP := B.xtop.fin.1.2
  have hS := B.xtop.fin.1.1.1
  have hal : P1.Aligned wp.1 := (hP.ep.balign wp hwB).1
  have hW : P1.WritesIn st s (L.wr s wp.1 v) (· = wp.1) := P1.writesIn_wr hal
  refine J.ofB (B.userWrJ hBP hwB hAp hObj v) hW (fun b hb => ?_) (fun b hb => ?_)
    (B.vkeep_of hW fun b hb => ?_) rfl
  · subst hb
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨wp, hwB, le_refl _, by omega⟩))))))
  · subst hb
    intro e
    have hvh : (P1.vHeadA st s).val = (L.ksb s).val + 80 := vHead_val B.kern.ksbFit
    have hnb : L.nodeBase s Z.c = (L.ksb s).val + 13568 + Z.c.val * 4288 := rfl
    have hf := hBP.far wp hwB
    rw [e, hvh, hnb] at hf
    omega
  · subst hb
    intro t ht e
    have hT := hS.placed.tcb
    have hv : wp.1.val = t.val + 3664 := by rw [e]; exact tfield_val (hT t ht) (K := 3664#u64) (by simp)
    rcases hAp t .tcb (B.zH.1 t ht) (fun _ e => by cases e) with e' | e'
    · omega
    · simp only [P1.HKind.bits] at e'; omega

end

end

end

end Fl4Proofs.P3
