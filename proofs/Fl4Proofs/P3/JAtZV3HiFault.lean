variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

/-! ## The null-handler arm at `JAtZV3` -/

section
open Classical Fl4Proofs.P3.Vs Fl4Proofs.P1 Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {V X : Set U64}

/-- **`set_thread_state Inactive` of the current thread at `JAtZV3`** (module docstring). -/
theorem JAtZV3.stsCurJ3 (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) (hni : Entered σ) {t : U64}
    (ht : t ∈ Z.T) (htD : t ∉ D) {x : Fl4Spec.Tcb} (hk : σ.kheap t.bv = some (.tcb x)) (hcur : σ.curThread = t.bv)
    (hrn : Fl4Spec.runnable x.tcbState = true) (hnq : ∀ d p, t.bv ∉ σ.readyQueues d p)
    (hB : sched.set_thread_state st s t sched.TS_INACTIVE ⦃ s' => P1.BlkOK st (P1.Heap.tcbs H) Cs (P1.Heap.omega H) H
      (P1.Heap.frame H) (P1.Heap.replies H) (P1.Heap.scs H) (P1.Heap.ntfns H) (P1.Heap.scBits H) Ac s' ∧
      P1.Foot st (P1.Heap.tcbs H) Cs (P1.Heap.frame H) (P1.Heap.scs H) (P1.Heap.scBits H) (P1.EH H) s s' ⦄) :
    sched.set_thread_state st s t sched.TS_INACTIVE ⦃ s6 => ∃ Lst' : U64 → List U64,
      JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst' D s6 a
        (stsAct (updK σ t.bv (.tcb { x with tcbState := .inactive })) t.bv) ⦄ := by
  have B := J.z2.zv.base
  have hS := B.xtop.fin.1.1.1
  refine WP.spec_mono (B.stsCurJ hni ht htD hk hcur hrn hnq hB) fun s6 h6 => ?_
  obtain ⟨Lst', B', hW⟩ := h6
  refine ⟨Lst', ?_⟩
  have hk7 : (stsAct (updK σ t.bv (.tcb { x with tcbState := .inactive })) t.bv).kheap t.bv =
      some (.tcb { x with tcbState := .inactive }) := by rw [stsAct_kheap]; simp [updK]
  have hkp7 : ∀ p, p ≠ t.bv → (stsAct (updK σ t.bv (.tcb { x with tcbState := .inactive })) t.bv).kheap p =
      σ.kheap p := by intro p hp; rw [stsAct_kheap]; simp [updK, hp]
  refine J.ofBS B' hW (fun b hb => tfoot_oobj hS hb) (fun b hb => B.tfoot_nh hb) (VKeep.of_tfoot hS B.thT hW)
    (fun u hu => ?_) (fun o ko' ho => ?_) (fun o x' ho hx => ?_) (fun o vs ho => ?_)
  · obtain ⟨vu, hvu⟩ := J.z2.zv.vm.spec u hu
    refine hkp7 _ fun e => ?_
    rw [e, hk] at hvu; cases hvu
  · by_cases e : o = t.bv
    · subst e
      rw [hk7] at ho; cases ho
      exact ⟨_, hk, rfl⟩
    · rw [hkp7 _ e] at ho; exact ⟨ko', ho, rfl⟩
  · by_cases e : o = t.bv
    · subst e
      rw [hk7] at ho; cases ho
      cases hx
    · rw [hkp7 _ e] at ho; exact ⟨x', ho, hx⟩
  · by_cases e : o = t.bv
    · subst e
      rw [hk7] at ho; cases ho
    · rw [hkp7 _ e] at ho; exact ho

set_option maxHeartbeats 4000000 in
/-- **`handle_fault` with a null fault handler at `JAtZV3`** (module docstring; `JAtZ.noFaultJ`'s proof). -/
theorem JAtZV3.noFaultJ3 (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) (hni : Entered σ) {ct : U64}
    (hct : sched.cur_thread st s = ok ct) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    (hnull : capAt (L.mem s) (cslotAddr (ct.bv, Fl4Spec.tcbCnodeIndex 3)) = ok .Null)
    (f : error.Fault) (f' : Fl4Spec.Fault) :
    faults.handle_fault st arI s a ct f ⦃ r => ∃ z ∈ (Fl4Spec.handleFault (Z := Unit) ct.bv f' σ).1,
      ZvPost (L := L) arI V X AR r.1 r.2 z.2 ⦄ := by
  have B := J.z2.zv.base
  obtain ⟨hcur, x, hk, hrn⟩ := B.curRunnable hni hct
  have htcb : Z.th ct = some .tcb := (B.xtop.curTcb hcur).1
  obtain ⟨x1, c1, hk1, hc1, hcr⟩ := fhCap_rel B.xtop.rel.2.1.1 htcb
  rw [hk] at hk1; cases hk1
  have e1 : c1 = .Null := by rw [hnull] at hc1; simpa using hc1.symm
  subst e1
  have hfh : x.tcbFaultHandler = .nullCap := by rw [← hcr.2]; rfl
  have hS := B.xtop.fin.1.1.1
  obtain ⟨Q, R, hc, hs⟩ := hS.lists
  have hct' : ct = nodeW st s Z.c layout.node.CUR_THREAD := by
    have h := sched.cur_thread.spec' (L := L) s
    rw [hct, WP.spec_ok, hc.cur] at h; exact h
  have hT : ct ∈ Z.T := by rw [hct']; exact hc.curT
  have hD : ct ∉ D := fun h => B.notDead hT hk (by have := runnable_code hrn; omega) ct h rfl
  have hnq' : ∀ d p, ct.bv ∉ σ.readyQueues d p := by rw [← hcur]; exact hnq
  have hCI : CurInv σ := B.curInv (by rw [hni.2]; intro e; cases e)
  have hnr : ct.bv ∉ σ.releaseQueue := by rw [← hcur]; exact hCI.notRel
  obtain ⟨bq, br⟩ := B.curBits hT hnq' hnr
  obtain ⟨hna, -⟩ := B.words_of_spec hT (fun u hu => by rw [hni.2] at hu; cases hu)
    (fun e => hni.1 (by rw [hcur, e]))
  obtain ⟨x0, hk0, hTR⟩ := (B.xtop.irelK B.ks B.buf).1.tcb ct hT
  rw [hk] at hk0; cases hk0
  have hv : (L.mem s (P1.stA ct)).val = tsCode x.tcbState := by
    rw [P1.stA_eq, ← tStA_eq]; exact hTR.st
  obtain ⟨hnb, hnrp⟩ := P1.run_word (w := L.mem s (P1.stA ct)) (by rw [hv]; exact runnable_code hrn)
  have hB := P1.sched.set_thread_state.inactive_blkR (Es := P1.EH H) s ct B.blk (B.zH.1 ct hT) hnb hnrp bq br hna
  have hspec := handleFault_null hk hfh f'
  unfold faults.handle_fault
  rw [tcb_slot_fault]
  apply ok_bind_spec
  rw [slot_cap_eq, hnull]
  apply ok_bind_spec
  step with Fl4Proofs.P1.obj.Tcb.sc.spec as ⟨i, _hi⟩
  unfold faults.send_fault_ipc
  dsimp only
  simp only [bind_ok, Bool.false_eq_true, ↓reduceIte]
  refine WP.spec_bind (J.stsCurJ3 hni hT hD hk hcur hrn hnq' hB) ?_
  rintro s6 ⟨Lst', J6⟩
  exact (WP.spec_ok _).2 ⟨_, by rw [hspec]; exact Set.mem_singleton _, ⟨Z, H, Cs, Ac, Lst', D, J6⟩⟩

end

end

/-! ## The narrowed premises and the top -/

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type}

/-- **[J] The entry state of a syscall** (module docstring): the current thread is not idle, the scheduler action
is `resumeCurThread` (`Entered`), and the current thread is in no ready queue. FL4 fl4-core sched.rs l. 645-675
(`schedule` ends with `set_action(ACTION_RESUME_CURRENT)`; the current thread is enqueued only on a reschedule and
then a chosen thread is dequeued by `switch_to_thread`); l4v `schact_is_rct`, `ct_not_in_q`. -/
def ZvEntry (σ : Fl4Spec.State Unit) : Prop :=
  Entered σ ∧ ∀ d p, σ.curThread ∉ σ.readyQueues d p

/-- **[W] The fault handler at `JAtZV3` for a non-null fault-handler cap** (module docstring): `ZvFaultHyp` asked
only when the faulting thread's fault-handler slot holds a non-null cap (an endpoint cap by l4v
`valid_fault_handler`): the fault-IPC send (P3/XTopJointFaultEp, XTopJointFaultRecv at `JAtZ`), not yet ported. -/
def ZvFaultEpHyp (arI : machine.Arch A) (V X : Set U64) (AR : A → Fl4Spec.Cr3 → Prop) (s : S) (a : A)
    (σ : Fl4Spec.State Unit) (ct : U64) (f : error.Fault) (f' : Fl4Spec.Fault) : Prop :=
  capAt (L.mem s) (cslotAddr (ct.bv, Fl4Spec.tcbCnodeIndex 3)) ≠ ok .Null →
    ZvFaultHyp (L := L) arI V X AR s a σ ct f f'

end

section
open Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit} {V X : Set U64}

/-- **`ZvFaultHyp` from `ZvEntry` and the narrower `ZvFaultEpHyp`** (module docstring). -/
theorem zvFaultHyp_of (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) (hE : ZvEntry σ) {ct : U64}
    (hct : sched.cur_thread st s = ok ct) {f : error.Fault} {f' : Fl4Spec.Fault}
    (hF : ZvFaultEpHyp (L := L) arI V X AR s a σ ct f f') : ZvFaultHyp (L := L) arI V X AR s a σ ct f f' := by
  by_cases hn : capAt (L.mem s) (cslotAddr (ct.bv, Fl4Spec.tcbCnodeIndex 3)) = ok .Null
  · exact J.noFaultJ3 hE.1 hct hE.2 hn f f'
  · exact hF hn

set_option maxHeartbeats 4000000 in
/-- **Gen 41's `JAtZV3.vcpuHandleJ` with `ZvFaultEpHyp` and `ZvEntry` for `ZvFaultHyp`** (module docstring). -/
theorem JAtZV3.vcpuHandleJ2 (hK : ARKeep arI AR) (hSy : ZvSyncKeep arI AR)
    (hVA : ZvVirtAgree arI) (hCap : ∀ a', VirtSanEq.CapAgree arI a') (hAT : P0.ArchTotal arI)
    (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) (onCore remoteCur : Fl4Spec.ObjRef → Bool)
    (is_call blocking can_donate first_phase : Bool) (cptr : U64)
    {ct : U64} (hct : sched.cur_thread st s = ok ct)
    {info : msginfo.MessageInfo} (hinfo : msg.msg_info st s ct = ok info)
    {mi : Fl4Spec.MessageInfo} (hmi : Fl4Spec.getMessageInfo (Z := Unit) ct.bv σ = ({(mi, σ)}, False))
    {buf : U64} (hbuf : msg.lookup_ipc_buffer st s false ct = ok buf)
    {buffer : Option Fl4Spec.ObjRef}
    (hbuffer : Fl4Spec.lookupIpcBuffer (Z := Unit) false ct.bv σ = ({(buffer, σ)}, False))
    {r2 : core.result.Result (Aeneas.Std.Array obj.Slot 3#usize) error.Fault}
    (hr2 : ipc.lookup_extra_caps st s ct buf info = ok r2)
    {er : Except Fl4Spec.Fault (List (Fl4Spec.Cap × Fl4Spec.CslotPtr))}
    (her : (Fl4Spec.lookupExtraCaps (Z := Unit) ct.bv buffer mi).run σ = ({(er, σ)}, False))
    (hrr : (∃ e exs, r2 = .Ok e ∧ er = .ok exs ∧
        (info.label = fl4_abi.label.X86VCPUEnableIOPort → IoFreshEx (L.mem s) e)) ∨
      (∃ f f', r2 = .Err f ∧ er = .error f' ∧
        (blocking = true → ZvFaultEpHyp (L := L) arI V X AR s a σ ct f f')))
    {args : List Fl4Spec.Data} (hmrs : Fl4Spec.getMrs (Z := Unit) ct.bv buffer mi σ = ({(args, σ)}, False))
    (hFL : blocking = true → ∀ lf lf', LookupFaultRel lf lf' →
      ZvFaultEpHyp (L := L) arI V X AR s a σ ct (.Cap cptr false lf)
        (.capFault (Fl4Spec.ofBl (Fl4Spec.toBl cptr.bv)) false lf'))
    (hent : blocking = true → ZvEntry σ)
    (hVc : ∀ r1, cspace.lookup_slot st s ct cptr = ok (.Ok r1) → ∃ p, capV (L.mem s) r1.slot = .Vcpu p)
    (hrun : ZvCtRun σ ct) :
    syscall.handle_invocation st arI s a is_call blocking can_donate first_phase cptr ⦃ res =>
      ∃ y ∈ ((Fl4Spec.fl4HandleInvocationVF (Z := Unit) onCore remoteCur true is_call blocking can_donate first_phase
          (Fl4Spec.toBl cptr.bv)).run σ).1,
        res.1 = .Ok () ∧ y.1 = .ok () ∧ ZvPost (L := L) arI V X AR res.2.1 res.2.2 y.2 ⦄ :=
  J.vcpuHandleJ hK hSy hVA hCap hAT onCore remoteCur is_call blocking can_donate first_phase cptr hct hinfo hmi hbuf
    hbuffer hr2 her
    (hrr.imp id fun ⟨f, f', h1, h2, h3⟩ => ⟨f, f', h1, h2, fun hb => zvFaultHyp_of J (hent hb) hct (h3 hb)⟩)
    hmrs (fun hb lf lf' hl => zvFaultHyp_of J (hent hb) hct (hFL hb lf lf' hl)) hVc hrun

end

end

