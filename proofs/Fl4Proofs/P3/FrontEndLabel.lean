/-
P3 (issue #16, front end): **FL4's label numbering and the spec's**.

The spec's label of a message is l4v's `invocation_type` of the label word
(`Fl4Spec.invocationType`, the position in l4v's `invocation_label`
enumeration), and the decode paths of XTopJointEntry ask, per cap, that it
be the spec label of FL4's (`cnodeLabelOf`, `tcbLabelOf`, `scLabelOf`, …).
The label word is the same on both sides (FL4's `msg_info` and the spec's
`getMessageInfo` both read bits 12.. of the message-info register).

FL4's labels (`fl4_abi::label`, generated by `crates/fl4-abi/build.rs` from
`interfaces/object-api*.xml`) number seL4's debug API (TCBSetBreakpoint ..
TCBConfigureSingleStepping, 16..19) and FL4's TCBReadFPU/WriteFPU/SetTimer
(22..24) inside the generic block, and the VT-x labels inside the arch
block, so from label 16 on FL4's numbers are not l4v's: FL4's
`CNodeRevoke` is 25, l4v's `CNodeRevoke` is 18 and l4v's label 25 is
`CNodeRotate`. Only labels 0..15 (InvalidInvocation, UntypedRetype and the
l4v TCB labels up to UnbindNotification) agree.

* `genInvocationType_fl4CNodeRevoke`, `cnodeLabel_mismatch`: at FL4's
  CNodeRevoke label the spec's label is `cnodeRotate`, so JCnodePath's
  `hlbl` (`genInvocationType slbl = cnodeLabelOf lbl` with `slbl` the
  label word) is false whenever a CNode cap is invoked with it.
* `genInvocationType_untyped_iff`: the label relation that does hold, the
  Untyped one (`JUtPath.hlbl`).
-/
import Fl4Proofs.P3.CnodeCopy

namespace Fl4Proofs.P3
open fl4_core Fl4Spec

/-- Every invocation label is in l4v's enumeration. -/
theorem InvocationLabel.fromEnum_lt (v : InvocationLabel) : v.fromEnum < InvocationLabel.enum.length := by
  cases v with
  | genInvocationLabel l => cases l <;> decide
  | archInvocationLabel l => cases l <;> decide

theorem enum_length : InvocationLabel.enum.length = 59 := by decide

/-- Every position of l4v's enumeration is some label's. -/
theorem enum_hit : ∀ n < 59, ∃ v ∈ InvocationLabel.enum, v.fromEnum = n := by decide

/-- The spec's label of a label word in range: the enumeration's entry. -/
theorem invocationType_of_lt {x : Data} (h : dataToNat x < InvocationLabel.enum.length) :
    invocationType x = InvocationLabel.enum[dataToNat x] := by
  have hex : ∃ v : InvocationLabel, v.fromEnum = dataToNat x := by
    obtain ⟨v, -, hv⟩ := enum_hit _ (by rw [← enum_length]; exact h)
    exact ⟨v, hv⟩
  unfold invocationType
  rw [if_pos hex]
  unfold InvocationLabel.toEnum
  rw [List.getElem?_eq_getElem h]
  rfl

/-- The spec's label of a label word out of range: invalid. -/
theorem invocationType_of_ge {x : Data} (h : InvocationLabel.enum.length ≤ dataToNat x) :
    invocationType x = .genInvocationLabel .invalidInvocation := by
  unfold invocationType
  rw [if_neg]
  rintro ⟨v, hv⟩
  have := InvocationLabel.fromEnum_lt v
  omega

theorem dataToNat_bv (w : Aeneas.Std.U64) : dataToNat w.bv = w.val := rfl

/-- **At FL4's `CNodeRevoke` label (25) the spec's label is `cnodeRotate`**
(l4v's label 25). -/
theorem genInvocationType_fl4CNodeRevoke :
    genInvocationType fl4_abi.label.CNodeRevoke.bv = .cnodeRotate := by
  have hv : dataToNat fl4_abi.label.CNodeRevoke.bv = 25 := by rw [dataToNat_bv]; exact lbl_revoke_val
  unfold genInvocationType
  rw [invocationType_of_lt (by rw [hv]; decide)]
  simp only [hv]
  rfl

/-- **The CNode label premise is false at FL4's `CNodeRevoke`**: with the
label word `slbl = lbl.bv` (the same register bits on both sides),
`genInvocationType slbl = cnodeLabelOf lbl` fails for `lbl = CNodeRevoke`. -/
theorem cnodeLabel_mismatch :
    genInvocationType fl4_abi.label.CNodeRevoke.bv ≠ cnodeLabelOf fl4_abi.label.CNodeRevoke := by
  rw [genInvocationType_fl4CNodeRevoke]
  unfold cnodeLabelOf
  rw [if_pos lbl_revoke_val]
  decide

/-- The generic label of an invocation label (`genInvocationType`'s match). -/
def genOfL : InvocationLabel → GenInvocationLabels
  | .genInvocationLabel l => l
  | .archInvocationLabel _ => .invalidInvocation

theorem genInvocationType_eq (x : Data) : genInvocationType x = genOfL (invocationType x) := by
  unfold genInvocationType genOfL; rfl

/-- Over l4v's enumeration, only entry 1 is `untypedRetype`. -/
theorem genOfL_enum_untyped :
    ∀ n < 59, genOfL (InvocationLabel.enum.getD n default) = .untypedRetype ↔ n = 1 := by
  decide

/-- **The Untyped label relation** (`JUtPath.hlbl`): the spec's label of the
label word is `untypedRetype` exactly at FL4's `UntypedRetype` (1, the same
number in both enumerations). -/
theorem genInvocationType_untyped_iff (w : Aeneas.Std.U64) :
    genInvocationType w.bv = .untypedRetype ↔ w = fl4_abi.label.UntypedRetype := by
  have hU : fl4_abi.label.UntypedRetype.val = 1 := by simp [fl4_abi.label.UntypedRetype]
  rw [u64_eq_iff, hU, ← dataToNat_bv, genInvocationType_eq]
  by_cases h : dataToNat w.bv < 59
  · rw [invocationType_of_lt (by rw [enum_length]; exact h), ← List.getD_eq_getElem _ default (by rw [enum_length]; exact h)]
    exact genOfL_enum_untyped _ h
  · rw [invocationType_of_ge (by rw [enum_length]; omega)]
    constructor
    · intro e; cases e
    · intro e; omega

end Fl4Proofs.P3
