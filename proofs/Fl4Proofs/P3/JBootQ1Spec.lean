  · rcases kh1_sc_of hp with ⟨-, rfl, -⟩ | ⟨-, rfl, -⟩
    · exact idleSc_active
    · exact idleSc_active
  · rcases kh1_sc_of hp with ⟨-, rfl, -⟩ | ⟨-, rfl, -⟩
    · exact idleSc_active
    · exact idleSc_active

