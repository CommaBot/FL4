    fun _ => ⟨fun _ _ h => by simp [σ1, fInitASt, initASt] at h, ⟨fun h => by simp [σ1, fInitASt, initASt] at h,
      fun h => by simp [σ1, fInitASt, initASt] at h⟩⟩, fun _ h => by simp [σ1, fInitASt, initASt] at h⟩,
    fun _ => Or.inl ⟨rootTcbV, kh1_rT, rfl⟩⟩

