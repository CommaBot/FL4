  nq := σ1_ntfnQB
  epq := σ1_epQB
  live := σ1_ifLiveT
  vi := σ1_validIdle
  ft := σ1_ft
  sl := ⟨⟨σ1_scLiveT, σ1_idleScOutV, σ1_ntfnScB, σ1_scInv⟩, σ1_scKindR⟩
  cs := σ1_curScT

