/-- #68: the TD module's frame write (memory only) as a machine leaf. -/
macro_rules | `(tactic| hv_leaf) => `(tactic| ((with_reducible refine WLH.msk _ ?_); exact mt_of_mkf (Fl4Proofs.P3.MachF.mkf_tdxFrameWrite _ _)))
/-- fb3e: the frame batch, from the leaves of its writes (`SInv.ik_performFrameBatchW`): the caps it
inserts or writes are frame caps (no IRQ handler), its `empty_slot`s have a Null cleanup cap. -/
theorem vil_performFrameBatch (b : Fl4FrameBatchInvocation) : IKH VIL (performFrameBatch (Z := Unit) b) := by
  have hca : ∀ c : Cap, Fl4Proofs.P3.SInv.IsFrameCap c → ∀ is, (fun _ => True : (Irq → IrqState) → Prop) is → CAL c is :=
    fun c hc is _ => cal_noH (fun irq e => by subst e; exact False.elim hc) is
  exact Fl4Proofs.P3.SInv.ik_performFrameBatchW b (fun c _ _ hc => vhl_capInsert c _ _ (hca c hc))
    (fun _ => vil_performPageInvocation _) (fun _ _ _ _ _ _ _ => hv_archFinaliseCap _ _)
    (fun sl σ hσ x hx => vil_emptySlot_p sl .nullCap σ (fun _ h => by cases h) hσ x hx)
    (fun _ _ _ _ => by unfold unmapPageUnflushed; hv_auto) (fun c _ hc => vhl_setCap c _ (hca c hc)) (hv_flushAll _ _)
macro_rules | `(tactic| hv_leaf) => `(tactic| with_reducible exact vil_performFrameBatch _)

