/-
**p3J gen 17 copy** of JBootQZ (namespace `JBootQ.M2`, generated by scratch/p3J/genM2.py): the same
proofs at the **2-core** boot witness `JBootQ.M2.w0` (JBootM2Mem: `JBootQ.img` plus core 1's node words, core 1's
idle TCB `I1T` and idle SC `I1S` as FL4's `create_idle_thread` writes them, boot.rs l.684-704; `NUM_NODES` 2),
cores `Csw = {0, 1}` (JBootM2Z). Core 1's idle objects are outside every ghost set, `H` and the spec state
(the per-core projection, P3JMc). Original docstring:

**p3J gen 7 copy** of JBootZ (namespace `JBootQ`, generated by scratch/p3J/genQ.py): the same proofs at
`JBootQ.w0` / `JBootQ.fInitASt` (FL4's boot IRQ layout: line 125 `IRQ_TIMER`, 126 / 127 `IRQ_IPI`; spec 125
`irqTimer`, 126 / 127 `irqReserved`). Original docstring:

P3 (line jboot, gen 3): **the witness's ghosts** at `w0` / `fInitASt` (JBootMem, JBootSched) and the slot facts
every CSpace conjunct reads.

* `thW` (the typed heap `Z.th`): the idle TCB and the 256 IRQ-node CNodes of `fInitASt` (radix 0) at `fIrqNode`:
  IRQs 0..127 inside the kernel-state block at `nodeA fkb i`, IRQs 128..255 at `kernelBase + 0x2000 + 32 i`
  (`KTyped` asks every spec CNode typed). **`thW_pos`** (positions), **`placed_thW`** (`Placed`),
  **`kTyped_thW`** (`KTyped`), **`intL_thW`** (`IntLayout`), **`thT_thW`**, **`thk_thW`**.
* `Gw` (the MDB ghost): no chains, no parents.
* `Hw` (P1's heap): the idle TCB, the idle SC (`sc 7`), the three global tables (`other 12`), the IRQ CNodes
  128..255 (`other 5`) and the kernel-state block (`ksH fkb`: the IRQ CNodes 0..127 as `other 5`, 8-byte
  `other 3` tiles). `Dw` (the dead set): the IRQ CNodes 128..255 and the global tables (no cap names them, no
  untyped covers them; `DeadP` / `DeadX` are vacuous for `other` objects).
* `Zw` (`XSets`): `th := thW`, `G := Gw`, `T := T0`, `C := C0`, every other set empty, core 0, `vx := ∅`.
* **The slots are null**: every word of every slot of `thW` is zero in `w0` (`mem_slotw`), so `capV` is `Null`,
  the links are 0 and the revocable bit is clear (`capV_slot`, `capAt_slot`, `prevOf_slot`, `nextOf_slot`,
  `revOf_slot`).

No sorry; no premises. New module; no existing statement changed.
-/
import Fl4Proofs.P3.JBootM2Sched
import Fl4Proofs.P3.KsHeap
import Fl4Proofs.P3.MdbInsert
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3.JBootQ.M2
open Fl4Proofs.P3.JBoot
open fl4_core Fl4Spec Fl4Proofs.P1 Fl4Proofs.P3 Fl4Proofs.P3.Sched Fl4Proofs.P2.Wit Classical

noncomputable section

set_option maxHeartbeats 1000000

/-! ## The IRQ node's positions -/

theorem fIrqNode_cases (irq : Irq) :
    (irq.toNat < 128 ∧ (fIrqNode irq).toNat = 18446744071562134752 + 32 * irq.toNat) ∨
    (128 ≤ irq.toNat ∧ irq.toNat < 256 ∧ (fIrqNode irq).toNat = 18446744071562076160 + 32 * irq.toNat) := by
  have := irq.isLt
  by_cases h : irq.toNat < 128
  · left; exact ⟨h, by have := fIrqNode_lo h; omega⟩
  · right; exact ⟨by omega, by omega, fIrqNode_hi h⟩

/-! ## The typed heap -/

/-- **The witness's typed heap** (module docstring). -/
def thW : TypedHeap := fun p =>
  if p = idT then some .tcb else if ∃ irq : Irq, fIrqNode irq = p.bv then some (.cnode 0) else none

theorem thW_some {p : U64} {k : ObjKind} (h : thW p = some k) :
    (p = idT ∧ k = .tcb) ∨ (∃ irq : Irq, fIrqNode irq = p.bv ∧ k = .cnode 0) := by
  unfold thW at h
  split_ifs at h with h1 h2
  · cases h; exact Or.inl ⟨h1, rfl⟩
  · cases h; obtain ⟨irq, e⟩ := h2; exact Or.inr ⟨irq, e, rfl⟩

/-- **The typed heap's objects by position.** -/
theorem thW_pos {p : U64} {k : ObjKind} (h : thW p = some k) :
    (p.val = 18446744071562072064 ∧ k = .tcb) ∨
    (k = .cnode 0 ∧ ((∃ i, i < 128 ∧ p.val = 18446744071562134752 + 32 * i) ∨
      (∃ i, 128 ≤ i ∧ i < 256 ∧ p.val = 18446744071562076160 + 32 * i))) := by
  rcases thW_some h with ⟨rfl, rfl⟩ | ⟨irq, e, rfl⟩
  · exact Or.inl ⟨rfl, rfl⟩
  · right; refine ⟨rfl, ?_⟩
    have hv : p.val = (fIrqNode irq).toNat := by rw [e]; rfl
    rcases fIrqNode_cases irq with ⟨h1, h2⟩ | ⟨h1, h2, h3⟩
    · exact Or.inl ⟨_, h1, by rw [hv, h2]⟩
    · exact Or.inr ⟨_, h1, h2, by rw [hv, h3]⟩

theorem thW_idT : thW idT = some .tcb := by unfold thW; rw [if_pos rfl]

theorem irq_ne_idT (irq : Irq) : (⟨fIrqNode irq⟩ : U64) ≠ idT := by
  intro e
  have hv : (fIrqNode irq).toNat = idT.val := by rw [← e]; rfl
  rw [idT_val] at hv
  rcases fIrqNode_cases irq with ⟨h1, h2⟩ | ⟨h1, h2, h3⟩ <;> omega

theorem thW_irq (irq : Irq) : thW ⟨fIrqNode irq⟩ = some (.cnode 0) := by
  unfold thW; rw [if_neg (irq_ne_idT irq), if_pos ⟨irq, rfl⟩]

/-- **`Placed`** of the typed heap. -/
theorem placed_thW : Placed thW where
  align p k h := by
    rcases thW_pos h with ⟨e, -⟩ | ⟨-, ⟨i, -, e⟩ | ⟨i, -, -, e⟩⟩ <;> omega
  fits p k h := by
    rcases thW_pos h with ⟨e, rfl⟩ | ⟨rfl, ⟨i, hi, e⟩ | ⟨i, hi, hi2, e⟩⟩ <;>
      simp only [objSize, Nat.pow_zero, Nat.mul_one] <;> omega
  disj p q kp kq hp hq hne := by
    have hv : p.val ≠ q.val := fun e => hne (UScalar.eq_of_val_eq e)
    rcases thW_pos hp with ⟨e, rfl⟩ | ⟨rfl, ⟨i, hi, e⟩ | ⟨i, hi, hi2, e⟩⟩ <;>
    rcases thW_pos hq with ⟨e', rfl⟩ | ⟨rfl, ⟨j, hj, e'⟩ | ⟨j, hj, hj2, e'⟩⟩ <;>
      simp only [objSize, Nat.pow_zero, Nat.mul_one] <;> omega
  high p k h := by
    rcases thW_pos h with ⟨e, -⟩ | ⟨-, ⟨i, -, e⟩ | ⟨i, -, -, e⟩⟩ <;> omega

/-- The spec CNodes of the witness are its IRQ-node CNodes. -/
theorem fInitKheap_cnode {o : ObjRef} {r : Nat} {cs : CnodeContents} (h : fInitKheap o = some (.cnode r cs)) :
    (∃ irq : Irq, fIrqNode irq = o) ∧ r = 0 ∧ cs = emptyCnode 0 := by
  unfold fInitKheap at h
  simp only [Function.update_apply] at h
  split_ifs at h with h1 h2 h3 h4 h5 h6
  · rw [initKheap_pd] at h; cases h
  · rw [initKheap_pdpt] at h; cases h
  · rw [initKheap_pml4] at h; cases h
  · rw [initKheap_idleS] at h; cases h
  · rw [initKheap_idleT] at h; cases h
  · cases h; exact ⟨h6, rfl, rfl⟩

/-- Each IRQ node slot of the witness holds an empty radix-0 CNode. -/
theorem fInitKheap_irq (irq : Irq) : fInitKheap (fIrqNode irq) = some (.cnode 0 (emptyCnode 0)) := by
  have hv := fIrqNode_cases irq
  have ne : ∀ x : ObjRef, x.toNat ≠ (fIrqNode irq).toNat → fIrqNode irq ≠ x := fun x h e => h (by rw [e])
  unfold fInitKheap
  rw [Function.update_of_ne (ne _ (by rw [show initGlobalPd.toNat = 18446744071562092544 by decide]; omega)),
    Function.update_of_ne (ne _ (by rw [show initGlobalPdpt.toNat = 18446744071562088448 by decide]; omega)),
    Function.update_of_ne (ne _ (by rw [show initGlobalPml4.toNat = 18446744071562084352 by decide]; omega)),
    Function.update_of_ne (ne _ (by rw [show idleScPtr.toNat = 18446744071562096640 by decide]; omega)),
    Function.update_of_ne (ne _ (by rw [show idleThreadPtr.toNat = 18446744071562072064 by decide]; omega)),
    if_pos ⟨irq, rfl⟩]

/-- **`KTyped`**: every spec CNode and TCB of `fInitASt` is typed. -/
theorem kTyped_thW : KTyped thW fInitASt := by
  intro o
  refine ⟨fun r cs h _ => ?_, fun t h => ?_⟩
  · obtain ⟨⟨irq, rfl⟩, rfl, -⟩ := fInitKheap_cnode h
    exact thW_irq irq
  · obtain ⟨rfl, -⟩ := bootHeap_fInit.tcb_of h
    rw [← idT_bv]; exact thW_idT

/-- `thW`'s TCBs are `T0`'s. -/
theorem thT_thW : ∀ t, thW t = some .tcb → t ∈ T0 := by
  intro t h
  rcases thW_some h with ⟨rfl, -⟩ | ⟨_, _, e⟩
  · rfl
  · cases e

/-- `thW` holds TCBs and CNodes only. -/
theorem thk_thW : ∀ q k, thW q = some k → k = .tcb ∨ ∃ r, k = .cnode r := by
  intro q k h
  rcases thW_some h with ⟨-, rfl⟩ | ⟨_, _, rfl⟩
  · exact Or.inl rfl
  · exact Or.inr ⟨0, rfl⟩

/-- **`IntLayout`** at `fkb`. -/
theorem intL_thW : IntLayout thW fkb where
  fit := fkb_lt
  align := fkb_fit.2.2
  st_out i hi := by
    have hv := irqStA_val (kb := fkb) fkb_lt hi
    rw [fkb_val] at hv
    refine ⟨by show (irqStA fkb i).val % 8 = 0; omega, fun p k hp => ?_⟩
    rw [hv]
    rcases thW_pos hp with ⟨e, rfl⟩ | ⟨rfl, ⟨j, hj, e⟩ | ⟨j, hj, hj2, e⟩⟩ <;>
      simp only [objSize, Nat.pow_zero, Nat.mul_one] <;> omega
  node i hi := by
    have e := fIrqNode_node i hi
    have hn : nodeA fkb i = ⟨fIrqNode (BitVec.ofNat 8 i.val)⟩ := by rw [e]
    rw [hn]; exact thW_irq _

/-! ## The slots are null -/

/-- The byte addresses of the typed heap's slots: the idle TCB's six slots, the IRQ CNodes 0..127 and 128..255. -/
def SlotNat (n : Nat) : Prop :=
  (18446744071562072064 ≤ n ∧ n < 18446744071562072064 + 192) ∨
  (18446744071562134752 ≤ n ∧ n < 18446744071562138848) ∨
  (18446744071562080256 ≤ n ∧ n < 18446744071562084352)

theorem mem_slot {a : U64} (h : SlotNat a.val) : wL.mem w0 a = 0#u64 := by
  rw [mem_w0]; unfold SlotNat at h; img0

/-- **Every byte of a slot of `thW` is a slot byte.** -/
theorem slot_nat {x : U64} (h : IsSlot thW x) (k : Nat) (hk : k < 32) : SlotNat (x.val + k) := by
  obtain ⟨p, i, hs, rfl⟩ := h
  rw [IsSlotAt.val placed_thW hs]
  unfold SlotNat
  rcases hs with ⟨r, hp, hi⟩ | ⟨hp, hi⟩
  · rcases thW_pos hp with ⟨-, e⟩ | ⟨e, ⟨j, hj, hv⟩ | ⟨j, hj, hj2, hv⟩⟩
    · cases e
    · cases e; rw [Nat.pow_zero] at hi; omega
    · cases e; rw [Nat.pow_zero] at hi; omega
  · unfold tcbSlots at hi
    rcases thW_pos hp with ⟨hv, -⟩ | ⟨e, -⟩
    · omega
    · cases e

theorem mem_slotw {x : U64} (h : IsSlot thW x) {k : U64} (hk : k.val < 32) : wL.mem w0 (wordOf x k) = 0#u64 := by
  have h1 := slot_nat h k.val hk
  apply mem_slot
  rw [wordOf_val (by unfold SlotNat at h1; omega)]; exact h1

theorem mem_slot0 {x : U64} (h : IsSlot thW x) : wL.mem w0 x = 0#u64 := by
  have h1 := slot_nat h 0 (by omega)
  rw [Nat.add_zero] at h1
  exact mem_slot h1

theorem capV_slot {x : U64} (h : IsSlot thW x) : capV (wL.mem w0) x = .Null :=
  capV_zero (mem_slot0 h) (mem_slotw h (k := 8#u64) (by decide))

theorem capAt_slot {x : U64} (h : IsSlot thW x) : capAt (wL.mem w0) x = ok .Null := by
  rw [capAt_capV, capV_slot h]

theorem prevOf_slot {x : U64} (h : IsSlot thW x) : prevOf (wL.mem w0) x = 0#u64 :=
  mem_slotw h (k := 16#u64) (by decide)

theorem nextOf_slot {x : U64} (h : IsSlot thW x) : nextOf (wL.mem w0) x = 0#u64 := by
  unfold nextOf; rw [mem_slotw h (k := 24#u64) (by decide)]; decide

theorem revOf_slot {x : U64} (h : IsSlot thW x) : revOf (wL.mem w0) x = false := by
  unfold revOf; rw [mem_slotw h (k := 24#u64) (by decide)]; decide

/-! ## The other ghosts -/

/-- **The MDB ghost**: no chains, no parents. -/
def Gw : MdbGhost := ⟨[], fun _ => none⟩

/-- **P1's heap** (module docstring). -/
def Hw : Heap := fun p =>
  if p = idT then some .tcb
  else if p = idS then some (.sc 7)
  else if p.val = 18446744071562084352 ∨ p.val = 18446744071562088448 ∨ p.val = 18446744071562092544 then
    some (.other 12)
  else if 18446744071562080256 ≤ p.val ∧ p.val < 18446744071562084352 ∧ p.val % 32 = 0 then some (.other 5)
  else ksH fkb p

theorem Hw_some {p : U64} {k : HKind} (h : Hw p = some k) :
    (p = idT ∧ k = .tcb) ∨ (p = idS ∧ k = .sc 7) ∨
    (k = .other 12 ∧ (p.val = 18446744071562084352 ∨ p.val = 18446744071562088448 ∨
      p.val = 18446744071562092544)) ∨
    (k = .other 5 ∧ 18446744071562080256 ≤ p.val ∧ p.val < 18446744071562084352 ∧ p.val % 32 = 0) ∨
    ksH fkb p = some k := by
  unfold Hw at h
  split_ifs at h with h1 h2 h3 h4
  · cases h; exact Or.inl ⟨h1, rfl⟩
  · cases h; exact Or.inr (Or.inl ⟨h2, rfl⟩)
  · cases h; exact Or.inr (Or.inr (Or.inl ⟨rfl, h3⟩))
  · cases h; exact Or.inr (Or.inr (Or.inr (Or.inl ⟨rfl, h4⟩)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr h)))

/-- **`Hw`'s objects by position** (the kernel-state block's tiles by `ksH_some`). -/
theorem Hw_pos {p : U64} {k : HKind} (h : Hw p = some k) :
    (p.val = 18446744071562072064 ∧ k = .tcb) ∨ (p.val = 18446744071562096640 ∧ k = .sc 7) ∨
    (k = .other 12 ∧ (p.val = 18446744071562084352 ∨ p.val = 18446744071562088448 ∨
      p.val = 18446744071562092544)) ∨
    (k = .other 5 ∧ 18446744071562080256 ≤ p.val ∧ p.val < 18446744071562084352 ∧ p.val % 32 = 0) ∨
    (k = .other 5 ∧ 18446744071562133504 + 1248 ≤ p.val ∧ p.val < 18446744071562133504 + 5344 ∧
      (p.val - 18446744071562133504) % 32 = 0) ∨
    (k = .other 3 ∧ 18446744071562133504 ≤ p.val ∧ p.val < 18446744071562133504 + 13568 ∧
      (p.val - 18446744071562133504) % 8 = 0 ∧
      ¬ (18446744071562133504 + 1248 ≤ p.val ∧ p.val < 18446744071562133504 + 5344)) := by
  rcases Hw_some h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | h3 | h4 | h5
  · exact Or.inl ⟨rfl, rfl⟩
  · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
  · exact Or.inr (Or.inr (Or.inl h3))
  · exact Or.inr (Or.inr (Or.inr (Or.inl h4)))
  · have := ksH_some h5
    rw [fkb_val] at this
    exact Or.inr (Or.inr (Or.inr (Or.inr this)))

theorem Hw_idT : Hw idT = some .tcb := by unfold Hw; rw [if_pos rfl]
theorem Hw_idS : Hw idS = some (.sc 7) := by unfold Hw; rw [if_neg (by decide), if_pos rfl]

/-- **The dead set**: the IRQ CNodes 128..255 and the three global tables. -/
def Dw : Set U64 := {p | (18446744071562080256 ≤ p.val ∧ p.val < 18446744071562084352 ∧ p.val % 32 = 0) ∨
  p.val = 18446744071562084352 ∨ p.val = 18446744071562088448 ∨ p.val = 18446744071562092544}

/-- The cores. -/
def Csw : Set U64 := {0#u64, 1#u64}

/-- **The witness's ghost sets** (module docstring). -/
def Zw : XSets := ⟨thW, Gw, ∅, ∅, ∅, ∅, ∅, ∅, T0, C0, ∅, ∅, ∅, 0#u64, ∅⟩

theorem Zw_vx : VxE Zw := ⟨rfl⟩

end

end Fl4Proofs.P3.JBootQ.M2
