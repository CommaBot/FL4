section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

/-! ## The donation at `JAtZB` and `JAtZV3` -/

section
open Classical Fl4Proofs.P3.Vs Fl4Proofs.P1 Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched

set_option maxHeartbeats 4000000 in
/-- **`maybe_donate_sched_context` to a running thread without an SC keeps `JAtZB`** (module docstring). -/
theorem JAtZB.donJ (hAT : P0.ArchTotal arI)
    (hmb : ∀ a : A, sporadic.min_budget arI a ⦃ mb => mb.bv = Fl4Spec.MIN_BUDGET ⦄)
    (J : JAtZB (L := L) arI AR Z H Cs Ac Lst D s a σ) {t n : U64} (ht : t ∈ Z.T) (hn : n ∈ Z.N)
    {x : Fl4Spec.Tcb} (hk : σ.kheap t.bv = some (.tcb x)) (hxr : x.tcbState = .running)
    (hx0 : x.tcbSchedContext = none) :
    notification.maybe_donate_sched_context st arI s a t n ⦃ r => r.2 = a ∧ ∃ σ' : Fl4Spec.State Unit,
      Fl4Spec.maybeDonateSc (Z := Unit) t.bv n.bv σ = ({((), σ')}, False) ∧ σ'.domainTime = σ.domainTime ∧
      ScTKw (fun _ => False) σ σ' ∧ P1.WritesIn st s r.1 (TFoot st Z.T Z.N Z.C Z.c s σ) ∧
      JAtZB (L := L) arI AR Z H Cs Ac Lst D r.1 a σ' ⦄ := by
  have hS := J.xtop.fin.1.1.1
  have hR : NtfnStateRel Z.N Z.T (L.mem s) σ := J.xtop.fin.1.1.2.2.1
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨Q, R0, hc, hs⟩ := hS.lists
  obtain ⟨xt, hkt, -, -, hsct, -⟩ := hs.tcb t ht
  rw [hk] at hkt; cases hkt
  have h0 : L.mem s (P1.scA t) = 0#u64 := optRef_none (hsct.symm.trans hx0)
  obtain ⟨xn, hkn, -⟩ := hR.ntfn n hn
  -- the spec: `t` in no queue
  have hrq : ∀ d p, t.bv ∉ σ.readyQueues d p := fun d p hm => by
    obtain ⟨x', scp, -, -, h1, h2, -⟩ := J.inv.rq d p t.bv hm
    rw [hk] at h1; cases h1; rw [hx0] at h2; cases h2
  have hnr : t.bv ∉ σ.releaseQueue := J.inv.notRel_of_noSc hk hx0
  have hnqT : NotQueued σ t.bv := ⟨hrq, hnr⟩
  -- P1's side conditions
  have htH : t ∈ P1.Heap.tcbs H := J.zH.1 t ht
  have hnH : n ∈ P1.Heap.ntfns H := J.zH.2.2.2 n hn
  obtain ⟨⟨Q1, R1, h1q⟩, hB1, hX1, hS1, hSg1⟩ := J.blk
  obtain ⟨x0, hk0, hTR⟩ := hI.1.tcb t ht
  rw [hk] at hk0; cases hk0
  have hv : (L.mem s (P1.stA t)).val = tsCode x.tcbState := by
    rw [P1.stA_eq, ← tStA_eq]; exact hTR.st
  obtain ⟨hnb, hnrp⟩ := P1.run_word (w := L.mem s (P1.stA t))
    (by rw [hv]; exact runnable_code (by rw [hxr]; rfl))
  have hnS : ¬ P1.Sch st s t := by
    rintro (e | e | e | e | ⟨e1, e2⟩ | e)
    · exact hB1.q t htH e h0
    · exact hB1.r t htH e h0
    · exact hB1.act (by rw [e]; exact htH) (by rw [e]; exact h0)
    · exact hB1.idle (by rw [e]; exact h0)
    · exact hB1.resume e1 (by rw [e2]; exact h0)
    · rcases e with e | e
      · exact hnb e
      · exact hnrp e
  have p1 := Fl4Proofs.P1.notification.maybe_donate_sched_context.tinvF (Es := P1.EH H) hAT s a t n Q1 R1 h1q
    hB1 hX1 hS1 hSg1 htH (Classical.byContradiction fun e => hB1.q t htH e h0)
    (Classical.byContradiction fun e => hB1.r t htH e h0)
    (fun e => hB1.act (by rw [e]; exact htH) (by rw [e]; exact h0)) (fun e => hB1.idle (by rw [e]; exact h0))
    (fun hn0 _ _ => by
      obtain ⟨c1, -⟩ := hX1.2.2.nsc n hnH hn0
      exact ⟨c1, hX1.2.2.core _ c1, fun h => absurd h hnS⟩)
  -- FL4's refinement
  have hDon := maybe_donate_refinesA s a σ hR hS J.inv.relOK (hmb a) t n ht hn
    (fun h => NSC.mem J.nsc hR hn h) (fun _ y hy => by rw [hk] at hy; cases hy; exact hrq _ _)
  refine WP.spec_mono (WP.spec_and hDon p1) ?_
  rintro ⟨s', a'⟩ ⟨⟨ha, σ1, he, hf, hkv, hS', hw, -⟩, hp1⟩
  try simp only [WP.uncurry'_pair] at hp1
  obtain ⟨hblk, -, -, hfoot⟩ := hp1
  simp only at ha
  subst ha
  have hK0 : ScTKw (fun _ => False) σ σ1 := NKT.of_eq (nkt_maybeDonateSc t.bv n.bv) he
  have hK : ScTKw (fun p => p = σ.curThread) σ σ1 := hK0.ofFalse
  have hN1 : NtfnStateRel Z.N Z.T (L.mem s') σ1 := hR.frame hS.placed hf hkv
  have hIR := tk_lift J.ip hI (hw.mono fun _ h => Or.inl h) hK hS' hN1
  have hF : IFrame (L := L) Z.th s s' := IRel.iframe_of hI hw (fun b hb => tfoot_oobj hS (Or.inl hb))
  have hFS : FinStep (st := st) Z.T Z.N Z.C Z.c s σ s' σ1 := ⟨hw.mono fun b hb => Or.inl hb, SzKeepC.of hK.szKeep⟩
  have hw' : P1.WritesIn st s s' (CnW (st := st) Z.T Z.N Z.C Z.E Z.R Z.c s σ) := hFS.1.mono fun b h => Or.inl h
  -- the spec's frame
  have hnipc : ∀ x', σ.kheap t.bv = some (.tcb x') → Fl4Spec.ipcQueuedThreadState x'.tcbState = false :=
    fun x' hx' => by rw [hk] at hx'; cases hx'; rw [hxr]; rfl
  obtain ⟨Fd, had, -, -, Bd⟩ := donate_dfr (r := n.bv) J.inv hk hkn hnqT J.off J.bsa hnipc he
  obtain ⟨Id, -⟩ := Inv.donate J.inv hk hkn (by rw [hxr]; rfl) hnqT he
  have hAI : ActIdle σ1 := ⟨fun u hu => Fd.sched (J.act.1 u (by rw [← had]; exact hu)), Fd.idleOK J.act.2⟩
  have hcur1 : σ1.schedulerAction = .chooseNewThread ∨ CurInv σ1 := J.cur.imp (fun e => had.trans e) Fd.curInv
  have hrun1 : CurRunM σ1 := J.curRun.of_act Fd.curRunW fun e => by rw [had]; exact e
  have hRR : ∀ q ∈ Z.R, ∀ xr, σ.kheap q.bv = some (.reply xr) → xr.replyTcb = some t.bv →
      Detached Z.C Lst q ∧ L.mem s (rNextA q) = 0#u64 ∧ L.mem s (rPrevA q) = 0#u64 := by
    intro q _ xr hq hxt
    exfalso
    obtain ⟨x', hk', hs'⟩ := J.sv.replyTcb q.bv xr t.bv hq hxt
    rw [hk] at hk'; cases hk'
    rcases hs' with e | ⟨ep, dd, e⟩ <;> rw [hxr] at e <;> cases e
  have htD := J.not_dead_of_st ht hk (by rw [hxr]; simp [tsCode])
  exact ⟨rfl, σ1, he, Fd.sk.dt, hK0, WritesIn.tfoot_of_kfoot hw,
    J.wake_postD hIR hF hw' hblk (hfoot (J.donCore hn)) Fd Id Bd hAI hcur1 hrun1 hRR htD ⟨t, ht, rfl⟩⟩

variable {V X : Set U64}

set_option maxHeartbeats 4000000 in
/-- **The donation at `JAtZV3`** (module docstring; `JAtZB.donJ` lifted by `JAtZV3.ofTK`). -/
theorem JAtZV3.donJ3 (hAT : P0.ArchTotal arI)
    (hmb : ∀ a : A, sporadic.min_budget arI a ⦃ mb => mb.bv = Fl4Spec.MIN_BUDGET ⦄)
    (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) {t n : U64} (ht : t ∈ Z.T) (hn : n ∈ Z.N)
    {x : Fl4Spec.Tcb} (hk : σ.kheap t.bv = some (.tcb x)) (hxr : x.tcbState = .running)
    (hx0 : x.tcbSchedContext = none) :
    notification.maybe_donate_sched_context st arI s a t n ⦃ r => ∃ σ' : Fl4Spec.State Unit,
      Fl4Spec.maybeDonateSc (Z := Unit) t.bv n.bv σ = ({((), σ')}, False) ∧ σ'.domainTime = σ.domainTime ∧
      JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D r.1 r.2 σ' ⦄ := by
  refine WP.spec_mono (J.z2.zv.base.donJ hAT hmb ht hn hk hxr hx0) ?_
  rintro r ⟨ha, σ', he, hdt, hK, hW, B'⟩
  rw [ha]
  exact ⟨σ', he, hdt, J.ofTK B' hW hK⟩

end

end

/-! ## `SigVmDonJ3` discharged -/

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit} {V X : Set U64}

/-- **Gen 42a's [J] `SigVmDonJ3`, proved** (module docstring), from the platform's totality and `MIN_BUDGET`. -/
theorem sigVmDonJ3_of (hAT : P0.ArchTotal arI)
    (hmb : ∀ a : A, sporadic.min_budget arI a ⦃ mb => mb.bv = Fl4Spec.MIN_BUDGET ⦄) :
    SigVmDonJ3 st arI V X AR Z H Cs D := by
  intro Ac Lst s1 a σr t n J hth hn hrun _
  obtain ⟨x, hk, hxr, hx0⟩ := hrun
  refine WP.spec_mono (J.donJ3 hAT hmb (J.z2.zv.base.thT t hth) hn hk hxr hx0) ?_
  rintro r ⟨σ', he, hdt, J'⟩
  exact ⟨σ', Ac, Lst, he, hdt, J'⟩

set_option maxHeartbeats 4000000 in
/-- **`send_signal` to an idle notification bound to a `RunningVM` thread at `JAtZV3`, with no [J]**
(module docstring): gen 42a's `JAtZV3.signalVmJ2` with `sigVmDonJ3_of`. -/
theorem JAtZV3.signalVmJ3 (hAT : P0.ArchTotal arI) (hVA : ZvVirtAgree arI) (hK : ARKeep arI AR)
    (hmb : ∀ a : A, sporadic.min_budget arI a ⦃ mb => mb.bv = Fl4Spec.MIN_BUDGET ⦄)
    (J : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) {n : U64} (hn : n ∈ Z.N)
    {x : Fl4Spec.Notification} (hk : σ.kheap n.bv = some (.notification x)) (hidle : x.ntfnObj = .idleNtfn)
    {t : U64} (hb : x.ntfnBoundTcb = some t.bv) {y : Fl4Spec.Tcb} (hkt : σ.kheap t.bv = some (.tcb y))
    (hrs : y.tcbState = .runningVM) (badge : U64) :
    notification.send_signal st arI s a n badge ⦃ r =>
      ∃ (σ' : Fl4Spec.State Unit) (Ac' : Set U64) (Lst' : U64 → List U64),
        Fl4Spec.sendSignalVF (Z := Unit) (v3OnCore st s) (v3RemCur st s) n.bv badge.bv σ = ({((), σ')}, False) ∧
        σ'.domainTime = σ.domainTime ∧ JAtZV3 (L := L) arI V X AR Z H Cs Ac' Lst' D r.1 r.2 σ' ⦄ :=
  J.signalVmJ2 hAT hVA hK (sigVmDonJ3_of hAT hmb) hn hk hidle hb hkt hrs badge

end

end

