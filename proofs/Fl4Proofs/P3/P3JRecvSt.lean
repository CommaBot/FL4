/-
P3 (p3J gen 31): **the endpoint receive at a dispatch state, stable ghosts; `RecvIpcStFt` reduced to its
footprint**.

* **`jRecvIpcU_ofSt`**, **`jRecvIpcLink_ofSt`** (generated by `scratch/p3J/gen_recvst2.py`):
  XTopJointRecvIpcLink's `jRecvIpcU_of` / `jRecvIpcLink_of` verbatim over P3JRecvStA–D's stable sub-leaves, post
  `RelTopM ∧ JStab Z H Cs` (the linked case cancels first, `JAtZ.cancelLinkJ` already lands at `Z.mv Z.G V` with the
  entry's `H`, `Cs`; the receive after is `jRecvIpcU_ofSt` there).
* **`RecvIpcLeafSt`**, **`jRecvIpcHypL_ofSt`**: XTopJointDispatch's `JRecvIpcHyp` shape at `RelTopM ∧ JStab Z H Cs`
  and its proof (`jRecvIpcHypL_of` stable). No premise.
* **`RecvIpcFt` [J]**: the footprint half of P3JRecvCls's `RecvIpcStFt` alone — at a dispatch state
  (`JAtZ (Z.mv Z.G V) H Cs`, `Entered`, the current thread in no ready queue, `CKI`, `RR`), FL4's `receive_ipc` on
  an endpoint cap with the receive right held in a slot, with a null or a held reply cap, writes only `ProjW H Cs s`.
  Justification (not refuted): every write of `receive_ipc` is a word of an `H` TCB (registers, state, queue links,
  SC / reply / fault words), an `H` endpoint / reply / SC / notification, a word of the kernel-state block or the
  current node's scheduler words; on `CKI` the transfer writes registers only (no buffer frame cap: P3JMcFootC's
  `bufOK_empty_cki`, gen 27's `xferOKRS_nb` at `U = ∅`); P1 EntryXG's `receive_ipc.xg` already bounds it inside
  `Cur0W` (`KW`, `DbgW`, `CapW`, and user words only through the transfer), and `ProjW` differs from that only in
  the other cores' `IDLE_THREAD` / `IDLE_SC` node words, which no receive step writes (the KWN walk of P2 `FootN*`
  covers each sub-operation but `take_reply` / `complete_signal` / `receive_from_sender`).
* **`recvIpcStFt_of`**: `VxE Z → RecvIpcFt → RecvIpcStFt` (given JEntryGlob's `maxTU` / `tu`): the stable post by
  `jRecvIpcHypL_ofSt`, the footprint by `RecvIpcFt`, `JStab` to `JStabR` by P3JRecvCls's `jStab_toR`.

Named premise: `RecvIpcFt` [J] (above). No sorry. New module; no existing statement changed.
-/
import Fl4Proofs.P3.P3JRecvStA
import Fl4Proofs.P3.P3JRecvStC
import Fl4Proofs.P3.P3JRecvStD
import Fl4Proofs.P3.XTopJointRecvIpcLink
import Fl4Proofs.P3.P3JRecvCls
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched

noncomputable section

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64}

set_option maxHeartbeats 4000000 in
/-- (p3J gen 31; stable ghosts, `JStab`) **`receive_ipc` at `J` with a null or free reply** (the former `jRecvIpcHyp_of`'s
case split, every waiting-sender case proved). -/
theorem jRecvIpcU_ofSt (hAT : P0.ArchTotal arI) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv) {s : S} {a : A}
    {σ : Fl4Spec.State Unit} (htu : ∀ v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (ht : ct ∈ Z.T)
    (hcur : σ.curThread = ct.bv) (hni : Entered σ) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    (blocking : Bool) (p b : U64) (sd g gr : Bool) (rc : capability.Cap) (rc' : Fl4Spec.Cap)
    (hpE : ∃ x, σ.kheap p.bv = some (.endpoint x))
    (hrc : (rc = .Null ∧ rc' = .nullCap) ∨
      (CapRel rc rc' ∧ ∃ q g', rc = .Reply q g' ∧ ∃ x, σ.kheap q.bv = some (.reply x)))
    (hHd : JHeld (L := L) Z.th s (.Endpoint p b sd true g gr))
    (hHr : ∀ q g', rc = .Reply q g' → JHeld (L := L) Z.th s rc)
    (hun : rc = .Null ∨ ∃ q g', rc = .Reply q g' ∧ L.mem s (rTcbA q) = 0#u64) :
    endpoint.receive_ipc st arI s a ct (.Endpoint p b sd true g gr) blocking rc ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveIpc (Z := Unit) ct.bv (absCap (.Endpoint p b sd true g gr)) blocking rc' σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  obtain ⟨xe, hke⟩ := hpE
  obtain ⟨e, he, h⟩ := J.obj.ep _ xe hke
  rw [Sched.bv_inj h] at he
  by_cases hca : RecvIpcActCase (L := L) ct s σ rc
  · obtain ⟨⟨xt, n0, x, b0, hkt, hbn, hkn, hact⟩, hrr⟩ := hca
    obtain ⟨n, hn, rfl⟩ := J.obj.ntfn _ x hkn
    obtain ⟨rv, hra⟩ := J.replyArg_of hrc hrr
    exact J.recvIpcActJSt hAT ht hcur hni hnq hkt hn hkn hbn hact blocking hke b sd true g gr hra b.bv
      (rightsOf sd true g gr)
  by_cases hcb : RecvIpcBlockCase (L := L) ct blocking s σ p rc
  · obtain ⟨rfl, hbn, hns, hrr⟩ := hcb
    obtain ⟨rv, hra⟩ := J.replyArg_of hrc hrr
    have hI := J.xtop.irelK J.ks J.buf
    obtain ⟨xt, hkt, -⟩ := hI.1.tcb ct ht
    obtain ⟨hcov, hcovR⟩ := J.recvCov_of he hHd hHr hra
    have hcB : Endp.CanBlock true xe := by
      cases xe with
      | idleEP => trivial
      | recvEP q => rfl
      | sendEP q => exact absurd rfl (hns _ hke q)
    have hx := hI.1.toE.at_ep he hke
    have hst2 : stOf (L.mem s) p = 0#u64 ∨ stOf (L.mem s) p = 2#u64 := by
      cases xe with
      | idleEP => exact Or.inl hx.1
      | recvEP q => exact Or.inr hx.1
      | sendEP q => exact absurd rfl (hns _ hke q)
    have hbound : L.mem s (tBoundA ct) = 0#u64 :=
      optRef_none ((hI.1.toE.at_tcb ht hkt).bound.symm.trans (hbn xt hkt))
    exact J.recvIpcBlockJSt ht hcur hni hnq hkt he hke hcB hcov hra hcovR b sd true g gr b.bv
      (rightsOf sd true g gr) (fun h => receive_ipc_block_red hra hbound hst2 h)
      (receiveIpc_noSend b.bv (rightsOf sd true g gr) true (replyArg_spec J.ip.e hI.1.toE hra) hkt (hbn xt hkt) hke
        (hns xe hke))
  by_cases hcn : RecvIpcBoundCase (L := L) ct blocking s σ p rc
  · obtain ⟨rfl, ⟨xt, n0, xn, hkt, hbn, hkn, hna⟩, hns, hrr⟩ := hcn
    obtain ⟨n, hn, rfl⟩ := J.obj.ntfn _ xn hkn
    obtain ⟨rv, hra⟩ := J.replyArg_of hrc hrr
    have hcB : Endp.CanBlock true xe := by
      cases xe with
      | idleEP => trivial
      | recvEP q => rfl
      | sendEP q => exact absurd rfl (hns _ hke q)
    by_cases hnr : xn.ntfnSc = xt.tcbSchedContext ∧ xn.ntfnSc ≠ none
    · exact J.recvIpcRetJSt ht hcur hni hnq hkt hn hbn hkn hna hnr he hke hcB hHd hHr hra b.bv (rightsOf sd true g gr)
    obtain ⟨hcov, hcovR⟩ := J.recvCov_of he hHd hHr hra
    exact J.recvIpcBlockNJSt ht hcur hni hnq hkt hn hbn hkn hna hnr he hke hcB hcov hra hcovR b sd true g gr b.bv
      (rightsOf sd true g gr)
  by_cases hcs : RecvSendBasicCase ct blocking σ p rc
  · obtain ⟨hbn, sd0, q, xs, hke', hks, hok⟩ := hcs
    obtain ⟨sdU, -, hsde⟩ := J.obj.tcb _ xs hks
    subst hsde
    have hI := J.xtop.irelK J.ks J.buf
    obtain ⟨xt, hkt, -⟩ := hI.1.tcb ct ht
    obtain ⟨rv, hra⟩ := J.replyArg_of hrc hun
    have hrun := (J.curRun.run hni) xt (by rw [hcur]; exact hkt)
    rcases hbn xt hkt with hb0 | ⟨n0, xn, hbn0, hkn, hna⟩
    · exact J.recvSendJ0XSt ht hkt hrun (Or.inl hb0) hcur he hke' hks
        b sd true g gr hra hok b.bv (rightsOf sd true g gr)
    by_cases hl : blocking = true ∧ (xn.ntfnSc = xt.tcbSchedContext ∧ xn.ntfnSc ≠ none)
    · obtain ⟨rfl, hl⟩ := hl
      obtain ⟨n, hn, rfl⟩ := J.obj.ntfn _ xn hkn
      exact J.recvSendRetJSt ht hcur hni hnq hkt hn hbn0 hkn hna hl he hke' hks b sd true g gr hra hok b.bv
        (rightsOf sd true g gr)
    · exact J.recvSendJ0XSt ht hkt hrun (Or.inr ⟨n0, xn, hbn0, hkn, hna, fun hb h => hl ⟨hb, h⟩⟩) hcur he hke' hks
        b sd true g gr hra hok b.bv (rightsOf sd true g gr)
  by_cases hcp : RecvSendPushCase ct blocking σ p rc
  · obtain ⟨hbn, sd0, q, xs, hke', hks, hok⟩ := hcp
    obtain ⟨sdU, -, hsde⟩ := J.obj.tcb _ xs hks
    subst hsde
    have hI := J.xtop.irelK J.ks J.buf
    obtain ⟨xt, hkt, -⟩ := hI.1.tcb ct ht
    obtain ⟨rv, hra⟩ := J.replyArg_of hrc hun
    have hrun := (J.curRun.run hni) xt (by rw [hcur]; exact hkt)
    have hrv0 : rv ≠ 0#u64 := by
      rcases hra with ⟨h1, -, -⟩ | ⟨_, _, _, _, hr, -⟩
      · exact absurd h1 hok.1
      · exact (J.rp.align rv hr).2.1
    obtain ⟨-, hcovR⟩ := J.recvCov_of he hHd hHr hra
    exact J.recvSendP0XSt hAT ht hkt hrun (hbn xt hkt) hcur hni hnq he hke' hks b sd true g gr hra (hcovR hrv0) hok
      b.bv (rightsOf sd true g gr)
  by_cases hcr : RecvSendRetPushCase ct blocking σ p rc
  · obtain ⟨rfl, hbn, sd0, q, xs, hke', hks, hok⟩ := hcr
    obtain ⟨sdU, -, hsde⟩ := J.obj.tcb _ xs hks
    subst hsde
    have hI := J.xtop.irelK J.ks J.buf
    obtain ⟨xt, hkt, -⟩ := hI.1.tcb ct ht
    obtain ⟨rv, hra⟩ := J.replyArg_of hrc hun
    obtain ⟨n0, xn, hbn0, hkn, hna, hl1, hl2⟩ := hbn xt hkt
    obtain ⟨n, hn, rfl⟩ := J.obj.ntfn _ xn hkn
    by_cases hsn : xs.tcbSchedContext = none
    · exact J.recvSendRetPJSt hAT ht hcur hni hnq hkt hn hbn0 hkn hna ⟨hl1, hl2⟩ he hke' hks b sd hra hok hsn
        hHd hHr b.bv (rightsOf sd true g gr)
    · exact J.recvSendRetPDJSt hAT ht hcur hni hnq hkt hn hbn0 hkn hna ⟨hl1, hl2⟩ he hke' hks b sd hra hok hsn
        hHd hHr b.bv (rightsOf sd true g gr)
  by_cases hc : RecvIpcPollCase (L := L) ct blocking s σ p rc
  swap
  · -- the case left: a head sender with a timeout fault and an SC
    obtain ⟨xt, hkt, -⟩ := (J.xtop.irelK J.ks J.buf).1.tcb ct ht
    have hbn0 : xt.tcbBoundNotification = none ∨ ∃ n xn, xt.tcbBoundNotification = some n ∧
        σ.kheap n = some (.notification xn) ∧ Fl4Spec.isActive xn = false := by
      rcases hb : xt.tcbBoundNotification with _ | n
      · exact Or.inl rfl
      · obtain ⟨xn, hkn⟩ := J.sv.tcbNtfn ct.bv xt n hkt hb
        refine Or.inr ⟨n, xn, rfl, hkn, ?_⟩
        cases hxo : xn.ntfnObj with
        | activeNtfn b0 => exact absurd ⟨⟨xt, n, xn, b0, hkt, hb, hkn, hxo⟩, hun⟩ hca
        | idleNtfn => simp [Fl4Spec.isActive, hxo]
        | waitingNtfn q => simp [Fl4Spec.isActive, hxo]
    have hbnA : ∀ xt', σ.kheap ct.bv = some (.tcb xt') → xt'.tcbBoundNotification = none ∨
        ∃ n xn, xt'.tcbBoundNotification = some n ∧ σ.kheap n = some (.notification xn) ∧
          Fl4Spec.isActive xn = false := fun x' hx' => by rw [hkt] at hx'; cases hx'; exact hbn0
    have hsend : ∃ l, xe = .sendEP l := by
      by_contra hns
      push_neg at hns
      have hns' : ∀ x, σ.kheap p.bv = some (.endpoint x) → ∀ q, x ≠ .sendEP q := fun x hx q => by
        rw [hke] at hx; cases hx; exact hns q
      rcases Bool.eq_false_or_eq_true blocking with hbl | hbl
      · rcases hbn0 with hb0 | ⟨n, xn, hb0, hkn, hna⟩
        · exact hcb ⟨hbl, fun x' hx' => by rw [hkt] at hx'; cases hx'; exact hb0, hns', hun⟩
        · exact hcn ⟨hbl, ⟨xt, n, xn, hkt, hb0, hkn, hna⟩, hns', hun⟩
      · exact hc ⟨hbl, hbnA, hns', hun⟩
    obtain ⟨l, rfl⟩ := hsend
    obtain ⟨sd0, q, xs, e', dd, rfl, hks, hstd⟩ := J.head_sendT he hke
    obtain ⟨sdU, -, hsde⟩ := J.obj.tcb _ xs hks
    subst hsde
    have hnl : ¬ (blocking = true ∧ ∃ n xn, xt.tcbBoundNotification = some n ∧
        σ.kheap n = some (.notification xn) ∧ xn.ntfnSc = xt.tcbSchedContext ∧ xn.ntfnSc ≠ none) →
        ∀ xt', σ.kheap ct.bv = some (.tcb xt') → xt'.tcbBoundNotification = none ∨
          ∃ n xn, xt'.tcbBoundNotification = some n ∧ σ.kheap n = some (.notification xn) ∧
            Fl4Spec.isActive xn = false ∧ (blocking = true → ¬ (xn.ntfnSc = xt'.tcbSchedContext ∧ xn.ntfnSc ≠ none)) := by
      intro hl x' hx'
      rw [hkt] at hx'; cases hx'
      rcases hbn0 with h | ⟨n, xn, hb0, hkn, hna⟩
      · exact Or.inl h
      · exact Or.inr ⟨n, xn, hb0, hkn, hna, fun hbl hl' => hl ⟨hbl, n, xn, hb0, hkn, hl'⟩⟩
    have hnaL : ∀ n xn, xt.tcbBoundNotification = some n → σ.kheap n = some (.notification xn) →
        Fl4Spec.isActive xn = false := by
      intro n xn hb0 hkn
      rcases hbn0 with h | ⟨n', xn', h', hkn', hna'⟩
      · rw [hb0] at h; cases h
      · rw [hb0] at h'; cases h'; rw [hkn] at hkn'; cases hkn'; exact hna'
    rcases sendOK_split rc hstd with hok | hok | hok
    · exact absurd ⟨hbnA, _, q, xs, hke, hks, hok⟩ hcs
    · by_cases hl : blocking = true ∧ ∃ n xn, xt.tcbBoundNotification = some n ∧
          σ.kheap n = some (.notification xn) ∧ xn.ntfnSc = xt.tcbSchedContext ∧ xn.ntfnSc ≠ none
      · obtain ⟨hbl, n, xn, hb0, hkn, hl1, hl2⟩ := hl
        exact absurd ⟨hbl, fun x' hx' => by
          rw [hkt] at hx'; cases hx'; exact ⟨n, xn, hb0, hkn, hnaL n xn hb0 hkn, hl1, hl2⟩,
          _, q, xs, hke, hks, hok⟩ hcr
      · exact absurd ⟨hnl hl, _, q, xs, hke, hks, hok⟩ hcp
    · obtain ⟨rv, hra⟩ := J.replyArg_of hrc hun
      have hrun := (J.curRun.run hni) xt (by rw [hcur]; exact hkt)
      by_cases hl : blocking = true ∧ ∃ n xn, xt.tcbBoundNotification = some n ∧
          σ.kheap n = some (.notification xn) ∧ xn.ntfnSc = xt.tcbSchedContext ∧ xn.ntfnSc ≠ none
      · obtain ⟨rfl, n0, xn, hb0, hkn, hl1, hl2⟩ := hl
        obtain ⟨n, hn, rfl⟩ := J.obj.ntfn _ xn hkn
        exact J.recvSendRetTJSt hAT hmax htu ht hcur hni hnq hkt hn hb0 hkn (hnaL _ xn hb0 hkn) ⟨hl1, hl2⟩ he hke hks
          b sd hra hok hHd hHr b.bv (rightsOf sd true g gr)
      · exact J.recvSendT0XSt hAT hmax htu ht hkt hrun (hnl hl xt hkt) hcur hni hnq he hke hks b sd true g gr hra
          (J.recvCov_of he hHd hHr hra).2 hok b.bv (rightsOf sd true g gr)
  obtain ⟨rfl, hbn, hns, hrr⟩ := hc
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨xt, hkt, -⟩ := hI.1.tcb ct ht
  obtain ⟨rv, hra⟩ := J.replyArg_of hrc hrr
  rcases hbn xt hkt with hbn | ⟨n0, xn, hbn, hkn, hna⟩
  · exact J.recvIpcPollJSt ht hkt hbn he hke (hns xe hke) b sd true g gr hra b.bv (rightsOf sd true g gr)
  · obtain ⟨n, hn, rfl⟩ := J.obj.ntfn _ xn hkn
    exact J.recvIpcPollNJSt ht hkt hn hbn hkn hna he hke (hns xe hke) b sd true g gr hra b.bv
      (rightsOf sd true g gr)

set_option maxHeartbeats 4000000 in
/-- (p3J gen 31; stable ghosts, `JStab`) **`receive_ipc` at `J` with a reply linked to another thread**
(module docstring): FL4's and the spec's `cancel_ipc` of that thread
(`JAtZ.cancelLinkJ`), then `jRecvIpcU_of` at the state after. -/
theorem jRecvIpcLink_ofSt (hAT : P0.ArchTotal arI) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv) {s : S} {a : A}
    {σ : Fl4Spec.State Unit} (htu : ∀ v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (ht : ct ∈ Z.T)
    (hcur : σ.curThread = ct.bv) (hni : Entered σ) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    (blocking : Bool) (p b : U64) (sd g gr : Bool) (q : U64) (g' : Bool) (rc' : Fl4Spec.Cap)
    (hpE : ∃ x, σ.kheap p.bv = some (.endpoint x)) (hcr : CapRel (.Reply q g') rc')
    {xr : Fl4Spec.Reply} (hkr : σ.kheap q.bv = some (.reply xr))
    (hHd : JHeld (L := L) Z.th s (.Endpoint p b sd true g gr))
    (hHr : JHeld (L := L) Z.th s (.Reply q g')) (hi0 : L.mem s (rTcbA q) ≠ 0#u64) :
    endpoint.receive_ipc st arI s a ct (.Endpoint p b sd true g gr) blocking (.Reply q g') ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveIpc (Z := Unit) ct.bv (absCap (.Endpoint p b sd true g gr)) blocking rc' σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  have hR := (J.xtop.irelK J.ks J.buf).1.toE
  obtain ⟨q0, hq, hqe⟩ := J.obj.reply _ xr hkr
  rw [Sched.bv_inj hqe] at hq
  have hrt : xr.replyTcb = some (L.mem s (rTcbA q)).bv := (hR.at_reply hq hkr).trans (Notif.optRef_ne hi0)
  obtain ⟨xi, hki, hsti⟩ := J.sv.replyTcb q.bv xr _ hkr hrt
  obtain ⟨i, hiT, hie⟩ := J.obj.tcb _ xi hki
  have hiq : L.mem s (rTcbA q) = i := (P1.eq_of_bv hie).symm
  rw [hiq] at hrt hki hi0
  have hict : i ≠ ct := by
    intro e
    subst e
    have hr := (J.curRun.run hni) xi (by rw [hcur]; exact hki)
    rcases hsti with h | ⟨_, _, h⟩ <;> rw [h] at hr <;> simp [Fl4Spec.runnable] at hr
  have hne : σ.curThread ≠ i.bv := fun e => hict (P1.eq_of_bv (e.symm.trans hcur))
  refine receive_ipc_linked hiq hi0 hict ?_
  refine WP.spec_mono (J.cancelLinkJ hiT hki hsti) ?_
  rintro ⟨s1, a1⟩ ⟨hSS, h1, σ', he, hin, V, Ac', Lst', J'⟩
  dsimp only at h1 hSS J' ⊢
  subst h1
  have hm : ((), σ') ∈ (Fl4Spec.cancelIpc (Z := Unit) i.bv σ).1 := by rw [he]; exact Set.mem_singleton _
  obtain ⟨hct', hid', hact', hrq', -⟩ := cancelOther_keep hm hne
  have hR' := (J'.xtop.irelK J'.ks J'.buf).1.toE
  obtain ⟨xr', hkr', hrl⟩ := hR'.reply q hq
  have hnone : xr'.replyTcb = none := cancelOther_reply J.sv J'.sv hm hkr hrt hin hkr'
  have h0' : L.mem s1 (rTcbA q) = 0#u64 := optRef_none (hrl.symm.trans hnone)
  refine ⟨h0', ?_⟩
  have hcr' : rc' = absCap (.Reply q g') := hcr.abs
  subst hcr'
  have hsp : Fl4Spec.receiveIpc (Z := Unit) ct.bv (absCap (.Endpoint p b sd true g gr)) blocking
      (absCap (.Reply q g')) σ =
      Fl4Spec.receiveIpc (Z := Unit) ct.bv (absCap (.Endpoint p b sd true g gr)) blocking
      (absCap (.Reply q g')) σ' :=
    receiveIpc_linked _ _ _ _ hkr hrt (fun e => hne (hcur.trans e.symm)) he hkr' hnone
  rw [hsp]
  obtain ⟨xe, hke⟩ := hpE
  obtain ⟨e, he', h⟩ := J.obj.ep _ xe hke
  rw [Sched.bv_inj h] at he'
  obtain ⟨xe', hke', -⟩ := hR'.ep p he'
  refine WP.spec_mono (jRecvIpcU_ofSt (Z := Z.mv Z.G V) hAT hmax htu J' ht (hct'.trans hcur) ⟨by rw [hct', hid']; exact hni.1, by rw [hact']; exact hni.2⟩
    (by rw [hct', hrq']; exact hnq) blocking p b sd g gr (.Reply q g') _ ⟨xe', hke'⟩
    (Or.inr ⟨hcr, q, g', rfl, xr', hkr'⟩) (jHeld_of_same hSS hHd) (fun _ _ _ => jHeld_of_same hSS hHr)
    (Or.inr ⟨q, g', rfl, h0'⟩)) fun r ⟨z, hz, h1, h2⟩ => ⟨z, hz, h1, JStab.mv h2⟩

end

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)
variable (AR : A → Fl4Spec.Cr3 → Prop)

/-- (p3J gen 31) **The endpoint leaf of `handle_recv` at stable ghosts** (`JRecvIpcHyp` at
`RelTopM ∧ JStab Z H Cs`). -/
def RecvIpcLeafSt (Z : XSets) (H : P1.Heap) (Cs : Set U64) (ct : U64) (blocking : Bool) (s : S) (a : A)
    (σ : Fl4Spec.State Unit) : Prop :=
  ∀ p b sd g gr rc rc', (∃ x, σ.kheap p.bv = some (.endpoint x)) →
    ((rc = .Null ∧ rc' = .nullCap) ∨
      (CapRel rc rc' ∧ ∃ q g', rc = .Reply q g' ∧ ∃ x, σ.kheap q.bv = some (.reply x))) →
    JHeld (L := L) Z.th s (.Endpoint p b sd true g gr) → (∀ q g', rc = .Reply q g' → JHeld (L := L) Z.th s rc) →
    endpoint.receive_ipc st arI s a ct (.Endpoint p b sd true g gr) blocking rc ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveIpc (Z := Unit) ct.bv (absCap (.Endpoint p b sd true g gr)) blocking rc' σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄

/-- (p3J gen 31) **`RecvIpcFt` [J]**: the footprint of the endpoint receive at a dispatch state (module
docstring). -/
def RecvIpcFt (Z : XSets) (H : P1.Heap) (Cs : Set U64) (s : S) (a : A) (σ : Fl4Spec.State Unit) : Prop :=
  ∀ (V : XVs) (Ac : Set U64) (Lst : U64 → List U64) (D : Set U64),
    JAtZ (L := L) arI AR (Z.mv Z.G V) H Cs Ac Lst D s a σ → Entered σ →
    (∀ d p, σ.curThread ∉ σ.readyQueues d p) → SInvCk.CKI σ → SInvRr.RR σ →
    ∀ ct, sched.cur_thread st s = ok ct → ∀ (blocking : Bool) p b sd g gr rc (rc' : Fl4Spec.Cap),
      (∃ x, σ.kheap p.bv = some (.endpoint x)) →
      ((rc = .Null ∧ rc' = .nullCap) ∨
        (CapRel rc rc' ∧ ∃ q g', rc = .Reply q g' ∧ ∃ x, σ.kheap q.bv = some (.reply x))) →
      JHeld (L := L) Z.th s (.Endpoint p b sd true g gr) → (∀ q g', rc = .Reply q g' → JHeld (L := L) Z.th s rc) →
      endpoint.receive_ipc st arI s a ct (.Endpoint p b sd true g gr) blocking rc ⦃ r =>
        P1.WritesIn st s r.1 (Mc.ProjW (L := L) H Cs s) ⦄

end

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64}

/-- (p3J gen 31) **`jRecvIpcHypL_of` at stable ghosts** (`jRecvIpcU_ofSt` for a null or free reply,
`jRecvIpcLink_ofSt` for a linked one). -/
theorem jRecvIpcHypL_ofSt (hAT : P0.ArchTotal arI) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv) {s : S}
    {a : A} {σ : Fl4Spec.State Unit} (htu : ∀ v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄)
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (ht : ct ∈ Z.T)
    (hcur : σ.curThread = ct.bv) (hni : Entered σ) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    (blocking : Bool) : RecvIpcLeafSt (L := L) arI AR Z H Cs ct blocking s a σ := by
  intro p b sd g gr rc rc' hpE hrc hHd hHr
  by_cases hun : rc = .Null ∨ ∃ q g', rc = .Reply q g' ∧ L.mem s (rTcbA q) = 0#u64
  · exact jRecvIpcU_ofSt hAT hmax htu J ht hcur hni hnq blocking p b sd g gr rc rc' hpE hrc hHd hHr hun
  · rcases hrc with ⟨rfl, -⟩ | ⟨hcr, q, g', rfl, xr, hkr⟩
    · exact absurd (Or.inl rfl) hun
    · exact jRecvIpcLink_ofSt hAT hmax htu J ht hcur hni hnq blocking p b sd g gr q g' rc' hpE hcr hkr hHd
        (hHr q g' rfl) (fun h => hun (Or.inr ⟨q, g', rfl, h⟩))

/-- (p3J gen 31) **`RecvIpcStFt` from its footprint** (module docstring). -/
theorem recvIpcStFt_of (hAT : P0.ArchTotal arI) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv)
    (htu : ∀ a v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄) [VxE Z] {s : S} {a : A}
    {σ : Fl4Spec.State Unit} (hF : RecvIpcFt (L := L) arI AR Z H Cs s a σ) :
    RecvIpcStFt (L := L) arI AR Z H Cs s a σ := by
  intro V Ac Lst D J hni hnq hC hRR ct hct blocking p b sd g gr rc rc' hpE hrc hHd hHr
  obtain ⟨hcur, -⟩ := J.curEq hct
  have hctT : ct ∈ (Z.mv Z.G V).T := TopSR.cur_mem J.xtop.fin.1 hcur.symm
  have h1 := jRecvIpcHypL_ofSt hAT hmax (htu a) J hctT hcur hni hnq blocking p b sd g gr rc rc' hpE hrc hHd hHr
  have h2 := hF V Ac Lst D J hni hnq hC hRR ct hct blocking p b sd g gr rc rc' hpE hrc hHd hHr
  refine WP.spec_mono (WP.spec_and h1 h2) ?_
  rintro r ⟨⟨z, hz, hr1, hr2⟩, hW⟩
  exact ⟨z, hz, hr1, jStab_toR (JStab.mv hr2), hW⟩

end

end

