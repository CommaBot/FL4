/-
P3 (line stpost, generation 5): **the IO port cap's leaves and the reply tails with the stable-ghost
post** (generated by `scratch/stpost/gen_io.py`).

XTopJointData's `JAtZ.replyTailJ`, XTopJointReplyTail's `JAtZ.flTailJ` / `replyErrJ` / `replyFailJ`,
XTopJointReply's `JAtZ.reply1J` and XTopJointPortIn's `portInTail_jat` /
`decode_invocation_ioport_inJ` / `decode_invocation_ioportJ_steps` end in `JAt` (existential ghosts),
but every step inside keeps the entry's `H` and `Cs` and moves only the MDB ghost / VSpace sets
(`regWrJ`, `runJ`, `userWrJ`, `setmrJ`: `Z.mv Z.G V`; the primitive steps `Steps.jatZ`: `Z.mv G' V'`).
This file is those proofs verbatim, named `…St`, with the post `JStab Z H Cs` (StPostFault) and the
final packings adjusted (`J.stab` / `JStab.mv`). The IO port chain no longer takes the reply step
`JReplyHyp` as a premise: `portInTail_jatSt` closes it by `JAtZ.reply1JSt`. No premise added.
-/
import Fl4Proofs.P3.StPostInv
import Fl4Proofs.P3.XTopJointReplyTail
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3

noncomputable section

section StIoA
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P1 Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

set_option maxHeartbeats 16000000 in
/-- (stable ghosts, `JStab`) **`reply1` at `J`** (module docstring): every outcome of the spec's
success tail has `JAt`. -/
theorem JAtZ.reply1JSt (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (hct : ct ∈ Z.T)
    {x : Fl4Spec.Tcb} (hk : σ.kheap ct.bv = some (.tcb x)) (hrs : x.tcbState = .restart) (call : Bool) (v : U64) :
    vspace.reply1 st s ct call v ⦃ s2 => ∀ z ∈ (specTail call ct.bv [v.bv] σ).1, JStab (L := L) arI AR Z H Cs s2 a z.2 ⦄ := by
  unfold vspace.reply1
  cases call
  · simp only [Bool.false_eq_true, ↓reduceIte, bind_ok]
    refine WP.spec_mono (J.runJ hct hk hrs) ?_
    rintro s2 ⟨Lst', D', J2⟩ z hz
    rw [specTail_restart hk hrs false v.bv] at hz
    simp only [Bool.false_eq_true, ↓reduceIte] at hz
    rw [Notif.setThreadState_eq .running hk] at hz
    rw [Set.mem_singleton_iff.1 hz]
    exact (by first | exact J2.stab | exact J2.stab.mv | exact J2.stab.mv.mv | exact J2.stab.mv.mv.mv)
  · simp only [↓reduceIte]
    have hin : (do
        let buf ← msg.lookup_ipc_buffer st s true ct
        let s2 ← obj.Tcb.set_reg st ct s layout.reg.BADGE 0#u64
        let (n, s3) ← msg.set_mr st s2 ct buf 0#u64 v
        let mi ← msginfo.MessageInfo.new 0#u64 0#u64 0#u64 n
        msg.set_msg_info st s3 ct mi) ⦃ s3 => ∃ w : U64,
          s3 = L.wr (L.wr (L.wr s (Endp.regA ct (Endp.regIdx Fl4Spec.badge_register)) 0#u64)
            (Endp.regA ct (Endp.regIdx (Endp.mrIdx 0))) v) (Endp.regA ct (Endp.regIdx Fl4Spec.msg_info_register)) w ∧
          w.bv = Fl4Spec.messageInfoToData ⟨Fl4Spec.natToLen 1, 0, 0, 0⟩ ⦄ := by
      refine WP.spec_bind (Fl4Proofs.P0.msg.lookup_ipc_buffer.p0 st s true ct L.total) ?_
      rintro buf -
      refine WP.spec_bind (Endp.obj.Tcb.set_reg.spec s ct layout.reg.BADGE 0#u64) ?_
      rintro s1 rfl
      have hset : ∀ s1 : S, msg.set_mr st s1 ct buf 0#u64 v ⦃ r =>
          r = (1#u64, L.wr s1 (Endp.regA ct (Endp.regIdx (Endp.mrIdx 0))) v) ⦄ := by
        intro s1
        unfold msg.set_mr
        have h4 : (0#u64 : U64) < msg.N_MSG_REGISTERS := by unfold msg.N_MSG_REGISTERS; decide
        simp only [h4, ↓reduceIte]
        refine WP.spec_bind (Endp.msg_register_spec 0#u64 (by decide)) ?_
        rintro r0 rfl
        refine WP.spec_bind (Endp.obj.Tcb.set_reg.spec _ ct _ v) ?_
        rintro s2 rfl
        simp only [lift, bind_ok, WP.spec_ok]
        rfl
      refine WP.spec_bind (hset _) ?_
      rintro r rfl
      unfold msginfo.MessageInfo.new
      simp only [bind_ok]
      refine WP.spec_mono (Endp.set_msg_info_spec _ ct 0#u64 1#u64 (by decide)) ?_
      rintro s3 ⟨w, rfl, hw⟩
      refine ⟨w, ?_, by rw [hw]; exact msg_info_one_bv⟩
      rw [Endp.regIdx_badge, Endp.regIdx_msgInfo]
    refine WP.spec_bind hin ?_
    rintro s3 ⟨w, rfl, hw⟩
    -- the badge register
    have hXb := badge_wr_irel J.ip (J.xtop.irelK J.ks J.buf) hct hk 0#u64
    rw [badgeRegA_eq_regA] at hXb
    obtain ⟨V1, J1⟩ := J.regWrJ hct hk Fl4Spec.badge_register 0#u64 hXb
    set x1 := setReg x Fl4Spec.badge_register (0#u64 : U64).bv with hx1
    have hk1 : (updK σ ct.bv (.tcb x1)).kheap ct.bv = some (.tcb x1) := by simp [updK]
    -- the message register
    have hX2 := reg_wr_irel J1.ip (J1.xtop.irelK J1.ks J1.buf) hct hk1 (Endp.mrIdx 0) (by decide) v
    obtain ⟨V2, J2⟩ := J1.regWrJ hct hk1 (Endp.mrIdx 0) v hX2
    set x2 := setReg x1 (Endp.mrIdx 0) v.bv with hx2
    have hk2 : (updK (updK σ ct.bv (.tcb x1)) ct.bv (.tcb x2)).kheap ct.bv = some (.tcb x2) := by simp [updK]
    -- the message info
    have hX3 := reg_wr_irel J2.ip (J2.xtop.irelK J2.ks J2.buf) hct hk2 Fl4Spec.msg_info_register (by decide) w
    obtain ⟨V3, J3⟩ := J2.regWrJ hct hk2 Fl4Spec.msg_info_register w hX3
    have hxC : setReg x2 Fl4Spec.msg_info_register w.bv = Endp.replyTcb x v.bv := by
      rw [hw]; rfl
    rw [updK_updK, updK_updK, hxC] at J3
    have hkC : (updK σ ct.bv (.tcb (Endp.replyTcb x v.bv))).kheap ct.bv = some (.tcb (Endp.replyTcb x v.bv)) := by
      simp [updK]
    -- `Running`
    refine WP.spec_mono (J3.runJ hct hkC hrs) ?_
    rintro s4 ⟨Lst', D', J4⟩ z hz
    rw [specTail_restart hk hrs true v.bv] at hz
    simp only [↓reduceIte] at hz
    rw [Notif.setThreadState_eq .running hkC] at hz
    rw [Set.mem_singleton_iff.1 hz]
    exact (by first | exact J4.stab | exact J4.stab.mv | exact J4.stab.mv.mv | exact J4.stab.mv.mv.mv)

end StIoA

section StIoB
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

set_option maxHeartbeats 16000000 in
/-- (stable ghosts, `JStab`) **The reply tail at `J`** (`reply_words` then `Running`, as XTopReply's
`reply_tail_inv`): from `JAtZ` at the spec's `set_mrs` state of the words
`ms` (the caller `Restart`), `JAt` at the spec's success tail with data
(`specTail_data`). -/
theorem JAtZ.replyTailJSt {σ0 : Fl4Spec.State Unit} {ct : U64} {x0 : Fl4Spec.Tcb} {ms : List Fl4Spec.Word}
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a (MrS σ0 ct.bv x0 (Endp.ipcBufOf true x0) ms)) [VxE Z]
    (hct : ct ∈ Z.T) (hk0 : σ0.kheap ct.bv = some (.tcb x0)) (hrs : x0.tcbState = .restart)
    (hlen : ms.length ≤ Fl4Spec.msgMaxLength)
    (hfr : ∀ p, Endp.ipcBufOf true x0 = some p → ∀ z ∈ Endp.mrPairs ms,
      (Endp.bufAddr p z.1).toNat % 8 = 0 ∧ Fl4Spec.inUserFrame (Endp.bufAddr p z.1) σ0)
    (n : U64) (hn : n.val = mrLen (Endp.ipcBufOf true x0) ms.length) (hn128 : n.val < 128) :
    (do
      let s4 ← tcb.reply_words st s ct n
      sched.set_thread_state st s4 ct sched.TS_RUNNING) ⦃ s5 =>
        ∀ z ∈ (specTail true ct.bv ms σ0).1, JStab (L := L) arI AR Z H Cs s5 a z.2 ⦄ := by
  set buf := Endp.ipcBufOf true x0
  have hkx := MrS_kheap_t σ0 ct.bv x0 buf ms
  refine WP.spec_bind (Pₘ := fun s4 => ∃ V, JAtZ (L := L) arI AR (Z.mv Z.G V) H Cs Ac Lst D s4 a
    (replyStateB σ0 ct.bv x0 buf ms)) ?_ ?_
  swap
  · rintro s4 ⟨V2, J2⟩
    refine WP.spec_mono (J2.runJ hct (replyStateB_kheap_t _ _ _ _ _) (by rw [replyTcbB_state, hrs])) ?_
    rintro s5 ⟨Lst', D', J5⟩ z hz
    rw [specTail_data hk0 hrs ms hlen hfr] at hz
    rw [Set.mem_singleton_iff.1 hz]
    exact (by first | exact J5.stab | exact J5.stab.mv | exact J5.stab.mv.mv | exact J5.stab.mv.mv.mv)
  unfold tcb.reply_words
  refine WP.spec_bind (Endp.obj.Tcb.set_reg.spec s ct layout.reg.BADGE 0#u64) ?_
  rintro s1 rfl
  -- the badge
  have hXb := badge_wr_irel J.ip (J.xtop.irelK J.ks J.buf) hct hkx 0#u64
  rw [badgeRegA_eq_regA] at hXb
  obtain ⟨V1, J1⟩ := J.regWrJ hct hkx Fl4Spec.badge_register 0#u64 hXb
  rw [Endp.regIdx_badge] at J1
  rw [mrS_setReg σ0 ct.bv x0 buf ms badge_not_mr] at J1
  have e0 : U64.bv 0#u64 = (0 : Fl4Spec.Word) := rfl
  rw [e0] at J1
  set xA := Notif.setReg x0 Fl4Spec.badge_register 0
  unfold msginfo.MessageInfo.new
  simp only [bind_ok]
  refine WP.spec_mono (Endp.set_msg_info_spec _ ct 0#u64 n hn128) ?_
  rintro s2 ⟨v, rfl, hv⟩
  rw [← Endp.regIdx_msgInfo]
  have hkA := MrS_kheap_t (Notif.updK σ0 ct.bv (.tcb xA)) ct.bv xA buf ms
  have hX2 := reg_wr_irel J1.ip (J1.xtop.irelK J1.ks J1.buf) hct hkA Fl4Spec.msg_info_register (by decide) v
  obtain ⟨V2, J2⟩ := J1.regWrJ hct hkA Fl4Spec.msg_info_register v hX2
  have hvd : v.bv = Fl4Spec.messageInfoToData ⟨Fl4Spec.natToLen (mrLen buf ms.length), 0, 0, 0⟩ := by
    rw [hv]; congr 2
    apply BitVec.eq_of_toNat_eq; simp only [Fl4Spec.natToLen, BitVec.toNat_ofNat, UScalar.bv_toNat, ← hn]; omega
  have eR : Notif.updK (MrS (Notif.updK σ0 ct.bv (.tcb xA)) ct.bv xA buf ms) ct.bv
      (.tcb (Notif.setReg (Endp.withRegs xA (Endp.mrRegs xA.tcbArch.tcbContext.userRegs ms))
        Fl4Spec.msg_info_register v.bv)) = replyStateB σ0 ct.bv x0 buf ms := by
    unfold replyStateB; rw [hvd]
  rw [eR] at J2
  exact ⟨V2, J2⟩

set_option maxHeartbeats 16000000 in
/-- (stable ghosts, `JStab`) **FL4's success tail for an empty result at `J`** (module docstring). -/
theorem JAtZ.flTailJSt (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (hcur : σ.curThread = ct.bv)
    (call : Bool) :
    flTail (st := st) ct call s a ⦃ res => res.1 = .Ok () ∧
      ∃ z ∈ (specTail call ct.bv [] σ).1, RelTopM (L := L) res.2.1 z.2 ∧ JStab (L := L) arI AR Z H Cs res.2.1 res.2.2 z.2 ⦄ := by
  have hct : ct ∈ Z.T := TopSR.cur_mem J.xtop.fin.1 hcur.symm
  obtain ⟨htcb, x, hk⟩ := J.xtop.curTcb hcur
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨x0, hk0, hTR⟩ := hI.1.tcb ct hct
  rw [hk] at hk0; cases hk0
  have hst : (L.mem s (tStA ct)).val = tsCode x.tcbState := hTR.st
  have hss : (L.mem s (P1.stA ct)).val = tsCode x.tcbState := by rw [P1.stA_eq, ← tStA_eq, hst]
  unfold flTail
  refine WP.spec_bind (tcb_state_spec' (st := st) s ct) ?_
  rintro i rfl
  by_cases hr : L.mem s (stA ct) = sched.TS_RESTART
  · rw [if_pos hr]
    have hrs : x.tcbState = .restart := by
      apply tsCode_two
      rw [← hss]
      show (L.mem s (stA ct)).val = 2
      rw [hr]; unfold sched.TS_RESTART; rfl
    rw [specTail_nil hk call, if_pos hrs]
    cases call
    · simp only [Bool.false_eq_true, ↓reduceIte, bind_ok]
      refine WP.spec_bind (J.runJ hct hk hrs) ?_
      rintro s2 ⟨Lst', D', J2⟩
      refine (WP.spec_ok _).2 ⟨rfl, ((), stsAct (updK σ ct.bv (.tcb { x with tcbState := .running })) ct.bv), ?_,
        J2.xtop.relTop, (by first | exact J2.stab | exact J2.stab.mv | exact J2.stab.mv.mv | exact J2.stab.mv.mv.mv)⟩
      rw [Notif.setThreadState_eq .running hk]; exact Set.mem_singleton _
    · simp only [↓reduceIte]
      have J0 : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a (MrS σ ct.bv x (Endp.ipcBufOf true x) []) := by
        rw [MrS_nil hk]; exact J
      have hR := J0.replyTailJSt hct hk hrs (by simp) (fun p _ z hz => by simp [Endp.mrPairs] at hz) 0#u64
        (by cases Endp.ipcBufOf true x <;> rfl) (by decide)
      have e : msg.reply_success_empty st s ct = tcb.reply_words st s ct 0#u64 := by
        unfold msg.reply_success_empty tcb.reply_words; rfl
      rw [e, ← Std.bind_assoc]
      refine WP.spec_bind hR ?_
      intro s5 h5
      have hkN : (Notif.updK σ ct.bv (.tcb (Endp.replyTcbNil x))).kheap ct.bv = some (.tcb (Endp.replyTcbNil x)) := by
        simp [Notif.updK]
      have hz : ((), stsAct (updK (Notif.updK σ ct.bv (.tcb (Endp.replyTcbNil x))) ct.bv
          (.tcb { Endp.replyTcbNil x with tcbState := .running })) ct.bv) ∈
          (specTail true ct.bv [] σ).1 := by
        rw [specTail_nil hk true, if_pos hrs]
        simp only [↓reduceIte]
        rw [Notif.setThreadState_eq .running hkN]; exact Set.mem_singleton _
      have hJ := h5 _ hz
      obtain ⟨G5, V5, Ac5, Lst5, D5, J5⟩ := hJ
      refine (WP.spec_ok _).2 ⟨rfl, _, ?_, J5.xtop.relTop, G5, V5, Ac5, Lst5, D5, J5⟩
      rw [Notif.setThreadState_eq .running hkN]; exact Set.mem_singleton _
  · rw [if_neg hr]
    have hrs : x.tcbState ≠ .restart := by
      intro h
      apply hr
      apply UScalar.eq_of_val_eq
      show (L.mem s (P1.stA ct)).val = _
      rw [hss, h]; unfold sched.TS_RESTART; rfl
    refine (WP.spec_ok _).2 ⟨rfl, ((), σ), ?_, J.xtop.relTop, J.stab⟩
    rw [specTail_nil hk call, if_neg hrs]; exact Set.mem_singleton _

set_option maxHeartbeats 64000000 in
/-- (stable ghosts, `JStab`) **FL4's `reply_error` at `J`** (module docstring). -/
theorem JAtZ.replyErrJSt (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z]
    {ct : U64} (hcur : σ.curThread = ct.bv) (e : error.SysError) (e' : Fl4Spec.SyscallError)
    (he : ErrRel (.Sys e) e') :
    syscall.reply_error st s ct e ⦃ s2 =>
      ∃ z ∈ (Fl4Spec.fl4ReplyFromKernelError (Z := Unit) true ct.bv (Fl4Spec.msgFromSyscallError e') σ).1,
        RelTopM (L := L) s2 z.2 ∧ JStab (L := L) arI AR Z H Cs s2 a z.2 ⦄ := by
  have hct : ct ∈ Z.T := TopSR.cur_mem J.xtop.fin.1 hcur.symm
  obtain ⟨htcb, x, hk⟩ := J.xtop.curTcb hcur
  obtain ⟨x', hk', hwx⟩ := J.buf ct hct
  rw [hk] at hk'; cases hk'
  have hOK0 := J.xferH.1
  have hBP0 := J.xferH.2.2
  have hmsl : (Fl4Spec.msgFromSyscallError e').2.length ≤ 5 := msgErr_len e'
  have hflag : fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC = true := by
    unfold fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC; rfl
  have hdm : syscall.DEBUG_MESSAGE_START + 1#u64 = ok 7#u64 := by
    unfold syscall.DEBUG_MESSAGE_START; rfl
  unfold syscall.reply_error
  refine WP.spec_bind (lookup_buf_full s σ J.xtop.rel.2.1.1 J.xtop.rel.2.1.2.1 htcb hk hOK0 true) ?_
  rintro w ⟨hw0, hwp⟩
  have hbm : ∀ q, Endp.ipcBufOf true x = some q → Endp.BufMap Z.B w q := fun q hq =>
    J.xferH.2.1 ct hct x true q hk hq w (hwp hwx q hq)
  have hfr : ∀ p, Endp.ipcBufOf true x = some p →
      ∀ k, k < 128 → (Endp.bufAddr p k).toNat % 8 = 0 ∧ Fl4Spec.inUserFrame (Endp.bufAddr p k) σ :=
    fun p hp k hk128 => ⟨Endp.bufAddr_aligned J.xtop.fin.1.2.ep (hbm p hp) k, buf_frame_of_ok hOK0 hk hp k hk128⟩
  have hspec := fl4ReplyErr_eq hk (Fl4Spec.msgFromSyscallError e').1 (Fl4Spec.msgFromSyscallError e').2
    (by omega) hfr
  suffices hsuf : (do
      let s1 ← obj.Tcb.set_reg st ct s layout.reg.BADGE 0#u64
      let (len, s2) ← syscall.error_mrs st s1 ct w e
      let (s3, len1) ←
        if fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC
        then
          if w != 0#u64
          then
            do
            let i ← syscall.DEBUG_MESSAGE_START + 1#u64
            let w1 ← msg.buf_get st s2 w i
            let i1 ← lift (~~~255#u64)
            let i2 ← lift (w1 &&& i1)
            let s3 ← msg.buf_set st s2 w i i2
            let len1 ← lift (core.num.U64.wrapping_add len 1#u64)
            ok (s3, len1)
          else ok (s2, len)
        else ok (s2, len)
      let i ← error.SysError.code e
      let mi ← msginfo.MessageInfo.new i 0#u64 0#u64 len1
      msg.set_msg_info st s3 ct mi) ⦃ s2 =>
        JStab (L := L) arI AR Z H Cs s2 a (replyErrState σ ct.bv x (Fl4Spec.msgFromSyscallError e').1
          (Fl4Spec.msgFromSyscallError e').2) ⦄ by
    refine WP.spec_mono hsuf ?_
    rintro s2 ⟨G2, V2, Ac2, Lst2, D2, J2⟩
    refine ⟨((), replyErrState σ ct.bv x (Fl4Spec.msgFromSyscallError e').1 (Fl4Spec.msgFromSyscallError e').2),
      ?_, J2.xtop.relTop, G2, V2, Ac2, Lst2, D2, J2⟩
    rw [hspec]; exact Set.mem_singleton _
  refine WP.spec_bind (Endp.obj.Tcb.set_reg.spec s ct layout.reg.BADGE 0#u64) ?_
  rintro s1 rfl
  -- the badge
  have hXb := badge_wr_irel J.ip (J.xtop.irelK J.ks J.buf) hct hk 0#u64
  rw [badgeRegA_eq_regA] at hXb
  obtain ⟨V1, J1⟩ := J.regWrJ hct hk Fl4Spec.badge_register 0#u64 hXb
  rw [Endp.regIdx_badge] at J1
  have e0 : U64.bv 0#u64 = (0 : Fl4Spec.Word) := rfl
  rw [e0] at J1
  set xA := Notif.setReg x Fl4Spec.badge_register 0 with hxA
  set σA := Notif.updK σ ct.bv (.tcb xA) with hσA
  have hkA : σA.kheap ct.bv = some (.tcb xA) := by simp [σA, Notif.updK]
  set s1 := L.wr s (Endp.regA ct layout.reg.BADGE) 0#u64 with hs1
  have hks1 : L.ksb s1 = L.ksb s := L.ksb_wr _ _ _
  have hBPA : ∀ s', L.ksb s' = L.ksb s → Vs.BufPlaced (L := L) Z.N Z.C Z.B Z.c s' σA := fun s' h =>
    hBP0.mono h (fun q y n hq => by
      by_cases e : q = ct.bv
      · subst e; rw [hkA] at hq; cases hq
      · simpa [σA, Notif.updK, e] using hq)
  have hOK1 := J1.xferH.1
  have hWOK : ∀ q, Endp.ipcBufOf true x = some q → ∀ i : U64, i.val < 128 →
      BufWordOK H σA (fl4BufA w i) := fun q hq i hi =>
    J1.bufWord hOK1 htcb hkA hq i.val hi (by rw [fl4BufA_bv, hwp hwx q hq])
  set buf := Endp.ipcBufOf true x with hbuf
  -- the words
  let I : S → List Fl4Spec.Word → Prop := fun s' ms => L.ksb s' = L.ksb s ∧
    ∃ V, JAtZ (L := L) arI AR (Z.mv Z.G V) H Cs Ac Lst D s' a (MrS σA ct.bv xA buf ms)
  have hI0 : I s1 [] := ⟨hks1, V1, by rw [MrS_nil hkA]; exact J1⟩
  have step : ∀ (s' : S) (ms1 : List Fl4Spec.Word), I s' ms1 → ∀ (i : U64), i.val = ms1.length →
      ms1.length < 120 → ∀ v : U64, msg.set_mr st s' ct w i v ⦃ r => r.1.val = mrLen buf (ms1.length + 1) ∧
        I r.2 (ms1 ++ [v.bv]) ⦄ := by
    rintro s' ms1 ⟨hk', V, J'⟩ i hi hi' v
    refine WP.spec_mono (J'.setmrJ hct hkA w hw0 hbm (hBPA s' hk') hWOK i hi hi' v) ?_
    rintro r ⟨h1, h2, V', J''⟩
    exact ⟨h1, h2.trans hk', V', J''⟩
  refine WP.spec_bind (error_mrs_gen ct buf w I step s1 hI0 e e' he) ?_
  rintro ⟨len, s3⟩ ⟨hlen, hk3, V3, J3⟩
  simp only at hlen hk3 J3
  have hkM := MrS_kheap_t σA ct.bv xA buf (Fl4Spec.msgFromSyscallError e').2
  cases hb : Endp.ipcBufOf true x with
  | none =>
    have hbn : buf = none := hb
    rw [hbn] at J3 hlen hkM
    have hw : w = 0#u64 := hw0.2 hb
    simp only [hflag, hw, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, bind_ok]
    refine WP.spec_bind (code_label he) ?_
    rintro cd hcd
    unfold msginfo.MessageInfo.new
    simp only [bind_ok]
    have hl128 : len.val < 128 := by rw [hlen]; simp only [mrLen]; omega
    refine WP.spec_mono (Endp.set_msg_info_spec _ ct cd len hl128) ?_
    rintro s4 ⟨v, rfl, hv⟩
    rw [← Endp.regIdx_msgInfo]
    have hX4 := reg_wr_irel J3.ip (J3.xtop.irelK J3.ks J3.buf) hct hkM Fl4Spec.msg_info_register (by decide) v
    obtain ⟨V4, J4⟩ := J3.regWrJ hct hkM Fl4Spec.msg_info_register v hX4
    have hvd : v.bv = Fl4Spec.messageInfoToData ⟨Fl4Spec.natToLen (mrLen none (Fl4Spec.msgFromSyscallError e').2.length),
        0, 0, (Fl4Spec.msgFromSyscallError e').1⟩ := by
      rw [hv, hcd]; congr 2
      apply BitVec.eq_of_toNat_eq; simp only [Fl4Spec.natToLen, BitVec.toNat_ofNat, UScalar.bv_toNat, hlen, mrLen]; omega
    unfold replyErrState
    simp only [hb]
    rw [← hvd]; exact (by first | exact J4.stab | exact J4.stab.mv | exact J4.stab.mv.mv | exact J4.stab.mv.mv.mv)
  | some p =>
    have hbs : buf = some p := hb
    rw [hbs] at J3 hlen hkM
    have hw : w ≠ 0#u64 := fun h => by rw [hbs] at hw0; cases hw0.1 h
    have hbw : (w != 0#u64) = true := by simp [hw]
    simp only [hflag, hbw, ↓reduceIte, hdm, bind_ok]
    have hdbg : (do
        let w_1 ← msg.buf_get st s3 w 7#u64
        let i1 ← lift (~~~255#u64)
        let i2 ← lift (w_1 &&& i1)
        let s4 ← msg.buf_set st s3 w 7#u64 i2
        let len2 ← lift (core.num.U64.wrapping_add len 1#u64)
        ok (s4, len2)) ⦃ r => r = (L.wr s3 (Endp.fl4BufA w 7#u64) (L.mem s3 (Endp.fl4BufA w 7#u64) &&& ~~~255#u64),
          core.num.U64.wrapping_add len 1#u64) ⦄ := by
      refine WP.spec_bind (Endp.msg.buf_get.spec s3 w 7#u64) ?_
      rintro dv rfl
      simp only [lift, bind_ok]
      refine WP.spec_bind (Endp.msg.buf_set.spec s3 w 7#u64 _) ?_
      rintro s4 rfl
      simp only [bind_ok, WP.spec_ok]
    refine WP.spec_bind hdbg ?_
    rintro r rfl
    have hpair := hbm p hb 7#u64 (by decide)
    set σM := MrS σA ct.bv xA (some p) (Fl4Spec.msgFromSyscallError e').2 with hσM
    have hdv : (L.mem s3 (Endp.fl4BufA w 7#u64)).bv = Endp.loadWordAt σM.machineState.underlyingMemory (Endp.bufAddr p 7) :=
      J3.xtop.fin.1.1.2.1.buf _ hpair
    have hval : (L.mem s3 (Endp.fl4BufA w 7#u64) &&& ~~~255#u64).bv =
        Endp.loadWordAt σM.machineState.underlyingMemory (Endp.bufAddr p 7) &&& ~~~(255 : Fl4Spec.Word) := by
      rw [UScalar.bv_and]; exact congrArg₂ (· &&& ·) hdv rfl
    obtain ⟨hAp, o, ko, hko, g1, g2⟩ := hWOK p hb 7#u64 (by decide)
    have hObj : ∃ o ko, σM.kheap o = some ko ∧ o.toNat ≤ (Endp.fl4BufA w 7#u64).val ∧
        (Endp.fl4BufA w 7#u64).val < o.toNat + 2 ^ Fl4Spec.objBits ko := by
      by_cases e : o = ct.bv
      · subst e; rw [hkA] at hko; cases hko
        exact ⟨_, _, MrS_kheap_t _ _ _ _ _, g1, g2⟩
      · exact ⟨o, ko, by rw [hσM, MrS_kheap_ne _ _ _ _ _ e]; exact hko, g1, g2⟩
    have hBP3 : Vs.BufPlaced (L := L) Z.N Z.C Z.B Z.c s3 σM := (hBPA s3 hk3).mono rfl (MrS_sc hkA _ _)
    have J4 := J3.userWrJ hBP3 hpair hAp hObj (L.mem s3 (Endp.fl4BufA w 7#u64) &&& ~~~255#u64)
    simp only [hval] at J4
    refine WP.spec_bind (code_label he) ?_
    rintro cd hcd
    unfold msginfo.MessageInfo.new
    simp only [bind_ok]
    have hl128 : (core.num.U64.wrapping_add len 1#u64).val < 128 := by
      simp [core.num.U64.wrapping_add_val_eq, U64.size_def, U64.numBits, hlen, mrLen]; omega
    refine WP.spec_mono (Endp.set_msg_info_spec _ ct cd _ hl128) ?_
    rintro s5 ⟨v, rfl, hv⟩
    rw [← Endp.regIdx_msgInfo]
    have hkD : (Endp.setUm σM (Endp.storeMem σM.machineState.underlyingMemory (Endp.bufAddr p 7)
        (Endp.loadWordAt σM.machineState.underlyingMemory (Endp.bufAddr p 7) &&& ~~~(255 : Fl4Spec.Word)))).kheap ct.bv =
        some (.tcb (Endp.withRegs xA (Endp.mrRegs xA.tcbArch.tcbContext.userRegs (Fl4Spec.msgFromSyscallError e').2))) :=
      hkM
    have hX5 := reg_wr_irel J4.ip (J4.xtop.irelK J4.ks J4.buf) hct hkD Fl4Spec.msg_info_register (by decide) v
    obtain ⟨V5, J5⟩ := J4.regWrJ hct hkD Fl4Spec.msg_info_register v hX5
    have hvd : v.bv = Fl4Spec.messageInfoToData ⟨Fl4Spec.natToLen (mrLen (some p)
        (Fl4Spec.msgFromSyscallError e').2.length) + 1, 0, 0, (Fl4Spec.msgFromSyscallError e').1⟩ := by
      rw [hv, hcd]; congr 2
      apply BitVec.eq_of_toNat_eq
      simp [Fl4Spec.natToLen, core.num.U64.wrapping_add_val_eq, U64.size_def, U64.numBits, hlen, mrLen]
    unfold replyErrState
    simp only [hb]
    rw [← hvd]; exact (by first | exact J5.stab | exact J5.stab.mv | exact J5.stab.mv.mv | exact J5.stab.mv.mv.mv)

set_option maxHeartbeats 4000000 in
/-- (stable ghosts, `JStab`) **The error reply at `J`** (`ReplyHypMX.fail`'s program, module
docstring). -/
theorem JAtZ.replyFailJSt (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z]
    {ct : U64} (hcur : σ.curThread = ct.bv) (is_call : Bool) (e : error.SysError) (e' : Fl4Spec.SyscallError)
    (he : ErrRel (.Sys e) e') :
    ((if is_call then do
        let s2 ← syscall.reply_error st s ct e
        ok ((core.result.Result.Ok () : core.result.Result Unit error.Exc), s2, a)
      else ok ((core.result.Result.Ok () : core.result.Result Unit error.Exc), s, a)) :
      Result ((core.result.Result Unit error.Exc) × S × A)) ⦃ res =>
      res.1 = .Ok () ∧ ∃ z ∈ ((Fl4Spec.NonDet.when is_call <|
        Fl4Spec.fl4ReplyFromKernelError true ct.bv (Fl4Spec.msgFromSyscallError e')) σ).1,
        RelTopM (L := L) res.2.1 z.2 ∧ JStab (L := L) arI AR Z H Cs res.2.1 res.2.2 z.2 ⦄ := by
  cases is_call
  · simp only [Bool.false_eq_true, ↓reduceIte, WP.spec_ok]
    refine ⟨trivial, ((), σ), ?_, J.xtop.relTop, J.stab⟩
    rw [Endp.nd_when_false (by simp)]; exact Set.mem_singleton _
  simp only [↓reduceIte]
  refine WP.spec_bind (J.replyErrJSt hcur e e' he) ?_
  rintro s2 ⟨z, hz, hRT, hJ⟩
  refine (WP.spec_ok _).2 ⟨rfl, z, ?_, hRT, hJ⟩
  unfold Fl4Spec.NonDet.when
  simp only [↓reduceIte]
  exact hz

end StIoB

section StIoC
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)
