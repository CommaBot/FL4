variable {Cs Sg Rp Scs Nt : Set U64} {Z : U64 → Nat} {Ac : Set U64} {U X : Set U64}
variable {Q : U64 → U64 → List U64} {R : U64 → List U64} {RS : S → S → Prop}

set_option hygiene false in
local macro "smrC" : tactic => `(tactic| (
  refine WP.spec_bind (msg.set_mr.xsfc hcur ht hb (by simp)) ?_
  rintro ⟨_, s'⟩ ⟨hcur, -⟩
  try simp only at hcur
  try simp only [WP.uncurry'_pair]))

set_option maxHeartbeats 4000000 in
/-- (p3J gen 35) P1's `error_mrs.xs` over `XSFC` (module docstring). -/
theorem syscall.error_mrs.xsfc {s0 s : S} {t buf : U64} {e : error.SysError}
    (h : XSFC st T Cs Ω H Sg Rp Scs Nt Z U RS Ac X Q R s0 s) (ht : t ∈ T) (hb : BufOK U buf) :
    syscall.error_mrs st s t buf e ⦃ r => XSFC st T Cs Ω H Sg Rp Scs Nt Z U RS Ac X Q R s0 r.2 ⦄ := by
  have hcur := h
  unfold syscall.error_mrs
  split
  · exact set_mr_lastFC h ht hb (by simp)
  · exact set_mr_lastFC h ht hb (by simp)
  · exact (WP.spec_ok _).2 h
  · smrC
    exact set_mr_lastFC hcur ht hb (by simp)
  · exact (WP.spec_ok _).2 h
  · split
    · smrC
      exact faults.set_mrs_lookup_failure.xsfc hcur ht hb (by simp)
    · smrC
      exact faults.set_mrs_lookup_failure.xsfc hcur ht hb (by simp)
  · exact (WP.spec_ok _).2 h
  · exact (WP.spec_ok _).2 h
  · exact (WP.spec_ok _).2 h
  · exact set_mr_lastFC h ht hb (by simp)

set_option maxHeartbeats 4000000 in
/-- (p3J gen 35) **P1's `reply_error.xs` over `XSFC`, the buffer from `NoBufCap`** (module docstring). -/
theorem syscall.reply_error.xsfc {s0 s : S} {t : U64}
    {e : error.SysError} (h : XSFC st T Cs Ω H Sg Rp Scs Nt Z U RS Ac X Q R s0 s) (ht : t ∈ T)
    (hN : NoBufCap (L := L) T s) :
    syscall.reply_error st s t e ⦃ s' => XSFC st T Cs Ω H Sg Rp Scs Nt Z U RS Ac X Q R s0 s' ⦄ := by
  have hS : P0.StoreTotal st := L.total
  unfold syscall.reply_error
  refine WP.spec_bind (Pₘ := fun b => BufOK U b) (by rw [lookup_ipc_buffer_noBuf hN ht true, WP.spec_ok]; exact fun h0 => (h0 rfl).elim) fun buf hb => ?_
  refine WP.spec_bind (obj.Tcb.set_reg.xsfc (v := 0#u64) h ht (by simp [layout.reg.BADGE, layout.reg.RDI]))
    fun s1 h1 => ?_
  refine WP.spec_bind (syscall.error_mrs.xsfc (e := e) h1 ht hb) ?_
  rintro ⟨len, s2⟩ h2
  simp only at h2
  try simp only [WP.uncurry'_pair]
  refine WP.spec_bind (Pₘ := fun r : S × U64 => XSFC st T Cs Ω H Sg Rp Scs Nt Z U RS Ac X Q R s0 r.1) ?_ ?_
  · simp only [fl4_abi.config.KERNEL_INVOCATION_REPORT_ERROR_IPC, ↓reduceIte]
    split
    · rename_i hne
      have h0 : buf ≠ 0#u64 := by simpa using hne
      simp only [syscall.DEBUG_MESSAGE_START]
      step as ⟨i, hi⟩
      refine WP.spec_bind (P0.msg.buf_get.p0 st s2 buf i hS) fun w _ => ?_
      try simp only [lift, bind_ok]
      refine WP.spec_bind (msg.buf_set.xsfc (v := w &&& ~~~255#u64) h2 hb h0 (by omega)) fun s4 h4 => ?_
      exact (WP.spec_ok _).2 h4
    · exact (WP.spec_ok _).2 h2
  rintro ⟨s3, len1⟩ h3
  simp only at h3
  try simp only [WP.uncurry'_pair]
  refine WP.spec_bind (P0.error.SysError.code.p0 e) fun i _ => ?_
  refine WP.spec_bind (P0.msginfo.MessageInfo.new.p0 _ _ _ _) fun mi _ => ?_
  unfold msg.set_msg_info
  exact WP.spec_bind (P0.msginfo.MessageInfo.to_word.p0 _) fun w _ =>
    obj.Tcb.set_reg.xsfc (v := w) h3 ht (by simp [layout.reg.MSG_INFO, layout.reg.RSI])

end

