/-
**p3J gen 15 copy** of JBoot1Z (namespace `JBootQ`, generated by scratch/p3J/genQ1.py): the same proofs
at the root-thread witness `JBootQ.w1` / `JBootQ.σ1` on FL4's boot IRQ layout (`JBootQ.fInitASt`, `JBootQ.img`:
line 125 `IRQ_TIMER`, 126 / 127 `IRQ_IPI`; spec 125 `irqTimer`, 126 / 127 `irqReserved`). Original docstring:

P3 (line jboot, gen 4): **the richer witness's ghosts** at `w1` / `σ1` (JBoot1Mem) and the slot facts.

* `thW1` (`Z.th`): `thW` (JBootZ: the idle TCB, the 256 IRQ-node CNodes) plus the root TCB at `rT` and the
  radix-1 root CNode at `rC`. **`placed_thW1`**, **`kTyped_thW1`**, **`intL_thW1`**, **`thT_thW1`**,
  **`thk_thW1`**.
* **The slots**: every slot word of `thW1` at offset 8, 16 or 24 is zero (`mem1_slotw`), so every link is 0
  and no cap is revocable or first-badged; the first words are zero but at the three cap slots
  (`capV1_slot`): the root TCB's slot 0 holds `cnC` (the CNode cap of `rC`, radix 1), the root CNode's slot 0
  `thC` (the thread cap of `rT`), its slot 1 `scC` (the SC cap of `rS`, size 7).
* `G1` (the MDB ghost): the three cap slots, each its own chain; no parent.
* `Hw1` (P1's heap): `Hw` plus the root TCB (`tcb`), the root SC (`sc 7`) and the root CNode (`other 6`).
* `Zw1`: `th := thW1`, `G := G1`, `T := T1`, `C := C1`, every other set empty, core 0, `vx := ∅`.

No sorry; no premises. New module; no existing statement changed.
-/
import Fl4Proofs.P3.JBootQ1Mem
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3.JBootQ
open Fl4Proofs.P3.JBoot
open fl4_core Fl4Spec Fl4Proofs.P1 Fl4Proofs.P3 Fl4Proofs.P3.Sched Fl4Proofs.P2.Wit Classical

noncomputable section

set_option maxHeartbeats 1000000

/-! ## The typed heap -/

/-- **The richer typed heap** (module docstring). -/
def thW1 : TypedHeap := fun p => if p = rT then some .tcb else if p = rC then some (.cnode 1) else thW p

theorem thW1_rT : thW1 rT = some .tcb := by unfold thW1; rw [if_pos rfl]
theorem thW1_rC : thW1 rC = some (.cnode 1) := by unfold thW1; rw [if_neg (by decide), if_pos rfl]
theorem thW1_old {p : U64} (h1 : p ≠ rT) (h2 : p ≠ rC) : thW1 p = thW p := by
  unfold thW1; rw [if_neg h1, if_neg h2]
theorem thW1_idT : thW1 idT = some .tcb := by rw [thW1_old (by decide) (by decide)]; exact thW_idT

theorem thW1_some {p : U64} {k : ObjKind} (h : thW1 p = some k) :
    (p = rT ∧ k = .tcb) ∨ (p = rC ∧ k = .cnode 1) ∨ (p ≠ rT ∧ p ≠ rC ∧ thW p = some k) := by
  by_cases e1 : p = rT
  · subst e1; rw [thW1_rT] at h; cases h; exact Or.inl ⟨rfl, rfl⟩
  by_cases e2 : p = rC
  · subst e2; rw [thW1_rC] at h; cases h; exact Or.inr (Or.inl ⟨rfl, rfl⟩)
  rw [thW1_old e1 e2] at h
  exact Or.inr (Or.inr ⟨e1, e2, h⟩)

/-- **The richer typed heap's objects by position.** -/
theorem thW1_pos {p : U64} {k : ObjKind} (h : thW1 p = some k) :
    (p.val = 18446744071562072064 ∧ k = .tcb) ∨ (p.val = 18446744071562100736 ∧ k = .tcb) ∨
    (p.val = 18446744071562108928 ∧ k = .cnode 1) ∨
    (k = .cnode 0 ∧ ((∃ i, i < 128 ∧ p.val = 18446744071562134752 + 32 * i) ∨
      (∃ i, 128 ≤ i ∧ i < 256 ∧ p.val = 18446744071562076160 + 32 * i))) := by
  rcases thW1_some h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨-, -, h'⟩
  · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
  · exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
  · rcases thW_pos h' with h1 | h1
    · exact Or.inl h1
    · exact Or.inr (Or.inr (Or.inr h1))

/-- Case split on `thW1`'s objects, the kind substituted. -/
macro "thc1" h:term : tactic =>
  `(tactic| (rcases thW1_pos $h with ⟨e, e'⟩ | ⟨e, e'⟩ | ⟨e, e'⟩ | ⟨e', ⟨i, hi, e⟩ | ⟨i, hi, hi2, e⟩⟩ <;> cases e'))

/-- **`Placed`** of the richer typed heap. -/
theorem placed_thW1 : Placed thW1 where
  align p k h := by thc1 h <;> omega
  fits p k h := by thc1 h <;> simp only [objSize, Nat.pow_zero, Nat.mul_one, Nat.pow_one] <;> omega
  disj p q kp kq hp hq hne := by
    have hv : p.val ≠ q.val := fun e => hne (UScalar.eq_of_val_eq e)
    rcases thW1_pos hp with ⟨e, rfl⟩ | ⟨e, rfl⟩ | ⟨e, rfl⟩ | ⟨rfl, ⟨i, hi, e⟩ | ⟨i, hi, hi2, e⟩⟩ <;>
    rcases thW1_pos hq with ⟨e', rfl⟩ | ⟨e', rfl⟩ | ⟨e', rfl⟩ | ⟨rfl, ⟨j, hj, e'⟩ | ⟨j, hj, hj2, e'⟩⟩ <;>
      simp only [objSize, Nat.pow_zero, Nat.mul_one, Nat.pow_one] <;> omega
  high p k h := by thc1 h <;> omega

/-- **`KTyped`**: every spec CNode and TCB of `σ1` is typed. -/
theorem kTyped_thW1 : KTyped thW1 σ1 := by
  intro o
  refine ⟨fun r cs h _ => ?_, fun t h => ?_⟩
  · rcases kh1_some h with ⟨-, e⟩ | ⟨-, e⟩ | ⟨rfl, e⟩ | ⟨-, -, -, h'⟩
    · cases e
    · cases e
    · cases e; exact thW1_rC
    · obtain ⟨⟨irq, rfl⟩, rfl, -⟩ := fInitKheap_cnode h'
      have h1 : (⟨fIrqNode irq⟩ : U64) ≠ rT := fun e => rT_irq irq (congrArg UScalar.bv e)
      have h2 : (⟨fIrqNode irq⟩ : U64) ≠ rC := fun e => rC_irq irq (congrArg UScalar.bv e)
      exact (thW1_old h1 h2).trans (thW_irq irq)
  · rcases kh1_tcb_of h with ⟨rfl, -⟩ | ⟨rfl, -⟩
    · exact thW1_rT
    · rw [← idT_bv]; exact thW1_idT

theorem thT_thW1 : ∀ t, thW1 t = some .tcb → t ∈ T1 := by
  intro t h
  rcases thW1_some h with ⟨rfl, -⟩ | ⟨-, e⟩ | ⟨-, -, h'⟩
  · exact rT_mem
  · cases e
  · rw [thT_thW t h']; exact idT_mem

theorem thk_thW1 : ∀ q k, thW1 q = some k → k = .tcb ∨ ∃ r, k = .cnode r := by
  intro q k h
  rcases thW1_some h with ⟨-, rfl⟩ | ⟨-, rfl⟩ | ⟨-, -, h'⟩
  · exact Or.inl rfl
  · exact Or.inr ⟨1, rfl⟩
  · exact thk_thW q k h'

/-- **`IntLayout`** at `fkb`. -/
theorem intL_thW1 : IntLayout thW1 fkb where
  fit := fkb_lt
  align := fkb_fit.2.2
  st_out i hi := by
    have hv := irqStA_val (kb := fkb) fkb_lt hi
    rw [fkb_val] at hv
    refine ⟨by show (irqStA fkb i).val % 8 = 0; omega, fun p k hp => ?_⟩
    rw [hv]
    thc1 hp <;> simp only [objSize, Nat.pow_zero, Nat.mul_one, Nat.pow_one] <;> omega
  node i hi := by
    have hv := nodeA_val (kb := fkb) fkb_lt hi
    rw [fkb_val] at hv
    rw [thW1_old (fun e => by rw [e, rT_val] at hv; omega) (fun e => by rw [e, rC_val] at hv; omega)]
    exact intL_thW.node i hi

/-! ## The slots -/

/-- The byte addresses of `thW1`'s slots. -/
def SlotNat1 (n : Nat) : Prop :=
  SlotNat n ∨ (18446744071562100736 ≤ n ∧ n < 18446744071562100736 + 192) ∨
    (18446744071562108928 ≤ n ∧ n < 18446744071562108928 + 64)

theorem slot_nat1 {x : U64} (h : IsSlot thW1 x) (k : Nat) (hk : k < 32) :
    SlotNat1 (x.val + k) ∧ x.val % 32 = 0 := by
  obtain ⟨p, i, hs, rfl⟩ := h
  rw [IsSlotAt.val placed_thW1 hs]
  unfold SlotNat1 SlotNat
  rcases hs with ⟨r, hp, hi⟩ | ⟨hp, hi⟩
  · rcases thW1_pos hp with ⟨-, e⟩ | ⟨-, e⟩ | ⟨hv, e⟩ | ⟨e, ⟨j, hj, hv⟩ | ⟨j, hj, hj2, hv⟩⟩
    · cases e
    · cases e
    · cases e; rw [Nat.pow_one] at hi; omega
    · cases e; rw [Nat.pow_zero] at hi; omega
    · cases e; rw [Nat.pow_zero] at hi; omega
  · unfold tcbSlots at hi
    rcases thW1_pos hp with ⟨hv, -⟩ | ⟨hv, -⟩ | ⟨-, e⟩ | ⟨e, -⟩
    · omega
    · omega
    · cases e
    · cases e

/-- **Every slot word at offset 8, 16 or 24 is zero.** -/
theorem mem1_slotw {x : U64} (h : IsSlot thW1 x) {k : U64} (hk0 : 8 ≤ k.val) (hk : k.val < 32) (hk8 : k.val % 8 = 0) :
    wL.mem w1 (wordOf x k) = 0#u64 := by
  obtain ⟨h1, ha⟩ := slot_nat1 h k.val hk
  have hv : (wordOf x k).val = x.val + k.val := wordOf_val (by unfold SlotNat1 SlotNat at h1; omega)
  rw [mem1_al hv (by omega)]
  unfold SlotNat1 SlotNat at h1
  img1z

/-- The root CNode's second slot. -/
def rC1 : U64 := 18446744071562108960#u64

/-- The three caps. -/
abbrev cnC : capability.Cap := .CNode rC 1#u64 0#u64 0#u64
abbrev thC : capability.Cap := .Thread rT
abbrev scC : capability.Cap := .SchedContext rS 7#u64

theorem w8_rT : wL.mem w1 (wordOf rT 8#u64) = 0#u64 := by
  rw [mem1_al (n := 18446744071562100744) (wordOf_val (by decide)) (by norm_num)]; decide
theorem w8_rC : wL.mem w1 (wordOf rC 8#u64) = 0#u64 := by
  rw [mem1_al (n := 18446744071562108936) (wordOf_val (by decide)) (by norm_num)]; decide
theorem w8_rC1 : wL.mem w1 (wordOf rC1 8#u64) = 0#u64 := by
  rw [mem1_al (n := 18446744071562108968) (wordOf_val (by decide)) (by norm_num)]; decide

theorem capV_rT : capV (wL.mem w1) rT = cnC := by
  unfold capV; rw [w8_rT, mem1_al (n := 18446744071562100736) rfl (by norm_num)]; rfl
theorem capV_rC : capV (wL.mem w1) rC = thC := by
  unfold capV; rw [w8_rC, mem1_al (n := 18446744071562108928) rfl (by norm_num)]; rfl
theorem capV_rC1 : capV (wL.mem w1) rC1 = scC := by
  unfold capV; rw [w8_rC1, mem1_al (n := 18446744071562108960) rfl (by norm_num)]; rfl

/-- **The caps of `thW1`'s slots**: the three cap slots, every other slot null. -/
theorem capV1_slot {x : U64} (h : IsSlot thW1 x) (h1 : x ≠ rT) (h2 : x ≠ rC) (h3 : x ≠ rC1) :
    capV (wL.mem w1) x = .Null := by
  have n1 : x.val ≠ 18446744071562100736 := fun e => h1 (UScalar.eq_of_val_eq (by rw [e]; rfl))
  have n2 : x.val ≠ 18446744071562108928 := fun e => h2 (UScalar.eq_of_val_eq (by rw [e]; rfl))
  have n3 : x.val ≠ 18446744071562108960 := fun e => h3 (UScalar.eq_of_val_eq (by rw [e]; rfl))
  obtain ⟨hs, ha⟩ := slot_nat1 h 0 (by omega)
  rw [Nat.add_zero] at hs
  apply capV_zero _ (mem1_slotw h (k := 8#u64) (by decide) (by decide) (by decide))
  rw [mem1_al rfl (by omega)]
  unfold SlotNat1 SlotNat at hs
  img1z

theorem isSlot_rT : IsSlot thW1 rT := ⟨rT, 0, Or.inr ⟨thW1_rT, by unfold tcbSlots; omega⟩, by decide⟩
theorem isSlot_rC : IsSlot thW1 rC := ⟨rC, 0, Or.inl ⟨1, thW1_rC, by norm_num⟩, by decide⟩
theorem isSlot_rC1 : IsSlot thW1 rC1 := ⟨rC, 1, Or.inl ⟨1, thW1_rC, by norm_num⟩, by decide⟩

theorem prevOf1 {x : U64} (h : IsSlot thW1 x) : prevOf (wL.mem w1) x = 0#u64 :=
  mem1_slotw h (k := 16#u64) (by decide) (by decide) (by decide)

theorem nextOf1 {x : U64} (h : IsSlot thW1 x) : nextOf (wL.mem w1) x = 0#u64 := by
  unfold nextOf; rw [mem1_slotw h (k := 24#u64) (by decide) (by decide) (by decide)]; decide

theorem revOf1 {x : U64} (h : IsSlot thW1 x) : revOf (wL.mem w1) x = false := by
  unfold revOf; rw [mem1_slotw h (k := 24#u64) (by decide) (by decide) (by decide)]; decide

theorem fbOf1 {x : U64} (h : IsSlot thW1 x) : fbOf (wL.mem w1) x = false := by
  unfold fbOf; rw [mem1_slotw h (k := 24#u64) (by decide) (by decide) (by decide)]; decide

/-- The non-null slots of `thW1` are the three cap slots. -/
theorem slot1_cases {x : U64} (h : IsSlot thW1 x) :
    (x = rT ∧ capV (wL.mem w1) x = cnC) ∨ (x = rC ∧ capV (wL.mem w1) x = thC) ∨
      (x = rC1 ∧ capV (wL.mem w1) x = scC) ∨ capV (wL.mem w1) x = .Null := by
  by_cases e1 : x = rT
  · subst e1; exact Or.inl ⟨rfl, capV_rT⟩
  by_cases e2 : x = rC
  · subst e2; exact Or.inr (Or.inl ⟨rfl, capV_rC⟩)
  by_cases e3 : x = rC1
  · subst e3; exact Or.inr (Or.inr (Or.inl ⟨rfl, capV_rC1⟩))
  exact Or.inr (Or.inr (Or.inr (capV1_slot h e1 e2 e3)))

/-! ## The other ghosts -/

/-- **The MDB ghost**: each of the three cap slots its own chain; no parent. -/
def G1 : MdbGhost := ⟨[[rT], [rC], [rC1]], fun _ => none⟩

theorem G1_flat {x : U64} : x ∈ G1.chains.flatten ↔ x = rT ∨ x = rC ∨ x = rC1 := by
  simp [G1]

/-- **P1's heap** (module docstring). -/
def Hw1 : Heap := fun p =>
  if p = rT then some .tcb else if p = rS then some (.sc 7) else if p = rC then some (.other 6) else Hw p

theorem Hw1_rT : Hw1 rT = some .tcb := by unfold Hw1; rw [if_pos rfl]
theorem Hw1_rS : Hw1 rS = some (.sc 7) := by unfold Hw1; rw [if_neg (by decide), if_pos rfl]
theorem Hw1_rC : Hw1 rC = some (.other 6) := by unfold Hw1; rw [if_neg (by decide), if_neg (by decide), if_pos rfl]
theorem Hw1_old {p : U64} (h1 : p ≠ rT) (h2 : p ≠ rS) (h3 : p ≠ rC) : Hw1 p = Hw p := by
  unfold Hw1; rw [if_neg h1, if_neg h2, if_neg h3]
theorem Hw1_idT : Hw1 idT = some .tcb := by rw [Hw1_old (by decide) (by decide) (by decide)]; exact Hw_idT
theorem Hw1_idS : Hw1 idS = some (.sc 7) := by rw [Hw1_old (by decide) (by decide) (by decide)]; exact Hw_idS

theorem Hw1_some {p : U64} {k : HKind} (h : Hw1 p = some k) :
    (p = rT ∧ k = .tcb) ∨ (p = rS ∧ k = .sc 7) ∨ (p = rC ∧ k = .other 6) ∨
      (p ≠ rT ∧ p ≠ rS ∧ p ≠ rC ∧ Hw p = some k) := by
  by_cases e1 : p = rT
  · subst e1; rw [Hw1_rT] at h; cases h; exact Or.inl ⟨rfl, rfl⟩
  by_cases e2 : p = rS
  · subst e2; rw [Hw1_rS] at h; cases h; exact Or.inr (Or.inl ⟨rfl, rfl⟩)
  by_cases e3 : p = rC
  · subst e3; rw [Hw1_rC] at h; cases h; exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
  rw [Hw1_old e1 e2 e3] at h
  exact Or.inr (Or.inr (Or.inr ⟨e1, e2, e3, h⟩))

/-- **`Hw1`'s objects by position.** -/
theorem Hw1_pos {p : U64} {k : HKind} (h : Hw1 p = some k) :
    (p.val = 18446744071562100736 ∧ k = .tcb) ∨ (p.val = 18446744071562104832 ∧ k = .sc 7) ∨
    (p.val = 18446744071562108928 ∧ k = .other 6) ∨
    (p.val = 18446744071562072064 ∧ k = .tcb) ∨ (p.val = 18446744071562096640 ∧ k = .sc 7) ∨
    (k = .other 12 ∧ (p.val = 18446744071562084352 ∨ p.val = 18446744071562088448 ∨
      p.val = 18446744071562092544)) ∨
    (k = .other 5 ∧ 18446744071562080256 ≤ p.val ∧ p.val < 18446744071562084352 ∧ p.val % 32 = 0) ∨
    (k = .other 5 ∧ 18446744071562133504 + 1248 ≤ p.val ∧ p.val < 18446744071562133504 + 5344 ∧
      (p.val - 18446744071562133504) % 32 = 0) ∨
    (k = .other 3 ∧ 18446744071562133504 ≤ p.val ∧ p.val < 18446744071562133504 + 13568 ∧
      (p.val - 18446744071562133504) % 8 = 0 ∧
      ¬ (18446744071562133504 + 1248 ≤ p.val ∧ p.val < 18446744071562133504 + 5344)) := by
  rcases Hw1_some h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨-, -, -, h'⟩
  · exact Or.inl ⟨rfl, rfl⟩
  · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
  · exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
  · right; right; right; exact Hw_pos h'

/-- **The richer witness's ghost sets** (module docstring). -/
def Zw1 : XSets := ⟨thW1, G1, ∅, ∅, ∅, ∅, ∅, ∅, T1, C1, ∅, ∅, ∅, 0#u64, ∅⟩

theorem Zw1_vx : VxE Zw1 := ⟨rfl⟩

end

end Fl4Proofs.P3.JBootQ
