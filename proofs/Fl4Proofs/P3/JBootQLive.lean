/-
**p3J gen 7 copy** of JBootLive (namespace `JBootQ`, generated by scratch/p3J/genQ.py): the same proofs at
`JBootQ.w0` / `JBootQ.fInitASt` (FL4's boot IRQ layout: line 125 `IRQ_TIMER`, 126 / 127 `IRQ_IPI`; spec 125
`irqTimer`, 126 / 127 `irqReserved`). Original docstring:

P3 (line jboot, gen 3): **the liveness bundle and the `JCarry` facts at the witness** (`w0`, `fInitASt`, the
ghosts of JBootZ).

* **`ioc_false`**: no slot of `fInitASt` is original (`initIoc`: `initKheap` holds only null caps).
* **`w0_liveJ`** (`LiveJ`: no slot in use, core 0's debug list empty, no zombie), **`w0_dbgWF`** (`DbgWF` with
  empty lists: the idle TCB's debug words zero), **`w0_nullOrig`** (`NullOrig`), hence **`w0_live`**
  (`JAtZ.live`, `LiveDN`).
* **`w0_vsNamed`** (`VsNamed`: the ASID table is zero, so no walk starts; every slot null),
  **`w0_archFit`** (`ArchFitHyp`: `Hw`'s `other` objects are at most a page, the spec's global tables a page),
  and the vacuous parts (no buffer word, no untyped cap), hence **`w0_carry`** (`JAtZ.carry`, `JCarry`).

No sorry; no premises. New module; no existing statement changed.
-/
import Fl4Proofs.P3.JBootQZ
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3.JBootQ
open Fl4Proofs.P3.JBoot
open fl4_core Fl4Spec Fl4Proofs.P1 Fl4Proofs.P3 Fl4Proofs.P3.Sched Fl4Proofs.P2.Wit Classical

noncomputable section

set_option maxHeartbeats 1000000

/-! ## No original cap -/

/-- **No slot of the witness's spec state is original.** -/
theorem ioc_false (sl : CslotPtr) : fInitASt.isOriginalCap sl = false := by
  obtain ⟨a, b⟩ := sl
  show initIoc (a, b) = false
  unfold initIoc
  apply decide_eq_false
  rintro ⟨obj, hk, cap, hc, hne⟩
  apply hne
  rcases bootHeap_init.obj _ _ hk with rfl | rfl | rfl | rfl | rfl | rfl
  · rw [initKheap_idleT] at hk; cases hk
    simp only [Fl4Spec.capOf, idleTcbV, tcbCnodeMap, Function.update_apply] at hc
    split_ifs at hc <;> first | (cases hc; rfl) | cases hc
  · rw [initKheap_idleS] at hk; cases hk; simp [Fl4Spec.capOf] at hc
  · simp only [Fl4Spec.capOf, emptyCnode] at hc; split_ifs at hc <;> first | (cases hc; rfl) | cases hc
  all_goals simp [Fl4Spec.capOf] at hc

theorem notInUse {y : U64} (hy : IsSlot thW y) : ¬ InUse (wL.mem w0) fInitASt y := by
  rintro (h | ⟨x, -, hx⟩)
  · exact h (capV_slot hy)
  · rw [ioc_false] at hx; cases hx

/-! ## The debug list -/

theorem dbgHead_w0 : dbgHead (L := wL) w0 = 0#u64 := by
  show nodeW wst w0 0#u64 layout.node.DEBUG_TCBS = 0#u64
  rw [show layout.node.DEBUG_TCBS = 88#u64 by unfold layout.node.DEBUG_TCBS; rfl, nodeW_v _ (by decide) (by decide)]
  decide

theorem dbgNth_zero (m : U64 → U64) : ∀ n, dbgNth m n 0#u64 = 0#u64
  | 0 => rfl
  | n + 1 => by simp [dbgNth]

theorem dn_w0 : wL.mem w0 (dnA idT) = 0#u64 := by
  unfold dnA; rw [tcbW_v _ (by decide) (by decide)]; decide

theorem dp_w0 : wL.mem w0 (dpA idT) = 0#u64 := by
  unfold dpA; rw [tcbW_v _ (by decide) (by decide)]; decide

theorem Hw_tcb {y : U64} (h : Hw y = some .tcb) : y = idT := by
  rcases Hw_some h with ⟨e, -⟩ | ⟨-, e⟩ | ⟨e, -⟩ | ⟨e, -⟩ | h5
  · exact e
  · cases e
  · cases e
  · cases e
  · rcases ksH_some h5 with ⟨e, -⟩ | ⟨e, -⟩ <;> cases e

/-! ## `LiveDN` -/

/-- **`LiveJ` at the witness.** -/
theorem w0_liveJ : LiveJ (L := wL) thW Hw Gw w0 fInitASt where
  slots q i hs hu := absurd hu (notInUse ⟨q, i, hs, rfl⟩)
  dbg n h := by rw [dbgHead_w0, dbgNth_zero] at h; exact absurd rfl h
  zslots y hy p zt n h := by rw [capV_slot hy] at h; cases h
  zdead y hy p zt n h := by rw [capV_slot hy] at h; cases h

/-- **`DbgWF` at the witness** (empty lists). -/
theorem w0_dbgWF : DbgWF (Heap.tcbs Hw) Csw (wL.mem w0) (dbgHd (L := wL) w0) := by
  refine ⟨fun _ => [], ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro c hc
    rw [Csw, Set.mem_singleton_iff] at hc; subst hc
    exact dbgHead_w0
  · intro c _ x hx; cases hx
  · intro c _ x hx; cases hx
  · intro c _; exact List.nodup_nil
  · intro c _ h; cases h
  · intro c _ x hx; cases hx
  · intro y hy _
    have e := Hw_tcb hy
    subst e
    exact ⟨dn_w0, dp_w0⟩

/-- **`NullOrig` at the witness.** -/
theorem w0_nullOrig : NullOrig thW (wL.mem w0) fInitASt := fun sl _ _ => ioc_false sl

/-- **`JAtZ.live` at the witness.** -/
theorem w0_live : LiveDN (L := wL) thW Hw Csw Gw w0 fInitASt := ⟨w0_liveJ, w0_dbgWF, w0_nullOrig⟩

/-! ## `JCarry` -/

theorem atA_w0 (hi : U64) (h : hi.val < 2048) : wL.mem w0 (Vs.atA fkb hi) = 0#u64 := by
  have hv : (Vs.atA fkb hi).val = 18446744071562133504 + 288000 + 8 * hi.val := by
    unfold Vs.atA
    simp [core.num.U64.wrapping_add_val_eq, core.num.U64.wrapping_mul_val_eq, U64.size_def, U64.numBits, fkb_val]
    omega
  rw [mem_al hv (by omega)]; img0

/-- No VSpace walk starts at the witness (the ASID table is zero). -/
theorem vsPath_none {k : Nat} {q : U64} {a v : Nat} (h : Vs.VsPath (wL.mem w0) fkb k q a v) : False := by
  induction h with
  | tbl hi hne => exact hne (atA_w0 _ hi)
  | pool _ _ _ _ ih => exact ih
  | l4 _ _ _ ih => exact ih
  | l3 _ _ _ _ ih => exact ih
  | l2 _ _ _ _ ih => exact ih

/-- **`VsNamed` at the witness.** -/
theorem w0_vsNamed : Vs.VsNamed thW (wL.mem w0) fkb where
  named k q a v h := (vsPath_none h).elim
  uref y y' hy _ _ hn := by rw [capV_slot hy] at hn; exact absurd rfl hn
  uun y y' hy _ _ ht := by rw [capV_slot hy] at ht; cases ht
  empty y hy ht := by rw [capV_slot hy] at ht; cases ht
  poolT y hy q b h := by rw [capV_slot hy] at h; cases h

/-- The spec's arch objects of the witness: the three global tables. -/
theorem fInit_arch {o : ObjRef} {ao : ArchKernelObj} (h : fInitASt.kheap o = some (.archObj ao)) :
    ao = .pageMapL4 globalPml4 ∨ ao = .pdPointerTable globalPdpt ∨ ao = .pageDirectory globalPd := by
  have B := bootHeap_fInit
  rcases B.obj _ _ h with rfl | rfl | e | e | e | e
  · have h2 : fInitKheap idleThreadPtr = some (.archObj ao) := h
    rw [B.tcb] at h2; cases h2
  · have h2 : fInitKheap idleScPtr = some (.archObj ao) := h
    rw [B.sc] at h2; cases h2
  · cases e
  · cases e; exact Or.inl rfl
  · cases e; exact Or.inr (Or.inl rfl)
  · cases e; exact Or.inr (Or.inr rfl)

/-- **`ArchFitHyp` at the witness.** -/
theorem w0_archFit : ArchFitHyp Hw fInitASt := by
  intro o ao n hk hH
  have hn : n ≤ 12 := by
    rcases Hw_pos hH with ⟨-, e⟩ | ⟨-, e⟩ | ⟨e, -⟩ | ⟨e, -⟩ | ⟨e, -⟩ | ⟨e, -⟩ <;> cases e <;> omega
  rcases fInit_arch hk with rfl | rfl | rfl <;> (refine le_trans hn ?_; decide)

/-- **`JAtZ.carry` at the witness.** -/
theorem w0_carry : JCarry (L := wL) Zw Hw Csw w0 fInitASt where
  bufPg wp hw := hw.elim
  archFit := w0_archFit
  devApart x hx := by cases hx
  devSep x hx := by cases hx
  vsTyp y hy := by
    show Vs.TabR _ (capV (wL.mem w0) y)
    rw [capV_slot hy]; trivial
  devTab x hx := by cases hx
  vsNamed _ := w0_vsNamed

end

end Fl4Proofs.P3.JBootQ
