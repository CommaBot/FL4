/-- One step of `rec_del`, its recursive calls keeping the invariant. -/
theorem ys_recDelF {f : RecDelCall → NonDet (State Unit) (Except Unit (Bool × Cap))}
    (hrec : ∀ k, YSK L (f k)) (k : RecDelCall) : YSKE L (recDelF (Z := Unit) f k) := by
  have hrec' : ∀ k, YSKE L (ε := Unit) (f k : NonDetE (State Unit) Unit (Bool × Cap)) := hrec
  cases k with
  | cTEDeleteCall sl e => unfold recDelF withoutPreemption; ys_auto; all_goals exact hrec' _
  | finaliseSlotCall sl e => unfold recDelF withoutPreemption; ys_auto; all_goals exact hrec' _
  | reduceZombieCall c sl e =>
    unfold recDelF withoutPreemption
    split <;> ys_auto
    all_goals exact hrec' _

theorem ys_recDel (c : RecDelCall) : YSKE L (recDel (Z := Unit) c) := by
  unfold recDel
  exact ik_lfp (fun f hf k => ys_recDelF hf k) c
