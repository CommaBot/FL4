/-
P3 (line stpost, generation 3): **the ReplyRecv fast path's invocation with the stable-ghost post**.

The fast path accepts ReplyRecv only when the cap in the REPLY register is a Reply cap
(`P1.RCaps`, StPostRRLink: `RCaps.replyLookup` gives `cspace.lookup_slot … = ok (.Ok found)` and
`obj.Slot.cap st found.slot s = ok (.Reply rptr g)`). The general path's `handle_invocation`
(`is_call = false`, `blocking = false`: the ReplyRecv arm of `dispatch_syscall`) then decodes only
that cap, so its post keeps the entry's `H` and `Cs` (no Untyped retype, finding 5 of the handoff).

* `handle_invocation_refinesMXPF`: XTopJointEntry's `handle_invocation_refinesMXP` with the lookup
  fixed by `hls` (generated by `scratch/stpost/gen_inv.py`): the lookup-fault premise `hFL` is gone
  and `hDec` is asked only at the found slot (`found.slot = cslotAddr sl`).
* `JStabM`: `JStab Z H Cs` with `MR` at the spec state (the stable `JAtM`).
* `JAtZ.flTailJStF`: `JAtZ.flTailJ`'s non-call tail with the post `JStab Z H Cs`.
* `handle_invocation_replyJSt`: the invocation of the Reply cap at `J` (`replyLeafJSt` with
  `runTmoP_recvSt`, `decode_replyDMX`, `MR` by `XCapP.mr`), post `HIPostMXP JStabM False`: the
  preempted outcome is excluded (`XP := False`). Premises: the platform facts `replyLeafJ` and
  `decOK_JMM` take ([P] `hA`, `hmax`, `htu`, `hmb`, `hM`, `hKD`), `Entered σ`, `MR` at the entry.
  No new [J]/[W] premise.
-/
import Fl4Proofs.P3.StPostTmo
import Fl4Proofs.P3.StPostRRLink
import Fl4Proofs.P3.XTopJointKEntry38
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
open Fl4Proofs.P3.SInvR.G4

noncomputable section

section StInvA
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)

/-- (stpost) **`handle_invocation_refinesMXP` with the lookup's result known** (module docstring). -/
theorem handle_invocation_refinesMXPF (X XP : S → A → Fl4Spec.State Unit → Prop) (rep : Bool) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (th : TypedHeap) (G : MdbGhost)
    (hP : Placed th) (hCR : CRel th (L.mem s) σ G) (hFI : FinInv th (L.mem s) σ G)
    (hDR : DomRel (L.mem s) (L.ksb s) σ) (hFR : MdbOKV (L.ksb s) (L.mem s) G)
    (hX0 : X s ar σ)
    (ct : U64) (hct : sched.cur_thread st s = ok ct) (hcur : σ.curThread = ct.bv) (htcb : th ct = some .tcb)
    (is_call blocking can_donate first_phase : Bool) (cptr : U64)
    (found : cspace.Resolved) (hls : cspace.lookup_slot st s ct cptr = ok (.Ok found))
    -- the front end's reads (`HIRead`)
    (info : msginfo.MessageInfo) (hinfo : msg.msg_info st s ct = ok info)
    (mi : Fl4Spec.MessageInfo) (hmi : Fl4Spec.getMessageInfo (Z := Unit) ct.bv σ = ({(mi, σ)}, False))
    (buf : U64) (hbuf : msg.lookup_ipc_buffer st s false ct = ok buf)
    (buffer : Option Fl4Spec.ObjRef)
    (hbuffer : Fl4Spec.lookupIpcBuffer (Z := Unit) false ct.bv σ = ({(buffer, σ)}, False))
    (r2 : core.result.Result (Aeneas.Std.Array obj.Slot 3#usize) error.Fault)
    (hr2 : ipc.lookup_extra_caps st s ct buf info = ok r2)
    (er : Except Fl4Spec.Fault (List (Fl4Spec.Cap × Fl4Spec.CslotPtr)))
    (her : (Fl4Spec.lookupExtraCaps (Z := Unit) ct.bv buffer mi).run σ = ({(er, σ)}, False))
    (hrr : (∃ e exs, r2 = .Ok e ∧ er = .ok exs) ∨
      (∃ f f', r2 = .Err f ∧ er = .error f' ∧ (blocking = true → faults.handle_fault st arI s ar ct f ⦃ r =>
        ∃ z ∈ (Fl4Spec.handleFault (Z := Unit) ct.bv f' σ).1, RelTopM (L := L) r.1 z.2 ∧ X r.1 r.2 z.2 ⦄)))
    (args : List Fl4Spec.Data) (hmrs : Fl4Spec.getMrs (Z := Unit) ct.bv buffer mi σ = ({(args, σ)}, False))
    -- the success tail (from `X` with the invoker still current) and the error reply (at the entry state)
    (hRepS : ∀ (s1 : S) (a1 : A) (σ' : Fl4Spec.State Unit), RelTopM (L := L) s1 σ' → X s1 a1 σ' →
      σ'.curThread = ct.bv → flTail (st := st) ct is_call s1 a1 ⦃ res => res.1 = .Ok () ∧
        ∃ z ∈ (specTail is_call ct.bv [] σ').1, RelTopM (L := L) res.2.1 z.2 ∧ X res.2.1 res.2.2 z.2 ⦄)
    (hRepF : ∀ (a1 : A) (e : error.SysError) (e' : Fl4Spec.SyscallError), X s a1 σ → ErrRel (.Sys e) e' →
      ((if is_call then do
          let s2 ← syscall.reply_error st s ct e
          ok ((core.result.Result.Ok () : core.result.Result Unit error.Exc), s2, a1)
        else ok ((core.result.Result.Ok () : core.result.Result Unit error.Exc), s, a1)) :
        Result ((core.result.Result Unit error.Exc) × S × A)) ⦃ res =>
        res.1 = .Ok () ∧ ∃ z ∈ ((Fl4Spec.NonDet.when is_call <|
          Fl4Spec.fl4ReplyFromKernelError rep ct.bv (Fl4Spec.msgFromSyscallError e')) σ).1,
          RelTopM (L := L) res.2.1 z.2 ∧ X res.2.1 res.2.2 z.2 ⦄)
    -- the invocation keeps the current thread
    (hPK : ∀ inv σ1 y, Fl4Spec.setThreadState (Z := Unit) σ.curThread .restart σ = ({((), σ1)}, False) →
      y ∈ ((Fl4Spec.fl4PerformInvocation (Z := Unit) blocking is_call can_donate inv).run σ1).1 →
      y.2.curThread = ct.bv)
    -- the decode and invocation of the cap
    (hDec : ∀ (sl : Fl4Spec.CslotPtr) (c : capability.Cap) (e : Aeneas.Std.Array obj.Slot 3#usize)
      (exs : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)), (∃ p, sl.1 = p.bv ∧ th p = some (.cnode sl.2.length)) →
      found.slot = cslotAddr sl →
      capAt (L.mem s) (cslotAddr sl) = ok c →
      Fl4Spec.getCap (Z := Unit) sl σ = ({(absCap c, σ)}, False) → r2 = .Ok e → er = .ok exs →
      XCapP (L := L) arI X XP s ar σ info.label (msgLen info buf) (cslotAddr sl) c blocking is_call can_donate
        first_phase buf e mi.miLabel args (Fl4Spec.toBl cptr.bv) sl exs buffer ct) :
    syscall.handle_invocation st arI s ar is_call blocking can_donate first_phase cptr ⦃ res =>
      HIPostMXP (L := L) X XP rep σ is_call blocking can_donate first_phase (Fl4Spec.toBl cptr.bv) res ⦄ := by
  have hRT0 : RelTopM (L := L) s σ := ⟨th, G, hP, hCR, hFI, hDR, hFR⟩
  unfold syscall.handle_invocation
  rw [hct]; simp only [bind_ok, hinfo]
  have hLR := lookup_slot_refines (Z := Unit) th s σ hCR.1 hCR.2.1 ct htcb cptr
  rw [hls, WP.spec_ok] at hLR
  obtain ⟨e, he, hrel, hok⟩ := hLR
  rw [hls]; simp only [bind_ok]
  cases e with
    | error lf' => exact hrel.elim
    | ok v =>
      obtain ⟨sl, rest⟩ := v
      obtain ⟨hsl, -⟩ := hrel
      obtain ⟨p, hp, hth, -⟩ := hok
      obtain ⟨c, a, hc, hca, hget⟩ := hCR.1.slot_cap hp hth
      have hl : (Fl4Spec.lookupCapAndSlot (Z := Unit) ct.bv (Fl4Spec.toBl cptr.bv)).run σ =
          ({(.ok (a, sl), σ)}, False) := by
        unfold Fl4Spec.lookupCapAndSlot
        rw [run_bind_ok he]
        simp only
        rw [run_bind_ok (run_liftE hget)]
        rfl
      try simp only
      rw [slot_cap_eq, hsl, hc]
      simp only [bind_ok, hbuf, hr2]
      rcases hrr with ⟨ex, exs, rfl, rfl⟩ | ⟨f, f', rfl, rfl, hfh⟩
      · simp only
        rw [msgLen_eq]; simp only [bind_ok]
        have hca' : absCap c = a := hca.2
        subst hca'
        have hmF := hiMF_ok (mi := mi) hl hbuffer her
        have hmE := hiME_run (cptr := Fl4Spec.toBl cptr.bv) (fp := first_phase) (a := absCap c) (sl := sl)
          (exs := exs) hmrs
        rcases hDec sl c ex exs ⟨p, hp, hth⟩ hsl hc hget rfl rfl with hD | hD
        swap
        · refine WP.spec_bind hD ?_
          rintro ⟨r3, s1, a1⟩ (⟨e3, he3, hs1, ⟨e', hdec, herr⟩, hXe⟩ | ⟨hok3, hne, inv, hdec, σ1, hst, rr, σy, hy, z, hz, hRT, hXz⟩)
          · simp only at he3 hs1
            subst he3 hs1
            cases e3 with
            | Sys e2 =>
              refine WP.spec_mono (hRepF a1 e2 e' hXe herr) ?_
              rintro res ⟨hres, z, hz, hRT, hXz⟩
              exact ⟨(.ok z.1, z.2), hi_memR rep hcur hmi (mem_syscall_err hmF (by rw [hmE, hdec]; rfl) hz),
                Or.inl ⟨hres, rfl⟩, hRT, ifP_ok hres hXz⟩
            | Fault _ => exact absurd herr (by rintro (h | ⟨n, h, -⟩) <;> cases h)
            | Lookup _ => exact absurd herr (by rintro (h | ⟨n, h, -⟩) <;> cases h)
            | Preempted => exact absurd herr (by rintro (h | ⟨n, h, -⟩) <;> cases h)
          simp only at hok3; subst hok3
          refine WP.spec_bind (tcb_state_spec' (st := st) s1 ct) ?_
          rintro v rfl
          rw [if_neg hne]
          refine (WP.spec_ok _).2 ?_
          exact ⟨(.ok z.1, z.2), hi_memR rep hcur hmi (mem_syscall_fin hmF (by rw [hmE]; exact hdec.1)
            (hiMFin_ok (by rw [← hcur]; exact hst) hy hz)), Or.inl ⟨rfl, rfl⟩, hRT, ifP_ok rfl hXz⟩
        refine WP.spec_bind hD ?_
        rintro ⟨r3, s1, a1⟩ hq
        rcases hq with ⟨e3, he3, hs1, ⟨e', hdec, herr⟩, hXe⟩ |
            ⟨inv, hdec, σ1, hst, y, hy, ⟨th', G', hcase, hP', hCR', hFI', hDR', hFR'⟩, hXy⟩
        · simp only at he3 hs1
          subst he3 hs1
          cases e3 with
          | Sys e2 =>
            refine WP.spec_mono (hRepF a1 e2 e' (ifP_X (r := .Err (.Sys e2)) (fun h => by cases h) hXe) herr) ?_
            rintro res ⟨hres, z, hz, hRT, hXz⟩
            exact ⟨(.ok z.1, z.2), hi_memR rep hcur hmi (mem_syscall_err hmF (by rw [hmE, hdec]; rfl) hz),
              Or.inl ⟨hres, rfl⟩, hRT, ifP_ok hres hXz⟩
          | Fault _ => exact absurd herr (by rintro (h | ⟨n, h, -⟩) <;> cases h)
          | Lookup _ => exact absurd herr (by rintro (h | ⟨n, h, -⟩) <;> cases h)
          | Preempted => exact absurd herr (by rintro (h | ⟨n, h, -⟩) <;> cases h)
        · rcases hcase with ⟨hok3, hyr⟩ | ⟨hpre, hyr⟩
          · simp only at hok3
            subst hok3
            refine WP.spec_mono (hRepS s1 a1 y.2 ⟨th', G', hP', hCR', hFI', hDR', hFR'⟩ (ifP_X (r := .Ok ()) (fun h => by cases h) hXy)
              (hPK inv σ1 y hst hy)) ?_
            rintro res ⟨hres, z, hz, hRT, hXz⟩
            obtain ⟨y1, y2⟩ := y
            simp only at hyr; subst hyr
            exact ⟨(.ok z.1, z.2), hi_memR rep hcur hmi (mem_syscall_fin hmF (by rw [hmE]; exact hdec.1)
              (hiMFin_ok (by rw [← hcur]; exact hst) hy hz)), Or.inl ⟨hres, rfl⟩, hRT, ifP_ok hres hXz⟩
          · simp only at hpre
            subst hpre
            refine (WP.spec_ok _).2 ?_
            obtain ⟨y1, y2⟩ := y
            simp only at hyr; subst hyr
            exact ⟨(.error (), y2), hi_memR rep hcur hmi (mem_syscall_fin hmF (by rw [hmE]; exact hdec.1)
              (hiMFin_pre (by rw [← hcur]; exact hst) hy)), Or.inr ⟨rfl, rfl⟩,
              ⟨th', G', hP', hCR', hFI', hDR', hFR'⟩, hXy⟩
      · simp only
        have hmF := hiMF_extra_err (cptr := Fl4Spec.toBl cptr.bv) hl hbuffer her
        cases blocking
        · simp only [Bool.false_eq_true, ↓reduceIte, WP.spec_ok]
          exact ⟨(.ok (), σ), hi_memR rep hcur hmi (mem_syscall_fault (z := ((), σ)) hmF
            (mem_when (fun h => by cases h) (fun _ => rfl))), Or.inl ⟨rfl, rfl⟩, hRT0, ifP_ok rfl hX0⟩
        · simp only [↓reduceIte]
          refine WP.spec_bind (hfh rfl) ?_
          rintro ⟨s1, a1⟩ ⟨z, hz, hRT, hXz⟩
          refine (WP.spec_ok _).2 ?_
          exact ⟨(.ok z.1, z.2), hi_memR rep hcur hmi (mem_syscall_fault hmF (mem_when (fun _ => hz) (fun h => by cases h))),
            Or.inl ⟨rfl, rfl⟩, hRT, ifP_ok rfl hXz⟩

end StInvA

section StInvB
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {MR : A → Fl4Spec.MachineState → Prop}

/-- (stpost) **`JStab` with `MR` at the spec state** (module docstring). -/
abbrev JStabM (arI : machine.Arch A) (AR : A → Fl4Spec.Cr3 → Prop) (MR : A → Fl4Spec.MachineState → Prop)
    (Z : XSets) (H : P1.Heap) (Cs : Set U64) (s : S) (a : A) (σ : Fl4Spec.State Unit) : Prop :=
  JStab (L := L) arI AR Z H Cs s a σ ∧ MR a σ.machineState

set_option maxHeartbeats 16000000 in
/-- (stable ghosts, `JStab`) **FL4's non-call success tail for an empty result at `J`**
(`JAtZ.flTailJ`'s `call = false` branch). -/
theorem JAtZ.flTailJStF {s : S} {a : A} {σ : Fl4Spec.State Unit}
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (hcur : σ.curThread = ct.bv) :
    flTail (st := st) ct false s a ⦃ res => res.1 = .Ok () ∧
      ∃ z ∈ (specTail false ct.bv [] σ).1, RelTopM (L := L) res.2.1 z.2 ∧
        JStab (L := L) arI AR Z H Cs res.2.1 res.2.2 z.2 ⦄ := by
  have hct : ct ∈ Z.T := TopSR.cur_mem J.xtop.fin.1 hcur.symm
  obtain ⟨htcb, x, hk⟩ := J.xtop.curTcb hcur
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨x0, hk0, hTR⟩ := hI.1.tcb ct hct
  rw [hk] at hk0; cases hk0
  have hst : (L.mem s (tStA ct)).val = tsCode x.tcbState := hTR.st
  have hss : (L.mem s (P1.stA ct)).val = tsCode x.tcbState := by rw [P1.stA_eq, ← tStA_eq, hst]
  unfold flTail
  refine WP.spec_bind (tcb_state_spec' (st := st) s ct) ?_
  rintro i rfl
  by_cases hr : L.mem s (stA ct) = sched.TS_RESTART
  · rw [if_pos hr]
    have hrs : x.tcbState = .restart := by
      apply tsCode_two
      rw [← hss]
      show (L.mem s (stA ct)).val = 2
      rw [hr]; unfold sched.TS_RESTART; rfl
    rw [specTail_nil hk false, if_pos hrs]
    simp only [Bool.false_eq_true, ↓reduceIte, bind_ok]
    refine WP.spec_bind (J.runJ hct hk hrs) ?_
    rintro s2 ⟨Lst', D', J2⟩
    refine (WP.spec_ok _).2 ⟨rfl, ((), stsAct (updK σ ct.bv (.tcb { x with tcbState := .running })) ct.bv), ?_,
      J2.xtop.relTop, J2.stab⟩
    rw [Notif.setThreadState_eq .running hk]; exact Set.mem_singleton _
  · rw [if_neg hr]
    have hrs : x.tcbState ≠ .restart := by
      intro h
      apply hr
      apply UScalar.eq_of_val_eq
      show (L.mem s (P1.stA ct)).val = _
      rw [hss, h]; unfold sched.TS_RESTART; rfl
    refine (WP.spec_ok _).2 ⟨rfl, ((), σ), ?_, J.xtop.relTop, J.stab⟩
    rw [specTail_nil hk false, if_neg hrs]; exact Set.mem_singleton _

set_option maxHeartbeats 8000000 in
/-- (stpost) **The ReplyRecv arm's invocation of a Reply cap at `J`, stable ghosts**
(module docstring): `handle_invocation false false don fp cptr`, the cap at `cptr` known to be
`Reply rptr g` (`hls`, `hcap`; StPostRRLink's `RCaps.replyLookup`), ends at `JStabM Z H Cs` at
the chosen spec outcome and never in `Preempted` (`XP := False`). -/
theorem handle_invocation_replyJSt [Fl4Proofs.P1.PlainStore st] (s : S) (ar : A)
    (σ : Fl4Spec.State Unit) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s ar σ) [VxE Z]
    (hA : P0.ArchTotal arI) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv)
    (htu : ∀ (a : A) v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄)
    (hmb : ∀ a : A, sporadic.min_budget arI a ⦃ mb => mb.bv = Fl4Spec.MIN_BUDGET ⦄)
    (hM : MachPlat arI MR) (hKD : MRKeepD arI MR) (hni : Entered σ) (hR : MR ar σ.machineState)
    (ct : U64) (hct : sched.cur_thread st s = ok ct) (can_donate first_phase : Bool) (cptr : U64)
    (found : cspace.Resolved) (hls : cspace.lookup_slot st s ct cptr = ok (.Ok found))
    {rptr : U64} {g : Bool} (hcap : obj.Slot.cap st found.slot s = ok (.Reply rptr g)) :
    syscall.handle_invocation st arI s ar false false can_donate first_phase cptr ⦃ res =>
      HIPostMXP (L := L) (JStabM (L := L) arI AR MR Z H Cs) (fun _ _ _ => False) true σ false false can_donate
        first_phase (Fl4Spec.toBl cptr.bv) res ⦄ := by
  obtain ⟨info, mi, buf, buffer, r2, er, argsU, hinfo, hmi, hbuf, hbuffer, hr2, her, hmrs⟩ :=
    JAtZ.frontEx arI J J.xferH.1 J.xferH.2.1 hct
  obtain ⟨hcur, -⟩ := J.curEq hct
  have htcb := (J.xtop.curTcb hcur).1
  have hX := J.xtop
  refine handle_invocation_refinesMXPF arI (JStabM (L := L) arI AR MR Z H Cs) (fun _ _ _ => False) true s ar σ
    Z.th Z.G hX.rel.1 hX.rel.2.1 hX.rel.2.2.1 hX.rel.2.2.2.1 hX.rel.2.2.2.2.1 ⟨J.stab, hR⟩ ct hct hcur htcb
    false false can_donate first_phase cptr found hls info hinfo mi hmi buf hbuf buffer hbuffer r2 hr2 er her
    ((J.extraJ J.xferH.1 J.xferH.2.1 hct hinfo hmi hbuf
      hbuffer hr2 her).imp id fun ⟨f, f', h1, h2, _⟩ => ⟨f, f', h1, h2, fun h => by cases h⟩)
    (argsU.map UScalar.bv) hmrs
    (fun s1 a1 σ' _ hXs hc => by
      obtain ⟨⟨_, _, _, _, _, J'⟩, hR'⟩ := hXs
      exact WP.spec_mono (WP.spec_and (J'.flTailJStF hc) (MKD.fl_tail L.total hA hKD hR'))
        fun _ ⟨⟨h1, z, hz, h2, h3⟩, h4⟩ => ⟨h1, z, hz, h2, h3.mv, msF_mr hM h4
          (congrArg Prod.fst (MachT.mtk_specTailG _ _ _ σ' z hz))⟩)
    (fun a1 e e' hX1 _ => by
      simp only [Bool.false_eq_true, ↓reduceIte]
      exact (WP.spec_ok _).2 ⟨rfl, ((), σ), mem_whenP (fun h => h.elim) (fun _ => rfl), hX.relTop, hX1⟩)
    (fun inv σ1 y hst hy => by
      rw [perfCurKeep _ _ _ inv σ1 y hy]
      obtain ⟨x, hk⟩ := (J.xtop.curTcb hcur).2
      rw [hcur] at hst
      have hm : ((), σ1) ∈ (Fl4Spec.setThreadState (Z := Unit) ct.bv .restart σ).1 := by
        rw [hst]; exact Set.mem_singleton _
      rw [Notif.setThreadState_eq .restart hk] at hm
      have e : σ1 = _ := congrArg Prod.snd (Set.mem_singleton_iff.1 hm)
      rw [e, Sched.stsAct_rec]; exact hcur) ?_
  intro sl c e exs hsl hfs hc hget _ _
  have hc' : c = .Reply rptr g := by
    rw [slot_cap_eq, hfs, hc] at hcap; exact ok_inj hcap
  subst hc'
  have hAs : AbsSlot Z.th sl := by
    obtain ⟨p, hp, hth⟩ := hsl; exact ⟨p, hp, Or.inl hth⟩
  obtain ⟨σ1, hst⟩ := XTop.restart (L := L) (show XTop (L := L) AR s ar σ from ⟨Z, J.xtop⟩)
  have hq : QuietF (.Reply rptr g) := by simp [QuietF]
  exact XCapP.mr hM
    (XCap.toPN arI (Or.inl (decode_replyDMX arI _ s ar σ _ _ _ rptr g _ _ _ _ _ _ _ _ _ _ _ _ ct hct hst
      (replyLeafJSt hA hmax htu hmb J hni hct hAs hc hst (runTmoP_recvSt _ hA hmax htu) J.stab)))
      (specDec_noPreK (by trivial)))
    (MKD.decode_quiet L.total hA hKD hq hR (fun _ _ _ h => by cases h))
    (fun inv hd => MachT.dec_quiet _ _ _ _ _ _ _ _ (quietS_of hq) σ _ hd.1 inv rfl)

end StInvB

end

end Fl4Proofs.P3
