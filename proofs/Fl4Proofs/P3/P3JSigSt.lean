/-
P3 (p3J gen 30): **the notification receive at a resumed entry, at stable ghosts, with its projection footprint**
(the notification leaf of `handle_recv`; the stable copies generated by `scratch/p3J/gen_sigst.py`).

XTopJointRecvSig's `JAtZ.recvSigPollJ` / `JAtZ.recvSigActiveJ`, XTopJointRecvSigBlock's `JAtZ.recvSigBlockJ` and
XTopJointRecvSigRet's `JAtZ.recvSigRetJ` end in `RJ` (`JAt` at existential ghosts) but build their exit
(`J.regWrJ`, `signal_badge_post`, `J.cs_frameI`, `maybeReturnJ`) at `Z.mv Z.G V'` with the entry's `H` and `Cs`.
This file is those proofs verbatim, named `…St`, with the post `RelTopM ∧ JStab Z H Cs` (StPostFault) and the
final packaging adjusted; then:

* **`jRecvSigSt_of`**: XTopJointRecvSigRet's `jRecvSigHyp_of` (every case: polling, active, blocking, blocking
  giving the SC back) with the stable post.
* **`ntfn_epState3`**: the two steps gen 28 left open for its footprint at a `JAtZ` state — a notification of
  the spec heap related at `J` is a notification of `H` (`J.obj.ntfn`, `J.zH`), and its state word is not 3
  (`IRel`'s notification relation: idle 0 / waiting 1 / active 2).
* **`jRecvSigStFt`**: `jRecvSigSt_of` together with gen 28's `Mc.recvSignalProjW` (P1 `BlkOK` from `J.blk`,
  `CanBlock` from `J.canBlockCur`, `HeapOK` from `J.kern.heap`): the receive writes only `ProjW H Cs s`.

No premise; no sorry. New module; no existing statement changed.
-/
import Fl4Proofs.P3.XTopJointRecvSigRet
import Fl4Proofs.P3.StPostFault
import Fl4Proofs.P3.P3JSysRecv
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3

noncomputable section

section
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64}

set_option maxHeartbeats 8000000 in
/-- (p3J gen 30; stable ghosts, `JStab`) **Polling a non-active notification at `J`** (module docstring). -/
theorem JAtZ.recvSigPollJSt {s : S} {a : A} {σ : Fl4Spec.State Unit}
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {t : U64} (ht : t ∈ Z.T)
    {n : U64} (hn : n ∈ Z.N) {x : Fl4Spec.Notification} (hk : σ.kheap n.bv = some (.notification x))
    (hna : ∀ b, x.ntfnObj ≠ .activeNtfn b) (cb : Fl4Spec.Badge) (cr : Fl4Spec.CapRights) :
    notification.receive_signal st arI s a t n false ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveSignal (Z := Unit) t.bv (.notificationCap n.bv cb cr) false σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  have hI := J.xtop.irelK J.ks J.buf
  refine WP.spec_mono (receive_signal_poll_eq (arI := arI) (a := a) hI.1 hn hk hna) ?_
  rintro r rfl
  obtain ⟨xt, hkt, -⟩ := hI.1.tcb t ht
  have hXb := badge_wr_irel J.ip hI ht hkt 0#u64
  rw [badgeRegA_eq_regA] at hXb
  obtain ⟨V1, J1⟩ := J.regWrJ ht hkt Fl4Spec.badge_register 0#u64 hXb
  have hspec : Fl4Spec.receiveSignal (Z := Unit) t.bv (.notificationCap n.bv cb cr) false σ =
      ({((), updK σ t.bv (.tcb (setReg xt Fl4Spec.badge_register (0#u64 : U64).bv)))}, False) := by
    rw [receiveSignal_notActive hk hna]
    unfold Fl4Spec.receiveSignalBlocked Fl4Spec.doNbrecvFailedTransfer
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [nd_bind_one (asUser_setRegister_eq _ _ hkt)]
    rfl
  rw [hspec, badgeRegA_eq_regA]
  exact ⟨_, Set.mem_singleton _, J1.xtop.relTop, _, _, _, _, _, J1⟩

set_option maxHeartbeats 16000000 in
/-- (p3J gen 30; stable ghosts, `JStab`) **Receiving from an active notification at `J`** (module docstring): the
current thread, resumed. -/
theorem JAtZ.recvSigActiveJSt (hAT : P0.ArchTotal arI) {s : S} {a : A} {σ : Fl4Spec.State Unit}
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {t : U64} (ht : t ∈ Z.T) (hcur : σ.curThread = t.bv)
    (hni : Entered σ) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    {n : U64} (hn : n ∈ Z.N) {x : Fl4Spec.Notification} (hk : σ.kheap n.bv = some (.notification x))
    {b0 : Fl4Spec.Badge} (hact : x.ntfnObj = .activeNtfn b0) (blk : Bool) (cb : Fl4Spec.Badge)
    (cr : Fl4Spec.CapRights) :
    notification.receive_signal st arI s a t n blk ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveSignal (Z := Unit) t.bv (.notificationCap n.bv cb cr) blk σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  have hI := J.xtop.irelK J.ks J.buf
  have hC : CurInv σ := J.curInv (by rw [hni.2]; intro e; cases e)
  obtain ⟨xt, hkt, -⟩ := hI.1.tcb t ht
  obtain ⟨xc, hkc, hscc, -⟩ := hC.tcb
  rw [hcur, hkt] at hkc; cases hkc
  obtain ⟨ys, ms, hks⟩ := hC.sc
  have hrn : Fl4Spec.runnable xt.tcbState = true := (J.curRun.run hni) xt (by rw [hcur]; exact hkt)
  have hcb := J.canBlockCur ht hcur hkt hrn hni hnq
  -- the badge register
  have hx := hI.1.toN.at_ntfn hn hk
  have hst : stOf (L.mem s) n = obj.NTFN_ACTIVE := stOf_active (T := Z.T) (hact ▸ hx.obj) rfl
  have hb0 : (L.mem s (nBadgeA n)).bv = b0 := by
    have := hx.obj; rw [hact] at this; exact this.2.2
  have hXb := badge_wr_irel J.ip hI ht hkt (L.mem s (nBadgeA n))
  rw [badgeRegA_eq_regA] at hXb
  obtain ⟨V1, J1⟩ := J.regWrJ ht hkt Fl4Spec.badge_register _ hXb
  rw [hb0] at J1
  have hnt : n.bv ≠ t.bv := by intro e; rw [e, hkt] at hk; cases hk
  have hk1 : (updK σ t.bv (.tcb (setReg xt Fl4Spec.badge_register b0))).kheap n.bv = some (.notification x) := by
    simp [updK, hnt, hk]
  -- the notification's state
  have hI1 := J1.xtop.irelK J1.ks J1.buf
  obtain ⟨hR2, hW2, hS2⟩ := set_idle_relI J1.ip hI1.1 hn hk1 hact
  have hSch2 := hI1.2.2.1.stable hW2 hS2
  obtain ⟨Q, R, hc, hs⟩ := hSch2.lists
  obtain ⟨xt2, hkt2, -, -, hsct2, -⟩ := hs.tcb t ht
  have hkt2' : (updK (updK σ t.bv (.tcb (setReg xt Fl4Spec.badge_register b0))) n.bv
      (.notification (Fl4Spec.ntfnObjUpdate (fun _ => .idleNtfn) x))).kheap t.bv =
      some (.tcb (setReg xt Fl4Spec.badge_register b0)) := by
    simp [updK, hnt.symm]
  rw [hkt2'] at hkt2; cases hkt2
  have hsw : optRef (L.mem (recvActS st s t n) (P1.scA t)) = some σ.curSc := hsct2.symm.trans hscc
  have h0 : L.mem (recvActS st s t n) (P1.scA t) ≠ 0#u64 := by
    intro e; rw [e, optRef_zero] at hsw; cases hsw
  have hcw : L.mem (recvActS st s t n) (P1.scA t) =
      Sched.nodeW st (recvActS st s t n) (L.cpu (recvActS st s t n)) layout.node.CUR_SC := by
    apply P1.eq_of_bv
    rw [Notif.optRef_ne h0] at hsw
    rw [Option.some.inj hsw]
    exact hs.curSc.trans (congrArg (fun q => (Sched.nodeW st (recvActS st s t n) q layout.node.CUR_SC).bv) hc.cur).symm
  have heq := spec_eq_ok (receive_signal_active_eq (arI := arI) (a := a) blk hst h0 hcw)
  -- P1's `BlkOK` after
  obtain ⟨⟨Q0, R0, h0'⟩, hB0, hX0, hS0, hSg0⟩ := J.blk
  have p1 := P1.notification.receive_signal.ipc hAT s a t n blk Q0 R0 h0' hB0 hX0 hS0 hSg0 hcb
    (J.zH.2.2.2 n hn) (J.zH.2.2.2 n hn) (by rw [epState_eq, hst, ntfn_consts.2.2]; decide)
  rw [heq, WP.spec_ok] at p1
  simp only [WP.uncurry'_pair] at p1
  -- the notification write at `J`
  have hxw : ∀ l, x.ntfnObj ≠ .waitingNtfn l := fun l h => by rw [hact] at h; cases h
  obtain ⟨σ', V', hsp', -, J2⟩ := J1.signal_badge_post hn hk1 hxw
    (y := Fl4Spec.ntfnObjUpdate (fun _ => .idleNtfn) x) (fun l h => by cases h) rfl rfl rfl
    ⟨_, rfl, hR2, hS2, hW2, NoBlock.ntfnUpd _ _ _⟩ p1
  obtain rfl := (congrArg Prod.snd (Set.singleton_eq_singleton_iff.1 (Prod.mk.inj hsp').1))
  -- the spec's outcome
  have hspec : Fl4Spec.receiveSignal (Z := Unit) t.bv (.notificationCap n.bv cb cr) blk σ =
      specRecvTail t.bv n.bv (updK (updK σ t.bv (.tcb (setReg xt Fl4Spec.badge_register b0))) n.bv
        (.notification (Fl4Spec.ntfnObjUpdate (fun _ => .idleNtfn) x))) := by
    rw [receiveSignal_cap hk]
    simp only [hact]
    rw [nd_bind_one (asUser_setRegister_eq _ _ hkt), nd_bind_one (setNotification_eq _ hk1)]
  have hct : σ.curSc ≠ t.bv := fun e => by rw [e, hkt] at hks; cases hks
  have hcn : σ.curSc ≠ n.bv := fun e => by rw [e, hk] at hks; cases hks
  rw [hspec, specRecvTail_cur hkt2' hscc (y := ys) (m := ms) (by simp [updK, hct, hcn, hks]), heq, WP.spec_ok]
  exact ⟨_, Set.mem_singleton _, J2.xtop.relTop, _, _, _, _, _, J2⟩

end

section
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched Fl4Proofs.P1
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

set_option maxHeartbeats 16000000 in
/-- (p3J gen 30; stable ghosts, `JStab`) **The blocking receive at `J`** (module docstring): the current thread
`t`, resumed and in no ready queue, blocks receiving on the idle or waiting
notification `n`, covered by a cap (`hcov`), whose SC is not the current SC
(`hnr`; otherwise `maybe_return_sched_context` gives it back). -/
theorem JAtZ.recvSigBlockJSt (hAT : P0.ArchTotal arI) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z]
    {t : U64} (ht : t ∈ Z.T) (hcur : σ.curThread = t.bv) (hni : Entered σ)
    (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    {n : U64} (hn : n ∈ Z.N) {x : Fl4Spec.Notification} (hk : σ.kheap n.bv = some (.notification x))
    (hna : ∀ b, x.ntfnObj ≠ .activeNtfn b) (hnr : x.ntfnSc ≠ some σ.curSc)
    (hcov : (∀ k, Z.th n = some k → Covered (L.mem s) Z.G n.val (n.val + max (objSize k) 1)) ∧
      (∀ k, H n = some k → Covered (L.mem s) Z.G n.val (n.val + 2 ^ k.bits)))
    (cb : Fl4Spec.Badge) (rt : Fl4Spec.CapRights) :
    notification.receive_signal st arI s a t n true ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveSignal (Z := Unit) t.bv (.notificationCap n.bv cb rt) true σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  have hI := J.xtop.irelK J.ks J.buf
  have hS := J.xtop.fin.1.1.1
  have hC : CurInv σ := J.curInv (by rw [hni.2]; intro e; cases e)
  have hres : σ.schedulerAction = .resumeCurThread := hni.2
  have hti : σ.curThread ≠ σ.idleThread := hni.1
  obtain ⟨xt, hkt, -⟩ := hI.1.tcb t ht
  obtain ⟨xc, hkc, hscc, -⟩ := hC.tcb
  rw [hcur, hkt] at hkc; cases hkc
  have hr : Fl4Spec.runnable xt.tcbState = true := (J.curRun.run hni) xt (by rw [hcur]; exact hkt)
  have hnr' : ¬ (x.ntfnSc = xt.tcbSchedContext ∧ x.ntfnSc ≠ none) := fun h => hnr (h.1.trans hscc)
  have hnb3 : tsCode xt.tcbState ≠ 3 ∧ tsCode xt.tcbState ≠ 4 := by
    rcases runnable_code hr with h | h | h <;> rw [h] <;> decide
  have hnn : ∀ m, xt.tcbState ≠ .blockedOnNotification m := fun m h => by rw [h] at hr; cases hr
  have hqE : ∀ e ∈ Z.E, ∀ z, σ.kheap e.bv = some (.endpoint z) → t.bv ∉ z.epQueue :=
    fun e he z hz => Endp.not_queued hI.1.toE ht hkt hnb3 e he z hz
  have hnqN : t.bv ∉ Fl4Spec.ntfnQueueOf x := not_member hI.1.toN ht hkt hnn n hn x hk
  have hq : ∀ y ∈ Fl4Spec.ntfnQueueOf x, ∃ z, σ.kheap y = some (.tcb z) := fun y hy => by
    obtain ⟨z, hz, -⟩ := (J.sv.ntfnQ _ _ hk).2 y hy
    exact ⟨z, hz⟩
  obtain ⟨σ', heq, F, hik, -, hcn, hsrt⟩ := recvSigBlock_eq hkt hk hna hnqN hq hr (J.isorted.2 _ _ hk) hnr' cb rt
  have hcn' : σ'.schedulerAction = .chooseNewThread := hcn hcur.symm hres
  -- P1's `BlkOK` after
  have hcb := J.canBlockCur ht hcur hkt hr hni hnq
  obtain ⟨⟨Q0, R0, h0⟩, hB0, hX0, hS0, hSg0⟩ := J.blk
  have hx := hI.1.toN.at_ntfn hn hk
  have hst0 : stOf (L.mem s) n = obj.NTFN_IDLE ∨ stOf (L.mem s) n = obj.NTFN_WAITING := by
    have := hx.obj
    cases h : x.ntfnObj with
    | idleNtfn => exact Or.inl (stOf_idle (T := Z.T) (h ▸ this) rfl)
    | waitingNtfn q => exact Or.inr (stOf_waiting (T := Z.T) (h ▸ this) rfl)
    | activeNtfn b => exact absurd h (hna b)
  have h3 : L.epState s n ≠ 3#u64 := by
    rw [epState_eq]
    rcases hst0 with h | h
    · rw [h, ntfn_consts.1]; decide
    · rw [h, ntfn_consts.2.1]; decide
  have p1 := P1.notification.receive_signal.ipc hAT s a t n true Q0 R0 h0 hB0 hX0 hS0 hSg0 hcb
    (J.zH.2.2.2 n hn) (J.zH.2.2.2 n hn) h3
  refine WP.spec_mono (WP.spec_and (receive_signal_blockF (ar := arI) J.ip s a σ hI ht hkt hnn hqE hn hk hna
    (J.qsortedN n hn) hnr' cb rt) p1) ?_
  rintro ⟨s', a'⟩ ⟨⟨ea, σ0, h0eq, hIR, hRB⟩, hbk⟩
  simp only [WP.uncurry'_pair] at ea hbk hIR hRB
  subst a'
  obtain rfl : σ' = σ0 := by
    have e1 := (Prod.mk.inj (h0eq.symm.trans heq)).1
    exact (congrArg Prod.snd (Set.singleton_eq_singleton_iff.1 e1)).symm
  have hblk := hbk
  have hW : P1.WritesIn st s s' (CnW (st := st) Z.T Z.N Z.C Z.E Z.R Z.c s σ) :=
    hRB.mono fun b hb => RBW.cnW hS hb
  have hDbg := J.rbw_dbg hRB
  -- the assembly (as XTopJointSendBlock's `JAtZ.sendBlockJ`)
  have hAR : AR a σ.archState.x64CurrentCr3 := J.xtop.fin.1.1.2.2.2.2.2.2
  have hF : IFrame (L := L) Z.th s s' := IRel.iframe_of hI hW fun b hb => CnW.oobj hI.2.2.1 hb
  obtain ⟨V', hX3⟩ := XTopAt.irel_same J.xtop hIR hAR hF.1 F.sk.cdt F.sk.orig F.ksub hF.2
  have hks : L.ksb s' = L.ksb s := hF.2
  obtain ⟨k1, k2, kb, k3, k4⟩ := J.cnW_keeps hW
  have ck := F.callKeep
  have hCR' : CallRel (L.mem s') Z.R Z.C σ' Lst :=
    J.call.frame k3 k4 (fun q _ y n hy => ck.1 _ y n hy) (fun d _ x hx => ck.2.1 _ x hx)
  have hRP' := J.rp.frame hks ck.2.2
  have hRF' : RFree (L.mem s') Z.R Z.C σ' Lst := by
    intro d hd hfd
    obtain ⟨y, hy, hyt⟩ := hfd
    obtain ⟨e1, e2⟩ := k4 d hd
    obtain ⟨h1, h2, h3⟩ := J.rfree d hd ⟨y, F.replyB hy, hyt⟩
    exact ⟨h1, by rw [e2]; exact h2, by rw [e1]; exact h3⟩
  have hS3 : SchedRel st Z.N Z.T Z.C Z.c s' σ' := hIR.2.2.1
  have hAI3 : ActIdle σ' := ⟨fun u hu => (by rw [hcn'] at hu; cases hu), F.idleOK J.act.2⟩
  have hcur3 : σ'.schedulerAction = .chooseNewThread ∨ CurInv σ' := Or.inl hcn'
  have hrun3 : CurRunM σ' := Or.inl (by rw [hcn']; intro h; cases h)
  -- the dead: the thread is not dead (runnable); the notification leaves the dead set
  have htD : ∀ q ∈ D, q.bv ≠ t.bv := J.notDead ht hkt (by rcases runnable_code hr with h | h | h <;> rw [h] <;> decide)
  have hdead : ∀ q ∈ D \ {n}, DeadP (L := L) H s' q := fun q hq => by
    have hd := J.jcov.dead q hq.1
    have hqt : q.bv ≠ t.bv := htD q hq.1
    have hqn : q.bv ≠ n.bv := fun h => hq.2 (P1.eq_of_bv h)
    refine J.deadP_keep hS3 hIR.1 (fun x hx h0 => ?_) (fun x hx => F.epF hx) (fun x hx => ?_)
      (fun x hx => ⟨x, F.replyF hx, rfl⟩) (fun x n hx => ⟨x, F.scF hx, Or.inl rfl, Or.inl rfl⟩)
      (fun hqC => k3 q hqC) (fun z hz hqC K hK8 hK => J.cnW_scOut hW hz hqC hK8 hK) F.sk.idle hAI3.1 (J.yld.frame k2 F.ykeep) (F.ykeep.dk q.bv) hd
    · obtain ⟨st', hk3, hs'⟩ := F.tcbF hx
      refine ⟨_, hk3, ?_, rfl, Or.inl rfl⟩
      show st' = x.tcbState
      rcases hs' with e1 | ⟨e1, -⟩
      · exact e1
      · exact absurd e1 hqt
    · obtain ⟨y, hy, hc'⟩ := F.ntfnF hx
      rcases hc' with rfl | ⟨e1, -⟩
      · exact ⟨_, hy, Or.inl rfl, rfl, Or.inl rfl⟩
      · exact absurd e1 hqn
  have hidl := J.idleW_keep hS3 F.sk.idle F.sk.isc
  have hjpl : ∃ Tr Cq, JPlaced (L := L) Z.th H Tr Cq s' σ' := by
    obtain ⟨Tr, Cq, hJ⟩ := J.jpl
    exact ⟨Tr, Cq, hJ.same hF.1 (fun q y n _ hq => F.szKeep q.bv y n hq) hks (J.cnW_irq hW) hidl.2⟩
  have hkern := J.kern_keep hks hW.2.1 hS3 F.sk.ct F.sk.csc (fun sl h => Or.inl (by rw [← F.sk.orig]; exact h))
    (by rw [F.sk.arch])
    (fun q ao h => F.othF h (fun _ e => by cases e) (fun _ e => by cases e)) hDbg
    (D' := D \ {n})
  have hRR' := J.rrecv.frame k4 F.khrb
  have hjcov : JCovD (L := L) Z.th H Z.G (D \ {n}) Cs s' := by
    obtain ⟨-, ⟨-, -, hM, -, -⟩, -⟩ := J.xtop.rel
    have hsl : ∀ x ∈ Z.G.chains.flatten, IsSlot Z.th x := fun x h => ((hM.members x).1 h).1
    exact (J.jcov.undead hcov.1 hcov.2).same (fun y hy _ _ => ⟨hy, hF.1.capV (hsl y hy)⟩) (fun q hq _ => hdead q hq)
      (J.jcov.ks.keep hks fun x hx p sb fi d hc => ⟨x, hx, fi, by rw [← hF.1.capV (hsl x hx)]; exact hc⟩) hidl hks
      (J.jcov.idleOut.keep hidl fun x hx p sb fi d hc => ⟨x, hx, fi, by rw [← hF.1.capV (hsl x hx)]; exact hc⟩) (fun q _ h => h.keep (DXKeep.of_dbg (J.rbw_dbgKeep hRB) (J.cnW_td hW)))
  -- `Inv` (`InvBut.ik`; the thread's `RelIfBound` from a runnable state)
  have hnqT : NotQueued σ t.bv := ⟨by rw [← hcur]; exact hnq, by rw [← hcur]; exact hC.notRel⟩
  obtain ⟨hIB, -⟩ := (J.inv.toBut t.bv).ik hnqT hik
  have hrib : RelIfBound σ' t.bv := Ipc.RelIfBound.of_keep (J.inv.rd t.bv xt hkt (Or.inl hr)) F.skeep
  have I3 : Inv σ' := hIB.inv fun _ _ _ => hrib
  -- `BlockedScActive`: the thread's SC is the current SC, active
  have hscA : ∀ p y n, σ.kheap p = some (.schedContext y n) → y.scTcb = some t.bv →
      Fl4Spec.scActive y = true := by
    intro p y n hp hyt
    obtain ⟨q, hqC, eq⟩ := J.obj.sc p y n hp
    subst eq
    obtain ⟨Tr, Cq, hJ⟩ := J.jpl
    have hq0 := J.c0 q hqC
    have hqS : q ∈ P1.Heap.scs H := ⟨_, (hJ.sc q y n hq0 hp).2⟩
    obtain ⟨u, -, -, xu, hku, hxs⟩ := scBack_of hS J.blk.2.2.1 J.tcbs_eq.1.symm hqC hqS hq0 hp hyt
    rw [hkt] at hku; cases hku
    have e1 : σ.curSc = q.bv := Option.some.inj (hscc.symm.trans hxs)
    rw [← e1] at hp
    exact hC.active (J.curSc_ne_idle hC hti) y n hp
  have R : JRest (L := L) arI (Z.mv Z.G V') H Cs Ac Lst (D \ {n}) s' σ' :=
    ⟨hCR', hRF', hRR', J.yld.frame k2 F.ykeep, J.mcp.frame k1 F.mcpKeep, J.buf.frame kb F.bufKeep, hRP',
      J.apart.sc_frame hks F.szKeep, hjpl, hjcov, hkern,
      J.cnW_utc hW hF.1 F.sk.cdt F.sk.orig F.sk.arch hDbg, F.nsc J.nsc, I3, hcur3, F.own J.own, F.off J.off,
      hAI3, F.bsa J.bsa hscA, F.isorted J.isorted hsrt, hrun3, hblk⟩
  have hC0 := JCs.same J hF.1 F.ksz
  have hCs : JCs (L := L) (Z.mv Z.G V') s' σ' := ⟨hC0.del, hC0.ut, hC0.finM, hC0.sfree⟩
  have J3 := J.cs_frameI hks hX3 hW (fun b hb => Ipc.CnW.oobj J.xtop.fin.1.1.1 hb) (fun b hb => J.cnW_nv hb) F.sk.arch
    (fun q ao h => F.othF h (fun _ e => by cases e) (fun _ e => by cases e)) F.szKeep hF.1 F.kback F.ipcFr hCs R
    (J.rbw_dbgKeep hRB) F.sk.orig (XTopAt.idleW_eqS J.xtop hX3 F.sk.idle) (J.zD_diffN hn)
  rw [heq]
  exact ⟨_, Set.mem_singleton _, J3.xtop.relTop, _, _, _, _, _, J3⟩

end

section
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P1 Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

set_option maxHeartbeats 4000000 in
/-- (p3J gen 30; stable ghosts, `JStab`) **The blocking receive at `J` that gives the SC back** (the former
`JRecvSigRetHyp` [W]): the current thread blocks on an idle or waiting
notification whose SC is the current SC (`hsc`); `JAtZ.recvSigBlockPreJ`,
then `JAtZ.maybeReturnJ` unbinds the SC (a reschedule is pending already). -/
theorem JAtZ.recvSigRetJSt (hAT : P0.ArchTotal arI) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z]
    {t : U64} (ht : t ∈ Z.T) (hcur : σ.curThread = t.bv) (hni : Entered σ)
    (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
    {n : U64} (hn : n ∈ Z.N) {x : Fl4Spec.Notification} (hk : σ.kheap n.bv = some (.notification x))
    (hna : ∀ b, x.ntfnObj ≠ .activeNtfn b) (hsc : x.ntfnSc = some σ.curSc)
    (hcov : (∀ k, Z.th n = some k → Covered (L.mem s) Z.G n.val (n.val + max (objSize k) 1)) ∧
      (∀ k, H n = some k → Covered (L.mem s) Z.G n.val (n.val + 2 ^ k.bits)))
    (cb : Fl4Spec.Badge) (rt : Fl4Spec.CapRights) :
    notification.receive_signal st arI s a t n true ⦃ r =>
      ∃ z ∈ (Fl4Spec.receiveSignal (Z := Unit) t.bv (.notificationCap n.bv cb rt) true σ).1,
        RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨xt, hkt, -⟩ := hI.1.tcb t ht
  have hC : CurInv σ := J.curInv (by rw [hni.2]; intro e; cases e)
  obtain ⟨xc, hkc, hscc, -⟩ := hC.tcb
  rw [hcur, hkt] at hkc; cases hkc
  obtain ⟨i, hiC, hib⟩ := J.nsc n hn x σ.curSc hk hsc
  have hx := hI.1.toN.at_ntfn hn hk
  have hst0 : stOf (L.mem s) n = obj.NTFN_IDLE ∨ stOf (L.mem s) n = obj.NTFN_WAITING := by
    have := hx.obj
    cases h : x.ntfnObj with
    | idleNtfn => exact Or.inl (stOf_idle (T := Z.T) (h ▸ this) rfl)
    | waitingNtfn q => exact Or.inr (stOf_waiting (T := Z.T) (h ▸ this) rfl)
    | activeNtfn b => exact absurd h (hna b)
  refine receive_signal_split hst0 (J.recvSigBlockPreJ hAT hkt ht hcur hni hnq hn hk hna hcov cb rt) ?_
  rintro s4 ⟨σ3, hspec, hnrw, hkt3, ⟨q, hkn3⟩, hact3, -, hid3, V', J3⟩
  refine WP.spec_mono (J3.maybeReturnJ ht hn hiC hkt3 hkn3 (by rw [hib]; exact hscc) (by rw [hib]; exact hsc)
    (by rfl) hnrw (fun u hu => by rw [hact3] at hu; cases hu) (by rw [hid3, ← hcur]; exact hni.1)) ?_
  rintro s5 ⟨σ5, he5, Ac', Lst', J5⟩
  exact ⟨((), σ5), by rw [hspec, he5]; exact Set.mem_singleton _, J5.xtop.relTop, _, _, _, _, _, J5⟩

end


section
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P1 Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}

set_option maxHeartbeats 4000000 in
/-- (p3J gen 30) **The notification receive at a resumed entry, stable** (`jRecvSigHyp_of` with the `JStab`
post; module docstring). -/
theorem jRecvSigSt_of (hAT : P0.ArchTotal arI)
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (ht : ct ∈ Z.T) (hcur : σ.curThread = ct.bv)
    (hni : Entered σ) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p) (blocking : Bool) :
    ∀ p b w rd ac, CapRel (.Notification p b w rd) ac → (∃ x, σ.kheap p.bv = some (.notification x)) →
      JHeld (L := L) Z.th s (.Notification p b w rd) →
      notification.receive_signal st arI s a ct p blocking ⦃ r =>
        ∃ z ∈ (Fl4Spec.receiveSignal (Z := Unit) ct.bv ac blocking σ).1,
          RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2 ⦄ := by
  rintro p b w rd ac hcr ⟨x, hk⟩ ⟨y, hy, hcv⟩
  have hac : ac = absCap (.Notification p b w rd) := hcr.abs
  subst hac
  obtain ⟨n, hn, h⟩ := J.obj.ntfn _ x hk
  rw [Sched.bv_inj h] at hn
  cases hact : x.ntfnObj with
  | activeNtfn b0 =>
    exact J.recvSigActiveJSt hAT ht hcur hni hnq hn hk hact blocking b.bv (rightsOf w rd false false)
  | _ =>
    have hna : ∀ b', x.ntfnObj ≠ .activeNtfn b' := fun b' h => by rw [hact] at h; cases h
    cases blocking
    · exact J.recvSigPollJSt ht hn hk hna b.bv (rightsOf w rd false false)
    · have hHn : H p = some .ntfn := J.zH.2.2.2 p hn
      have hfit := J.kern.heap.fits p _ hHn
      simp only [P1.HKind.bits] at hfit
      have hcov := J.cover_cap (P1.WritesIn.refl s _) hy (by rw [capAt_capV, hcv]) (fun h => by cases h)
        (ok_inj (phys_eq _).symm) rfl (range_ntfn p b w rd hfit) fun k hk' => by
          rw [hHn] at hk'; cases hk'
          exact ⟨by simp only [P1.HKind.bits]; omega, fun z h => by cases h⟩
      by_cases hsc : x.ntfnSc = some σ.curSc
      · exact J.recvSigRetJSt hAT ht hcur hni hnq hn hk hna hsc hcov b.bv (rightsOf w rd false false)
      · exact J.recvSigBlockJSt hAT ht hcur hni hnq hn hk hna hsc hcov b.bv (rightsOf w rd false false)

/-- (p3J gen 30) **A related notification is an `H` notification whose state word is not 3** (module
docstring). -/
theorem ntfn_epState3 (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) {p : U64} {x : Fl4Spec.Notification}
    (hk : σ.kheap p.bv = some (.notification x)) :
    p ∈ Z.N ∧ H p = some .ntfn ∧ L.epState s p ≠ 3#u64 := by
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨n, hn, h⟩ := J.obj.ntfn _ x hk
  rw [Sched.bv_inj h] at hn
  refine ⟨hn, J.zH.2.2.2 p hn, ?_⟩
  have hx := hI.1.toN.at_ntfn hn hk
  rw [epState_eq]
  have := hx.obj
  cases hc : x.ntfnObj with
  | idleNtfn => rw [stOf_idle (T := Z.T) (hc ▸ this) rfl, ntfn_consts.1]; decide
  | waitingNtfn q => rw [stOf_waiting (T := Z.T) (hc ▸ this) rfl, ntfn_consts.2.1]; decide
  | activeNtfn b => rw [stOf_active (T := Z.T) (hc ▸ this) rfl, ntfn_consts.2.2]; decide

set_option maxHeartbeats 4000000 in
/-- (p3J gen 30) **The notification receive at a resumed entry, stable, writing only `ProjW H Cs s`** (module
docstring). -/
theorem jRecvSigStFt (hAT : P0.ArchTotal arI)
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z] {ct : U64} (ht : ct ∈ Z.T) (hcur : σ.curThread = ct.bv)
    (hni : Entered σ) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p) (blocking : Bool) :
    ∀ p b w rd ac, CapRel (.Notification p b w rd) ac → (∃ x, σ.kheap p.bv = some (.notification x)) →
      JHeld (L := L) Z.th s (.Notification p b w rd) →
      notification.receive_signal st arI s a ct p blocking ⦃ r =>
        (∃ z ∈ (Fl4Spec.receiveSignal (Z := Unit) ct.bv ac blocking σ).1,
          RelTopM (L := L) r.1 z.2 ∧ JStab (L := L) arI AR Z H Cs r.1 r.2 z.2) ∧
        P1.WritesIn st s r.1 (Mc.ProjW (L := L) H Cs s) ⦄ := by
  intro p b w rd ac hcr hex hHd
  obtain ⟨x, hk⟩ := hex
  obtain ⟨-, hHn, h3⟩ := ntfn_epState3 J hk
  have hI := J.xtop.irelK J.ks J.buf
  obtain ⟨xt, hkt, -⟩ := hI.1.tcb ct ht
  have hrn : Fl4Spec.runnable xt.tcbState = true := (J.curRun.run hni) xt (by rw [hcur]; exact hkt)
  have hcb := J.canBlockCur ht hcur hkt hrn hni hnq
  obtain ⟨⟨Q0, R0, h0⟩, hB0, hX0, hS0, hSg0⟩ := J.blk
  have hF := Mc.recvSignalProjW (L := L) hAT J.kern.heap s a ct p blocking Q0 R0 h0 hB0 hX0 hS0 hSg0 hcb hHn hHn h3
  refine WP.spec_mono (WP.spec_and (jRecvSigSt_of hAT J ht hcur hni hnq blocking p b w rd ac hcr ⟨x, hk⟩ hHd) hF) ?_
  rintro ⟨s', a'⟩ ⟨h1, h2⟩
  simp only [WP.uncurry'_pair] at h2
  exact ⟨h1, h2⟩

end

end

end Fl4Proofs.P3
