/-
P3 (DESIGN.md §9), invariant line G1 (g5c, KENTRY-PLAN g5c): **no spec step
but `set_ioport_mask` writes the allocated IO ports** (`IoIs N σ :=
σ.archState.x64AllocatedIoPorts = N`), part 1, spec side only. The family
`IoK N m := IK (IoIs N) m` is sg1's idle-pointer family SpecInvSgI1..I6
mechanically renamed (the idle predicate → `IoIs`, `idleThread` → the allocated IO ports,
the lemma prefix → `iok_`; generated by proofs/scratch/g5c/mkiok.py), without the 32
functions reaching `set_ioport_mask` (its callers `free_ioport_range`,
`arch_post_cap_deletion`, `post_cap_deletion`, `empty_slot`, the deletion
recursion, the IO port control perform and every shell above them): those are
SpecInvIoPorts*'s. Parts 2-6: SpecInvIoK2..K6.
-/
import Fl4Proofs.P3.SpecInvNativeScopeT
open Classical

namespace Fl4Proofs.P3.SInvIo
open Fl4Spec Fl4Proofs.P3.SInv

noncomputable section

set_option maxHeartbeats 1000000
set_option maxErrors 2000

/-- The allocated IO ports are `N`. -/
def IoIs (N : IoPort → Bool) (σ : State Unit) : Prop := σ.archState.x64AllocatedIoPorts = N

abbrev IoK (N : IoPort → Bool) {α : Type} (m : NonDet (State Unit) α) : Prop := IK (IoIs N) m
abbrev IoKE (N : IoPort → Bool) {ε α : Type} (m : NonDetE (State Unit) ε α) : Prop := IKE (IoIs N) m

variable {N : IoPort → Bool}

macro "iok_side" : tactic => `(tactic| first | (intro _ _ h; exact h) | (intro _ h; exact h) | trivial)

macro "iok0_auto" : tactic => `(tactic| repeat' (first
  | ((with_reducible refine ik_doMachineOp ?_ _); iok_side)
  | ((with_reducible refine ik_doExtendedOp ?_ _); iok_side)
  | with_reducible exact ik_getObject _
  | ik_step0 | ik_unfold | (unfold NonDetE.whenE) | (unfold NonDetE.unlessE) | (unfold NonDet.when)
  | (unfold NonDet.unless)))

theorem iok_setObject (p : ObjRef) (o : KernelObject) : IoK N (setObject (Z := Unit) p o) := by
  unfold setObject; iok0_auto

