    p1f) ?_
  rintro ⟨s', a'⟩ ⟨⟨⟨ea, σ0, h0eq, hIR, hW3⟩, hbk⟩, hfoot3⟩
  simp only [WP.uncurry'_pair] at ea hbk hfoot3 hIR hW3
