/-- **A `CnW` word is not the VCPU-list head word** (module docstring). -/
theorem JAtZB.cnW_nh (J : JAtZB (L := L) arI AR Z H Cs Ac Lst D s a σ) {b : U64}
    (h : CnW (st := st) Z.T Z.N Z.C Z.E Z.R Z.c s σ b) : b ≠ P1.vHeadA st s := by
  rcases h with hf | ⟨e, he, hb⟩ | ⟨r, hr, hb⟩
  · exact J.finW_nh hf
  · intro eb
    subst eb
    have hvh : (P1.vHeadA st s).val = (L.ksb s).val + 80 := vHead_val J.kern.ksbFit
    have d := J.kern.hks e _ (J.zH.2.1 e he) (fun _ h => by cases h)
    simp only [P1.HKind.bits, Nat.reducePow] at d
    unfold Endp.EW at hb
    omega
  · intro eb
    subst eb
    have hvh : (P1.vHeadA st s).val = (L.ksb s).val + 80 := vHead_val J.kern.ksbFit
    have d := J.kern.hks r _ (J.zH.2.2.1 r hr) (fun _ h => by cases h)
    simp only [P1.HKind.bits, Nat.reducePow] at d
    omega

end

end

