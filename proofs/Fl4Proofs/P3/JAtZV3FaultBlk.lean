theorem JAtZV3.faultBlockJ3 (J3 : JAtZV3 (L := L) arI V X AR Z H Cs Ac Lst D s a σ) (hni : Entered σ) {ct : U64}
    (hct : sched.cur_thread st s = ok ct) (hnq : ∀ d p, σ.curThread ∉ σ.readyQueues d p)
