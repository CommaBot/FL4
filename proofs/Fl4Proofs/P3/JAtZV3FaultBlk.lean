/-- **What a blocking send's spec frame keeps of the VM epoch** (module docstring). -/
theorem zv_bfrt {t e : Fl4Spec.ObjRef} {σ σ' : Fl4Spec.State Unit} (h : Sched.BFrT t e σ σ') :
    (∀ p ao, σ.kheap p = some (.archObj ao) → σ'.kheap p = σ.kheap p) ∧
    (∀ o ko', σ'.kheap o = some ko' → ∃ ko, σ.kheap o = some ko ∧ Fl4Spec.objBits ko' = Fl4Spec.objBits ko) ∧
    (∀ o x', σ'.kheap o = some (.tcb x') → x'.tcbState = .runningVM →
      ∃ x, σ.kheap o = some (.tcb x) ∧ x.tcbState = .runningVM) ∧
    (∀ p (vs : Fl4Spec.VcpuState), σ'.kheap p = some (.archObj (.vcpu vs)) →
      σ.kheap p = some (.archObj (.vcpu vs))) := by
  refine ⟨fun p ao hp => ?_, fun o ko' ho => ?_, fun o x' ho hx => ?_, fun p vs hp => ?_⟩
  · rcases h.kh p with k | ⟨o, o', h1, -, hc⟩
    · exact k
    · rw [hp] at h1; cases h1
      rcases hc with ⟨_, _, _, _, e, -⟩ | ⟨_, _, e, -⟩ <;> cases e
  · rcases h.kh o with k | ⟨o1, o2, h1, h2, hc⟩
    · exact ⟨ko', by rw [← k]; exact ho, rfl⟩
    · rw [ho] at h2; cases h2
      rcases hc with ⟨_, _, _, _, rfl, rfl, -⟩ | ⟨_, _, rfl, rfl, -⟩
      · exact ⟨_, h1, rfl⟩
      · exact ⟨_, h1, rfl⟩
  · rcases h.kh o with k | ⟨o1, o2, h1, h2, hc⟩
    · exact ⟨x', by rw [← k]; exact ho, hx⟩
    · rw [ho] at h2; cases h2
      rcases hc with ⟨_, _, _, _, rfl, e, -⟩ | ⟨_, _, rfl, e, -⟩
      · cases e; cases hx
      · cases e
  · rcases h.kh p with k | ⟨o1, o2, h1, h2, hc⟩
    · rw [← k]; exact hp
    · rw [hp] at h2; cases h2
      rcases hc with ⟨_, _, _, _, -, e, -⟩ | ⟨_, _, -, e, -⟩ <;> cases e

