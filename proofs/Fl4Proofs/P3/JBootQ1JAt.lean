/-- **`JAt` at the richer witness.** -/
theorem jAt_w1 (a : MachineState) : JAt (L := wL) warI wAR w1 a σ1 :=
  ⟨Zw1, Hw1, Csw, C1, fun _ => [], Dw, jAtZ_w1 a, Zw1_vx⟩

theorem σ1_mr : wMR σ1.machineState σ1.machineState := ⟨rfl, rfl, rfl, rfl⟩

/-- **The richer witness starts `JReachU3`.** -/
theorem jReachU3_w1 : SInvR.G5.JReachU3 (L := wL) warI wAR wMR w1 σ1.machineState σ1 :=
  .start (jAtZ_w1 _) Zw1_vx σ1_sinvX σ1_sinvIP σ1_mr σ1_utPgR

/-- **`JReachU17` at the richer witness**, whose current thread is the root thread, not the idle thread. -/
theorem jReachU17_w1 : SInvR.G5.JReachU17 (L := wL) warI wAR wMR w1 σ1.machineState σ1 :=
  ⟨jReachU3_w1, σ1_gpmOut, σ1_idleVtS, σ1_devRangeS⟩

/-! ## Non-idle at every reachable state over `w1` -/

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {MR : A → Fl4Spec.MachineState → Prop}

/-- **Every `JReachU3` state is a `JAt` state** (the start rule's `JAtZ`; each step rule's exit `RJM`). -/
theorem JReachU3.jAt {s : S} {a : A} {σ : Fl4Spec.State Unit}
    (h : SInvR.G5.JReachU3 (L := L) arI AR MR s a σ) : JAt (L := L) arI AR s a σ := by
  cases h with
  | start J hvx _ _ _ _ => exact ⟨_, _, _, _, _, _, J, hvx⟩
  | step _ _ _ _ _ _ _ hR => exact hR.1.2
  | irq _ _ _ _ _ hR => exact hR.1.2
  | user _ _ _ _ _ _ _ hR => exact hR.1.2
  | vmf _ _ _ _ _ _ _ _ hR => exact hR.1.2
  | trap _ _ _ _ _ _ _ _ hR => exact hR.1.2
  | sysU _ _ _ _ _ _ _ _ _ hR => exact hR.1.2

/-- At a `JAt` state the spec's current and idle threads are core `cpu s`'s node words. -/
theorem JAt.curIdle {s : S} {a : A} {σ : Fl4Spec.State Unit} (h : JAt (L := L) arI AR s a σ) :
    σ.curThread = (nodeW st s (L.cpu s) layout.node.CUR_THREAD).bv ∧
      σ.idleThread = (nodeW st s (L.cpu s) layout.node.IDLE_THREAD).bv := by
  obtain ⟨Z, H, Cs, Ac, Lst, D, J, -⟩ := h
  obtain ⟨⟨⟨hSR, -⟩, -⟩, -⟩ := J.xtop.fin
  obtain ⟨Q, R, hC, hS⟩ := hSR.lists
  rw [hC.cur]
  exact ⟨hS.curThread, hS.idleTh⟩

end

end

