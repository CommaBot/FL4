/-
P3 (DESIGN.md §9), kernel entry (KENTRY-PLAN mr9 GOAL 2): **`kernel_entryJ23P`**,
`kernel_entryJ22P` with a path premise that no longer carries the [W] field
`JUtPath.ret` (UtRetResetJ's `JUtRetHypR2`, for the VT-x Untyped types only).
The P line's Untyped decode (`decode_invocation_untypedJM`, through
`jPreDecHyp_of14`) never reads it, yet `JPathAt` made every caller supply it.
XTopJointEntry is not edited (generated by scratch/mr9/gen23.py from the
originals; every proof body is the original's text with the names below).

* `JUtPathM`: `JUtPath` without `ret` (same fields, same tags); `JUtPath.toM`.
* `JPathM`: `JPath` with `JUtPathM` for the RAM Untyped cap (every other case
  identical); `JPathM.of` (`JPath → JPathM`). `JPathAtM`: `JPathAt` asking
  `JPathM`; `JPathAt.toM`. So the new path premise is strictly weaker.
* `JPreDecHypKM` / `JPreDecHypM` / `JVtxHypMU`: `JPreDecHypK` / `JPreDecHyp`
  / `JVtxHypM` given `JPathM` for `JPath` (the [scope] `JVtxHypMU` is asked
  with the weaker path fact; it concerns the same VT-x retypes `ret` did).
* XTopJointKEntry13P's dispatch layer at `JPathM` (`decOK_JMU`,
  `handle_invocation_entryJMU`, `invoke_afterJMU`, `dispatch_invokeJMU`,
  `mid_invRecvJMU`, `dispatch_midJMU`, `dispatch_invokeJAllMU`,
  `KDispHyps13PU`, `dispatch_all13PU`) and `kernel_entryJ13PU` (=
  XTopJointKEntry22P's `kernel_entryJ13PB`, KBudgetB budget step).
* `jPreDecHyp_of14U` / `of17U` / `of18U` / `of20U`: the P line's family
  lemmas at `JPathM`.
* `KDispHypsKV23` (= `KDispHypsKV21` with `JPathAtM` and `JVtxHypMU`),
  `KDispHypsKV23.to13PU`, NEW TOP `kernel_entryJ23P`, `j23P_platform`.
-/
import Fl4Proofs.P3.XTopJointKEntry20P
import Fl4Proofs.P3.XTopJointKEntry22M
import Fl4Proofs.P3.XTopJointKEntry8B
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched

noncomputable section

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)

/-- **The RAM Untyped path without the [W] field `ret`** (module docstring):
`JUtPath` minus `JUtPath.ret` (`JUtRetHypR2`, VT-x types only), which the P
line's untyped decode (`decode_invocation_untypedJM`) never reads. Every
other field as `JUtPathM`, with its tag. -/
structure JUtPathM (AR : A → Fl4Spec.Cr3 → Prop) (Z : XSets) (H : P1.Heap) (Cs D : Set U64) (s : S) (ar : A) (σ : Fl4Spec.State Unit)
    (lbl length p sb fi : U64) (blk call don fp : Bool) (buf : U64) (extra : Aeneas.Std.Array obj.Slot 3#usize)
    (slbl : Fl4Spec.Data) (argsU : List U64) (ci : Fl4Spec.CapRef) (sl : Fl4Spec.CslotPtr)
    (excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)) (buffer : Option Fl4Spec.ObjRef) (ct : U64) : Prop where
  /-- [P] `CONFIG_RETYPE_FAN_OUT_LIMIT` is FL4's 256. -/
  fan : Fl4Spec.retypeFanOutLimit = 256#64
  /-- [scope] a VT-x object type (14 to 18: VMCS, EPT tables). -/
  vtx : ∀ x, argsU.head? = some x → 14 ≤ x.val → x.val < 19 →
    JVtxScope (L := L) arI AR s ar σ lbl length (.Untyped p sb fi false) blk call don fp buf extra slbl argsU ci sl
      excaps buffer ct
  /-- [P] one core (as `JEntryAt.stall`, `JSchedCPath.core`): the sets' core
  is core 0, the core of the TCBs and SCs a retype makes (their affinity and
  `CORE` words are 0, ScFresh's `SchedRel.add_tcbs`, ScFreshSc's
  `SchedRel.add_scs`). -/
  core0 : Z.c = 0#u64
  /-- [J] every IPC-buffer word lies in a spec object (XTopJointUtEp's
  `BufObjHyp`; l4v `valid_ipc_buffer_cap` with `obj_at`), for the
  endpoints', notifications' and replies' retype (`JAtZ.utEpJ`). -/
  bufObj : BufObjHyp Z.B σ
  /-- [J] at the entry's own ghost heap `H`, cores `Cs` and dead set `D`:
  UtEpSets' `ArchFitHyp` (`H`'s object at a spec arch object no larger than
  it; l4v the arch objects' `obj_range`) and ScJoint's `RegionUnrefAt` at the
  entry state's restart (the kept objects and FL4's debug and timer lists name
  no object of a range whose objects are in `D`; l4v `untyped_children_in_mdb`
  + `if_live_then_nonz_cap` + `sym_refs`), for `JAtZ.utEpJ` and the other
  retypes. -/
  heapH : ArchFitHyp H σ ∧ RegionUnrefAt (L := L) H Cs D s
  /-- [J] the reset's `VsReachMiss` (VsDrop; l4v `valid_vs_lookup` with
  `dead_childless`: no table reachable from the ASID table lies in a childless
  untyped cap's region, nor one reachable from a table a slot's cap names:
  l4v `valid_cap` + `untyped_children_in_mdb` for the caps' own tables), for
  the cap's region at the restart's state, with the roots the slots' caps ask
  (`Vs.NeedR`: unmapped PT/PD/PDPT caps' tables, PML4 and pool caps' frames;
  `JAtZ.drop`'s `hXc`, so `JAtZ.vsc` survives the drop): UtResetTopJ's
  `JAtZ.reset_untypedJ` (`JAtZ.drop`), the retype with a reset
  (`JAtZ.utResetJ`). Asked only when the invoked cap has no descendants
  (FINDING g7b-2: unguarded it is false). -/
  vsReach : (∀ y, ¬ Mdb.Desc Z.G.par y (cslotAddr sl)) → ∀ s1, sched.set_thread_state st s ct sched.TS_RESTART = ok s1 →
    Vs.VsReachMiss p.val (p.val + 2 ^ sb.val) (L.mem s1) (L.ksb s1)
        (Vs.NeedR Z.th (L.mem s1) 5) (Vs.NeedR Z.th (L.mem s1) 4) (Vs.NeedR Z.th (L.mem s1) 3)
        (Vs.NeedR Z.th (L.mem s1) 2) (Vs.NeedR Z.th (L.mem s1) 1)
  /-- [P] `CONFIG_RESET_CHUNK_BITS` is FL4's 16 (`untyped::RESET_CHUNK_BITS`):
  the reset's chunks (`JAtZ.reset_untypedJ`). -/
  rcb : Fl4Spec.resetChunkBits = 16

/-- **`JPath` with `JUtPathM` for the RAM Untyped cap** (module docstring);
every other cap kind's premise is `JPath`'s, case by case. -/
def JPathM (AR : A → Fl4Spec.Cr3 → Prop) (Z : XSets) (H : P1.Heap) (Cs D : Set U64) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (lbl length : U64)
    (blk call don fp : Bool) (buf : U64) (extra : Aeneas.Std.Array obj.Slot 3#usize) (slbl : Fl4Spec.Data)
    (argsU : List U64) (ci : Fl4Spec.CapRef) (sl : Fl4Spec.CslotPtr) (excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr))
    (buffer : Option Fl4Spec.ObjRef) (ct : U64) : capability.Cap → Prop
  | .Null | .Zombie .. | .Notification .. => True
  | .Endpoint .. => True
  | .Reply .. => True
  | .CNode .. => True
  | .Thread p =>
      (lbl = fl4_abi.label.TCBSetEPTRoot →
        JVtxScope (L := L) arI AR s ar σ lbl length (.Thread p) blk call don fp buf extra slbl argsU ci sl excaps buffer
          ct) ∧
      (lbl ≠ fl4_abi.label.TCBSetEPTRoot →
        JThreadPath (L := L) AR Z s ar σ lbl length p blk call don fp buf extra slbl argsU ci sl excaps buffer ct)
  | .IoPort first last z =>
      (z ≠ 0#u64 → JVtxScope (L := L) arI AR s ar σ lbl length (.IoPort first last z) blk call don fp buf extra slbl
        argsU ci sl excaps buffer ct)
  | .IrqControl => True
  | .IoPortControl => True
  | .TdxControl => True
  | .IrqHandler _ => True
  | .Domain => True
  | .SchedContext p sb =>
      (ScJLabel s lbl p → JSchedCtxPath (L := L) arI AR Z s ar σ lbl length p sb blk call don fp buf extra
        slbl sl excaps ct) ∧
      (lbl = fl4_abi.label.SchedContextYieldTo → JSchedYieldPath arI ar)
  | .SchedControl cpu => JSchedCPath (L := L) arI AR Z s ar σ lbl length cpu blk call don fp buf extra slbl argsU sl
      excaps ct
  | .PageTable _ _ _ _ => True
  | .PageDirectory _ _ _ _ => True
  | .Pdpt _ _ _ _ => True
  | .Pml4 _ _ _ => True
  | .AsidPool ptr base => JPoolPath (L := L) AR Z s ar σ lbl length (.AsidPool ptr base) blk call don fp buf extra
      slbl argsU ci sl excaps buffer ct
  | .Frame p sz rt d m ep asid va =>
      (ep = true ∨ lbl = fl4_abi.label.X86PageMapEPT → JVtxScope (L := L) arI AR s ar σ lbl length
        (.Frame p sz rt d m ep asid va) blk call don fp buf extra slbl argsU ci sl excaps buffer ct) ∧
      (ep = false → JFramePath (L := L) AR Z s ar σ lbl length p sz rt d m asid va blk call don fp buf extra slbl
        argsU ci sl excaps buffer ct)
  | .AsidControl => JAsidCPath (L := L) AR Z H Cs D s ar σ lbl length blk call don fp buf extra slbl argsU ci sl excaps
      buffer ct
  | .Vcpu p => JVtxScope (L := L) arI AR s ar σ lbl length (.Vcpu p) blk call don fp buf extra slbl argsU ci sl excaps
      buffer ct
  | .Ept p l m asid va => JVtxScope (L := L) arI AR s ar σ lbl length (.Ept p l m asid va) blk call don fp buf extra
      slbl argsU ci sl excaps buffer ct
  | .Untyped p sb fi dev =>
      (dev = true → JDevPath (L := L) arI AR Z H Cs D s ar σ lbl length p sb fi blk call don fp buf extra slbl argsU
        ci sl excaps buffer ct) ∧
      (dev = false → JUtPathM (L := L) arI AR Z H Cs D s ar σ lbl length p sb fi blk call don fp buf extra slbl argsU ci sl
        excaps buffer ct)

/-- **`JPathAt` asking `JPathM`** (module docstring). -/
def JPathAtM (AR : A → Fl4Spec.Cr3 → Prop) (Z : XSets) (H : P1.Heap) (Cs D : Set U64) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (ct : U64)
    (is_call blocking can_donate first_phase : Bool) (cptr : U64) : Prop :=
  ∀ (info : msginfo.MessageInfo) (mi : Fl4Spec.MessageInfo) (buf : U64) (buffer : Option Fl4Spec.ObjRef)
    (r2 : core.result.Result (Aeneas.Std.Array obj.Slot 3#usize) error.Fault)
    (er : Except Fl4Spec.Fault (List (Fl4Spec.Cap × Fl4Spec.CslotPtr))) (argsU : List U64),
    msg.msg_info st s ct = ok info →
    Fl4Spec.getMessageInfo (Z := Unit) ct.bv σ = ({(mi, σ)}, False) →
    msg.lookup_ipc_buffer st s false ct = ok buf →
    Fl4Spec.lookupIpcBuffer (Z := Unit) false ct.bv σ = ({(buffer, σ)}, False) →
    ipc.lookup_extra_caps st s ct buf info = ok r2 →
    (Fl4Spec.lookupExtraCaps (Z := Unit) ct.bv buffer mi).run σ = ({(er, σ)}, False) →
    Fl4Spec.getMrs (Z := Unit) ct.bv buffer mi σ = ({(argsU.map UScalar.bv, σ)}, False) →
    ∀ (sl : Fl4Spec.CslotPtr) (c : capability.Cap) (e : Aeneas.Std.Array obj.Slot 3#usize)
      (exs : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)), (∃ p, sl.1 = p.bv ∧ Z.th p = some (.cnode sl.2.length)) →
      capAt (L.mem s) (cslotAddr sl) = ok c → Fl4Spec.getCap (Z := Unit) sl σ = ({(absCap c, σ)}, False) →
      r2 = .Ok e → er = .ok exs →
      JPathM (L := L) arI AR Z H Cs D s ar σ info.label (msgLen info buf) blocking is_call can_donate first_phase buf e
        mi.miLabel argsU (Fl4Spec.toBl cptr.bv) sl exs buffer ct c

/-- **[W] `JPreDecHypK` given `JPathM`** (module docstring; as `JPreDecHypK`). -/
def JPreDecHypKM (K : capability.Cap → List U64 → Prop) (AR : A → Fl4Spec.Cr3 → Prop)
    (MR : A → Fl4Spec.MachineState → Prop) (Z : XSets) (H : P1.Heap)
    (Cs D : Set U64) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (ct : U64) : Prop :=
  MR ar σ.machineState → ValidMachineTime σ → ValidIrqMasks σ →
  ∀ (lbl length : U64) (blk call don fp : Bool) (buf : U64) (extra : Aeneas.Std.Array obj.Slot 3#usize)
    (slbl : Fl4Spec.Data) (argsU : List U64), length.val = argsU.length →
    (∀ (i : U64) x, argsU[i.val]? = some x → msg.syscall_arg st s ct buf i = ok x) →
    msg.lookup_ipc_buffer st s false ct = ok buf → argsU.length ≤ 120 →
    ∀ (ci : Fl4Spec.CapRef) (sl : Fl4Spec.CslotPtr), (∃ p, sl.1 = p.bv ∧ Z.th p = some (.cnode sl.2.length)) →
    ∀ (c : capability.Cap), capAt (L.mem s) (cslotAddr sl) = ok c → K c argsU →
    ∀ (excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)) (buffer : Option Fl4Spec.ObjRef),
    ExtraOK Z.th (L.mem s) extra excaps → ExtraNamed Z.th (L.mem s) extra → lbl.bv = slbl →
    ArgRel (st := st) s σ ct buf buffer 5 →
    JPathM (L := L) arI AR Z H Cs D s ar σ lbl length blk call don fp buf extra slbl argsU ci sl excaps buffer ct c →
    XCapP (L := L) arI (JAt (L := L) arI AR) (JAtPreMV (L := L) arI AR MR) s ar σ lbl length (cslotAddr sl) c blk call
      don fp buf extra slbl (argsU.map UScalar.bv) ci sl excaps buffer ct

/-- `JPreDecHypKM` at J13P's cap condition (`JPreDecHyp`'s shape). -/
abbrev JPreDecHypM (AR : A → Fl4Spec.Cr3 → Prop) (MR : A → Fl4Spec.MachineState → Prop) (Z : XSets) (H : P1.Heap)
    (Cs D : Set U64) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (ct : U64) : Prop :=
  JPreDecHypKM (L := L) arI (fun c _ => NoPreKind c → False) AR MR Z H Cs D s ar σ ct

/-- **[scope] `JVtxHypM` given `JPathM`** (module docstring; as `JVtxHypM`). -/
def JVtxHypMU (AR : A → Fl4Spec.Cr3 → Prop) (MR : A → Fl4Spec.MachineState → Prop) (Z : XSets) (H : P1.Heap)
    (Cs D : Set U64) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (ct : U64) : Prop :=
  MR ar σ.machineState → ValidMachineTime σ → ValidIrqMasks σ →
  ∀ (lbl length : U64) (blk call don fp : Bool) (buf : U64) (extra : Aeneas.Std.Array obj.Slot 3#usize)
    (slbl : Fl4Spec.Data) (argsU : List U64), length.val = argsU.length →
    (∀ (i : U64) x, argsU[i.val]? = some x → msg.syscall_arg st s ct buf i = ok x) →
    msg.lookup_ipc_buffer st s false ct = ok buf → argsU.length ≤ 120 →
    ∀ (ci : Fl4Spec.CapRef) (sl : Fl4Spec.CslotPtr), (∃ p, sl.1 = p.bv ∧ Z.th p = some (.cnode sl.2.length)) →
    ∀ p sb fi dev, capAt (L.mem s) (cslotAddr sl) = ok (.Untyped p sb fi dev) →
    ∀ x, argsU.head? = some x → 14 ≤ x.val → x.val < 19 →
    ∀ (excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)) (buffer : Option Fl4Spec.ObjRef),
    ExtraOK Z.th (L.mem s) extra excaps → ExtraNamed Z.th (L.mem s) extra → lbl.bv = slbl →
    ArgRel (st := st) s σ ct buf buffer 5 →
    JPathM (L := L) arI AR Z H Cs D s ar σ lbl length blk call don fp buf extra slbl argsU ci sl excaps buffer ct
      (.Untyped p sb fi dev) →
    JVtxScopeM (L := L) arI AR MR s ar σ lbl length (.Untyped p sb fi dev) blk call don fp buf extra slbl argsU ci sl
      excaps buffer ct

end

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)
variable {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
  {Lst : U64 → List U64} {D : Set U64} {MR : A → Fl4Spec.MachineState → Prop}

set_option maxHeartbeats 4000000 in
theorem decOK_JMU [Fl4Proofs.P1.PlainStore st] (s : S) (ar : A) (σ : Fl4Spec.State Unit)
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s ar σ) [VxE Z]
    (hG : JEntryGlobM (L := L) arI AR MR Z.th) (hE : JEntryAt (L := L) arI AR Z H Cs s ar σ)
    (ct : U64) (hct : sched.cur_thread st s = ok ct)
    (lbl length : U64) (blk call don fp : Bool) (buf : U64) (extra : Aeneas.Std.Array obj.Slot 3#usize)
    (slbl : Fl4Spec.Data) (argsU : List U64) (hlen : length.val = argsU.length)
    (hargs : ∀ (i : U64) x, argsU[i.val]? = some x → msg.syscall_arg st s ct buf i = ok x)
    (hbuf : msg.lookup_ipc_buffer st s false ct = ok buf) (hl : argsU.length ≤ 120)
    (ci : Fl4Spec.CapRef) (sl : Fl4Spec.CslotPtr) (hsl : ∃ p, sl.1 = p.bv ∧ Z.th p = some (.cnode sl.2.length))
    (c : capability.Cap) (hc : capAt (L.mem s) (cslotAddr sl) = ok c)
    (excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)) (buffer : Option Fl4Spec.ObjRef)
    (hXO : ExtraOK Z.th (L.mem s) extra excaps) (hXN : ExtraNamed Z.th (L.mem s) extra) (hLb : lbl.bv = slbl)
    (hA5 : ArgRel (st := st) s σ ct buf buffer 5)
    (hN : JPathM (L := L) arI AR Z H Cs D s ar σ lbl length blk call don fp buf extra slbl argsU ci sl excaps buffer ct c)
    (hPD : JPreDecHypM (L := L) arI AR MR Z H Cs D s ar σ ct) (hR : MR ar σ.machineState) (hVT : ValidMachineTime σ)
    (hVI : ValidIrqMasks σ) (hNs : NativeScope σ) :
    XCapP (L := L) arI (JAt (L := L) arI AR) (JAtPreMV (L := L) arI AR MR) s ar σ lbl length (cslotAddr sl) c blk call
      don fp buf extra slbl (argsU.map UScalar.bv) ci sl excaps buffer ct := by
  have hX0 : JAt (L := L) arI AR s ar σ := ⟨Z, H, Cs, Ac, Lst, D, J, inferInstance⟩
  obtain ⟨σ1, hst⟩ := XTop.restart (L := L) (show XTop (L := L) AR s ar σ from ⟨Z, J.xtop⟩)
  have hAs : AbsSlot Z.th sl := by
    obtain ⟨p, hp, hth⟩ := hsl; exact ⟨p, hp, Or.inl hth⟩
  have hsc : capV (L.mem s) (cslotAddr sl) = c := capV_of_capAt hc
  have hni := hE.ni
  have hLv := hE.live
  have hP0 := J.ppr0_start arI hni hE.rd0 hE.ctnq
  have hPl : Placed Z.th := J.xtop.rel.1
  cases c
  case Null =>
    refine XCap.toPN arI (Or.inl ?_) (specDec_noPreK (by trivial))
    unfold DecOKDMX syscall.decode_invocation
    rw [hct]; simp only [bind_ok, WP.spec_ok]
    exact Or.inl ⟨_, rfl, rfl, ⟨_, rfl, Or.inr ⟨0#u64, rfl, rfl⟩⟩, hX0⟩
  case Zombie p zt n =>
    refine XCap.toPN arI (Or.inl ?_) (specDec_noPreK (by trivial))
    unfold DecOKDMX syscall.decode_invocation
    rw [hct]; simp only [bind_ok, WP.spec_ok]
    exact Or.inl ⟨_, rfl, rfl, ⟨_, rfl, Or.inr ⟨0#u64, rfl, rfl⟩⟩, hX0⟩
  case Endpoint p b sd rv g gr =>
    exact XCap.toPN arI (Or.inl (decode_endpointDMX arI _ s ar σ lbl length _ p b sd rv g gr blk call don fp buf extra
      slbl _ ci sl excaps buffer ct hct hX0 hst fun _ => sendLeafJ2 hG.tot J hni hE.ctnq hE.cnf hct hAs hc hst blk call g gr don
        hX0)) (specDec_noPreK (by trivial))
  case Notification p b sd rv =>
    exact XCap.toPN arI (Or.inl (decode_notificationDMX arI _ s ar σ lbl length _ p b sd rv blk call don fp buf extra
      slbl _ ci sl excaps buffer ct hct hX0 hst fun _ => notifLeafJN hG.tot hG.ppA.minBudget J hNs
        hni hct hAs hc hst hX0)) (specDec_noPreK (by trivial))
  case Reply p g =>
    exact XCap.toPN arI (Or.inl (decode_replyDMX arI _ s ar σ lbl length _ p g blk call don fp buf extra slbl _ ci sl
      excaps buffer ct hct hst (replyLeafJ hG.tot hG.maxTU hG.tu hG.ppA.minBudget J hni hct hAs hc hst
        (runTmoP_recv _ hG.tot hG.maxTU hG.tu) hX0))) (specDec_noPreK (by trivial))
  case CNode p r gs g =>
    exact hPD hR hVT hVI lbl length blk call don fp buf extra slbl argsU hlen hargs hbuf hl ci sl hsl _ hc (fun h => h)
      excaps buffer hXO hXN hLb hA5 hN
  case Thread p =>
    exact hPD hR hVT hVI lbl length blk call don fp buf extra slbl argsU hlen hargs hbuf hl ci sl hsl _ hc (fun h => h)
      excaps buffer hXO hXN hLb hA5 hN
  case IoPort first last z =>
    have hOpen := hN
    by_cases h0 : z = 0#u64
    · subst h0 hLb
      exact (decode_invocation_ioportJ arI s ar σ J hni hG.ari hG.tot (J.zNoBlk hE.sg) lbl lbl.bv (port_label lbl) length buf ct
        hct argsU hlen hargs sl hAs first last hsc call (fun _ => hG.portIn.at hR) blk don fp extra ci excaps buffer).toPN
        arI (specDec_noPreK (by trivial))
    · exact XCapP.reXP arI (hOpen h0) (specDec_noPreK (by trivial))
  case IrqControl =>
    subst hLb
    have hex := ExtraOK.rel1 hPl hXO
    obtain ⟨nA, hnum, hnA⟩ := hE.ioapics
    obtain ⟨sl1, idxs⟩ := sl
    obtain ⟨p0, hp0, hth0⟩ := hsl
    try simp only at hp0 hth0
    subst hp0
    exact (decode_invocation_irq_controlJ arI s ar σ J hni hG.ari hG.tot (J.zNoBlk hE.sg) hE.handlers lbl lbl.bv (irqControl_label lbl)
      (irqControl_remap lbl) length buf ct hct argsU hlen hargs J.act2 extra _ (exAt_idx0 extra) excaps hex hth0 rfl hc nA hnum hnA hE.archIrq
      blk call don fp ci buffer).toPN arI (specDec_noPreK (by trivial))
  case TdxControl =>
    subst hLb
    exact (decode_invocation_tdxJ arI s ar σ J hni hG.ari hG.tot (J.zNoBlk hE.sg) lbl length buf ct hct argsU hlen
      hargs extra excaps (ExtraOK.rel1 hPl hXO) (cslotAddr sl) blk call don fp ci sl buffer).toPN arI
      (specDec_noPreK (by trivial))
  case IoPortControl =>
    subst hLb
    have hex := ExtraOK.rel1 hPl hXO
    obtain ⟨sl1, idxs⟩ := sl
    obtain ⟨p0, hp0, hth0⟩ := hsl
    try simp only at hp0 hth0
    subst hp0
    exact (decode_invocation_ioport_controlJ arI s ar σ J hni hG.ari hG.tot (J.zNoBlk hE.sg) hE.ports lbl lbl.bv (ioControl_label lbl)
