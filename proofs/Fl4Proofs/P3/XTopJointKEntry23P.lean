section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)

/-- **`KDispHypsKV21` with `JPathAtM` and `JVtxHypMU`** (module docstring):
no `JUtPath.ret` [W] in the path premise. -/
structure KDispHypsKV23 (AR : A → Fl4Spec.Cr3 → Prop) (MR : A → Fl4Spec.MachineState → Prop) (Z : XSets)
    (H : P1.Heap) (Cs D : Set U64) (s : S) (a : A) (σ : Fl4Spec.State Unit) (n : I64) (c : Fl4Spec.Syscall) : Prop where
  inv : ∀ ct call bl don, sched.cur_thread st s = ok ct → InvSys n call bl don →
    JEntryGlobM (L := L) arI AR MR Z.th ∧ JEntryAt (L := L) arI AR Z H Cs s a σ ∧
    JPathAtM (L := L) arI AR Z H Cs D s a σ ct call bl don false (L.mem s (regA ct layout.reg.CAP)) ∧
    JVtxHypMU (L := L) arI AR MR Z H Cs D s a σ ct
  recv : ∀ bl cr, RecvSys n bl cr → (∀ d p, σ.curThread ∉ σ.readyQueues d p) ∧
    (∀ x, σ.kheap σ.curThread = some (.tcb x) → Fl4Spec.validFaultHandler x.tcbFaultHandler)
  mid : ∀ ct rg sr cr, sched.cur_thread st s = ok ct → MidSysR n c rg sr cr →
    JEntryGlobM (L := L) arI AR MR Z.th ∧ JEntryAt (L := L) arI AR Z H Cs s a σ ∧
    JPathAtM (L := L) arI AR Z H Cs D s a σ ct false false true true (L.mem s (regA ct rg)) ∧
    MidRun.JMidPerfHypQ true (Fl4Spec.toBl (L.mem s (regA ct rg)).bv) σ ∧
    JMidVfhHyp (Fl4Spec.toBl (L.mem s (regA ct rg)).bv) σ ∧
    JMidLeavesHyp13 (L := L) arI AR (Fl4Spec.toBl (L.mem s (regA ct rg)).bv) σ ∧
    JVtxHypMU (L := L) arI AR MR Z H Cs D s a σ ct

variable {arI} {MR : A → Fl4Spec.MachineState → Prop} {AR : A → Fl4Spec.Cr3 → Prop}

/-- **J23P's dispatch premise as `KDispHyps13PU`** at one dispatch state (the
conversions of `KDispHypsKV21.to13P` at `JPathM`). -/
theorem KDispHypsKV23.to13PU [Fl4Proofs.P1.PlainStore st] {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
    {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ σ0 : Fl4Spec.State Unit} {n : I64} {c : Fl4Spec.Syscall}
    (h : KDispHypsKV23 (L := L) arI AR MR Z H Cs D s a σ n c) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) [VxE Z]
    (hBA : BudgetAt σ0 σ true) (hA : P0.ArchTotal arI) (hnd : Fl4Spec.numDomains = 1) (hM : MachPlat arI MR)
    (hKD : MRKeepD arI MR) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv)
    (htu : ∀ a v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄) :
    KDispHyps13PU (L := L) arI AR MR Z H Cs D s a σ n c where
  inv ct call bl don hct hi := by
    obtain ⟨h1, h2, h3, h4⟩ := h.inv ct call bl don hct hi
    exact ⟨h1, h2, h3, jPreDecHyp_of14U J hct h1 h2 hM (jPreDecHyp_of17U J hct h1 h2 hM hKD
      (jPreDecHyp_of18U J hct h1 h2 hM hKD (jPreDecHyp_of20U h4)))⟩
  recv := h.recv
  mid ct rg sr cr hct hm := by
    obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := h.mid ct rg sr cr hct hm
    exact ⟨h1, h2, h3, h4, h5, jMidLeavesHyp_of7 hA (jMidLeavesHyp_of8 hA (jMidLeavesHyp_of9 hA
      (jMidLeavesHyp_of10 hA (jMidLeavesHyp_of11 hA hmax htu (jMidLeavesHyp_of12 hA
        (jMidLeavesHyp_of13 hA hmax htu h6)))))),
      jPreDecHyp_of14U J hct h1 h2 hM (jPreDecHyp_of17U J hct h1 h2 hM hKD
        (jPreDecHyp_of18U J hct h1 h2 hM hKD (jPreDecHyp_of20U h7)))⟩
  vmt := hBA.vmt hnd

end

