/-- **The perform keeps every `GKB` predicate when its IRQ control issue is bounded** (`InvB`, the decode's
range checks: SpecInvIrqBound's `okb_fl4Decode`). -/
theorem gkb_fl4PerformInvocation (x0 : Bool) (x1 : Bool) (x2 : Bool) (x3 : Fl4Invocation) (hb : InvB x3) :
    GKBE (fl4PerformInvocation (Z := Unit) x0 x1 x2 x3) := by
  cases x3 with
  | invokeIRQControl i =>
    simp only [InvB] at hb; simp only [fl4PerformInvocation]
    exact gkbe_bind (gkb_invokeFl4IrqControl i hb) fun _ => gkbe_returnOk _
  | _ => simp only [fl4PerformInvocation]; gkb_auto

