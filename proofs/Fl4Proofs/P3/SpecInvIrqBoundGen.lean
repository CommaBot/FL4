/-
P3 (line irqfix, gen 2): **`GKB` for the spec functions of the kernel entry below the invocation shell**
(spec side only; outside the `JAtZ` cone). Generated by proofs/scratch/irqfix2/genG.py from invB's
SpecInvValidMachineTimeGen (one lemma per function, `GK` ↦ `GKB`: the same proofs with the bounded
`set_irq_state` leaves of SpecInvIrqBoundKit). By hand: the IRQ control issues and the perform take the
decode's bound (`AicB`, `IcB`, `FIcB`, `InvB`: the issued line `≤ maxIRQ`). The invocation shell and
everything above it are in SpecInvIrqBound (with the decode carry).
-/
import Fl4Proofs.P3.SpecInvIrqBoundKit
import Fl4Proofs.P3.SpecFbX

open Classical

namespace Fl4Proofs.P3.SInvIB
open Fl4Spec Fl4Proofs.P3 Fl4Proofs.P3.Vs Fl4Proofs.P3.MachF Fl4Proofs.P3.MachT Fl4Proofs.P3.SInvV

noncomputable section

/-- The arch IRQ control issue's line is `≤ maxIRQ`. -/
def AicB : ArchIrqControlInvocation → Prop
  | .issueIRQHandlerIOAPIC irq _ _ _ _ _ _ _ => IRQ irq ≤ maxIRQ
  | .issueIRQHandlerMSI irq _ _ _ _ _ _ => IRQ irq ≤ maxIRQ

/-- l4v's IRQ control issue's line is `≤ maxIRQ`. -/
def IcB : IrqControlInvocation → Prop
  | .irqControl irq _ _ => irq ≤ maxIRQ
  | .archIRQControl aic => AicB aic

/-- FL4's IRQ control issue's line is `≤ maxIRQ`. -/
def FIcB : Fl4IrqControlInvocation → Prop
  | .spec i => IcB i
  | .ioapicRemapped irq _ _ _ _ _ _ _ _ => IRQ irq ≤ maxIRQ

/-- A decoded invocation's IRQ control issue is bounded. -/
def InvB : Fl4Invocation → Prop
  | .invokeIRQControl i => FIcB i
  | _ => True

set_option maxRecDepth 20000
set_option maxHeartbeats 1000000

