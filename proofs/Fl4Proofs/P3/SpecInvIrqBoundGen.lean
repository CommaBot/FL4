/-- **`cap_revoke` keeps every `GKB` predicate.** -/
theorem gkb_capRevoke (sl : CslotPtr) : GKBE (capRevoke (Z := Unit) sl) := by
  intro P L σ h x hx
  let f : CslotPtr → NonDet (State Unit) (Except Unit Unit) := fun _ t =>
    ({y | ∀ P, WLB P → P t → P y.2}, True)
  have hf : ∀ k t, (fun r c => capRevokeF (Z := Unit) r c) f k t ≤ f k t := fun k t =>
    ⟨fun y hy P' L' ht => gkb_capRevokeF (f := f) (fun _ P'' L'' _ hs _ hz => hz P'' L'' hs) k P' L' t ht y hy,
      fun _ => trivial⟩
  exact (lfp_le_prefixed _ f hf sl σ).1 hx P L h
macro_rules | `(tactic| gkb_leaf) => `(tactic| with_reducible apply gkb_capRevoke)

