theorem gkb_syscall {α β γ : Type} {mF : FMonad Unit α} {hF : Fault → SMonad Unit γ}
    {mE : α → SEMonad Unit β} {hE : SyscallError → SMonad Unit γ} {mFin : β → PMonad Unit γ}
    (h1 : GKBE mF) (h2 : ∀ f, GKB (hF f)) (h3 : ∀ a, GKBE (mE a)) (h4 : ∀ e, GKB (hE e))
    (h5 : ∀ b, GKBE (mFin b)) : GKBE (syscall (Z := Unit) mF hF mE hE mFin) := by
  unfold syscall
  refine gkbe_bind (gkbe_withoutPreemption h1) fun r => ?_
  cases r with
  | error f => exact gkbe_withoutPreemption (h2 f)
  | ok a =>
    refine gkbe_bind (gkbe_withoutPreemption (h3 a)) fun r => ?_
    cases r with
    | error e => exact gkbe_withoutPreemption (h4 e)
    | ok b => exact h5 b
macro_rules | `(tactic| gkb_leaf) => `(tactic| with_reducible refine gkb_syscall ?_ (fun _ => ?_) (fun _ => ?_) (fun _ => ?_) (fun _ => ?_))

