def faults.set_fault
  {S : Type _} (machineStoreInst : machine.Store S) (s : S) (t : obj.Tcb)
  (f : error.Fault) :
  Result S
  := do
  let (s1, ty, w0, w1, w2) ←
    match f with
    | error.Fault.Null =>
      ok (s, fl4_abi.consts.fault.NullFault, 0#u64, 0#u64, 0#u64)
    | error.Fault.Cap addr in_recv lf =>
      do
      let (lt, l0, l1) ← error.LookupFault.encode lf
      let s2 ← obj.Tcb.set_lf_type machineStoreInst t s lt
      let s3 ← obj.Tcb.set_lf_w0 machineStoreInst t s2 l0
      let s4 ← obj.Tcb.set_lf_w1 machineStoreInst t s3 l1
      let i ← if in_recv
                then ok 1#u64
                else ok 0#u64
      ok (s4, fl4_abi.consts.fault.CapFault, addr, i, 0#u64)
    | error.Fault.UnknownSyscall number =>
      ok (s, fl4_abi.consts.fault.UnknownSyscall, number, 0#u64, 0#u64)
    | error.Fault.UserException number code =>
      ok (s, fl4_abi.consts.fault.UserException, number, code, 0#u64)
    | error.Fault.Debug reason addr bp =>
      ok (s, fl4_abi.consts.fault.DebugException, reason, addr, bp)
    | error.Fault.Timeout badge =>
      ok (s, fl4_abi.consts.fault.Timeout, badge, 0#u64, 0#u64)
    | error.Fault.VmFault addr fsr instruction =>
      do
      let i ← if instruction
                then ok 1#u64
                else ok 0#u64
      ok (s, fl4_abi.consts.fault.VMFault, addr, fsr, i)
  let s2 ← obj.Tcb.set_fault_type machineStoreInst t s1 ty
  let s3 ← obj.Tcb.set_fault_w0 machineStoreInst t s2 w0
  let s4 ← obj.Tcb.set_fault_w1 machineStoreInst t s3 w1
  obj.Tcb.set_fault_w2 machineStoreInst t s4 w2

