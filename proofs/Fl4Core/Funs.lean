def obj.Slot.first_badged
  {S : Type _} (machineStoreInst : machine.Store S) (self : obj.Slot) (s : S) :
  Result Bool
  := do
  let i ← obj.Slot.next_word machineStoreInst self s
  let i1 ← obj.MDB_FIRST_BADGED
  let i2 ← lift (i &&& i1)
  ok (i2 != 0#u64)

