def sched.update_timestamp
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) :
  Result (S × A)
  := do
  let prev ← sched.cur_time machineStoreInst s
  let (now, a1) ← machineArchInst.now a
  let c ← machineStoreInst.cur_cpu s
  let s1 ← obj.node_set machineStoreInst s c layout.node.CUR_TIME now
  let used ← lift (core.num.U64.wrapping_sub now prev)
  let i ← sched.consumed machineStoreInst s1
  let total ← lift (core.num.U64.wrapping_add i used)
  let s2 ← sched.set_consumed machineStoreInst s1 total
  if layout.NUM_DOMAINS > 1#u64
  then
    let dt ← sched.domain_time machineStoreInst s2
    let i1 ← sporadic.min_budget machineArchInst a1
    let i2 ← lift (core.num.U64.saturating_add used i1)
    if i2 >= dt
    then
      let s3 ← obj.ks_set machineStoreInst s2 layout.ks.DOMAIN_TIME 0#u64
      ok (s3, a1)
    else
      let i3 ← dt - used
      let s3 ← obj.ks_set machineStoreInst s2 layout.ks.DOMAIN_TIME i3
      ok (s3, a1)
  else ok (s2, a1)

