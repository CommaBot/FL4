        if i != 0#u64
        then ipc.reply_unlink machineStoreInst s2 i t
        else ok s2
      else ok s2
    let s4 ← sched.set_thread_state machineStoreInst s3 t sched.TS_INACTIVE
    ok (s4, a)
  else
    if st = sched.TS_BLOCKED_ON_RECV
    then
      let ep ← obj.Tcb.block_obj machineStoreInst t s1
      let s2 ← endpoint.ep_dequeue machineStoreInst s1 ep t
      let s3 ←
        if st = sched.TS_BLOCKED_ON_RECV
