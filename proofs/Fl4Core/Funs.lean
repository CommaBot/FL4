  let (s2, a2) ←
    if b
    then
      do
      let t ← sched.cur_thread machineStoreInst s1
      let i ← code >>> 4#i32
      let i1 ← lift (i &&& 1#u64)
      let f ← vspace.vm_fault addr code (i1 != 0#u64)
